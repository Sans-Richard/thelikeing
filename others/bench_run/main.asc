// Local benchmark main — multiple configs per process for msprof batch timing
// Usage: ./add_rms_norm_bias_custom r1 d1 dt1 it1 r2 d2 dt2 it2 ...
//   dtype: 0=fp32 1=fp16 2=bf16
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cmath>
#include <vector>
#include <string>
#include <chrono>
#include "acl/acl.h"

#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo {
    const int64_t* shape;
    int64_t numDims;
    int32_t dtype;
};
struct TensorGroupInfo {
    const TensorInfo* tensors;
    int64_t numTensors;
};
#endif

#include "data_utils.h"

#define ACL_CHECK(expr) do { aclError _ret = (expr); if (_ret != 0) { \
    fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, _ret); \
    return 1; } } while(0)

#include "kernel.asc"

static double runOnce(aclrtStream stream, uint64_t rows, uint32_t d, int32_t dtype,
                      void* dev_x, void* dev_r, void* dev_g, void* dev_b, void* dev_o,
                      int64_t availCores, float eps) {
    int64_t shape1[2] = {(int64_t)rows, (int64_t)d};
    TensorInfo ti = {shape1, 2, dtype};
    TensorGroupInfo gx = {&ti, 1};
    auto t0 = std::chrono::steady_clock::now();
    run_kernel((GM_ADDR)dev_x, gx, (GM_ADDR)dev_r, gx, (GM_ADDR)dev_g, gx,
               (GM_ADDR)dev_b, gx, (GM_ADDR)dev_o, gx, availCores, stream, eps);
    aclrtSynchronizeStream(stream);
    auto t1 = std::chrono::steady_clock::now();
    return std::chrono::duration<double, std::milli>(t1 - t0).count();
}

int main(int argc, char** argv) {
    int32_t deviceId = 0;
    int64_t availCores = 0;
    aclrtStream stream = nullptr;
    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(deviceId));
    ACL_CHECK(aclrtGetDeviceInfo(deviceId, ACL_DEV_ATTR_VECTOR_CORE_NUM, &availCores));
    ACL_CHECK(aclrtCreateStream(&stream));
    fprintf(stderr, "[bench] availCores=%ld argc=%d\n", (long)availCores, argc);

    struct Cfg { uint64_t rows; uint32_t d; int32_t dtype; int iters; };
    std::vector<Cfg> cfgs;
    for (int a = 1; a + 2 < argc; a += 4) {
        Cfg c;
        c.rows = std::stoull(argv[a]);
        c.d = (uint32_t)std::stoul(argv[a + 1]);
        c.dtype = std::stoi(argv[a + 2]);
        c.iters = (a + 3 < argc) ? std::stoi(argv[a + 3]) : 3;
        cfgs.push_back(c);
    }

    for (auto& c : cfgs) {
        size_t bytes = (size_t)c.rows * c.d * (c.dtype == 0 ? 4 : 2);
        size_t gbytes = (size_t)c.d * (c.dtype == 0 ? 4 : 2);
        void *hx = nullptr, *hr = nullptr, *hg = nullptr, *hb = nullptr, *ho = nullptr;
        void *dx = nullptr, *dr = nullptr, *dg = nullptr, *db = nullptr, *do_ = nullptr;
        ACL_CHECK(aclrtMallocHost((void**)&hx, bytes)); ACL_CHECK(aclrtMalloc((void**)&dx, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
        ACL_CHECK(aclrtMallocHost((void**)&hr, bytes)); ACL_CHECK(aclrtMalloc((void**)&dr, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
        ACL_CHECK(aclrtMallocHost((void**)&hg, gbytes)); ACL_CHECK(aclrtMalloc((void**)&dg, gbytes, ACL_MEM_MALLOC_HUGE_FIRST));
        ACL_CHECK(aclrtMallocHost((void**)&hb, gbytes)); ACL_CHECK(aclrtMalloc((void**)&db, gbytes, ACL_MEM_MALLOC_HUGE_FIRST));
        ACL_CHECK(aclrtMallocHost((void**)&ho, bytes)); ACL_CHECK(aclrtMalloc((void**)&do_, bytes, ACL_MEM_MALLOC_HUGE_FIRST));

        uint8_t* p = (uint8_t*)hx;
        for (size_t i = 0; i < bytes; ++i) p[i] = (uint8_t)(i * 31 + 7);
        p = (uint8_t*)hr;
        for (size_t i = 0; i < bytes; ++i) p[i] = (uint8_t)(i * 17 + 3);
        p = (uint8_t*)hg;
        for (size_t i = 0; i < gbytes; ++i) p[i] = (uint8_t)(i * 7 + 1);
        p = (uint8_t*)hb;
        for (size_t i = 0; i < gbytes; ++i) p[i] = (uint8_t)(i * 13 + 5);

        ACL_CHECK(aclrtMemcpy(dx, bytes, hx, bytes, ACL_MEMCPY_HOST_TO_DEVICE));
        ACL_CHECK(aclrtMemcpy(dr, bytes, hr, bytes, ACL_MEMCPY_HOST_TO_DEVICE));
        ACL_CHECK(aclrtMemcpy(dg, gbytes, hg, gbytes, ACL_MEMCPY_HOST_TO_DEVICE));
        ACL_CHECK(aclrtMemcpy(db, gbytes, hb, gbytes, ACL_MEMCPY_HOST_TO_DEVICE));

        // warmup (1 launch)
        runOnce(stream, c.rows, c.d, c.dtype, dx, dr, dg, db, do_, availCores, 1e-5f);
        double best = 1e18, sum = 0;
        for (int i = 0; i < c.iters; ++i) {
            double t = runOnce(stream, c.rows, c.d, c.dtype, dx, dr, dg, db, do_, availCores, 1e-5f);
            if (t < best) best = t;
            sum += t;
        }
        const char* dn = c.dtype == 0 ? "fp32" : (c.dtype == 1 ? "fp16" : "bf16");
        printf("rows=%6llu d=%5u %s iters=%d best=%.3fms avg=%.3fms\n",
               (unsigned long long)c.rows, c.d, dn, c.iters, best, sum / c.iters);
        fflush(stdout);

        if (hx) aclrtFreeHost(hx); if (dx) aclrtFree(dx);
        if (hr) aclrtFreeHost(hr); if (dr) aclrtFree(dr);
        if (hg) aclrtFreeHost(hg); if (dg) aclrtFree(dg);
        if (hb) aclrtFreeHost(hb); if (db) aclrtFree(db);
        if (ho) aclrtFreeHost(ho); if (do_) aclrtFree(do_);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
