// 15 estimated hidden-case shapes, one pass (for msprof device timing)
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cmath>
#include <chrono>
#include "acl/acl.h"
#ifndef TENSOR_GROUP_INFO_DEFINED
#define TENSOR_GROUP_INFO_DEFINED
struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
#endif
#include "data_utils.h"
#define ACL_CHECK(expr) do { aclError _ret = (expr); if (_ret != 0) { fprintf(stderr, "[ERROR] %s @%d ret=%d\n", #expr, __LINE__, _ret); return 1; } } while(0)
#include "kernel.asc"

struct Cfg { uint64_t rows; uint32_t d; int32_t dtype; };
int main(int argc, char** argv) {
    int32_t dev=0; int64_t cores=0; aclrtStream stream=nullptr;
    ACL_CHECK(aclInit(nullptr)); ACL_CHECK(aclrtSetDevice(dev));
    ACL_CHECK(aclrtGetDeviceInfo(dev, ACL_DEV_ATTR_VECTOR_CORE_NUM, &cores));
    ACL_CHECK(aclrtCreateStream(&stream));
    Cfg cfgs[] = {
        {1, 64, 1}, {8, 197, 0}, {128, 256, 0}, {768, 197, 1}, {8, 32768, 1},
        {1513, 577, 1}, {3114, 401, 1}, {10240, 512, 1}, {4096, 1535, 0}, {8192, 1024, 1},
        {3748, 3080, 0}, {3408, 4096, 2}, {10296, 3076, 0}, {2097152, 115, 2}, {262144, 8192, 2},
    };
    int n = sizeof(cfgs)/sizeof(cfgs[0]);
    int iters = argc > 1 ? atoi(argv[1]) : 2;
    for (int i = 0; i < n; ++i) {
        Cfg c = cfgs[i];
        int esz = c.dtype == 0 ? 4 : 2;
        size_t bytes = (size_t)c.rows * c.d * esz;
        size_t gbytes = (size_t)c.d * esz;
        void *hx=nullptr,*hr=nullptr,*hg=nullptr,*hb=nullptr,*ho=nullptr;
        void *dx=nullptr,*dr=nullptr,*dg=nullptr,*db=nullptr,*do_=nullptr;
        ACL_CHECK(aclrtMallocHost(&hx, bytes)); ACL_CHECK(aclrtMalloc(&dx, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
        ACL_CHECK(aclrtMallocHost(&hr, bytes)); ACL_CHECK(aclrtMalloc(&dr, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
        ACL_CHECK(aclrtMallocHost(&hg, gbytes)); ACL_CHECK(aclrtMalloc(&dg, gbytes, ACL_MEM_MALLOC_HUGE_FIRST));
        ACL_CHECK(aclrtMallocHost(&hb, gbytes)); ACL_CHECK(aclrtMalloc(&db, gbytes, ACL_MEM_MALLOC_HUGE_FIRST));
        ACL_CHECK(aclrtMallocHost(&ho, bytes)); ACL_CHECK(aclrtMalloc(&do_, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
        uint8_t* p=(uint8_t*)hx; for (size_t k=0;k<bytes;++k) p[k]=(uint8_t)(k*31+7);
        p=(uint8_t*)hr; for (size_t k=0;k<bytes;++k) p[k]=(uint8_t)(k*17+3);
        p=(uint8_t*)hg; for (size_t k=0;k<gbytes;++k) p[k]=(uint8_t)(k*7+1);
        p=(uint8_t*)hb; for (size_t k=0;k<gbytes;++k) p[k]=(uint8_t)(k*13+5);
        ACL_CHECK(aclrtMemcpy(dx, bytes, hx, bytes, ACL_MEMCPY_HOST_TO_DEVICE));
        ACL_CHECK(aclrtMemcpy(dr, bytes, hr, bytes, ACL_MEMCPY_HOST_TO_DEVICE));
        ACL_CHECK(aclrtMemcpy(dg, gbytes, hg, gbytes, ACL_MEMCPY_HOST_TO_DEVICE));
        ACL_CHECK(aclrtMemcpy(db, gbytes, hb, gbytes, ACL_MEMCPY_HOST_TO_DEVICE));
        int64_t shape1[2] = {(int64_t)c.rows, (int64_t)c.d};
        TensorInfo ti = {shape1, 2, c.dtype};
        TensorGroupInfo gx = {&ti, 1};
        int64_t gshape[1] = {(int64_t)c.d};
        TensorInfo gti = {gshape, 1, c.dtype};
        TensorGroupInfo gg = {&gti, 1};
        for (int it = 0; it < iters; ++it) {
            auto t0 = std::chrono::steady_clock::now();
            run_kernel((GM_ADDR)dx, gx, (GM_ADDR)dr, gx, (GM_ADDR)dg, gg,
                       (GM_ADDR)db, gg, (GM_ADDR)do_, gx, cores, stream, 1e-5f);
            aclrtSynchronizeStreamWithTimeout(stream, 60000);
            auto t1 = std::chrono::steady_clock::now();
            printf("case%02d R=%llu D=%u DT=%d wall=%.1fus\n", i+1,
                   (unsigned long long)c.rows, c.d, c.dtype,
                   std::chrono::duration<double, std::micro>(t1-t0).count());
            fflush(stdout);
        }
        if (hx) aclrtFreeHost(hx); if (dx) aclrtFree(dx);
        if (hr) aclrtFreeHost(hr); if (dr) aclrtFree(dr);
        if (hg) aclrtFreeHost(hg); if (dg) aclrtFree(dg);
        if (hb) aclrtFreeHost(hb); if (db) aclrtFree(db);
        if (ho) aclrtFreeHost(ho); if (do_) aclrtFree(do_);
    }
    aclrtDestroyStream(stream); aclrtResetDevice(dev); aclFinalize();
    return 0;
}
