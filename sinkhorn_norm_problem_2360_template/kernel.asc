// Route B: isolated H88 q2/q3 device entry. Host admission fixes each owner to
// valid 2/3; runtime iters and eps are forwarded unchanged. The final branch is
// a defensive in-process fallback for any unexpected owner shape.
__global__ __vector__ void sinkhorn_norm_custom_compact_h88_scaled(
    GM_ADDR mixes, GM_ADDR pre, GM_ADDR post, GM_ADDR comb,
    uint64_t tokens, uint32_t iters, float eps, uint32_t tokenGroup, uint32_t q)
{
    uint64_t first = 0;
    uint64_t end = 0;
    sinkhorn_norm::TokenRange(tokens, tokenGroup, first, end);
    const uint64_t valid = end - first;
    if (q == 3U && valid == 3U) {
        AscendC::TPipe pipe;
        sinkhorn_norm::ResidentScaledTokenBatchKernel kernel;
        kernel.InitRange(mixes, pre, post, comb, first, end, 88U, iters, eps, q, 1U, &pipe);
        kernel.ProcessFixed<3U, 3U>();
    } else if (q == 3U && valid == 2U) {
        AscendC::TPipe pipe;
        sinkhorn_norm::ResidentScaledTokenBatchKernel kernel;
        kernel.InitRange(mixes, pre, post, comb, first, end, 88U, iters, eps, q, 1U, &pipe);
        kernel.ProcessFixed<3U, 2U>();
    } else if (q == 2U && valid == 2U) {
        AscendC::TPipe pipe;
        sinkhorn_norm::ResidentScaledTokenBatchKernel kernel;
        kernel.InitRange(mixes, pre, post, comb, first, end, 88U, iters, eps, q, 1U, &pipe);
        kernel.ProcessFixed<2U, 2U>();
    } else {
        AscendC::TPipe pipe;
        sinkhorn_norm::ResidentScaledTokenBatchKernel kernel;
        kernel.Init(mixes, pre, post, comb, tokens, 88U, iters, eps,
            tokenGroup, q, 1U, &pipe);
        kernel.Process();
    }
}

namespace sinkhorn_norm {
// H2 direct streaming route. The hidden H=2/I=2 point has one 32-byte
// input token and one 32-byte output token. A device-built byte-offset map
// gathers the contiguous AoS input into eight token-wide FP32 planes using the
// same indexing convention as the device-validated q256 plane kernel. The
// direct 2x2 formula then replaces every generic softmax/state-update loop.
// The output Gather compacts all three destinations into one contiguous panel,
// issued once per whole-token tile (T=888 on the device; 128/256/512 fallbacks).
template <uint32_t TileTokens>
class H2DirectStreamKernel {
    static_assert(TileTokens == 888U || TileTokens == 512U ||
        TileTokens == 256U || TileTokens == 128U,
        "H2 direct stream tile must be a whole eight-token group");
public:
    static constexpr uint32_t kWidth = 8U;
    static constexpr uint32_t kTileFloats = TileTokens * kWidth;

    __aicore__ inline void Init(GM_ADDR mixes, GM_ADDR pre, GM_ADDR post,
        GM_ADDR comb, uint64_t n, uint32_t h, uint32_t iters, float eps,
        uint32_t tokenGroup, TPipe* pipe)
    {
        pipe_ = pipe;
        h_ = h;
        iters_ = iters;
        eps_ = eps;
        TokenRange(n, tokenGroup, first_, end_);
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(mixes));
        pre_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(pre));
        post_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(post));
        comb_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(comb));

        // Six 8T panels are retained: two offset maps, raw input, packed
        // output, eight SoA planes, and shared math scratch. One extra 2T
        // constant panel supplies exact 1/x reciprocals without Reciprocal.
        pipe_->InitBuffer(indexBuf_,
            2U * kTileFloats * sizeof(int32_t) + 32U);
        pipe_->InitBuffer(inputQueue_, 1, kTileFloats * sizeof(float));
        pipe_->InitBuffer(outputQueue_, 1, kTileFloats * sizeof(float));
        pipe_->InitBuffer(soaBuf_, kTileFloats * sizeof(float));
        pipe_->InitBuffer(scratchBuf_, kTileFloats * sizeof(float));
        pipe_->InitBuffer(onesBuf_, 2U * TileTokens * sizeof(float));
        soa_ = soaBuf_.Get<float>();
        scratch_ = scratchBuf_.Get<float>();
        ones_ = onesBuf_.Get<float>();
        Duplicate(ones_, 1.0f, static_cast<int32_t>(2U * TileTokens));
        VectorDone();
        auto indices = indexBuf_.Get<int32_t>();
        outputIndex_ = indices;
        inputIndex_ = indices[kTileFloats];
        BuildOutputIndex(TileTokens);
        BuildInputIndex(TileTokens);
    }

    __aicore__ inline void Process()
    {
        for (uint64_t token = first_; token < end_; token += TileTokens) {
            const uint32_t valid = static_cast<uint32_t>(
                end_ - token < TileTokens ? end_ - token : TileTokens);
            auto raw = inputQueue_.AllocTensor<float>();
            LoadExact(raw, x_[token * kWidth], valid * kWidth);
            inputQueue_.EnQue(raw);
            raw = inputQueue_.DeQue<float>();
            if (valid != TileTokens) {
                BuildInputIndex(valid);
                BuildOutputIndex(valid);
            }
            Gather(soa_, raw, inputIndex_.ReinterpretCast<uint32_t>(),
                uint32_t(0), kTileFloats);
            VectorDone();
            inputQueue_.FreeTensor(raw);

            ComputeGates();
            RowSoftmaxOnce();
            NormalizeColumns();
            NormalizeRows();
            NormalizeColumns();

            // The two Gathers update the vector mask state. Restore the normal
            // 64-FP32-lane mask before the packed output Gather.
            SetMaskNorm();
            ResetMask();
            auto output = outputQueue_.AllocTensor<float>();
            Gather(output, soa_, outputIndex_.ReinterpretCast<uint32_t>(),
                uint32_t(0), valid * kWidth);
            VectorDone();
            outputQueue_.EnQue(output);
            output = outputQueue_.DeQue<float>();
            StoreExact(pre_[token * 2U], output, valid * 2U);
            StoreExact(post_[token * 2U], output[2U * valid], valid * 2U);
            StoreExact(comb_[token * 4U], output[4U * valid], valid * 4U);
            outputQueue_.FreeTensor(output);
        }
    }

private:
    __aicore__ inline void BuildInputIndex(uint32_t valid)
    {
        for (uint32_t field = 0; field < kWidth; ++field) {
            for (uint32_t token = 0; token < TileTokens; ++token) {
                const uint32_t sourceToken = token < valid ? token : 0U;
                inputIndex_.SetValue(field * TileTokens + token,
                    static_cast<int32_t>((sourceToken * kWidth + field) *
                        sizeof(float)));
            }
        }
        SyncPipelines<HardEvent::S_V>(*pipe_);
    }

    // All four stable sigmoids are one contiguous 4T vector:
    // exp(min(z,0)) / (1 + exp(-abs(z))). The two 4T scratch halves hold
    // numerator and denominator simultaneously; no per-plane helper calls.
    __aicore__ inline void ComputeGates()
    {
        Mins(scratch_, soa_, 0.0f, static_cast<int32_t>(4U * TileTokens));
        Abs(scratch_[4U * TileTokens], soa_,
            static_cast<int32_t>(4U * TileTokens));
        VectorDone();
        Exp(scratch_, scratch_, static_cast<int32_t>(4U * TileTokens));
        Muls(scratch_[4U * TileTokens], scratch_[4U * TileTokens], -1.0f,
            static_cast<int32_t>(4U * TileTokens));
        VectorDone();
        Exp(scratch_[4U * TileTokens], scratch_[4U * TileTokens],
            static_cast<int32_t>(4U * TileTokens));
        VectorDone();
        Adds(scratch_[4U * TileTokens], scratch_[4U * TileTokens], 1.0f,
            static_cast<int32_t>(4U * TileTokens));
        VectorDone();
        Div(soa_, scratch_, scratch_[4U * TileTokens],
            static_cast<int32_t>(4U * TileTokens));
        VectorDone();
        Adds(soa_, soa_, eps_, static_cast<int32_t>(2U * TileTokens));
        Muls(soa_[2U * TileTokens], soa_[2U * TileTokens], 2.0f,
            static_cast<int32_t>(2U * TileTokens));
        VectorDone();
    }

    // Keep row max and subtraction at their original per-row order. Only the
    // normalization multiply is fused across the four matrix planes.
    __aicore__ inline void RowSoftmaxOnce()
    {
        auto a = soa_[4U * TileTokens];
        auto b = soa_[5U * TileTokens];
        auto c = soa_[6U * TileTokens];
        auto d = soa_[7U * TileTokens];
        auto max0 = scratch_;
        auto max1 = scratch_[TileTokens];
        Max(max0, a, b, static_cast<int32_t>(TileTokens));
        Max(max1, c, d, static_cast<int32_t>(TileTokens));
        VectorDone();
        Sub(a, a, max0, static_cast<int32_t>(TileTokens));
        Sub(b, b, max0, static_cast<int32_t>(TileTokens));
        Sub(c, c, max1, static_cast<int32_t>(TileTokens));
        Sub(d, d, max1, static_cast<int32_t>(TileTokens));
        VectorDone();
        Exp(a, a, static_cast<int32_t>(4U * TileTokens));
        VectorDone();
        Add(max0, a, b, static_cast<int32_t>(TileTokens));
        Add(max1, c, d, static_cast<int32_t>(TileTokens));
        VectorDone();
        auto inv0 = scratch_[2U * TileTokens];
        auto inv1 = scratch_[3U * TileTokens];
        Div(inv0, ones_, max0, static_cast<int32_t>(2U * TileTokens));
        VectorDone();
        Mul(a, a, inv0, static_cast<int32_t>(TileTokens));
        Mul(b, b, inv0, static_cast<int32_t>(TileTokens));
        Mul(c, c, inv1, static_cast<int32_t>(TileTokens));
        Mul(d, d, inv1, static_cast<int32_t>(TileTokens));
        VectorDone();
        Adds(a, a, eps_, static_cast<int32_t>(4U * TileTokens));
        VectorDone();
    }

    // Every normalization computes 1/(sum+eps) once for both roots, then
    // broadcasts each root by ordinary plane multiplies. This removes four
    // Div launches per stage while retaining Div for the inverse itself.
    __aicore__ inline void NormalizeRows()
    {
        auto a = soa_[4U * TileTokens];
        auto b = soa_[5U * TileTokens];
        auto c = soa_[6U * TileTokens];
        auto d = soa_[7U * TileTokens];
        auto sum0 = scratch_;
        auto sum1 = scratch_[TileTokens];
        Add(sum0, a, b, static_cast<int32_t>(TileTokens));
        Add(sum1, c, d, static_cast<int32_t>(TileTokens));
        VectorDone();
        Adds(sum0, sum0, eps_, static_cast<int32_t>(2U * TileTokens));
        VectorDone();
        auto inv0 = scratch_[2U * TileTokens];
        auto inv1 = scratch_[3U * TileTokens];
        Div(inv0, ones_, sum0, static_cast<int32_t>(2U * TileTokens));
        VectorDone();
        Mul(a, a, inv0, static_cast<int32_t>(TileTokens));
        Mul(b, b, inv0, static_cast<int32_t>(TileTokens));
        Mul(c, c, inv1, static_cast<int32_t>(TileTokens));
        Mul(d, d, inv1, static_cast<int32_t>(TileTokens));
        VectorDone();
    }

    __aicore__ inline void NormalizeColumns()
    {
        auto a = soa_[4U * TileTokens];
        auto b = soa_[5U * TileTokens];
        auto c = soa_[6U * TileTokens];
        auto d = soa_[7U * TileTokens];
        auto sum0 = scratch_;
        auto sum1 = scratch_[TileTokens];
        Add(sum0, a, c, static_cast<int32_t>(TileTokens));
        Add(sum1, b, d, static_cast<int32_t>(TileTokens));
        VectorDone();
        Adds(sum0, sum0, eps_, static_cast<int32_t>(2U * TileTokens));
        VectorDone();
        auto inv0 = scratch_[2U * TileTokens];
        auto inv1 = scratch_[3U * TileTokens];
        Div(inv0, ones_, sum0, static_cast<int32_t>(2U * TileTokens));
        VectorDone();
        Mul(a, a, inv0, static_cast<int32_t>(TileTokens));
        Mul(c, c, inv0, static_cast<int32_t>(TileTokens));
        Mul(b, b, inv1, static_cast<int32_t>(TileTokens));
        Mul(d, d, inv1, static_cast<int32_t>(TileTokens));
        VectorDone();
    }

    __aicore__ inline void BuildOutputIndex(uint32_t valid)
    {
        for (uint32_t token = 0; token < valid; ++token) {
            const uint32_t tokenByte = token * sizeof(float);
            outputIndex_.SetValue(2U * token, static_cast<int32_t>(tokenByte));
            outputIndex_.SetValue(2U * token + 1U,
                static_cast<int32_t>(TileTokens * sizeof(float) + tokenByte));
            outputIndex_.SetValue(2U * valid + 2U * token,
                static_cast<int32_t>(2U * TileTokens * sizeof(float) + tokenByte));
            outputIndex_.SetValue(2U * valid + 2U * token + 1U,
                static_cast<int32_t>(3U * TileTokens * sizeof(float) + tokenByte));
            for (uint32_t field = 0; field < 4U; ++field) {
                outputIndex_.SetValue(4U * valid + 4U * token + field,
                    static_cast<int32_t>((4U + field) * TileTokens * sizeof(float) + tokenByte));
            }
        }
        SyncPipelines<HardEvent::S_V>(*pipe_);
    }

    TPipe* pipe_;
    TQue<QuePosition::VECIN, 1> inputQueue_;
    TQue<QuePosition::VECOUT, 1> outputQueue_;
    TBuf<TPosition::VECCALC> soaBuf_, scratchBuf_, indexBuf_, onesBuf_;
    GlobalTensor<float> x_, pre_, post_, comb_;
    LocalTensor<float> soa_, scratch_, ones_;
    LocalTensor<int32_t> outputIndex_, inputIndex_;
    uint64_t first_, end_;
    uint32_t h_, iters_;
    float eps_;
};

inline uint64_t H2DirectStreamBytes(uint32_t tileTokens)
{
    // Six 8T panels plus the exact reciprocal constant panel.
    return (uint64_t(200U) * tileTokens) + 256U;
}

}  // namespace sinkhorn_norm

// NATURAL_Q256_DEVICE_BEGIN
namespace sinkhorn_norm {
class BatchPlanesQ256Kernel {
public:
    __aicore__ inline void Init(GM_ADDR mixes, GM_ADDR pre, GM_ADDR post,
        GM_ADDR comb, uint64_t n, uint32_t h, uint32_t iters, float eps,
        uint32_t tokenGroup, uint32_t q, TPipe* pipe)
    {
        pipe_ = pipe;
        h_ = h;
        q_ = q;
        w_ = h * h + 2 * h;
        iters_ = iters;
        eps_ = eps;
        TokenRange(n, tokenGroup, first_, end_);
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(mixes));
        pre_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(pre));
        post_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(post));
        comb_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(comb));
        const uint32_t planeBytes = w_ * q_ * sizeof(float);
        pipe_->InitBuffer(input_, 1, planeBytes);
        pipe_->InitBuffer(output_, 1, planeBytes);
        pipe_->InitBuffer(planesBuf_, planeBytes);
        pipe_->InitBuffer(inputIndexBuf_, planeBytes);
        pipe_->InitBuffer(outputIndexBuf_, planeBytes);
        pipe_->InitBuffer(workBuf_, 4 * h_ * q_ * sizeof(float));
        planes_ = planesBuf_.Get<float>();
        work_ = workBuf_.Get<float>();
        inputIndex_ = inputIndexBuf_.Get<uint32_t>();
        outputIndex_ = outputIndexBuf_.Get<uint32_t>();
        BuildInputIndex(q_);
        BuildOutputIndex(tokenGroup);
    }

    __aicore__ inline void Process()
    {
        for (uint64_t token = first_; token < end_; token += q_) {
            const uint32_t valid = static_cast<uint32_t>(
                end_ - token < q_ ? end_ - token : q_);
            if (valid != q_) {
                // The preceding Gather must finish before scalar index writes.
                SyncPipelines<HardEvent::V_S>(*pipe_);
                BuildInputIndex(valid);
            }
            auto input = input_.AllocTensor<float>();
            LoadExact(input, x_[token * w_], valid * w_);
            input_.EnQue(input);
            input = input_.DeQue<float>();
            Gather(planes_, input, inputIndex_, uint32_t(0), w_ * q_);
            VectorDone();
            input_.FreeTensor(input);

            const uint32_t gates = 2 * h_ * q_;
            SigmoidInPlace(planes_, work_, work_[gates], gates);
            Adds(planes_, planes_, eps_, h_ * q_);
            Muls(planes_[h_ * q_], planes_[h_ * q_], 2.0f, h_ * q_);
            VectorDone();
            RowSoftmax();
            NormalizeColumns();
            for (uint32_t iter = 1; iter < iters_; ++iter) {
                NormalizeRows();
                NormalizeColumns();
            }

            auto output = output_.AllocTensor<float>();
            Gather(output, planes_, outputIndex_, uint32_t(0), w_ * q_);
            VectorDone();  // Complete the read before the next batch overwrites planes_.
            output_.EnQue(output);  // V -> MTE3 dependency
            output = output_.DeQue<float>();
            StoreExact(pre_[token * h_], output, valid * h_);
            StoreExact(post_[token * h_], output[q_ * h_], valid * h_);
            StoreExact(comb_[token * h_ * h_], output[2 * q_ * h_],
                valid * h_ * h_);
            output_.FreeTensor(output);
        }
    }

private:
    __aicore__ inline void BuildInputIndex(uint32_t valid)
    {
        // A2 supports int32 Adds. Gather still consumes the same uint32 byte
        // offsets; all offsets are <= 24572 for H<=4 and Q==256.
        // The first Q entries form an immutable seed for the remaining planes.
        for (uint32_t token = 0; token < q_; ++token) {
            // Dummy lanes reuse token 0, never the uninitialized DMA tail.
            const uint32_t sourceToken = token < valid ? token : 0;
            inputIndex_.SetValue(token, sourceToken * w_ * sizeof(float));
        }
        SyncPipelines<HardEvent::S_V>(*pipe_);
        auto indices = inputIndex_.ReinterpretCast<int32_t>();
        for (uint32_t feature = 1; feature < w_; ++feature) {
            // Q is a multiple of eight, so every base is 32-byte aligned.
            Adds<int32_t>(indices[feature * q_], indices,
                static_cast<int32_t>(feature * sizeof(float)), q_);
        }
        VectorDone();
    }

    __aicore__ inline void BuildOutputIndex(uint32_t tokenGroup)
    {
        // tokenGroup = 8/gcd(H,8): each seed and destination group occupies
        // whole 32-byte blocks, including odd H. Q is divisible by tokenGroup.
        for (uint32_t token = 0; token < tokenGroup; ++token) {
            for (uint32_t i = 0; i < h_; ++i) {
                outputIndex_.SetValue(token * h_ + i,
                    (i * q_ + token) * sizeof(float));
                outputIndex_.SetValue(q_ * h_ + token * h_ + i,
                    ((h_ + i) * q_ + token) * sizeof(float));
            }
            for (uint32_t ij = 0; ij < h_ * h_; ++ij) {
                outputIndex_.SetValue(2 * q_ * h_ + token * h_ * h_ + ij,
                    ((2 * h_ + ij) * q_ + token) * sizeof(float));
            }
        }
        // Keep this synchronization even when Q==tokenGroup: Gather must see
        // the scalar seed writes when no vector expansion is needed.
        SyncPipelines<HardEvent::S_V>(*pipe_);
        auto indices = outputIndex_.ReinterpretCast<int32_t>();
        const uint32_t gateCount = tokenGroup * h_;
        const uint32_t matrixCount = gateCount * h_;
        for (uint32_t token = tokenGroup; token < q_; token += tokenGroup) {
            const int32_t offset = static_cast<int32_t>(token * sizeof(float));
            Adds<int32_t>(indices[token * h_], indices, offset, gateCount);
            Adds<int32_t>(indices[q_ * h_ + token * h_], indices[q_ * h_],
                offset, gateCount);
            Adds<int32_t>(indices[2 * q_ * h_ + token * h_ * h_],
                indices[2 * q_ * h_], offset, matrixCount);
        }
        VectorDone();
    }

    __aicore__ inline LocalTensor<float> Entry(uint32_t i, uint32_t j)
    {
        return planes_[(2 * h_ + i * h_ + j) * q_];
    }

    __aicore__ inline void RowSoftmax()
    {
        // One Q-wide statistic per row. All H rows are independent repeats.
        // Q is 256; four FP32 64-lane slices use matrix repeat stride <= 128 blocks.
        auto rowMax = work_;
        auto rowSum = work_[h_ * q_];
        const uint8_t statsStride = static_cast<uint8_t>(q_ / kBlockFloats);
        const uint8_t matrixStride = static_cast<uint8_t>(h_ * q_ / kBlockFloats);
        const uint8_t repeats = static_cast<uint8_t>(h_);
        const uint64_t mask = kVectorFloats;
        const UnaryRepeatParams copyRows{1, 1, statsStride, matrixStride};
        const BinaryRepeatParams reduceRows{1, 1, 1, statsStride, statsStride, matrixStride};
        const BinaryRepeatParams applyRows{1, 1, 1, matrixStride, matrixStride, statsStride};

        for (uint32_t lane = 0; lane < q_; lane += kVectorFloats) {
                Adds(rowMax[lane], Entry(0, 0)[lane], 0.0f, mask, repeats, copyRows);
            }
        VectorDone();
        for (uint32_t j = 1; j < h_; ++j) {
            for (uint32_t lane = 0; lane < q_; lane += kVectorFloats) {
                Max(rowMax[lane], rowMax[lane], Entry(0, j)[lane], mask, repeats, reduceRows);
            }
            VectorDone();
        }
        for (uint32_t j = 0; j < h_; ++j) {
            for (uint32_t lane = 0; lane < q_; lane += kVectorFloats) {
                Sub(Entry(0, j)[lane], Entry(0, j)[lane], rowMax[lane], mask, repeats, applyRows);
            }
        }
        VectorDone();
        Exp(Entry(0, 0), Entry(0, 0), h_ * h_ * q_);
        VectorDone();
        for (uint32_t lane = 0; lane < q_; lane += kVectorFloats) {
                Adds(rowSum[lane], Entry(0, 0)[lane], 0.0f, mask, repeats, copyRows);
            }
        VectorDone();
        for (uint32_t j = 1; j < h_; ++j) {
            // The j order for every (row, token) is identical to the scalar loop.
            for (uint32_t lane = 0; lane < q_; lane += kVectorFloats) {
                Add(rowSum[lane], rowSum[lane], Entry(0, j)[lane], mask, repeats, reduceRows);
            }
            VectorDone();
        }
        for (uint32_t j = 0; j < h_; ++j) {
            for (uint32_t lane = 0; lane < q_; lane += kVectorFloats) {
                Div(Entry(0, j)[lane], Entry(0, j)[lane], rowSum[lane], mask, repeats, applyRows);
            }
        }
        VectorDone();
        // The softmax denominator has NO eps. Eps is added to its result.
        Adds(Entry(0, 0), Entry(0, 0), eps_, h_ * h_ * q_);
        VectorDone();
    }

    __aicore__ inline void NormalizeRows()
    {
        auto sum = work_;
        const uint8_t statsStride = static_cast<uint8_t>(q_ / kBlockFloats);
        const uint8_t matrixStride = static_cast<uint8_t>(h_ * q_ / kBlockFloats);
        const uint8_t repeats = static_cast<uint8_t>(h_);
        const uint64_t mask = kVectorFloats;
        const UnaryRepeatParams copyRows{1, 1, statsStride, matrixStride};
        const BinaryRepeatParams reduceRows{1, 1, 1, statsStride, statsStride, matrixStride};
        const BinaryRepeatParams applyRows{1, 1, 1, matrixStride, matrixStride, statsStride};
        for (uint32_t lane = 0; lane < q_; lane += kVectorFloats) {
                Adds(sum[lane], Entry(0, 0)[lane], 0.0f, mask, repeats, copyRows);
            }
        VectorDone();
        for (uint32_t j = 1; j < h_; ++j) {
            for (uint32_t lane = 0; lane < q_; lane += kVectorFloats) {
                Add(sum[lane], sum[lane], Entry(0, j)[lane], mask, repeats, reduceRows);
            }
            VectorDone();
        }
        Adds(sum, sum, eps_, h_ * q_);
        VectorDone();
        for (uint32_t j = 0; j < h_; ++j) {
            for (uint32_t lane = 0; lane < q_; lane += kVectorFloats) {
                Div(Entry(0, j)[lane], Entry(0, j)[lane], sum[lane], mask, repeats, applyRows);
            }
        }
        VectorDone();
    }

    __aicore__ inline void NormalizeColumns()
    {
        // All columns and token lanes form one contiguous H*Q vector. The
        // accumulation order remains i=0,1,...,H-1 for every (column, token).
        auto sum = work_;
        const uint32_t rowCount = h_ * q_;
        Adds(sum, Entry(0, 0), 0.0f, rowCount);
        VectorDone();
        for (uint32_t i = 1; i < h_; ++i) {
            Add(sum, sum, Entry(i, 0), rowCount);
            VectorDone();
        }
        Adds(sum, sum, eps_, rowCount);
        VectorDone();
        for (uint32_t i = 0; i < h_; ++i) {
            Div(Entry(i, 0), Entry(i, 0), sum, rowCount);
        }
        VectorDone();
    }

    TPipe* pipe_;
    TQue<QuePosition::VECIN, 1> input_;
    TQue<QuePosition::VECOUT, 1> output_;
    TBuf<TPosition::VECCALC> planesBuf_, inputIndexBuf_, outputIndexBuf_, workBuf_;
    GlobalTensor<float> x_, pre_, post_, comb_;
    LocalTensor<float> planes_, work_;
    LocalTensor<uint32_t> inputIndex_, outputIndex_;
    uint64_t first_, end_;
    uint32_t h_, q_, w_, iters_;
    float eps_;
};

} // namespace sinkhorn_norm
__global__ __vector__ void sinkhorn_norm_planes_q256(GM_ADDR mixes, GM_ADDR pre,
    GM_ADDR post, GM_ADDR comb, uint64_t tokens, uint32_t h, uint32_t iters,
    float eps, uint32_t tokenGroup)
{
    AscendC::TPipe pipe;
    sinkhorn_norm::BatchPlanesQ256Kernel kernel;
    kernel.Init(mixes, pre, post, comb, tokens, h, iters, eps, tokenGroup, 512U, &pipe);
    kernel.Process();
}

// NATURAL_Q256_DEVICE_END

// Isolated H2/I2 streaming entry. Tile width is selected only from usable UB
// and per-core token metadata; every legal N/tail is processed in the same leaf.
__global__ __vector__ void sinkhorn_norm_h2_direct_stream(
    GM_ADDR mixes, GM_ADDR pre, GM_ADDR post, GM_ADDR comb,
    uint64_t tokens, uint32_t h, uint32_t iters, float eps,
    uint32_t tokenGroup, uint32_t tileTokens)
{
    AscendC::InitSocState();
    AscendC::TPipe pipe;
    if (tileTokens == 888U) {
        sinkhorn_norm::H2DirectStreamKernel<888U> kernel;
        kernel.Init(mixes, pre, post, comb, tokens, h, iters, eps,
            tokenGroup, &pipe);
        kernel.Process();
    } else if (tileTokens == 512U) {
        sinkhorn_norm::H2DirectStreamKernel<512U> kernel;
        kernel.Init(mixes, pre, post, comb, tokens, h, iters, eps,
            tokenGroup, &pipe);
        kernel.Process();
    } else if (tileTokens == 256U) {
        sinkhorn_norm::H2DirectStreamKernel<256U> kernel;
        kernel.Init(mixes, pre, post, comb, tokens, h, iters, eps,
            tokenGroup, &pipe);
        kernel.Process();
    } else {
        sinkhorn_norm::H2DirectStreamKernel<128U> kernel;
        kernel.Init(mixes, pre, post, comb, tokens, h, iters, eps,
            tokenGroup, &pipe);
        kernel.Process();
    }
}

inline void sinkhorn_norm_launch(GM_ADDR mixes, GM_ADDR pre, GM_ADDR post,
    GM_ADDR comb, int64_t b, int64_t s, int64_t h, int64_t iters, float eps,
    int64_t availableCoreNum, uint64_t availableUbBytes, aclrtStream stream)
{
    using namespace sinkhorn_norm;
    if (b < 1 || b > 128 || s < 1 || s > 8192 || h < 2 || h > 128 ||
        iters < 1 || iters > 32 || availableCoreNum < 1 ||
        mixes == nullptr || pre == nullptr || post == nullptr || comb == nullptr) {
        throw std::invalid_argument("SinkhornNorm: invalid shape, iterations, cores or pointer");
    }
    // The published statement does not specify eps's permitted range. Forward
    // every finite eps without clamping. A positive eps avoids zero denominators.
    if (!std::isfinite(eps)) {
        throw std::invalid_argument("SinkhornNorm: eps must be finite");
    }
    const uint32_t height = static_cast<uint32_t>(h);
    const uint64_t tokens = static_cast<uint64_t>(b) * static_cast<uint64_t>(s);
    const uint32_t gateTokenGroup = TokenGroup(height);
    const uint32_t matrixTokenGroup = TokenGroup(height * height);
    const uint64_t gateGroups = (tokens + gateTokenGroup - 1) / gateTokenGroup;
    const uint64_t cores = static_cast<uint64_t>(availableCoreNum);
    // Increase matrix parallelism only when gate alignment leaves usable AIV
    // blocks idle. Gate outputs keep their original stronger alignment group.
    // Odd H, H%8==0 and long-row paths retain the original launch/ownership.
    const bool splitOwnership = height > kBlockFloats && height < kVectorFloats &&
        matrixTokenGroup < gateTokenGroup && gateGroups < cores &&
        (tokens + matrixTokenGroup - 1) / matrixTokenGroup > gateGroups;
    const uint32_t tokenGroup = splitOwnership ? matrixTokenGroup : gateTokenGroup;
    const uint64_t groups = (tokens + tokenGroup - 1) / tokenGroup;
    const uint32_t blocks = static_cast<uint32_t>(groups < cores ? groups : cores);
    const uint64_t groupBound = ((groups + blocks - 1) / blocks) * tokenGroup;
    const uint64_t maxTokensPerCore = groupBound < tokens ? groupBound : tokens;
    // H2/I2 owns the dense 8-float stream. Pick the widest whole-token tile
    // whose complete UB arena is admitted; otherwise preserve q256/generic.
    uint32_t h2DirectTile = 0U;
    if (height == 2U && iters == 2U && maxTokensPerCore >= 128U) {
        if (H2DirectStreamBytes(888U) <= availableUbBytes) {
            h2DirectTile = 888U;
        } else if (H2DirectStreamBytes(512U) <= availableUbBytes) {
            h2DirectTile = 512U;
        } else if (H2DirectStreamBytes(256U) <= availableUbBytes) {
            h2DirectTile = 256U;
        } else if (H2DirectStreamBytes(128U) <= availableUbBytes) {
            h2DirectTile = 128U;
        }
    }
    // F2 inherits F0's H88-only positive-eps resource domain.
    const bool f2PipelineFactor = height == 88U && tokenGroup == 1U &&
        eps > 0.0f && F0StaticFactorUbReady(availableUbBytes);
    // B4 width-isolated factor dispatch. The corrected MTE contract completes
    // only the last partial 32-byte block; a separate aligned destination gap
    // advances each padded UB row. H56/H64/H100 each have their own entry.
    const bool ubFactorEligible = eps > 0.0f && iters >= 4;
    const bool ubFactorH56 = ubFactorEligible && height == 56U &&
        UBFactorUbReady<56U>(availableUbBytes);
    // Measured 2026-11-06 on 910B3: for H64 the C6 interleaved batch path
    // (sinkhorn_norm_custom_h64_interleaved_batch) is consistently 10-13%
    // faster than the factorized ub_factor_prefetch_h64 at iters 4/20/32.
    // H64 appears only in hidden case H8 (N=160/I=20). Keep H56/H100 on the
    // factorized path (verified faster there).
    const bool ubFactorH64 = false;
    const bool ubFactorH100 = ubFactorEligible && height == 100U &&
        UBFactorUbReady<100U>(availableUbBytes);
    uint32_t planeBatch = 0;
    // H13 (h=13, iters=2): use the generic planes kernel with 32 token-lanes so
    // per-op setup amortizes 4x more than the q==8 resident batch (platform best
    // 19.5us implies ~64 lanes; q=32 fits UB: 5x195x32x4 + work).
    if (height == 13U && iters == 2U && tokens >= 512U) {
        for (uint32_t q = 64U; q >= 8U; q -= 8U) {
            if (PlaneBytes(height, q) <= availableUbBytes) { planeBatch = q; break; }
        }
    }
    // A row fitting one FP32 data block is the initial small-matrix range.
    // Thresholds/batch size are provisional tuning choices, not benchmark wins.
    if (height <= kBlockFloats && maxTokensPerCore >= kBlockFloats) {
        const uint32_t limit = static_cast<uint32_t>(
            maxTokensPerCore < kMaxBatch ? maxTokensPerCore : kMaxBatch);
        planeBatch = (limit + 7) / 8 * 8;
        while (planeBatch != 0 && PlaneBytes(height, planeBatch) > availableUbBytes) {
            planeBatch -= 8;
        }
    }
    if (planeBatch == 0 && ResidentBytes(height) > availableUbBytes) {
        throw std::invalid_argument("SinkhornNorm: insufficient usable UB for resident matrix");
    }
    // Preserve all existing H<=8 dispatch decisions. Only independent
    // resident matrices are packed; their arithmetic is unchanged per token.
    uint32_t residentBatch = 1;
    if (height > kBlockFloats && maxTokensPerCore >= 2) {
        residentBatch = 4;
        while (residentBatch > 1 && (residentBatch > maxTokensPerCore ||
            ResidentTokenBatchBytes(height, residentBatch) > availableUbBytes)) {
            residentBatch /= 2;
        }
    }
    // Larger batches amortize barriers only in the sub-vector-row family
    // where packing independent tokens also reduces column issue slices.
    // Account for the entire possible row denominator panel before increasing
    // q, so the larger matrix never displaces a usable short-row Div panel.
    const uint64_t widePitch = (height + 7) / 8 * 8;
    const uint64_t wideStats = (kMaxResidentTokenBatch * height + 7) / 8 * 8;
    const uint64_t widePanelExtra = sizeof(float) * wideStats * (widePitch - 8);
    if (height > kBlockFloats && height < kVectorFloats &&
        maxTokensPerCore >= kMaxResidentTokenBatch &&
        (kMaxResidentTokenBatch * widePitch + kVectorFloats - 1) / kVectorFloats
            < kMaxResidentTokenBatch &&
        ResidentTokenBatchBytes(height, kMaxResidentTokenBatch) + widePanelExtra
            <= availableUbBytes) {
        residentBatch = kMaxResidentTokenBatch;
    }
    uint32_t scaledResident =
        height >= kVectorFloats && iters > 1 &&
        ResidentScaledBytes(height) <= availableUbBytes;
    // Pack independent scaled matrices only when alignment permits a dense
    // interleaved row and the metadata predicts fewer column vector repeats.
    // Keep the original core partition and query the actual usable UB budget.
    if (scaledResident != 0 && height > kVectorFloats &&
        height < 2 * kVectorFloats && height % kBlockFloats == 0 &&
        maxTokensPerCore >= 2) {
        const uint32_t limit = static_cast<uint32_t>(
            maxTokensPerCore < 4 ? maxTokensPerCore : 4);
        for (uint32_t q = limit; q >= 2; --q) {
            const uint32_t packedRepeats = (q * height + kVectorFloats - 1) / kVectorFloats;
            const uint32_t separateRepeats = q * ((height + kVectorFloats - 1) / kVectorFloats);
            if (packedRepeats < separateRepeats &&
                ResidentScaledTokenBatchBytes(height, q) <= availableUbBytes) {
                scaledResident = q;
                break;
            }
        }
    }
    // Dedicated H==64 interleaved batch. It keeps the C6 H64 BR8 row tree
    // and C6 column row-order, but shares one column recurrence across q
    // tokens. q=4 is tried first; q=2 is the only fallback (q=3 is not used),
    // and anything below q=2 keeps the existing complete_br8 entry.
    uint32_t h64InterleavedBatch = 0;
    if (scaledResident != 0 && height == kVectorFloats && iters > 1 &&
        maxTokensPerCore >= 2) {
        if (maxTokensPerCore >= 4 &&
            H64InterleavedScaledBytes(height, 4) <= availableUbBytes) {
            h64InterleavedBatch = 4;
        } else if (H64InterleavedScaledBytes(height, 2) <= availableUbBytes) {
            h64InterleavedBatch = 2;
        }
    }
    // P2 preserves the original q1 scaled admission and original ownership.
    // Packing costs use P, because the physical E=valid*P includes each tail.
    // P128 (and every q with no native column-issue saving) stays on q1.
    uint32_t wideOriginalBatch = 0;
    if (scaledResident == 1 && height > kVectorFloats &&
        height < 2 * kVectorFloats && height % kBlockFloats != 0 &&
        maxTokensPerCore >= 2) {
        const uint32_t limit = static_cast<uint32_t>(
            maxTokensPerCore < 4 ? maxTokensPerCore : 4);
        for (uint32_t q = limit; q >= 2; --q) {
            const uint32_t packedRepeats = static_cast<uint32_t>(
                (q * widePitch + kVectorFloats - 1) / kVectorFloats);
            const uint32_t separateRepeats =
                q * ((height + kVectorFloats - 1) / kVectorFloats);
            if (packedRepeats < separateRepeats &&
                WideOriginalScaledTokenBatchBytes(height, q) <= availableUbBytes) {
                wideOriginalBatch = q;
                break;
            }
        }
    }
    // Keep the previously selected q. If the extra denominator panel does
    // not fit the actual UB budget, keep q and the original compact path.
    const uint64_t batchPitch = (height + 7) / 8 * 8;
    const uint64_t batchStats = (residentBatch * height + 7) / 8 * 8;
    const uint64_t panelExtraBytes = sizeof(float) * batchStats * (batchPitch - 8);
    const bool rowDivPanel = scaledResident == 0 && (residentBatch > 1 || splitOwnership) &&
        height > kBlockFloats && height < kVectorFloats && batchPitch < kVectorFloats &&
        ResidentTokenBatchBytes(height, residentBatch) + panelExtraBytes <= availableUbBytes;
    // Preserve the original q and the selected Div panel. Only the natural
    // two-to-four-block row family may add physical rows for its final BR.
    // Existing stats/Brcb storage is already rounded to eight real-row slots.
    const uint64_t tailRowsExtraBytes = sizeof(float) *
        (batchStats - uint64_t(residentBatch) * height) * batchPitch;
    const bool shortTailBr = scaledResident == 0 && (residentBatch > 1 || splitOwnership) &&
        height > kBlockFloats && batchPitch <= kVectorFloats / 2 &&
        height % kBlockFloats != 0 &&
        ResidentTokenBatchBytes(height, residentBatch) +
            (rowDivPanel ? panelExtraBytes : 0) + tailRowsExtraBytes <= availableUbBytes;
    // Match UseRowInnerCompactDen's full-q8 metadata predicate. The exact TPipe
    // layout must fit both the wrapper budget and the queried platform budget.
    const uint32_t compactRows = kMaxResidentTokenBatch * height;
    const uint32_t compactBroadcasts = (compactRows + 7) / 8;
    const uint32_t compactPackedDivs =
        (compactRows * batchPitch + kVectorFloats - 1) / kVectorFloats;
    const bool compactRowsPanel = rowDivPanel &&
        compactBroadcasts * (batchPitch / kBlockFloats) +
            4U * compactPackedDivs <
        compactBroadcasts + 4U * compactRows;
    const bool compactInterleaved = height % kBlockFloats == 0 ||
        (height > kBlockFloats && height < kVectorFloats &&
            height % kBlockFloats != 0 &&
            (kMaxResidentTokenBatch * batchPitch + kVectorFloats - 1) /
                kVectorFloats < kMaxResidentTokenBatch);
    const bool compactMetadata = planeBatch == 0 && scaledResident == 0 &&
        !splitOwnership && residentBatch == kMaxResidentTokenBatch &&
        (batchPitch == 5 * kBlockFloats || batchPitch == 6 * kBlockFloats) &&
        height < kVectorFloats && batchPitch > kVectorFloats / 2 &&
        eps >= 0x1p-60f && eps <= 0x1p+60f && compactRowsPanel &&
        compactInterleaved && batchStats == compactRows && iters > 1 &&
        (iters - 1) * (batchPitch / kBlockFloats - 1) >
            2 * (batchPitch / kBlockFloats);
    const uint64_t queriedUbBytes = QueryUsableUbBytes();
    const bool h128FPanelSlots = planeBatch == 0 &&
        height == sinkhorn_norm::kH128SlotRows &&
        eps > 0.0f &&
        sinkhorn_norm::kF128PanelArenaBytes <= availableUbBytes &&
        sinkhorn_norm::kF128PanelArenaBytes <= queriedUbBytes;
    const uint64_t bulkInputBytes =
        ResidentTokenBatchBulkInputBytes(height, kMaxResidentTokenBatch);
    const bool bulkInputGather = compactMetadata &&
        bulkInputBytes <= availableUbBytes &&
        bulkInputBytes <= queriedUbBytes;
    uint32_t packedResidentBatch = residentBatch |
        (rowDivPanel ? kShortRowDivPanelFlag : 0) |
        (shortTailBr ? kShortRowTailBrFlag : 0) |
        (bulkInputGather ? kBulkInputGatherFlag : 0);
    // The original q8 resident path stores at most one resident batch per
    // block. When every q8 batch fits in one hardware wave, make that same
    // batch also the ownership group. This removes arbitrary one-versus-two
    // TokenRange groups per block while preserving q, UB layout, and math.
    // Both original output groups must divide q8, so every owner boundary is
    // still a complete 32-byte output boundary. No case number, SKU core
    // count, or UB size is encoded.
    uint32_t residentLaunchBlocks = blocks;
    uint32_t residentLaunchTokenGroup = tokenGroup;
    const uint64_t singleWaveQ8Blocks =
        (tokens + kMaxResidentTokenBatch - 1) / kMaxResidentTokenBatch;
    const bool singleWaveQ8Partition = planeBatch == 0 && scaledResident == 0 &&
        !splitOwnership && residentBatch == kMaxResidentTokenBatch &&
        gateTokenGroup == tokenGroup &&
        tokenGroup < kMaxResidentTokenBatch &&
        kMaxResidentTokenBatch % tokenGroup == 0 &&
        kMaxResidentTokenBatch % matrixTokenGroup == 0 &&
        singleWaveQ8Blocks <= cores;
    if (singleWaveQ8Partition) {
        residentLaunchTokenGroup = kMaxResidentTokenBatch;
        residentLaunchBlocks = static_cast<uint32_t>(singleWaveQ8Blocks);
    }
    // C2: only short q2 split-ownership calls can move gates to surplus
    // vector blocks. Original matrix ownership/batches/UB/math stay fixed.
    // All aligned gate groups must fit in the spare capacity in this wave:
    // no matrix core is stolen and no gate owner serializes multiple groups.
    // Four or more strict iterations is a conservative metadata cost guard;
    // it is a tuning hypothesis, not evidence of measured speed.
    const bool surplusQ2Gates = splitOwnership && planeBatch == 0 &&
        scaledResident == 0 && residentBatch == 2 &&
        height > kBlockFloats && batchPitch <= kVectorFloats / 2 &&
        rowDivPanel && shortTailBr && iters >= 4 &&
        residentLaunchBlocks < cores &&
        gateGroups <= cores - residentLaunchBlocks;
    const uint32_t independentGateCoreCount = surplusQ2Gates
        ? static_cast<uint32_t>(gateGroups) : 0;
// Cpack admits the compact output tiler after proving low iters, a nonaligned
// short row and enough room; full q8 batches use it and a partial tail falls back.
const uint64_t lowIterOutputBytes =
    ResidentTokenBatchLowIterOutputBytes(height, kMaxResidentTokenBatch);
const bool lowIterOutputPack = planeBatch == 0 &&
    scaledResident == 0 && !splitOwnership &&
    residentBatch == kMaxResidentTokenBatch &&
    residentLaunchTokenGroup == kMaxResidentTokenBatch &&
    // Full q8 batches use the compact tiler; the final partial batch keeps the R4 output fallback.
    height > kBlockFloats && height <= 2U * kBlockFloats &&
    height % kBlockFloats != 0 && iters <= 3U && rowDivPanel &&
    lowIterOutputBytes <= availableUbBytes &&
    lowIterOutputBytes <= queriedUbBytes;
if (lowIterOutputPack) {
    packedResidentBatch |= kLowIterOutputPackFlag;
}
    // Keep the former device priority; exactly one branch launches.
    // TokenRange groups and N are multiples of q8, so every owner batch is full.
    const bool slimCompact40 = compactMetadata && bulkInputGather && batchPitch == 40U &&
        residentLaunchTokenGroup == 8U && tokens % 8U == 0;
    // Complete q2 owners only; unusual eps and partial owners retain generic.
    // Keep parent q/flags/ownership/UB selection; every BR source row exists.
    const bool compactShortNative = planeBatch == 0 && scaledResident == 0 &&
        height > 8U && height <= 32U && residentBatch == 2U && rowDivPanel &&
        (shortTailBr || (2U * height) % 8U == 0) &&
        eps >= 0x1p-20f && eps <= 0x1p-4f &&
        tokens % 2U == 0 &&
        (tokenGroup % 2U == 0 ||
            (groups % blocks == 0 && ((groups / blocks) * tokenGroup) % 2U == 0));
    if (height == 7U && planeBatch == 8U) {
        sinkhorn_norm_h7_q8_tree<<<blocks, nullptr, stream>>>(
            mixes, pre, post, comb, tokens, height,
            static_cast<uint32_t>(iters), eps, tokenGroup);
    } else if (ubFactorH56) {
        sinkhorn_norm_ub_factor_prefetch_h56<<<blocks, nullptr, stream>>>(
            mixes, pre, post, comb, tokens, static_cast<uint32_t>(iters),
            eps, tokenGroup);
    } else if (ubFactorH64) {
        sinkhorn_norm_ub_factor_prefetch_h64<<<blocks, nullptr, stream>>>(
            mixes, pre, post, comb, tokens, static_cast<uint32_t>(iters),
            eps, tokenGroup);
    } else if (ubFactorH100) {
        sinkhorn_norm_ub_factor_prefetch_h100<<<blocks, nullptr, stream>>>(
            mixes, pre, post, comb, tokens, static_cast<uint32_t>(iters),
            eps, tokenGroup);
    } else if (f2PipelineFactor) {
        // Compact the q1 owner set without changing the tokenGroup==1 work:
        // C0=min(N,C), L=ceil(N/C0), B=ceil(N/L).  Every division is guarded
        // by the launcher's N>=1, C>=1 and tokenGroup==1 admission invariants.
        const uint64_t compactOwnerCapacity = tokens < cores ? tokens : cores;
        const uint64_t compactOwnerWidth = tokens / compactOwnerCapacity +
            (tokens % compactOwnerCapacity != 0U ? 1U : 0U);
        const uint64_t compactOwnerBlocks = tokens / compactOwnerWidth +
            (tokens % compactOwnerWidth != 0U ? 1U : 0U);
        sinkhorn_norm_f2_io_pipeline_q1<<<static_cast<uint32_t>(compactOwnerBlocks), nullptr, stream>>>(
            mixes, pre, post, comb, tokens, static_cast<uint32_t>(iters),
            eps, tokenGroup);
    } else if (h2DirectTile != 0U) {
        sinkhorn_norm_h2_direct_stream<<<blocks, nullptr, stream>>>(
            mixes, pre, post, comb, tokens, height,
            static_cast<uint32_t>(iters), eps, tokenGroup, h2DirectTile);
    } else if (compactShortNative && surplusQ2Gates && batchPitch == 24U) {
        // Full static M1 arena: rounded matrix, gates, 256B pad, work,
        // stats and rounded Brcb panel. The flag never changes admission/q.
        const uint64_t p24Stats=(2U*height+7U)/8U*8U;
        const uint64_t p24PhysicalRows=shortTailBr ? p24Stats : 2U*height;
        const uint64_t p24BroadcastAddr=
            (p24PhysicalRows*24U+96U+192U+p24Stats)*sizeof(float)+256U;
        const uint64_t p24RowDenAddr=(p24BroadcastAddr+255U)/512U*512U+256U;
        const uint64_t p24PanelBytes=24U*p24Stats*sizeof(float);
        const uint64_t p24OldEnd=p24BroadcastAddr+p24PanelBytes;
        const uint64_t p24DenEnd=p24RowDenAddr+p24PanelBytes;
        const uint64_t p24HighWater=p24DenEnd>p24OldEnd ? p24DenEnd : p24OldEnd;
        const uint32_t p24Flags=packedResidentBatch |
            ((p24HighWater<=availableUbBytes && p24HighWater<=queriedUbBytes)
                ? kP24RowDenLayoutFlag : 0U);
        // A1: the unchanged admission exhausts H18/H22 (matrix q2, gate q4).
        // Every admitted input is covered; no N/core/iters/eps specialization.
        if (height == 18U) {
            sinkhorn_norm_compact_short_static_p24_h18<<<
                blocks + independentGateCoreCount,nullptr,stream>>>(
                mixes,pre,post,comb,tokens,height,static_cast<uint32_t>(iters),eps,
                tokenGroup,p24Flags,blocks);
        } else {
            // Algebraically the only other admitted height is 22.
            sinkhorn_norm_compact_short_static_p24_h22<<<
                blocks + independentGateCoreCount,nullptr,stream>>>(
                mixes,pre,post,comb,tokens,height,static_cast<uint32_t>(iters),eps,
                tokenGroup,p24Flags,blocks);
        }
    } else if (compactShortNative && surplusQ2Gates) {
        // q2 excludes the q8 repartition, so blocks == residentLaunchBlocks.
        // Keep the old A1 block count; only add independently aligned gates.
        sinkhorn_norm_compact_short_native_fused<<<
            blocks + independentGateCoreCount,nullptr,stream>>>(
            mixes,pre,post,comb,tokens,height,static_cast<uint32_t>(iters),eps,
            tokenGroup,packedResidentBatch,blocks);
    } else if (compactShortNative) {
        sinkhorn_norm_compact_short_native<<<blocks,nullptr,stream>>>(
            mixes,pre,post,comb,tokens,height,static_cast<uint32_t>(iters),eps,
            tokenGroup,packedResidentBatch);
    } else if (slimCompact40) {
        sinkhorn_norm_slim_compact40<<<residentLaunchBlocks,nullptr,stream>>>(
            mixes,pre,post,comb,tokens,height,static_cast<uint32_t>(iters),eps,
            residentLaunchTokenGroup);
    } else if (planeBatch == 0 && h64InterleavedBatch > 1) {
        sinkhorn_norm_custom_h64_interleaved_batch<<<blocks, nullptr, stream>>>(mixes, pre, post, comb,
            tokens, height, static_cast<uint32_t>(iters), eps, tokenGroup,
            h64InterleavedBatch);
    } else if (planeBatch == 0 && wideOriginalBatch > 1) {
        sinkhorn_norm_custom_wide_original_batch<<<blocks, nullptr, stream>>>(mixes, pre, post, comb,
            tokens, height, static_cast<uint32_t>(iters), eps, tokenGroup, wideOriginalBatch);
    } else if (planeBatch == 0 && scaledResident > 1) {
        // Optional full-column tree is considered only after the original q
        // and every device-entry priority are fixed. Never reduce q to fit it.
        uint32_t columnTreeEnabled = 0;
        if (height > kVectorFloats && height < 2 * kVectorFloats &&
            height % kBlockFloats == 0 &&
            eps >= 0.00000095367431640625f && eps <= 0.0625f) {
            // This admission cannot use QueryUsableUbBytes' fallback budget:
            // zero/unavailable actual query keeps the original complete path.
            auto* treePlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
            uint64_t treePhysicalUbBytes = 0;
            if (treePlatform != nullptr) {
                treePlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB,
                    treePhysicalUbBytes);
            }
            const uint64_t treeReserveBytes = 16U * 1024U;
            if (treePhysicalUbBytes > treeReserveBytes) {
                const uint64_t queriedTreeBudget =
                    (treePhysicalUbBytes - treeReserveBytes) / 32U * 32U;
                const uint64_t treePitch = (height + 7) / 8 * 8;
                const uint64_t treeStats =
                    (uint64_t(scaledResident) * height + 7) / 8 * 8;
                const uint64_t originalScratchFloats = 16U * treeStats;
                const uint64_t fullTreeScratchFloats =
                    ((uint64_t(height) + 1) / 2) * scaledResident * treePitch;
                const uint64_t admittedScratchFloats =
                    fullTreeScratchFloats > originalScratchFloats ?
                    fullTreeScratchFloats : originalScratchFloats;
                const uint64_t fullTreeBytes =
                    ResidentScaledTokenBatchBytes(height, scaledResident) +
                    sizeof(float) * (admittedScratchFloats - originalScratchFloats);
                if (fullTreeBytes <= availableUbBytes &&
                    fullTreeBytes <= queriedTreeBudget) {
                    columnTreeEnabled = 1;
                }
            }
        }
        const bool compactH88Scaled = height == 88U && tokenGroup == 1U &&
            columnTreeEnabled != 0U && groups / blocks >= 2U &&
            ((scaledResident == 2U && maxTokensPerCore == 2U) ||
             (scaledResident == 3U && maxTokensPerCore == 3U));
        if (compactH88Scaled) {
            sinkhorn_norm_custom_compact_h88_scaled<<<blocks, nullptr, stream>>>(
                mixes, pre, post, comb, tokens, static_cast<uint32_t>(iters),
                eps, tokenGroup, scaledResident);
        } else {
            sinkhorn_norm_custom_scaled_batch<<<blocks, nullptr, stream>>>(
                mixes, pre, post, comb, tokens, height, static_cast<uint32_t>(iters),
                eps, tokenGroup, planeBatch, packedResidentBatch, scaledResident, columnTreeEnabled);
        }
    } else if (planeBatch == 0 && height <= kBlockFloats && iters == 1) {
        // Only actual one-iteration calls select the exhaustive fixed-height family.
        switch (height) {
        case 2:
            sinkhorn_norm_custom_tiny_resident_once_h2<<<blocks, nullptr, stream>>>(mixes, pre, post, comb,
                tokens, height, static_cast<uint32_t>(iters), eps, tokenGroup, planeBatch,
                packedResidentBatch, scaledResident);
            break;
        case 3:
            sinkhorn_norm_custom_tiny_resident_once_h3<<<blocks, nullptr, stream>>>(mixes, pre, post, comb,
                tokens, height, static_cast<uint32_t>(iters), eps, tokenGroup, planeBatch,
                packedResidentBatch, scaledResident);
            break;
        case 4:
            sinkhorn_norm_custom_tiny_resident_once_h4<<<blocks, nullptr, stream>>>(mixes, pre, post, comb,
                tokens, height, static_cast<uint32_t>(iters), eps, tokenGroup, planeBatch,
                packedResidentBatch, scaledResident);
            break;
        case 5:
            if (tokens == 1U) {
                sinkhorn_norm_custom_tiny_resident_r2_h5_once_n1<<<1, nullptr, stream>>>(
                    mixes, pre, post, comb, tokens, height,
                    static_cast<uint32_t>(iters), eps, tokenGroup, planeBatch,
                    packedResidentBatch, scaledResident);
            } else {
                sinkhorn_norm_custom_tiny_resident_once_h5<<<blocks, nullptr, stream>>>(
                    mixes, pre, post, comb, tokens, height,
                    static_cast<uint32_t>(iters), eps, tokenGroup, planeBatch,
                    packedResidentBatch, scaledResident);
            }
            break;
        case 6:
            sinkhorn_norm_custom_tiny_resident_once_h6<<<blocks, nullptr, stream>>>(mixes, pre, post, comb,
                tokens, height, static_cast<uint32_t>(iters), eps, tokenGroup, planeBatch,
                packedResidentBatch, scaledResident);
            break;
        case 7:
            sinkhorn_norm_custom_tiny_resident_once_h7<<<blocks, nullptr, stream>>>(mixes, pre, post, comb,
                tokens, height, static_cast<uint32_t>(iters), eps, tokenGroup, planeBatch,
                packedResidentBatch, scaledResident);
            break;
        case 8:
            sinkhorn_norm_custom_tiny_resident_once_h8<<<blocks, nullptr, stream>>>(mixes, pre, post, comb,
                tokens, height, static_cast<uint32_t>(iters), eps, tokenGroup, planeBatch,
                packedResidentBatch, scaledResident);
            break;
        default:
            throw std::invalid_argument("SinkhornNorm: invalid tiny height");
        }
    } else if (planeBatch == 0 && height <= kBlockFloats) {
        // All seven legal heights of the one-block-row family; plane routing is unchanged.
        switch (height) {
        case 2:
            sinkhorn_norm_custom_tiny_resident_h2<<<blocks, nullptr, stream>>>(mixes, pre, post, comb,
                tokens, height, static_cast<uint32_t>(iters), eps, tokenGroup, planeBatch,
                packedResidentBatch, scaledResident);
            break;
        case 3:
            sinkhorn_norm_custom_tiny_resident_h3<<<blocks, nullptr, stream>>>(mixes, pre, post, comb,
                tokens, height, static_cast<uint32_t>(iters), eps, tokenGroup, planeBatch,
                packedResidentBatch, scaledResident);
            break;
        case 4:
            sinkhorn_norm_custom_tiny_resident_h4<<<blocks, nullptr, stream>>>(mixes, pre, post, comb,
                tokens, height, static_cast<uint32_t>(iters), eps, tokenGroup, planeBatch,
                packedResidentBatch, scaledResident);
            break;
        case 5:
            sinkhorn_norm_custom_tiny_resident_h5<<<blocks, nullptr, stream>>>(mixes, pre, post, comb,
                tokens, height, static_cast<uint32_t>(iters), eps, tokenGroup, planeBatch,
                packedResidentBatch, scaledResident);
            break;
        case 6:
            sinkhorn_norm_custom_tiny_resident_h6<<<blocks, nullptr, stream>>>(mixes, pre, post, comb,
                tokens, height, static_cast<uint32_t>(iters), eps, tokenGroup, planeBatch,
                packedResidentBatch, scaledResident);
            break;
        case 7:
            sinkhorn_norm_custom_tiny_resident_h7<<<blocks, nullptr, stream>>>(mixes, pre, post, comb,
                tokens, height, static_cast<uint32_t>(iters), eps, tokenGroup, planeBatch,
                packedResidentBatch, scaledResident);
            break;
        case 8:
            sinkhorn_norm_custom_tiny_resident_h8<<<blocks, nullptr, stream>>>(mixes, pre, post, comb,
                tokens, height, static_cast<uint32_t>(iters), eps, tokenGroup, planeBatch,
                packedResidentBatch, scaledResident);
            break;
        default:
            throw std::invalid_argument("SinkhornNorm: invalid tiny height");
        }
    } else if (h128FPanelSlots) {
        sinkhorn_norm_custom_f128_panel_slots<<<blocks, nullptr, stream>>>(
            mixes, pre, post, comb, tokens, height,
            static_cast<uint32_t>(iters), eps, tokenGroup);
    } else if (planeBatch == 0 && scaledResident == 1 &&
        height == 2 * kVectorFloats) {
        bool halfSwapArena = false;
        if (eps > 0.0f) {
            // Actual successful UB query is mandatory; the generic fallback
            // budget cannot admit the larger arena. Keep every prior priority.
            auto* halfSwapPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();
            uint64_t physicalUbBytes = 0;
            if (halfSwapPlatform != nullptr) {
                halfSwapPlatform->GetCoreMemSize(platform_ascendc::CoreMemType::UB,
                    physicalUbBytes);
            }
            const uint64_t reserveBytes = 16U * 1024U;
            if (physicalUbBytes > reserveBytes) {
                const uint64_t queriedBudget =
                    (physicalUbBytes - reserveBytes) / 32U * 32U;
                halfSwapArena = kH128HalfSwapArenaBytes <= availableUbBytes &&
                    kH128HalfSwapArenaBytes <= queriedBudget;
            }
        }
        if (halfSwapArena) {
            sinkhorn_norm_custom_complete_matrix_prefetch_halfswap<<<blocks, nullptr, stream>>>(
                mixes, pre, post, comb, tokens, height, static_cast<uint32_t>(iters), eps,
                tokenGroup, planeBatch, packedResidentBatch, scaledResident);
        } else {
            sinkhorn_norm_custom_complete_matrix_prefetch<<<blocks, nullptr, stream>>>(mixes, pre, post, comb,
                tokens, height, static_cast<uint32_t>(iters), eps, tokenGroup, planeBatch,
                packedResidentBatch, scaledResident);
        }
    } else if (planeBatch == 0 && scaledResident == 1 &&
        height % kVectorFloats == 0) {
        sinkhorn_norm_custom_complete_br8<<<blocks, nullptr, stream>>>(mixes, pre, post, comb,
            tokens, height, static_cast<uint32_t>(iters), eps, tokenGroup, planeBatch,
            packedResidentBatch, scaledResident);
    } else if (surplusQ2Gates) {
        sinkhorn_norm_surplus_q2_dedicated<<<
            residentLaunchBlocks + independentGateCoreCount, nullptr, stream>>>(
            mixes, pre, post, comb, tokens, height, static_cast<uint32_t>(iters), eps,
            residentLaunchTokenGroup, packedResidentBatch, residentLaunchBlocks);
    } else if (height <= 4U && planeBatch == 64U &&
        maxTokensPerCore >= 512U && PlaneBytes(height, 512U) <= availableUbBytes) {
        // The original common-plane route owns these tokens. Wider batching
        // changes only this resource-admitted H2..4 family and computes every token.
        sinkhorn_norm_planes_q256<<<blocks, nullptr, stream>>>(mixes, pre, post, comb,
            tokens, height, static_cast<uint32_t>(iters), eps, tokenGroup);
    } else {
        sinkhorn_norm_custom<<<residentLaunchBlocks, nullptr, stream>>>(mixes, pre, post, comb,
            tokens, height, static_cast<uint32_t>(iters), eps,
            residentLaunchTokenGroup, planeBatch, packedResidentBatch, scaledResident);
    }
}

#ifndef SINKHORN_NORM_NO_CONTEST_ADAPTER
namespace sinkhorn_norm {
inline void CheckTensor(const TensorGroupInfo& group, const int64_t* expected,
    int64_t rank)
{
    if (group.numTensors != 1 || group.tensors == nullptr) {
        throw std::invalid_argument("SinkhornNorm: expected one tensor per argument");
    }
    const TensorInfo& tensor = group.tensors[0];
    if (tensor.dtype != 0 || tensor.numDims != rank || tensor.shape == nullptr) {
        throw std::invalid_argument("SinkhornNorm: expected dense float32 tensor");
    }
    for (int64_t i = 0; i < rank; ++i) {
        if (tensor.shape[i] != expected[i]) {
            throw std::invalid_argument("SinkhornNorm: inconsistent tensor shape");
        }
    }
}
}  // namespace sinkhorn_norm

// ABI checked against the finals main.asc displayed with submission 928045.
// Assumes TensorInfo / TensorGroupInfo are already defined by the including file.
extern "C" void run_kernel(GM_ADDR mixes, const TensorGroupInfo& info_mixes,
    GM_ADDR pre, const TensorGroupInfo& info_pre,
    GM_ADDR post, const TensorGroupInfo& info_post,
    GM_ADDR comb, const TensorGroupInfo& info_comb,
    int64_t availableCoreNum, aclrtStream stream,
    int64_t hc_mult, int64_t hc_sinkhorn_iters, float eps)
{
    using namespace sinkhorn_norm;
    if (info_mixes.numTensors != 1 || info_mixes.tensors == nullptr ||
        info_mixes.tensors[0].numDims != 3 || info_mixes.tensors[0].shape == nullptr ||
        hc_mult < 2 || hc_mult > 128) {
        throw std::invalid_argument("SinkhornNorm: invalid input metadata");
    }
    const int64_t b = info_mixes.tensors[0].shape[0];
    const int64_t s = info_mixes.tensors[0].shape[1];
    const int64_t inputShape[] = {b, s, hc_mult * hc_mult + 2 * hc_mult};
    const int64_t gateShape[] = {b, s, hc_mult};
    const int64_t matrixShape[] = {b, s, hc_mult, hc_mult};
    CheckTensor(info_mixes, inputShape, 3);
    CheckTensor(info_pre, gateShape, 3);
    CheckTensor(info_post, gateShape, 3);
    CheckTensor(info_comb, matrixShape, 4);
    sinkhorn_norm_launch(mixes, pre, post, comb, b, s, hc_mult,
        hc_sinkhorn_iters, eps, availableCoreNum,
        QueryUsableUbBytes(), stream);
}
#endif
