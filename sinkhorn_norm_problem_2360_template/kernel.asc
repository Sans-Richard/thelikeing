__global__ __vector__ void sinkhorn_norm_custom_tiny_resident_h5(GM_ADDR mixes, GM_ADDR pre,
    GM_ADDR post, GM_ADDR comb, uint64_t tokens, uint32_t h, uint32_t iters,
    float eps, uint32_t tokenGroup, uint32_t planeBatch, uint32_t residentBatch,
    uint32_t scaledResident)
{
