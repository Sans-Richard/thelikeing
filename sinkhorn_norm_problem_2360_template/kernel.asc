// Resource-aware entry point; the displayed official wrapper passes AIV count.
// availableCoreNum must count usable VECTOR execution blocks for the target.
// On A2 this means AIV capacity (GetCoreNumAiv semantics), not AIC capacity.
// The wrapper must supply the actual available value; do not hard-code a SKU
// count or multiply an unspecified core count by two.
// availableUbBytes is usable per-block UB after the caller's reserved space.
// All four buffers must be distinct, non-overlapping dense allocations.
__global__ __vector__ void sinkhorn_norm_compact_short_static_p24_h18(
    GM_ADDR mixes,GM_ADDR pre,GM_ADDR post,GM_ADDR comb,uint64_t tokens,
    uint32_t h,uint32_t iters,float eps,uint32_t tokenGroup,uint32_t flags,
    uint32_t matrixCoreCount)
{
    AscendC::InitSocState();
    sinkhorn_norm::CompactShortStaticP24Kernel<18U> kernel;
    kernel.Init(mixes,pre,post,comb,tokens,18U,iters,eps,tokenGroup,flags,matrixCoreCount);
    kernel.Process();
}

