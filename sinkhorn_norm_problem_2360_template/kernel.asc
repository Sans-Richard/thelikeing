/*
 * SinkhornNorm -- local Ascend C implementation, 2026-10-23.
 *
 * Contract (float32, dense ND):
 *   mixes: [B, S, H*H + 2*H], split into pre, post, and row-major comb.
 *   pre  = sigmoid(pre_logits) + eps; post = 2 * sigmoid(post_logits).
 *   comb = row_softmax(comb_logits) + eps;
 *   comb = column_normalize(comb, eps);
 *   repeat iters-1 times: row_normalize, then column_normalize.
 *   normalize(x, eps) = x / (sum(x) + eps).
 * Outputs: [B,S,H], [B,S,H], [B,S,H,H]. All intermediates are float32.
 *
 * Ancestor submission 928045 passed 15/15 on 2026-10-23. R4 submission 928794
 * displays Pass and five visible passing cases; ten case details are hidden.
 * R5 below is a local candidate and requires a new platform submission.
 * Target confirmed by the user: Atlas A2 (Ascend 910B4).
 * The displayed finals wrapper and dav-2201 build target have been checked.
 * The platform's installed SDK version has not been exposed.
 * The raw launcher below takes scalar metadata and an explicit usable UB budget.
 * The optional run_kernel adapter matches the displayed finals main.asc.
 * Define SINKHORN_NORM_NO_CONTEST_ADAPTER to omit that adapter.
 * This file is intended to be included by a direct-invocation .asc translation
 * unit, like the existing template; it deliberately has no main().
 *
 * Layouts:
 *   H <= 8, enough tokens and enough UB: feature-major planes across tokens.
 *   Otherwise: one padded row-major matrix per core, resident for all iterations.
 * Dispatch depends only on metadata and resource capacity. One launch per call.
 * All GM offsets use 64 bits. No input writes, persistent results, or host-side
 * tensor computation. All divisions use Div, not approximate Reciprocal.
 * V1 batches independent row/column operations. Each output lane retains its
 * original max/sum order; UB allocations and the dispatch policy are unchanged.
 * A2 uses int32 Adds to expand aligned Gather-index seeds on the device. No
 * floating-point operation, index layout, UB allocation or dispatch is changed.
 * R2 collects resident row sums before one Brcb and row-repeat Div. It keeps
 * each row's count-mode ReduceSum, FP32 operations, and summation order.
 * R3 uses Add's supported dst/src1 recurrence across repeats for column sums.
 * Each column still adds rows 0,1,...,H-1 in order; no tree reduction or inverse.
 * R4 batches softmax Exp, sum broadcasts, Div and eps addition across rows.
 * Per-row ReduceMax/Sub and count-mode ReduceSum keep their original order.
 * H64 candidate: an independent [row=H][token=q][lane=64] interleaved scaled
 * batch for H==64, iters>1, q in {4,2}. It keeps the C6 H64 BR8 row tree and
 * the C6 row0..63 column recurrence, but shares each column vector operation
 * across the batched tokens. Other metadata and insufficient UB keep C6.
 * R5 collects 8-byte-aligned row maxima in completed gate work storage.
 * Two bounded Brcb/Sub groups reuse the existing broadcast allocation.
 * Every max still keeps its count-mode API and shared-scratch barrier.
 *
 * API references consulted (CANN 9.0; actual installed headers still to check):
 *   Gather:    atlasascendc_api_07_0092.html (offsets are BYTES)
 *   ReduceMax: atlasascendc_api_07_0076.html
 *   ReduceSum: atlasascendc_api_07_0078.html
 *   Brcb:      atlasascendc_api_07_0089.html (8 floats -> 64 floats)
 *   DataCopyPad: atlasascendc_api_07_0265.html
 *   SetFlag/WaitFlag: atlasascendc_api_07_0270.html
 *   FetchEventID: atlasascendc_api_07_0116.html
 *   Adds (A2 int32): atlasascendc_api_07_0054.html
 *   Add / recurrence overlap: atlasascendc_api_07_0035.html / _0004.html
 *   Exp (mask/repeat): atlasascendc_api_07_0025.html
 *   LocalTensor::ReinterpretCast: atlasascendc_api_07_00110.html
 *   https://www.hiascend.com/document/detail/zh/canncommercial/900/index/index.html
 */

// Enable the A2 L2-cache-hint mechanism. Defining this before the SDK headers
// (a) makes SetL2CacheHint(CACHE_MODE_DISABLE) alter the GM address into the
// reserved L2-bypass alias on dav-2201, and (b) emits the .ascend.meta feature
// marker so the launch framework supplies a non-zero l2Cacheoffset.
#ifndef L2_CACHE_HINT
#define L2_CACHE_HINT
#endif

#include <cstdint>
#include <cmath>
#include <stdexcept>
#include "kernel_operator.h"
#include "acl/acl.h"
#include "tiling/platform/platform_ascendc.h"

// This is a conservative allocation BUDGET, not a detected hardware capacity.
// Replace it with the confirmed available capacity when integrating the wrapper.
#ifndef SINKHORN_NORM_UB_BUDGET_BYTES
#define SINKHORN_NORM_UB_BUDGET_BYTES (128U * 1024U)
#endif

#ifndef SINKHORN_NORM_H128_SEGMENTED_DESCRIPTORS
#define SINKHORN_NORM_H128_SEGMENTED_DESCRIPTORS 1
#endif

#ifndef SINKHORN_NORM_H128_STORE_GATES
#define SINKHORN_NORM_H128_STORE_GATES 1
#endif

#ifndef SINKHORN_NORM_F128_TWO_SLOT_PREFETCH
#define SINKHORN_NORM_F128_TWO_SLOT_PREFETCH 1
#endif

// Trick 8: route the H128 output writes (pre/post/comb) through the L2-bypass
// alias so streamed outputs do not evict the prefetched input from L2. The
// input tensor keeps the default normal cache policy.
#ifndef SINKHORN_NORM_H128_OUTPUT_L2_BYPASS
#define SINKHORN_NORM_H128_OUTPUT_L2_BYPASS 1
#endif

namespace sinkhorn_norm {
using namespace AscendC;

constexpr uint32_t kBlockFloats = 8;
constexpr uint32_t kVectorFloats = 64;
constexpr uint32_t kMaxBatch = 64;
constexpr uint32_t kReduceScratchFloats = 256;

__aicore__ inline void VectorDone()
{
    PipeBarrier<PIPE_V>();
}

// TPipe/TQue own the hardware event pool. Do not hard-code an event ID, even
// when its direction currently differs from the explicit queues. These pairs
// are immediate, with no other event acquisition between SetFlag and WaitFlag,
// so a temporarily available ID from FetchEventID is sufficient.
template <HardEvent Event>
__aicore__ inline void SyncPipelines(TPipe& pipe)
{
    const int32_t eventId = static_cast<int32_t>(pipe.FetchEventID(Event));
    SetFlag<Event>(eventId);
    WaitFlag<Event>(eventId);
}

// GM addresses may be unaligned. Local starts must be 32-byte aligned.
// DataCopyPad emits only the requested bytes to GM, including the final tail.
__aicore__ inline void LoadExact(const LocalTensor<float>& dst,
    const GlobalTensor<float>& src, uint32_t count)
{
    DataCopyExtParams copy{1, static_cast<uint32_t>(count * sizeof(float)), 0, 0, 0};
    DataCopyPadExtParams<float> padding{
        true, 0, static_cast<uint8_t>((8 - count % 8) % 8), 0.0f};
    DataCopyPad(dst, src, copy, padding);
}

__aicore__ inline void StoreExact(const GlobalTensor<float>& dst,
    const LocalTensor<float>& src, uint32_t count)
{
    DataCopyExtParams copy{1, static_cast<uint32_t>(count * sizeof(float)), 0, 0, 0};
    DataCopyPad(dst, src, copy);
}

// Stable for finite logits of either sign, with no branch on tensor values:
// sigmoid(z) = exp(min(z,0)) / (1 + exp(-abs(z))).
__aicore__ inline void SigmoidInPlace(const LocalTensor<float>& z,
    const LocalTensor<float>& numerator, const LocalTensor<float>& denominator,
    uint32_t count)
{
    Mins(numerator, z, 0.0f, count);
    Abs(denominator, z, count);
    VectorDone();
    Exp(numerator, numerator, count);
    Muls(denominator, denominator, -1.0f, count);
    VectorDone();
    Exp(denominator, denominator, count);
    VectorDone();
    Adds(denominator, denominator, 1.0f, count);
    VectorDone();
    Div(z, numerator, denominator, count);
    VectorDone();
}

// Core boundaries are groups of 8/gcd(H,8) tokens. Consequently every output
// boundary between cores falls on a 32-byte boundary, even when H is odd.
// This avoids two cores writing different pieces of the same output data block.
// A dense FP32 output of width elementsPerToken may transfer a partial final
// 32-byte block. Distinct cores therefore own multiples of this token group.
__aicore__ inline uint32_t DeviceOutputTokenGroup(uint32_t elementsPerToken)
{
    uint32_t a = elementsPerToken;
    uint32_t b = kBlockFloats;
    while (b != 0) {
        const uint32_t remainder = a % b;
        a = b;
        b = remainder;
    }
    return kBlockFloats / a;
}

__aicore__ inline void TokenRange(uint64_t n, uint32_t tokenGroup,
    uint64_t& first, uint64_t& end)
{
    const uint64_t groups = (n + tokenGroup - 1) / tokenGroup;
    const uint64_t blocks = GetBlockNum();
    const uint64_t block = GetBlockIdx();
    first = (groups * block / blocks) * tokenGroup;
    end = (groups * (block + 1) / blocks) * tokenGroup;
    if (end > n) {
        end = n;
    }
}

// For a tiny matrix, each vector plane contains the same matrix entry from Q
// independent tokens. Row/column reductions become vector additions of planes.
// The H7/Q8 specialization fixes the seven-term reduction topology and keeps
// the generic plane path byte-for-byte separate.
template <bool H7Q8Tree = false>
class BatchPlanesKernel {
public:
    __aicore__ inline void Init(GM_ADDR mixes, GM_ADDR pre, GM_ADDR post,
        GM_ADDR comb, uint64_t n, uint32_t h, uint32_t iters, float eps,
        uint32_t tokenGroup, uint32_t q, TPipe* pipe)
    {
        pipe_ = pipe;
        h_ = h;
        q_ = q;
        w_ = h * h + 2 * h;
        iters_ = iters;
        eps_ = eps;
        TokenRange(n, tokenGroup, first_, end_);
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(mixes));
        pre_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(pre));
        post_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(post));
        comb_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(comb));
        const uint32_t planeBytes = w_ * q_ * sizeof(float);
        pipe_->InitBuffer(input_, 1, planeBytes);
        pipe_->InitBuffer(output_, 1, planeBytes);
        pipe_->InitBuffer(planesBuf_, planeBytes);
        pipe_->InitBuffer(inputIndexBuf_, planeBytes);
        pipe_->InitBuffer(outputIndexBuf_, planeBytes);
        pipe_->InitBuffer(workBuf_, 4 * h_ * q_ * sizeof(float));
        planes_ = planesBuf_.Get<float>();
        work_ = workBuf_.Get<float>();
        inputIndex_ = inputIndexBuf_.Get<uint32_t>();
        outputIndex_ = outputIndexBuf_.Get<uint32_t>();
        BuildInputIndex(q_);
        BuildOutputIndex(tokenGroup);
    }

    __aicore__ inline void Process()
    {
        for (uint64_t token = first_; token < end_; token += q_) {
            const uint32_t valid = static_cast<uint32_t>(
                end_ - token < q_ ? end_ - token : q_);
            if (valid != q_) {
                // The preceding Gather must finish before scalar index writes.
                SyncPipelines<HardEvent::V_S>(*pipe_);
                BuildInputIndex(valid);
            }
            auto input = input_.AllocTensor<float>();
            LoadExact(input, x_[token * w_], valid * w_);
            input_.EnQue(input);
            input = input_.DeQue<float>();
            Gather(planes_, input, inputIndex_, uint32_t(0), w_ * q_);
            VectorDone();
            input_.FreeTensor(input);

            const uint32_t gates = 2 * h_ * q_;
            SigmoidInPlace(planes_, work_, work_[gates], gates);
            Adds(planes_, planes_, eps_, h_ * q_);
            Muls(planes_[h_ * q_], planes_[h_ * q_], 2.0f, h_ * q_);
            VectorDone();
            RowSoftmax();
            NormalizeColumns();
            for (uint32_t iter = 1; iter < iters_; ++iter) {
                NormalizeRows();
                NormalizeColumns();
            }

            auto output = output_.AllocTensor<float>();
            Gather(output, planes_, outputIndex_, uint32_t(0), w_ * q_);
            VectorDone();  // Complete the read before the next batch overwrites planes_.
            output_.EnQue(output);  // V -> MTE3 dependency
            output = output_.DeQue<float>();
            StoreExact(pre_[token * h_], output, valid * h_);
            StoreExact(post_[token * h_], output[q_ * h_], valid * h_);
            StoreExact(comb_[token * h_ * h_], output[2 * q_ * h_],
                valid * h_ * h_);
            output_.FreeTensor(output);
        }
    }

private:
    __aicore__ inline void BuildInputIndex(uint32_t valid)
    {
        // A2 supports int32 Adds. Gather still consumes the same uint32 byte
        // offsets; all offsets are <= 20476 for H<=8 and Q<=64.
        // The first Q entries form an immutable seed for the remaining planes.
        for (uint32_t token = 0; token < q_; ++token) {
            // Dummy lanes reuse token 0, never the uninitialized DMA tail.
            const uint32_t sourceToken = token < valid ? token : 0;
            inputIndex_.SetValue(token, sourceToken * w_ * sizeof(float));
        }
        SyncPipelines<HardEvent::S_V>(*pipe_);
        auto indices = inputIndex_.ReinterpretCast<int32_t>();
        for (uint32_t feature = 1; feature < w_; ++feature) {
            // Q is a multiple of eight, so every base is 32-byte aligned.
            Adds<int32_t>(indices[feature * q_], indices,
                static_cast<int32_t>(feature * sizeof(float)), q_);
        }
        VectorDone();
    }

    __aicore__ inline void BuildOutputIndex(uint32_t tokenGroup)
    {
        // tokenGroup = 8/gcd(H,8): each seed and destination group occupies
        // whole 32-byte blocks, including odd H. Q is divisible by tokenGroup.
        for (uint32_t token = 0; token < tokenGroup; ++token) {
            for (uint32_t i = 0; i < h_; ++i) {
                outputIndex_.SetValue(token * h_ + i,
                    (i * q_ + token) * sizeof(float));
                outputIndex_.SetValue(q_ * h_ + token * h_ + i,
                    ((h_ + i) * q_ + token) * sizeof(float));
            }
            for (uint32_t ij = 0; ij < h_ * h_; ++ij) {
                outputIndex_.SetValue(2 * q_ * h_ + token * h_ * h_ + ij,
                    ((2 * h_ + ij) * q_ + token) * sizeof(float));
            }
        }
        // Keep this synchronization even when Q==tokenGroup: Gather must see
        // the scalar seed writes when no vector expansion is needed.
        SyncPipelines<HardEvent::S_V>(*pipe_);
        auto indices = outputIndex_.ReinterpretCast<int32_t>();
        const uint32_t gateCount = tokenGroup * h_;
        const uint32_t matrixCount = gateCount * h_;
        for (uint32_t token = tokenGroup; token < q_; token += tokenGroup) {
            const int32_t offset = static_cast<int32_t>(token * sizeof(float));
            Adds<int32_t>(indices[token * h_], indices, offset, gateCount);
            Adds<int32_t>(indices[q_ * h_ + token * h_], indices[q_ * h_],
                offset, gateCount);
            Adds<int32_t>(indices[2 * q_ * h_ + token * h_ * h_],
                indices[2 * q_ * h_], offset, matrixCount);
        }
        VectorDone();
    }

    __aicore__ inline LocalTensor<float> Entry(uint32_t i, uint32_t j)
    {
        return planes_[(2 * h_ + i * h_ + j) * q_];
    }

    // H=7, q=8 has seven row blocks in every 56-float matrix row. A balanced
    // tree changes the Add/Max association but not the set of seven terms.
    // Three leaves are independent; the combine level and root add one
    // dependency barrier each. Callers own the barrier after the final root.
    __aicore__ inline LocalTensor<float> H7Q8Entry(uint32_t i, uint32_t j)
    {
        return planes_[(2U * 7U + i * 7U + j) * 8U];
    }

    __aicore__ inline void H7Q8RowMax(const LocalTensor<float>& rowMax)
    {
        constexpr uint32_t rowFloats = 7U * 8U;
        constexpr uint64_t laneMask = 8U;
        constexpr uint8_t rows = 7U;
        const BinaryRepeatParams pairColumns{1, 1, 1, 1, 7, 7};
        const BinaryRepeatParams tailColumn{1, 1, 1, 1, 1, 7};
        auto part0 = work_[rowFloats];
        auto part1 = work_[2U * rowFloats];
        auto part2 = work_[3U * rowFloats];
        Max(part0, H7Q8Entry(0U, 0U), H7Q8Entry(0U, 1U),
            laneMask, rows, pairColumns);
        Max(part1, H7Q8Entry(0U, 2U), H7Q8Entry(0U, 3U),
            laneMask, rows, pairColumns);
        Max(part2, H7Q8Entry(0U, 4U), H7Q8Entry(0U, 5U),
            laneMask, rows, pairColumns);
        VectorDone();
        Max(part0, part0, part1, rowFloats);
        Max(part1, part2, H7Q8Entry(0U, 6U),
            laneMask, rows, tailColumn);
        VectorDone();
        Max(rowMax, part0, part1, rowFloats);
    }

    __aicore__ inline void H7Q8RowSum(const LocalTensor<float>& rowSum)
    {
        constexpr uint32_t rowFloats = 7U * 8U;
        constexpr uint64_t laneMask = 8U;
        constexpr uint8_t rows = 7U;
        const BinaryRepeatParams pairColumns{1, 1, 1, 1, 7, 7};
        const BinaryRepeatParams tailColumn{1, 1, 1, 1, 1, 7};
        auto part0 = work_[rowFloats];
        auto part1 = work_[2U * rowFloats];
        auto part2 = work_[3U * rowFloats];
        Add(part0, H7Q8Entry(0U, 0U), H7Q8Entry(0U, 1U),
            laneMask, rows, pairColumns);
        Add(part1, H7Q8Entry(0U, 2U), H7Q8Entry(0U, 3U),
            laneMask, rows, pairColumns);
        Add(part2, H7Q8Entry(0U, 4U), H7Q8Entry(0U, 5U),
            laneMask, rows, pairColumns);
        VectorDone();
        Add(part0, part0, part1, rowFloats);
        Add(part1, part2, H7Q8Entry(0U, 6U),
            laneMask, rows, tailColumn);
        VectorDone();
        Add(rowSum, part0, part1, rowFloats);
    }

    __aicore__ inline void RowSoftmax()
    {
        if constexpr (H7Q8Tree) {
            auto rowMax = work_;
            auto rowSum = work_[7U * 8U];
            constexpr uint32_t rowFloats = 7U * 8U;
            constexpr uint32_t matrixFloats = 7U * 7U * 8U;
            constexpr uint64_t laneMask = 8U;
            constexpr uint8_t rows = 7U;
            const BinaryRepeatParams applyRows{1, 1, 1, 7, 7, 1};

            H7Q8RowMax(rowMax);
            VectorDone();
            for (uint32_t j = 0U; j < 7U; ++j) {
                Sub(H7Q8Entry(0U, j), H7Q8Entry(0U, j), rowMax,
                    laneMask, rows, applyRows);
            }
            VectorDone();
            Exp(H7Q8Entry(0U, 0U), H7Q8Entry(0U, 0U), matrixFloats);
            VectorDone();
            H7Q8RowSum(rowSum);
            VectorDone();
            for (uint32_t j = 0U; j < 7U; ++j) {
                Div(H7Q8Entry(0U, j), H7Q8Entry(0U, j), rowSum,
                    laneMask, rows, applyRows);
            }
            VectorDone();
            // Softmax eps remains after division, as in the scalar contract.
            Adds(H7Q8Entry(0U, 0U), H7Q8Entry(0U, 0U),
                eps_, matrixFloats);
            VectorDone();
            return;
        }
        // One Q-wide statistic per row. All H rows are independent repeats.
        // Q is a multiple of 8 in [8,64]; matrix repeat stride <= 64 blocks.
        auto rowMax = work_;
        auto rowSum = work_[h_ * q_];
        const uint8_t statsStride = static_cast<uint8_t>(q_ / kBlockFloats);
        const uint8_t matrixStride = static_cast<uint8_t>(h_ * q_ / kBlockFloats);
        const uint8_t repeats = static_cast<uint8_t>(h_);
        const uint64_t mask = q_;
        const UnaryRepeatParams copyRows{1, 1, statsStride, matrixStride};
        const BinaryRepeatParams reduceRows{1, 1, 1, statsStride, statsStride, matrixStride};
        const BinaryRepeatParams applyRows{1, 1, 1, matrixStride, matrixStride, statsStride};

        Adds(rowMax, Entry(0, 0), 0.0f, mask, repeats, copyRows);
        VectorDone();
        for (uint32_t j = 1; j < h_; ++j) {
            Max(rowMax, rowMax, Entry(0, j), mask, repeats, reduceRows);
            VectorDone();
        }
        for (uint32_t j = 0; j < h_; ++j) {
            Sub(Entry(0, j), Entry(0, j), rowMax, mask, repeats, applyRows);
        }
        VectorDone();
        Exp(Entry(0, 0), Entry(0, 0), h_ * h_ * q_);
        VectorDone();
        Adds(rowSum, Entry(0, 0), 0.0f, mask, repeats, copyRows);
        VectorDone();
        for (uint32_t j = 1; j < h_; ++j) {
            // The j order for every (row, token) is identical to the scalar loop.
            Add(rowSum, rowSum, Entry(0, j), mask, repeats, reduceRows);
            VectorDone();
        }
        for (uint32_t j = 0; j < h_; ++j) {
            Div(Entry(0, j), Entry(0, j), rowSum, mask, repeats, applyRows);
        }
        VectorDone();
        // The softmax denominator has NO eps. Eps is added to its result.
        Adds(Entry(0, 0), Entry(0, 0), eps_, h_ * h_ * q_);
        VectorDone();
    }

    __aicore__ inline void NormalizeRows()
    {
        auto sum = work_;
        if constexpr (H7Q8Tree) {
            constexpr uint32_t rowFloats = 7U * 8U;
            constexpr uint64_t laneMask = 8U;
            constexpr uint8_t rows = 7U;
            const BinaryRepeatParams applyRows{1, 1, 1, 7, 7, 1};
            const BinaryRepeatParams pairColumns{1, 1, 1, 1, 7, 7};
            const UnaryRepeatParams tailRows{1, 1, 1, 7};
            auto part1 = work_[rowFloats];
            auto part2 = work_[2U * rowFloats];
            auto part3 = work_[3U * rowFloats];
            // Treat eps as the eighth leaf of the same balanced tree. This
            // preserves all seven data terms while removing the separate
            // Adds-eps dependency barrier after each row normalization.
            Add(sum, H7Q8Entry(0U, 0U), H7Q8Entry(0U, 1U),
                laneMask, rows, pairColumns);
            Add(part1, H7Q8Entry(0U, 2U), H7Q8Entry(0U, 3U),
                laneMask, rows, pairColumns);
            Add(part2, H7Q8Entry(0U, 4U), H7Q8Entry(0U, 5U),
                laneMask, rows, pairColumns);
            Adds(part3, H7Q8Entry(0U, 6U), eps_,
                laneMask, rows, tailRows);
            VectorDone();
            Add(sum, sum, part1, rowFloats);
            Add(part2, part2, part3, rowFloats);
            VectorDone();
            Add(sum, sum, part2, rowFloats);
            VectorDone();
            for (uint32_t j = 0U; j < 7U; ++j) {
                Div(H7Q8Entry(0U, j), H7Q8Entry(0U, j), sum,
                    laneMask, rows, applyRows);
            }
            VectorDone();
            return;
        }
        const uint8_t statsStride = static_cast<uint8_t>(q_ / kBlockFloats);
        const uint8_t matrixStride = static_cast<uint8_t>(h_ * q_ / kBlockFloats);
        const uint8_t repeats = static_cast<uint8_t>(h_);
        const uint64_t mask = q_;
        const UnaryRepeatParams copyRows{1, 1, statsStride, matrixStride};
        const BinaryRepeatParams reduceRows{1, 1, 1, statsStride, statsStride, matrixStride};
        const BinaryRepeatParams applyRows{1, 1, 1, matrixStride, matrixStride, statsStride};
        Adds(sum, Entry(0, 0), 0.0f, mask, repeats, copyRows);
        VectorDone();
        for (uint32_t j = 1; j < h_; ++j) {
            Add(sum, sum, Entry(0, j), mask, repeats, reduceRows);
            VectorDone();
        }
        Adds(sum, sum, eps_, h_ * q_);
        VectorDone();
        for (uint32_t j = 0; j < h_; ++j) {
            Div(Entry(0, j), Entry(0, j), sum, mask, repeats, applyRows);
        }
        VectorDone();
    }

    __aicore__ inline void NormalizeColumns()
    {
        if constexpr (H7Q8Tree) {
            constexpr uint32_t rowFloats = 7U * 8U;
            auto sum = work_;
            auto part1 = work_[rowFloats];
            auto part2 = work_[2U * rowFloats];
            auto part3 = work_[3U * rowFloats];
            // Same eighth-leaf eps fusion as row normalization. Column terms
            // remain lane-local: ((0+1)+(2+3)) + ((4+5)+(6+eps)).
            Add(sum, H7Q8Entry(0U, 0U), H7Q8Entry(1U, 0U), rowFloats);
            Add(part1, H7Q8Entry(2U, 0U), H7Q8Entry(3U, 0U), rowFloats);
            Add(part2, H7Q8Entry(4U, 0U), H7Q8Entry(5U, 0U), rowFloats);
            Adds(part3, H7Q8Entry(6U, 0U), eps_, rowFloats);
            VectorDone();
            Add(sum, sum, part1, rowFloats);
            Add(part2, part2, part3, rowFloats);
            VectorDone();
            Add(sum, sum, part2, rowFloats);
            VectorDone();
            for (uint32_t i = 0U; i < 7U; ++i) {
                Div(H7Q8Entry(i, 0U), H7Q8Entry(i, 0U), sum, rowFloats);
            }
            VectorDone();
            return;
        }
        // All columns and token lanes form one contiguous H*Q vector. The
        // accumulation order remains i=0,1,...,H-1 for every (column, token).
        auto sum = work_;
        const uint32_t rowCount = h_ * q_;
        Adds(sum, Entry(0, 0), 0.0f, rowCount);
        VectorDone();
        for (uint32_t i = 1; i < h_; ++i) {
            Add(sum, sum, Entry(i, 0), rowCount);
            VectorDone();
        }
        Adds(sum, sum, eps_, rowCount);
        VectorDone();
        for (uint32_t i = 0; i < h_; ++i) {
            Div(Entry(i, 0), Entry(i, 0), sum, rowCount);
        }
        VectorDone();
    }

    TPipe* pipe_;
    TQue<QuePosition::VECIN, 1> input_;
    TQue<QuePosition::VECOUT, 1> output_;
    TBuf<TPosition::VECCALC> planesBuf_, inputIndexBuf_, outputIndexBuf_, workBuf_;
    GlobalTensor<float> x_, pre_, post_, comb_;
    LocalTensor<float> planes_, work_;
    LocalTensor<uint32_t> inputIndex_, outputIndex_;
    uint64_t first_, end_;
    uint32_t h_, q_, w_, iters_;
    float eps_;
};

// Only UB allocation offsets change; shared padding is included in host accounting.
constexpr uint32_t kResidentMatrixKernelUbBankPaddingBytes = 256;
template <uint32_t FixedPitch = 0, uint32_t FixedHeight = 0,
    bool OneIteration = false>
class ResidentMatrixKernel {
    static_assert(!OneIteration || (FixedPitch == kBlockFloats &&
        FixedHeight >= 2 && FixedHeight <= kBlockFloats),
        "OneIteration is the exhaustive fixed-height tiny metadata family");
public:
    __aicore__ inline void Init(GM_ADDR mixes, GM_ADDR pre, GM_ADDR post,
        GM_ADDR comb, uint64_t n, uint32_t h, uint32_t iters, float eps,
        uint32_t tokenGroup, TPipe* pipe)
    {
        pipe_ = pipe;
        h_ = FixedHeight == 0 ? h : FixedHeight;
        pitch_ = FixedPitch == 0 ? (h + 7) / 8 * 8 : FixedPitch;
        w_ = h_ * h_ + 2 * h_;
        iters_ = iters;
        eps_ = eps;
        TokenRange(n, tokenGroup, first_, end_);
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(mixes));
        pre_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(pre));
        post_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(post));
        comb_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(comb));
        if constexpr (FixedPitch == kBlockFloats) {
            // Tiny only: one static VECIN input, then one VECCALC scratch slab.
            // Keep E4's input/slab address ranges; no input queue events.
            pipe_->InitBuffer(matrixQueue_, (h_ + 2) * pitch_ * sizeof(float));
            const uint32_t bankPadFloats =
                kResidentMatrixKernelUbBankPaddingBytes / sizeof(float);
            const uint32_t scratchFloats = bankPadFloats + 3 * pitch_ +
                kReduceScratchFloats + pitch_ + kBlockFloats * pitch_;
            pipe_->InitBuffer(workBuf_, scratchFloats * sizeof(float));
            auto scratch = workBuf_.Get<float>();
            work_ = scratch[bankPadFloats];
            reduce_ = scratch[bankPadFloats + 3 * pitch_];
            stats_ = scratch[bankPadFloats + 3 * pitch_ + kReduceScratchFloats];
            broadcast_ = scratch[bankPadFloats + 4 * pitch_ + kReduceScratchFloats];
        } else {
            pipe_->InitBuffer(matrixQueue_, 1, h_ * pitch_ * sizeof(float));
            pipe_->InitBuffer(gatesQueue_, 1, 2 * pitch_ * sizeof(float));
            // Shared UB address padding; never read as tensor data.
            pipe_->InitBuffer(ubBankPadBeforeWork_, uint32_t(256));
            pipe_->InitBuffer(workBuf_, 3 * pitch_ * sizeof(float));
            pipe_->InitBuffer(reduceBuf_, kReduceScratchFloats * sizeof(float));
            pipe_->InitBuffer(statsBuf_, pitch_ * sizeof(float));
            pipe_->InitBuffer(broadcastBuf_, kBlockFloats * pitch_ * sizeof(float));
            work_ = workBuf_.Get<float>();
            reduce_ = reduceBuf_.Get<float>();
            stats_ = statsBuf_.Get<float>();
            broadcast_ = broadcastBuf_.Get<float>();
        }
        Duplicate(stats_, 0.0f, pitch_);
        // Initialize reusable gate/max work, including padded slots.
        Duplicate(work_, 0.0f, 2 * pitch_);
        VectorDone();
    }

    __aicore__ inline void Process()
    {
        if constexpr (FixedPitch == kBlockFloats) {
            auto input = matrixQueue_.template Get<float>();
            for (uint64_t token = first_; token < end_; ++token) {
                DataCopyExtParams inputRows{static_cast<uint16_t>(h_ + 2),
                    static_cast<uint32_t>(h_ * sizeof(float)), 0, 0, 0};
                DataCopyPadExtParams<float> padding{
                    true, 0, static_cast<uint8_t>(pitch_ - h_), 0.0f};
                DataCopyPad(input, x_[token * w_], inputRows, padding);
                SyncPipelines<HardEvent::MTE2_V>(*pipe_);
                auto gates = input;
                auto matrix = input[2 * pitch_];
                DataCopyExtParams rows{static_cast<uint16_t>(h_),
                    static_cast<uint32_t>(h_ * sizeof(float)), 0, 0, 0};

                // All H+2 rows, including both gate paddings, were initialized.
                // work_ >= 2*pitch_; reduce_ has 256 floats >= 2*pitch_.
                SigmoidInPlace(gates, work_, reduce_, 2 * pitch_);
                Adds(gates, gates, eps_, h_);
                Muls(gates[pitch_], gates[pitch_], 2.0f, h_);
                VectorDone();
                RowSoftmax(matrix);
                NormalizeColumns(matrix);
                if constexpr (!OneIteration) {
                    for (uint32_t iter = 1; iter < iters_; ++iter) {
                        NormalizeRows(matrix);
                        NormalizeColumns(matrix);
                    }
                }

                // Both views share static VECIN. Its MTE3 output reads must
                // finish before the next token's MTE2 input overwrite.
                SyncPipelines<HardEvent::V_MTE3>(*pipe_);
                StoreExact(pre_[token * h_], gates, h_);
                StoreExact(post_[token * h_], gates[pitch_], h_);
                DataCopyPad(comb_[token * h_ * h_], matrix, rows);
                SyncPipelines<HardEvent::MTE3_MTE2>(*pipe_);
            }
        } else {
            for (uint64_t token = first_; token < end_; ++token) {
                auto gates = gatesQueue_.AllocTensor<float>();
                LoadExact(gates, x_[token * w_], h_);
                LoadExact(gates[pitch_], x_[token * w_ + h_], h_);
                gatesQueue_.EnQue(gates);
                auto matrix = matrixQueue_.template AllocTensor<float>();
                DataCopyExtParams rows{static_cast<uint16_t>(h_),
                    static_cast<uint32_t>(h_ * sizeof(float)), 0, 0, 0};
                DataCopyPadExtParams<float> padding{
                    true, 0, static_cast<uint8_t>(pitch_ - h_), 0.0f};
                DataCopyPad(matrix, x_[token * w_ + 2 * h_], rows, padding);
                matrixQueue_.EnQue(matrix);
                gates = gatesQueue_.DeQue<float>();
                matrix = matrixQueue_.template DeQue<float>();

                // Both padded gate rows are initialized by LoadExact.
                // work_ >= 2*pitch_; reduce_ has 256 floats >= 2*pitch_.
                SigmoidInPlace(gates, work_, reduce_, 2 * pitch_);
                Adds(gates, gates, eps_, h_);
                Muls(gates[pitch_], gates[pitch_], 2.0f, h_);
                VectorDone();
                RowSoftmax(matrix);
                NormalizeColumns(matrix);
                for (uint32_t iter = 1; iter < iters_; ++iter) {
                    NormalizeRows(matrix);
                    NormalizeColumns(matrix);
                }

                // These tensors live in VECIN queues. Explicitly synchronize the
                // output DMA, including its completion before either buffer is freed.
                SyncPipelines<HardEvent::V_MTE3>(*pipe_);
                StoreExact(pre_[token * h_], gates, h_);
                StoreExact(post_[token * h_], gates[pitch_], h_);
                DataCopyPad(comb_[token * h_ * h_], matrix, rows);
                SyncPipelines<HardEvent::MTE3_V>(*pipe_);
                gatesQueue_.FreeTensor(gates);
                matrixQueue_.FreeTensor(matrix);
            }
        }
    }

private:
    static constexpr bool kTinySingleVector = FixedPitch == kBlockFloats &&
        FixedHeight >= 2 && FixedHeight <= kBlockFloats;

    __aicore__ static constexpr uint64_t TinyMatrixLaneMask()
    {
        uint64_t mask = 0;
        if constexpr (kTinySingleVector) {
            const uint64_t rowBits = (uint64_t(1) << FixedHeight) - 1;
            for (uint32_t row = 0; row < FixedHeight; ++row) {
                // Shift at most 56 bits; H=8 never forms 1ULL << 64.
                mask |= rowBits << (row * kBlockFloats);
            }
        }
        return mask;
    }

    __aicore__ inline void BroadcastStatistic()
    {
        // Brcb reads eight initialized floats, writes 64 floats. Only the first
        // output block (eight copies of stats_[0]) is used by BroadcastApply.
        Brcb(broadcast_, stats_, uint8_t(1), {1, 8});
        VectorDone();
    }

    template <bool IsDivision>
    __aicore__ inline void BroadcastApply(const LocalTensor<float>& row)
    {
        const uint32_t fullRepeats = h_ / kVectorFloats;
        const uint32_t tail = h_ % kVectorFloats;
        // Source 1 uses the same 8-float block for every block and repeat.
        const BinaryRepeatParams strides{1, 1, 0, 8, 8, 0};
        if (fullRepeats != 0) {
            if (IsDivision) {
                Div(row, row, broadcast_, uint64_t(64),
                    static_cast<uint8_t>(fullRepeats), strides);
            } else {
                Sub(row, row, broadcast_, uint64_t(64),
                    static_cast<uint8_t>(fullRepeats), strides);
            }
        }
        if (tail != 0) {
            auto rest = row[fullRepeats * kVectorFloats];
            if (IsDivision) {
                Div(rest, rest, broadcast_, uint64_t(tail), uint8_t(1), strides);
            } else {
                Sub(rest, rest, broadcast_, uint64_t(tail), uint8_t(1), strides);
            }
        }
        VectorDone();
    }

    __aicore__ inline void ReduceRowSums(const LocalTensor<float>& matrix)
    {
        const int32_t count = static_cast<int32_t>(
            h_ < kVectorFloats ? h_ : kVectorFloats);
        WholeReduceSum(stats_, matrix, count, static_cast<int32_t>(h_),
            1, 1, static_cast<int32_t>(pitch_ / kBlockFloats));
        if (h_ > kVectorFloats) {
            // A2/A3 count mode sums repeats in order. H<=128 needs two
            // identical intra-repeat trees followed by this one FP32 addition.
            WholeReduceSum(reduce_, matrix[kVectorFloats],
                static_cast<int32_t>(h_ - kVectorFloats),
                static_cast<int32_t>(h_), 1, 1,
                static_cast<int32_t>(pitch_ / kBlockFloats));
            VectorDone();
            Add(stats_, stats_, reduce_, h_);
        }
    }

    __aicore__ inline void RowSoftmax(const LocalTensor<float>& matrix)
    {
        const uint8_t rowStride = static_cast<uint8_t>(pitch_ / kBlockFloats);
        const uint8_t repeats = static_cast<uint8_t>(h_);
        const uint32_t firstCount = h_ < kVectorFloats ? h_ : kVectorFloats;
        // Reduce independent row chunks directly into compact UB statistics.
        // Max changes no floating-point addition tree or Div operation.
        WholeReduceMax(stats_, matrix, static_cast<int32_t>(firstCount),
            static_cast<int32_t>(h_), 1, 1, static_cast<int32_t>(rowStride),
            ReduceOrder::ORDER_ONLY_VALUE);
        if (h_ > kVectorFloats) {
            WholeReduceMax(work_, matrix[kVectorFloats],
                static_cast<int32_t>(h_ - kVectorFloats),
                static_cast<int32_t>(h_), 1, 1, static_cast<int32_t>(rowStride),
                ReduceOrder::ORDER_ONLY_VALUE);
            VectorDone();
            Max(stats_, stats_, work_, h_);
        }
        VectorDone();
        Brcb(broadcast_, stats_, static_cast<uint8_t>(pitch_ / kBlockFloats), {1, 8});
        VectorDone();
        const BinaryRepeatParams subtractMax{1, 1, 0, rowStride, rowStride, 1};
        if constexpr (kTinySingleVector) {
            uint64_t matrixMask[2] = {TinyMatrixLaneMask(), uint64_t(0)};
            // One physical block per row; Brcb already supplies all row blocks.
            const BinaryRepeatParams singleRows{1, 1, 1, 8, 8, 8};
            Sub(matrix, matrix, broadcast_, matrixMask, uint8_t(1), singleRows);
        } else {
            Sub(matrix, matrix, broadcast_, uint64_t(firstCount), repeats, subtractMax);
            if (h_ > kVectorFloats) {
                Sub(matrix[kVectorFloats], matrix[kVectorFloats], broadcast_,
                    uint64_t(h_ - kVectorFloats), repeats, subtractMax);
            }
        }
        VectorDone();
        // Rows remain independent; retain R4's elementwise batching and sums.
        const UnaryRepeatParams elementwise{1, 1, rowStride, rowStride};
        if constexpr (kTinySingleVector) {
            // Sub set Normal/K; VectorDone does not change the vector mask.
            const UnaryRepeatParams singleVector{1, 1, 8, 8};
            Exp<float, false>(matrix, matrix, MASK_PLACEHOLDER, uint8_t(1), singleVector);
        } else {
            Exp(matrix, matrix, uint64_t(firstCount), repeats, elementwise);
            if (h_ > kVectorFloats) {
                Exp(matrix[kVectorFloats], matrix[kVectorFloats],
                    uint64_t(h_ - kVectorFloats), repeats, elementwise);
            }
        }
        VectorDone();
        ReduceRowSums(matrix);
        VectorDone();
        Brcb(broadcast_, stats_, static_cast<uint8_t>(pitch_ / kBlockFloats), {1, 8});
        VectorDone();
        const BinaryRepeatParams divideRows{1, 1, 0, rowStride, rowStride, 1};
        if constexpr (kTinySingleVector) {
            uint64_t matrixMask[2] = {TinyMatrixLaneMask(), uint64_t(0)};
            const BinaryRepeatParams singleRows{1, 1, 1, 8, 8, 8};
            Div(matrix, matrix, broadcast_, matrixMask, uint8_t(1), singleRows);
        } else {
            Div(matrix, matrix, broadcast_, uint64_t(firstCount), repeats, divideRows);
            if (h_ > kVectorFloats) {
                Div(matrix[kVectorFloats], matrix[kVectorFloats], broadcast_,
                    uint64_t(h_ - kVectorFloats), repeats, divideRows);
            }
        }
        VectorDone();
        // Softmax adds eps AFTER division; it must not enter the denominator.
        if constexpr (kTinySingleVector) {
            // Div re-established K after ReduceRowSums/Brcb; reuse it here.
            const UnaryRepeatParams singleVector{1, 1, 8, 8};
            Adds<float, false>(matrix, matrix, eps_, MASK_PLACEHOLDER, uint8_t(1), singleVector);
        } else {
            Adds(matrix, matrix, eps_, uint64_t(firstCount), repeats, elementwise);
            if (h_ > kVectorFloats) {
                Adds(matrix[kVectorFloats], matrix[kVectorFloats], eps_,
                    uint64_t(h_ - kVectorFloats), repeats, elementwise);
            }
        }
        VectorDone();
        // Tiny exit is Normal/K. The immediate NormalizeColumns sets Normal/H
        // before its first mask-consuming instruction; generic exit is unchanged.
    }

    __aicore__ inline void NormalizeRows(const LocalTensor<float>& matrix)
    {
        // Preserve each 64-element binary tree and then the original repeat order.
        ReduceRowSums(matrix);
        VectorDone();
        Adds(stats_, stats_, eps_, h_);
        VectorDone();
        // Brcb reads pitch_ initialized statistics and writes one 32-byte block
        // per row. Blocks for padded rows are initialized but never consumed.
        Brcb(broadcast_, stats_, static_cast<uint8_t>(pitch_ / kBlockFloats), {1, 8});
        VectorDone();
        const uint8_t rowStride = static_cast<uint8_t>(pitch_ / kBlockFloats);
        const uint8_t repeats = static_cast<uint8_t>(h_);
        // Each repeat owns one row and advances source 1 by one broadcast block.
        // Every block within that row reuses its denominator (src1BlkStride=0).
        const BinaryRepeatParams steps{1, 1, 0, rowStride, rowStride, 1};
        const uint32_t firstCount = h_ < kVectorFloats ? h_ : kVectorFloats;
        Div(matrix, matrix, broadcast_, uint64_t(firstCount), repeats, steps);
        if (h_ > kVectorFloats) {
            // Reuse the SAME per-row denominator blocks for the second slice.
            Div(matrix[kVectorFloats], matrix[kVectorFloats], broadcast_,
                uint64_t(h_ - kVectorFloats), repeats, steps);
        }
        VectorDone();
    }

    __aicore__ inline void NormalizeColumns(const LocalTensor<float>& matrix)
    {
        if constexpr (FixedPitch == kBlockFloats &&
            FixedHeight >= 2 && FixedHeight <= kBlockFloats) {
            auto sums = work_[2 * pitch_];
            const uint8_t rowStride = static_cast<uint8_t>(pitch_ / kBlockFloats);
            const uint32_t firstCount = h_ < kVectorFloats ? h_ : kVectorFloats;
            const BinaryRepeatParams accumulate{1, 1, 1, 0, rowStride, 0};
            const uint8_t remainingRows = static_cast<uint8_t>(h_ - 1);
            const UnaryRepeatParams scalarSteps{1, 1, 8, 8};
            // The seed, ordered row accumulation and eps touch the same H lanes.
            // Keep row0 +0 as a real FP32 operation, with the original barriers.
            SetMaskNorm();
            SetVectorMask<float, MaskMode::NORMAL>(static_cast<int32_t>(FixedHeight));
            Adds<float, false>(sums, matrix, 0.0f, MASK_PLACEHOLDER, 1, scalarSteps);
            VectorDone();
            Add<float, false>(sums, matrix[pitch_], sums, MASK_PLACEHOLDER,
                remainingRows, accumulate);
            VectorDone();
            Adds<float, false>(sums, sums, eps_, MASK_PLACEHOLDER, 1, scalarSteps);
            VectorDone();
            // Reuse the same eight-lane sums block across every physical row.
            // Div sets K itself; the next reduction sets H, or DMA ignores the mask.
            uint64_t matrixMask[2] = {TinyMatrixLaneMask(), uint64_t(0)};
            const BinaryRepeatParams singleColumns{1, 1, 0, 8, 8, 0};
            Div(matrix, matrix, sums, matrixMask, uint8_t(1), singleColumns);
            VectorDone();
        } else {
            auto sums = work_[2 * pitch_];
            Adds(sums, matrix, 0.0f, h_);
            VectorDone();
            const uint8_t rowStride = static_cast<uint8_t>(pitch_ / kBlockFloats);
            const uint32_t firstCount = h_ < kVectorFloats ? h_ : kVectorFloats;
            // Add permits a previous repeat's dst to be the next repeat's src1
            // when dstRepStride or src1RepStride is zero. Keep both zero so each
            // column has one accumulator, while src0 advances through rows 1..H-1.
            // The accumulator moves from operand 0 to operand 1; each FP32 addition
            // still consumes exactly the same pair, without changing row order.
            const BinaryRepeatParams accumulate{1, 1, 1, 0, rowStride, 0};
            const uint8_t remainingRows = static_cast<uint8_t>(h_ - 1);
            Add(sums, matrix[pitch_], sums, uint64_t(firstCount), remainingRows, accumulate);
            if (h_ > kVectorFloats) {
                Add(sums[kVectorFloats], matrix[pitch_ + kVectorFloats], sums[kVectorFloats],
                    uint64_t(h_ - kVectorFloats), remainingRows, accumulate);
            }
            VectorDone();
            Adds(sums, sums, eps_, h_);
            VectorDone();
            // All rows share the same column denominators. Each repeat owns one
            // distinct row; source 1 repeats the same denominator vector. Split the
            // columns at 64 so both masks stay within the FP32 vector width.
            const uint8_t repeats = static_cast<uint8_t>(h_);
            const BinaryRepeatParams steps{1, 1, 1, rowStride, rowStride, 0};
            Div(matrix, matrix, sums, uint64_t(firstCount), repeats, steps);
            if (h_ > kVectorFloats) {
                Div(matrix[kVectorFloats], matrix[kVectorFloats], sums[kVectorFloats],
                    uint64_t(h_ - kVectorFloats), repeats, steps);
            }
            VectorDone();
        }
    }

    TPipe* pipe_;
    using MatrixInputOwner = typename AscendC::Std::conditional<
        FixedPitch == kBlockFloats, TBuf<TPosition::VECIN>,
        TQue<QuePosition::VECIN, 1>>::type;
    MatrixInputOwner matrixQueue_;
    TQue<QuePosition::VECIN, 1> gatesQueue_;
    TBuf<TPosition::VECCALC> workBuf_, reduceBuf_, statsBuf_, broadcastBuf_;
    GlobalTensor<float> x_, pre_, post_, comb_;
    LocalTensor<float> work_, reduce_, stats_, broadcast_;
    uint64_t first_, end_;
    uint32_t h_, pitch_, w_, iters_;
    float eps_;
    TBuf<TPosition::VECCALC> ubBankPadBeforeWork_;
};

// C1: complete one-block-row family with explicit UB addresses and events.
// This entry owns its UB; it never constructs a framework buffer or pipe.
template <uint32_t FixedPitch = kBlockFloats, uint32_t FixedHeight = 0,
    bool OneIteration = false>
class TinyStaticResidentKernel {
    static_assert(FixedPitch == kBlockFloats && FixedHeight >= 2 &&
        FixedHeight <= kBlockFloats, "Static tiny covers all one-block-row heights");
public:
    __aicore__ inline void Init(GM_ADDR mixes, GM_ADDR pre, GM_ADDR post,
        GM_ADDR comb, uint64_t n, uint32_t h, uint32_t iters, float eps,
        uint32_t tokenGroup)
    {
        h_ = FixedHeight == 0 ? h : FixedHeight;
        pitch_ = FixedPitch == 0 ? (h + 7) / 8 * 8 : FixedPitch;
        w_ = h_ * h_ + 2 * h_;
        iters_ = iters;
        eps_ = eps;
        tokenCount_ = n;
        TokenRange(n, tokenGroup, first_, end_);
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(mixes));
        pre_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(pre));
        post_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(post));
        comb_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(comb));
        constexpr uint32_t inputFloats = (FixedHeight + 2) * FixedPitch;
        constexpr uint32_t inputBytes = inputFloats * sizeof(float);
        constexpr uint32_t bankPadFloats =
            kResidentMatrixKernelUbBankPaddingBytes / sizeof(float);
        constexpr uint32_t scratchFloats = bankPadFloats + 3 * FixedPitch +
            kReduceScratchFloats + FixedPitch + kBlockFloats * FixedPitch;
        // Match the original two buffer allocations, including their gap.
        input_ = LocalTensor<float>(TPosition::VECIN, uint32_t(0), inputFloats);
        auto scratch = LocalTensor<float>(TPosition::VECCALC, inputBytes, scratchFloats);
        work_ = scratch[bankPadFloats];
        reduce_ = scratch[bankPadFloats + 3 * pitch_];
        stats_ = scratch[bankPadFloats + 3 * pitch_ + kReduceScratchFloats];
        broadcast_ = scratch[bankPadFloats + 4 * pitch_ + kReduceScratchFloats];
        Duplicate(stats_, 0.0f, pitch_);
        // Initialize reusable gate/max work, including padded slots.
        Duplicate(work_, 0.0f, 2 * pitch_);
        VectorDone();
    }

    __aicore__ inline void Process()
    {
        auto input = input_;
        for (uint64_t token = first_; token < end_; ++token) {
            DataCopyExtParams inputRows{static_cast<uint16_t>(h_ + 2),
                static_cast<uint32_t>(h_ * sizeof(float)), 0, 0, 0};
            DataCopyPadExtParams<float> padding{
                true, 0, static_cast<uint8_t>(pitch_ - h_), 0.0f};
            DataCopyPad(input, x_[token * w_], inputRows, padding);
            SyncStaticPipelines<HardEvent::MTE2_V>();
            auto gates = input;
            auto matrix = input[2 * pitch_];
            DataCopyExtParams rows{static_cast<uint16_t>(h_),
                static_cast<uint32_t>(h_ * sizeof(float)), 0, 0, 0};

            // All H+2 rows, including both gate paddings, were initialized.
            // work_ >= 2*pitch_; reduce_ has 256 floats >= 2*pitch_.
            SigmoidInPlace(gates, work_, reduce_, 2 * pitch_);
            Adds(gates, gates, eps_, h_);
            Muls(gates[pitch_], gates[pitch_], 2.0f, h_);
            VectorDone();
            RowSoftmax(matrix);
            NormalizeColumns(matrix);
            if constexpr (!OneIteration) {
                for (uint32_t iter = 1; iter < iters_; ++iter) {
                    NormalizeRows(matrix);
                    NormalizeColumns(matrix);
                }
            }

            bool compactComb = false;
            if constexpr (FixedHeight == 5 && OneIteration) {
                compactComb = tokenCount_ == 1;
                if (compactComb) {
                    CompactCombH5Once(matrix);
                }
            }

            // Both views share static VECIN. Its MTE3 output reads must
            // finish before the next token's MTE2 input overwrite.
            SyncStaticPipelines<HardEvent::V_MTE3>();
            StoreExact(pre_[token * h_], gates, h_);
            StoreExact(post_[token * h_], gates[pitch_], h_);
            if (compactComb) {
                StoreExact(comb_[token * h_ * h_], reduce_, h_ * h_);
            } else {
                DataCopyPad(comb_[token * h_ * h_], matrix, rows);
            }
            SyncStaticPipelines<HardEvent::MTE3_MTE2>();
        }
    }

private:
    // T2b compacts the live 5x8 comb tile (40 physical lanes, 25 real values)
    // without calling the public GatherMask wrapper or reading GetRsvdCnt().
    // The destination is reduce_, pattern words live in broadcast_, and neither
    // overlaps the live gate or matrix bytes in input_.
    __aicore__ inline void CompactCombH5Once(
        const LocalTensor<float>& matrix)
    {
        static_assert(FixedPitch == kBlockFloats && FixedHeight == 5 &&
            OneIteration, "T2b output compaction is isolated to the H5 once leaf");
        constexpr uint32_t sourceFloats = FixedHeight * FixedPitch;
        constexpr uint32_t outputFloats = FixedHeight * FixedHeight;
        static_assert(sourceFloats == 40 && outputFloats == 25,
            "H5 comb compaction must reduce 40 lanes to 25 values");

        auto compact = reduce_;
        auto pattern = broadcast_.ReinterpretCast<uint32_t>();
        uint32_t lowMask = 0;
        uint32_t highMask = 0;
        for (uint32_t row = 0; row < FixedHeight; ++row) {
            for (uint32_t column = 0; column < FixedHeight; ++column) {
                const uint32_t bit = row * FixedPitch + column;
                if (bit < 32U) {
                    lowMask |= uint32_t(1) << bit;
                } else {
                    highMask |= uint32_t(1) << (bit - 32U);
                }
            }
        }
        // broadcast_ held the last softmax Brcb data. Drain that V consumer
        // before scalar code overwrites it with the GatherMask pattern.
        SyncStaticPipelines<HardEvent::V_S>();
        // Pattern mode 0 consumes these two 32-bit words as the source mask.
        // The following zero words keep any conservative pattern read in-bounds.
        pattern.SetValue(0, lowMask);
        pattern.SetValue(1, highMask);
        pattern.SetValue(2, uint32_t(0));
        pattern.SetValue(3, uint32_t(0));
        SyncStaticPipelines<HardEvent::S_V>();

        // On the real A2 device path, mirror C220 GatherMask reduceMode=true
        // while omitting its reserved-count readback. CPU/host and DFX builds
        // retain the public implementation for compatibility.
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 2201 && !ASCENDC_CPU_DEBUG && !defined(__MSTX_DFX_REPORT__)
        SetMaskCount();
        SetVectorMask<uint32_t, MaskMode::COUNTER>(
            uint64_t(0), uint64_t(sourceFloats));
        vreducev2((__ubuf__ uint32_t*)compact.GetPhyAddr(),
            (__ubuf__ uint32_t*)matrix.GetPhyAddr(),
            (__ubuf__ uint32_t*)pattern.GetPhyAddr(), uint16_t(1), uint8_t(1),
            uint8_t(0), uint16_t(kBlockFloats), uint8_t(kBlockFloats));
#else
        uint64_t reservedCount = 0;
        GatherMaskParams fallbackParams{1, 1, uint16_t(kBlockFloats),
            uint8_t(kBlockFloats)};
        GatherMask(compact, matrix, pattern, true, sourceFloats,
            fallbackParams, reservedCount);
#endif
        SetMaskNorm();
        ResetMask();
        VectorDone();
    }

    static constexpr bool kTinySingleVector = FixedPitch == kBlockFloats &&
        FixedHeight >= 2 && FixedHeight <= kBlockFloats;

    __aicore__ static constexpr uint64_t TinyMatrixLaneMask()
    {
        uint64_t mask = 0;
        if constexpr (kTinySingleVector) {
            const uint64_t rowBits = (uint64_t(1) << FixedHeight) - 1;
            for (uint32_t row = 0; row < FixedHeight; ++row) {
                // Shift at most 56 bits; H=8 never forms 1ULL << 64.
                mask |= rowBits << (row * kBlockFloats);
            }
        }
        return mask;
    }

    __aicore__ inline void BroadcastStatistic()
    {
        // Brcb reads eight initialized floats, writes 64 floats. Only the first
        // output block (eight copies of stats_[0]) is used by BroadcastApply.
        Brcb(broadcast_, stats_, uint8_t(1), {1, 8});
        VectorDone();
    }

    template <bool IsDivision>
    __aicore__ inline void BroadcastApply(const LocalTensor<float>& row)
    {
        const uint32_t fullRepeats = h_ / kVectorFloats;
        const uint32_t tail = h_ % kVectorFloats;
        // Source 1 uses the same 8-float block for every block and repeat.
        const BinaryRepeatParams strides{1, 1, 0, 8, 8, 0};
        if (fullRepeats != 0) {
            if (IsDivision) {
                Div(row, row, broadcast_, uint64_t(64),
                    static_cast<uint8_t>(fullRepeats), strides);
            } else {
                Sub(row, row, broadcast_, uint64_t(64),
                    static_cast<uint8_t>(fullRepeats), strides);
            }
        }
        if (tail != 0) {
            auto rest = row[fullRepeats * kVectorFloats];
            if (IsDivision) {
                Div(rest, rest, broadcast_, uint64_t(tail), uint8_t(1), strides);
            } else {
                Sub(rest, rest, broadcast_, uint64_t(tail), uint8_t(1), strides);
            }
        }
        VectorDone();
    }

    __aicore__ inline void ReduceRowSums(const LocalTensor<float>& matrix)
    {
        const int32_t count = static_cast<int32_t>(
            h_ < kVectorFloats ? h_ : kVectorFloats);
        WholeReduceSum(stats_, matrix, count, static_cast<int32_t>(h_),
            1, 1, static_cast<int32_t>(pitch_ / kBlockFloats));
        if (h_ > kVectorFloats) {
            // A2/A3 count mode sums repeats in order. H<=128 needs two
            // identical intra-repeat trees followed by this one FP32 addition.
            WholeReduceSum(reduce_, matrix[kVectorFloats],
                static_cast<int32_t>(h_ - kVectorFloats),
                static_cast<int32_t>(h_), 1, 1,
                static_cast<int32_t>(pitch_ / kBlockFloats));
            VectorDone();
            Add(stats_, stats_, reduce_, h_);
        }
    }

    __aicore__ inline void RowSoftmax(const LocalTensor<float>& matrix)
    {
        const uint8_t rowStride = static_cast<uint8_t>(pitch_ / kBlockFloats);
        const uint8_t repeats = static_cast<uint8_t>(h_);
        const uint32_t firstCount = h_ < kVectorFloats ? h_ : kVectorFloats;
        // Reduce independent row chunks directly into compact UB statistics.
        // Max changes no floating-point addition tree or Div operation.
        WholeReduceMax(stats_, matrix, static_cast<int32_t>(firstCount),
            static_cast<int32_t>(h_), 1, 1, static_cast<int32_t>(rowStride),
            ReduceOrder::ORDER_ONLY_VALUE);
        if (h_ > kVectorFloats) {
            WholeReduceMax(work_, matrix[kVectorFloats],
                static_cast<int32_t>(h_ - kVectorFloats),
                static_cast<int32_t>(h_), 1, 1, static_cast<int32_t>(rowStride),
                ReduceOrder::ORDER_ONLY_VALUE);
            VectorDone();
            Max(stats_, stats_, work_, h_);
        }
        VectorDone();
        Brcb(broadcast_, stats_, static_cast<uint8_t>(pitch_ / kBlockFloats), {1, 8});
        VectorDone();
        const BinaryRepeatParams subtractMax{1, 1, 0, rowStride, rowStride, 1};
        if constexpr (kTinySingleVector) {
            uint64_t matrixMask[2] = {TinyMatrixLaneMask(), uint64_t(0)};
            // One physical block per row; Brcb already supplies all row blocks.
            const BinaryRepeatParams singleRows{1, 1, 1, 8, 8, 8};
            Sub(matrix, matrix, broadcast_, matrixMask, uint8_t(1), singleRows);
        } else {
            Sub(matrix, matrix, broadcast_, uint64_t(firstCount), repeats, subtractMax);
            if (h_ > kVectorFloats) {
                Sub(matrix[kVectorFloats], matrix[kVectorFloats], broadcast_,
                    uint64_t(h_ - kVectorFloats), repeats, subtractMax);
            }
        }
        VectorDone();
        // Rows remain independent; retain R4's elementwise batching and sums.
        const UnaryRepeatParams elementwise{1, 1, rowStride, rowStride};
        if constexpr (kTinySingleVector) {
            // Sub set Normal/K; VectorDone does not change the vector mask.
            const UnaryRepeatParams singleVector{1, 1, 8, 8};
            Exp<float, false>(matrix, matrix, MASK_PLACEHOLDER, uint8_t(1), singleVector);
        } else {
            Exp(matrix, matrix, uint64_t(firstCount), repeats, elementwise);
            if (h_ > kVectorFloats) {
                Exp(matrix[kVectorFloats], matrix[kVectorFloats],
                    uint64_t(h_ - kVectorFloats), repeats, elementwise);
            }
        }
        VectorDone();
        ReduceRowSums(matrix);
        VectorDone();
        Brcb(broadcast_, stats_, static_cast<uint8_t>(pitch_ / kBlockFloats), {1, 8});
        VectorDone();
        const BinaryRepeatParams divideRows{1, 1, 0, rowStride, rowStride, 1};
        if constexpr (kTinySingleVector) {
            uint64_t matrixMask[2] = {TinyMatrixLaneMask(), uint64_t(0)};
            const BinaryRepeatParams singleRows{1, 1, 1, 8, 8, 8};
            Div(matrix, matrix, broadcast_, matrixMask, uint8_t(1), singleRows);
        } else {
            Div(matrix, matrix, broadcast_, uint64_t(firstCount), repeats, divideRows);
            if (h_ > kVectorFloats) {
                Div(matrix[kVectorFloats], matrix[kVectorFloats], broadcast_,
                    uint64_t(h_ - kVectorFloats), repeats, divideRows);
            }
        }
        VectorDone();
        // Softmax adds eps AFTER division; it must not enter the denominator.
        if constexpr (kTinySingleVector) {
            // Div re-established K after ReduceRowSums/Brcb; reuse it here.
            const UnaryRepeatParams singleVector{1, 1, 8, 8};
            Adds<float, false>(matrix, matrix, eps_, MASK_PLACEHOLDER, uint8_t(1), singleVector);
        } else {
            Adds(matrix, matrix, eps_, uint64_t(firstCount), repeats, elementwise);
            if (h_ > kVectorFloats) {
                Adds(matrix[kVectorFloats], matrix[kVectorFloats], eps_,
                    uint64_t(h_ - kVectorFloats), repeats, elementwise);
            }
        }
        VectorDone();
        // Tiny exit is Normal/K. The immediate NormalizeColumns sets Normal/H
        // before its first mask-consuming instruction; generic exit is unchanged.
    }

    __aicore__ inline void NormalizeRows(const LocalTensor<float>& matrix)
    {
        // Preserve each 64-element binary tree and then the original repeat order.
        ReduceRowSums(matrix);
        VectorDone();
        Adds(stats_, stats_, eps_, h_);
        VectorDone();
        // Brcb reads pitch_ initialized statistics and writes one 32-byte block
        // per row. Blocks for padded rows are initialized but never consumed.
        Brcb(broadcast_, stats_, static_cast<uint8_t>(pitch_ / kBlockFloats), {1, 8});
        VectorDone();
        const uint8_t rowStride = static_cast<uint8_t>(pitch_ / kBlockFloats);
        const uint8_t repeats = static_cast<uint8_t>(h_);
        // Each repeat owns one row and advances source 1 by one broadcast block.
        // Every block within that row reuses its denominator (src1BlkStride=0).
        const BinaryRepeatParams steps{1, 1, 0, rowStride, rowStride, 1};
        const uint32_t firstCount = h_ < kVectorFloats ? h_ : kVectorFloats;
        Div(matrix, matrix, broadcast_, uint64_t(firstCount), repeats, steps);
        if (h_ > kVectorFloats) {
            // Reuse the SAME per-row denominator blocks for the second slice.
            Div(matrix[kVectorFloats], matrix[kVectorFloats], broadcast_,
                uint64_t(h_ - kVectorFloats), repeats, steps);
        }
        VectorDone();
    }

    __aicore__ inline void NormalizeColumns(const LocalTensor<float>& matrix)
    {
        if constexpr (FixedPitch == kBlockFloats &&
            FixedHeight >= 2 && FixedHeight <= kBlockFloats) {
            auto sums = work_[2 * pitch_];
            const uint8_t rowStride = static_cast<uint8_t>(pitch_ / kBlockFloats);
            const uint32_t firstCount = h_ < kVectorFloats ? h_ : kVectorFloats;
            const BinaryRepeatParams accumulate{1, 1, 1, 0, rowStride, 0};
            const uint8_t remainingRows = static_cast<uint8_t>(h_ - 1);
            const UnaryRepeatParams scalarSteps{1, 1, 8, 8};
            // The seed, ordered row accumulation and eps touch the same H lanes.
            // Keep row0 +0 as a real FP32 operation, with the original barriers.
            SetMaskNorm();
            SetVectorMask<float, MaskMode::NORMAL>(static_cast<int32_t>(FixedHeight));
            Adds<float, false>(sums, matrix, 0.0f, MASK_PLACEHOLDER, 1, scalarSteps);
            VectorDone();
            Add<float, false>(sums, matrix[pitch_], sums, MASK_PLACEHOLDER,
                remainingRows, accumulate);
            VectorDone();
            Adds<float, false>(sums, sums, eps_, MASK_PLACEHOLDER, 1, scalarSteps);
            VectorDone();
            // Reuse the same eight-lane sums block across every physical row.
            // Div sets K itself; the next reduction sets H, or DMA ignores the mask.
            uint64_t matrixMask[2] = {TinyMatrixLaneMask(), uint64_t(0)};
            const BinaryRepeatParams singleColumns{1, 1, 0, 8, 8, 0};
            Div(matrix, matrix, sums, matrixMask, uint8_t(1), singleColumns);
            VectorDone();
        } else {
            auto sums = work_[2 * pitch_];
            Adds(sums, matrix, 0.0f, h_);
            VectorDone();
            const uint8_t rowStride = static_cast<uint8_t>(pitch_ / kBlockFloats);
            const uint32_t firstCount = h_ < kVectorFloats ? h_ : kVectorFloats;
            // Add permits a previous repeat's dst to be the next repeat's src1
            // when dstRepStride or src1RepStride is zero. Keep both zero so each
            // column has one accumulator, while src0 advances through rows 1..H-1.
            // The accumulator moves from operand 0 to operand 1; each FP32 addition
            // still consumes exactly the same pair, without changing row order.
            const BinaryRepeatParams accumulate{1, 1, 1, 0, rowStride, 0};
            const uint8_t remainingRows = static_cast<uint8_t>(h_ - 1);
            Add(sums, matrix[pitch_], sums, uint64_t(firstCount), remainingRows, accumulate);
            if (h_ > kVectorFloats) {
                Add(sums[kVectorFloats], matrix[pitch_ + kVectorFloats], sums[kVectorFloats],
                    uint64_t(h_ - kVectorFloats), remainingRows, accumulate);
            }
            VectorDone();
            Adds(sums, sums, eps_, h_);
            VectorDone();
            // All rows share the same column denominators. Each repeat owns one
            // distinct row; source 1 repeats the same denominator vector. Split the
            // columns at 64 so both masks stay within the FP32 vector width.
            const uint8_t repeats = static_cast<uint8_t>(h_);
            const BinaryRepeatParams steps{1, 1, 1, rowStride, rowStride, 0};
            Div(matrix, matrix, sums, uint64_t(firstCount), repeats, steps);
            if (h_ > kVectorFloats) {
                Div(matrix[kVectorFloats], matrix[kVectorFloats], sums[kVectorFloats],
                    uint64_t(h_ - kVectorFloats), repeats, steps);
            }
            VectorDone();
        }
    }

    template <HardEvent Event>
    __aicore__ static inline void SyncStaticPipelines()
    {
        // Immediate matched pairs, serialized across tokens. IDs 6/7 are unused.
        SetFlag<Event>(int32_t(0));
        WaitFlag<Event>(int32_t(0));
    }

    GlobalTensor<float> x_, pre_, post_, comb_;
    LocalTensor<float> input_, work_, reduce_, stats_, broadcast_;
    uint64_t tokenCount_, first_, end_;
    uint32_t h_, pitch_, w_, iters_;
    float eps_;
};

// R2: dedicated H5/iters=1/N=1 main leaf. It owns one token, one input
// transfer and one launch, with no token loop or runtime compaction branch.
// The schedule fuses the stable sigmoid denominator with matrix softmax Exp:
// first 16 lanes hold -abs(gate), next 40 lanes hold matrix-rowmax, and one
// Exp materializes both. The gate numerator remains in work_.
class TinyH5OnceN1R2Kernel {
    static constexpr uint32_t kHeight = 5;
    static constexpr uint32_t kPitch = kBlockFloats;
    static constexpr uint32_t kInputRows = kHeight + 2;
    static constexpr uint32_t kInputFloats = kInputRows * kPitch;
    static constexpr uint32_t kInputBytes = kInputFloats * sizeof(float);
    static constexpr uint32_t kRawFloats = kInputRows * kHeight;
    static constexpr uint32_t kRawBytes = kRawFloats * sizeof(float);
    static constexpr uint32_t kIndexStorageFloats = kInputFloats;
    static constexpr uint32_t kIndexPackedWords = kInputFloats / 2;
    static constexpr uint32_t kMatrixOffset = 2 * kPitch;
    static constexpr uint32_t kGateFloats = 2 * kPitch;
    static constexpr uint32_t kMatrixFloats = kHeight * kPitch;
    static constexpr uint32_t kCompactFloats = kHeight * kHeight;
    static constexpr uint64_t kGateMask = 0xffffULL;
    static constexpr uint64_t kInputMask = (uint64_t(1) << 56) - uint64_t(1);
    static constexpr uint64_t kMatrixMask = 0x1f1f1f1f1fULL;
    static constexpr uint64_t kColumnMask = 0x1fULL;
    static constexpr uint64_t kStatsMask = 0xffULL;
    static constexpr uint64_t kWorkMask = (uint64_t(1) << 24) - uint64_t(1);
    static_assert(kInputRows == 7 && kRawFloats == 35 && kRawBytes == 140 &&
        kInputFloats == 56 && kIndexPackedWords == 28 &&
        kInputRows * (kPitch / 2) == kIndexPackedWords,
        "R3 requires seven rows and one 140-byte input mapped by 28 packed words");

public:
    __aicore__ inline void Init(GM_ADDR mixes, GM_ADDR pre, GM_ADDR post,
        GM_ADDR comb, float eps)
    {
        eps_ = eps;
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(mixes));
        pre_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(pre));
        post_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(post));
        comb_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(comb));

        constexpr uint32_t bankPadFloats =
            kResidentMatrixKernelUbBankPaddingBytes / sizeof(float);
        constexpr uint32_t workFloats = 3 * kPitch;
        constexpr uint32_t reduceOffset = bankPadFloats + workFloats;
        constexpr uint32_t statsOffset = reduceOffset + kReduceScratchFloats;
        constexpr uint32_t broadcastOffset = statsOffset + kBlockFloats;
        constexpr uint32_t patternOffset =
            broadcastOffset + kBlockFloats * kPitch;
        constexpr uint32_t indexOffset = patternOffset + kBlockFloats;
        constexpr uint32_t scratchFloats =
            indexOffset + kIndexStorageFloats;
        static_assert(patternOffset % kBlockFloats == 0,
            "R3 compaction pattern must start on a 32-byte UB boundary");
        static_assert(indexOffset % kBlockFloats == 0,
            "R3 packed offsets must start on a 32-byte UB boundary");

        input_ = LocalTensor<float>(
            TPosition::VECIN, uint32_t(0), kInputFloats);
        auto scratch = LocalTensor<float>(
            TPosition::VECCALC, kInputBytes, scratchFloats);
        work_ = scratch[bankPadFloats];
        reduce_ = scratch[reduceOffset];
        stats_ = scratch[statsOffset];
        broadcast_ = scratch[broadcastOffset];
        compactPattern_ = scratch[patternOffset];
        inputIndex_ = scratch[indexOffset].ReinterpretCast<uint32_t>();
        auto pattern = compactPattern_.ReinterpretCast<uint32_t>();

        // Initialize the complete aligned 32-byte stats block once so its
        // allocation has valid contiguous storage. BlockReduceMax may leave
        // fully masked tail outputs unspecified. Brcb may replicate those
        // lanes, but every numeric consumer masks exactly matrix rows 0..4;
        // broadcast blocks 5..7 are never selected. No tail rewrite or extra
        // WAW fence is therefore needed.
        // R5 keeps Normal mask mode for the dedicated kernel. Level0 false
        // suppresses each public API's mask-mode update; explicit masks below
        // cover every initialized lane and are re-established after reductions
        // or Brcb's internal ResetMask.
        SetMaskNorm();
        SetVectorMask<float, MaskMode::NORMAL>(uint64_t(0), kStatsMask);
        Duplicate<float, false>(stats_, 0.0f, MASK_PLACEHOLDER, uint8_t(1),
            uint16_t(1), uint8_t(kBlockFloats));
        SetVectorMask<float, MaskMode::NORMAL>(uint64_t(0), kWorkMask);
        Duplicate<float, false>(work_, 0.0f, MASK_PLACEHOLDER, uint8_t(1),
            uint16_t(1), uint8_t(kBlockFloats));
        // Keep the H5 GatherMask pattern in its own block. The 56 Gather
        // offset records occupy the following aligned block and are built in
        // Process while the 140-byte DMA is in flight.
        pattern.SetValue(0, uint32_t(0x1f1f1f1fU));
        pattern.SetValue(1, uint32_t(0x1fU));
        pattern.SetValue(2, uint32_t(0));
        pattern.SetValue(3, uint32_t(0));
        VectorDone();
    }

    __aicore__ inline void Process()
    {
        // One 140-byte GM read. DataCopyPad right-pads one float in UB at
        // byte 140; Gather padding lanes index that zero slot, so GM reads no
        // byte beyond the real 35-float input. reduce_ later becomes compact
        // comb output after Gather has consumed the raw input.
        auto rawInput = reduce_;
        DataCopyExtParams rawRows{1, kRawBytes, 0, 0, 0};
        DataCopyPadExtParams<float> rawPadding{true, 0, 1, 0.0f};
        DataCopyPad(rawInput, x_[0], rawRows, rawPadding);
        // Hide the packed-index scalar stores in the MTE2 window, then publish
        // them and the Init-written pattern before Gather consumes either map.
        BuildInputIndex();
        SyncStaticPipelines<HardEvent::S_V>();
        SyncStaticPipelines<HardEvent::MTE2_V>();

        // Level-2 Gather consumes the 56 uint32 byte offsets packed into
        // inputIndex_. The S_V above publishes both maps before this call.
        Gather(input_, rawInput, inputIndex_, uint32_t(0), kInputFloats);
        VectorDone();
        // Stage 1 re-establishes the gate mask after Gather updates the mask.

        auto gates = input_;
        auto matrix = input_[kMatrixOffset];
        auto numerator = work_;
        uint64_t rowMask[2] = {0x1f1f1f1f1fULL, uint64_t(0)};
        const UnaryRepeatParams singleLanes{1, 1, 8, 8};

        // 1) Read the original gate and matrix, then form min(z,0) and the
        // five row maxima. No instruction below may overwrite gates before
        // both reads complete.
        SetVectorMask<float, MaskMode::NORMAL>(uint64_t(0), kGateMask);
        Mins<float, false>(numerator, gates, 0.0f, MASK_PLACEHOLDER, uint8_t(1),
            singleLanes);
        BlockReduceMax(stats_, matrix, 1, rowMask, 1, 1, 1);
        VectorDone();

        // 2) Form -abs(z), exp(min(z,0)), and the row-max broadcast. Brcb's
        // implementation resets the vector mask, so step 3 restores 16 lanes.
        SetVectorMask<float, MaskMode::NORMAL>(uint64_t(0), kGateMask);
        Abs<float, false>(gates, gates, MASK_PLACEHOLDER, uint8_t(1), singleLanes);
        Exp<float, false>(numerator, numerator, MASK_PLACEHOLDER, uint8_t(1),
            singleLanes);
        Brcb(broadcast_, stats_, uint8_t(1), {1, 8});
        VectorDone();

        // 3) Turn gate lanes into -abs(z) and subtract each row maximum from
        // the five real columns. Padding retains zero until the fused Exp.
        SetVectorMask<float, MaskMode::NORMAL>(uint64_t(0), kGateMask);
        Muls<float, false>(gates, gates, -1.0f, MASK_PLACEHOLDER, uint8_t(1),
            singleLanes);
        const BinaryRepeatParams singleRows{1, 1, 1, 8, 8, 8};
        Sub(matrix, matrix, broadcast_, rowMask, uint8_t(1), singleRows);
        VectorDone();

        // 4) One Exp over all 7x8 lanes materializes the 16 gate denominators
        // and the 40 matrix exponentials. This is the only matrix Exp.
        SetVectorMask<float, MaskMode::NORMAL>(uint64_t(0), kInputMask);
        Exp<float, false>(input_, input_, MASK_PLACEHOLDER, uint8_t(1), singleLanes);
        VectorDone();

        // 5) Complete each gate denominator and retain the original
        // WholeReduceSum count=5, repeat=5 row tree/order.
        SetVectorMask<float, MaskMode::NORMAL>(uint64_t(0), kGateMask);
        Adds<float, false>(gates, gates, 1.0f, MASK_PLACEHOLDER, uint8_t(1),
            singleLanes);
        WholeReduceSum(stats_, matrix, int32_t(kHeight), int32_t(kHeight),
            1, 1, int32_t(kPitch / kBlockFloats));
        VectorDone();

        // 6) Compute sigmoid and broadcast the five row sums. Brcb resets the
        // mask again; step 7 establishes the five-column mask afterwards.
        SetVectorMask<float, MaskMode::NORMAL>(uint64_t(0), kGateMask);
        Div<float, false>(gates, numerator, gates, MASK_PLACEHOLDER, uint8_t(1),
            singleRows);
        Brcb(broadcast_, stats_, uint8_t(1), {1, 8});
        VectorDone();

        // 7) Add pre eps, multiply post by two, and normalize softmax rows.
        SetVectorMask<float, MaskMode::NORMAL>(uint64_t(0), kColumnMask);
        Adds<float, false>(gates, gates, eps_, MASK_PLACEHOLDER, uint8_t(1),
            singleLanes);
        Muls<float, false>(gates[kPitch], gates[kPitch], 2.0f, MASK_PLACEHOLDER,
            uint8_t(1), singleLanes);
        SetVectorMask<float, MaskMode::NORMAL>(uint64_t(0), kMatrixMask);
        Div<float, false>(matrix, matrix, broadcast_, MASK_PLACEHOLDER, uint8_t(1),
            singleRows);
        VectorDone();

        // Gates are final after stage 7. Start their output while the matrix
        // eps, column normalization and compaction continue on PIPE_V. The
        // extra V_MTE3 dependency is deliberate; its performance is unproven.
        SyncStaticPipelines<HardEvent::V_MTE3>();
        StoreGatesEarly(gates);

        // 8) Softmax eps is after division. Column sums retain the original
        // row0 seed and rows 1..4 recurrence, followed by eps and native Div.
        Adds<float, false>(matrix, matrix, eps_, MASK_PLACEHOLDER, uint8_t(1),
            singleLanes);
        VectorDone();
        auto columnSums = work_[2 * kPitch];
        SetVectorMask<float, MaskMode::NORMAL>(uint64_t(0), kColumnMask);
        const BinaryRepeatParams accumulate{1, 1, 1, 0, 1, 0};
        Add<float, false>(columnSums, matrix, columnSums,
            MASK_PLACEHOLDER, uint8_t(kHeight), accumulate);
        VectorDone();
        Adds<float, false>(columnSums, columnSums, eps_, MASK_PLACEHOLDER,
            uint8_t(1), singleLanes);
        VectorDone();
        const BinaryRepeatParams singleColumns{1, 1, 0, 8, 8, 0};
        SetVectorMask<float, MaskMode::NORMAL>(uint64_t(0), kMatrixMask);
        Div<float, false>(matrix, matrix, columnSums, MASK_PLACEHOLDER, uint8_t(1),
            singleColumns);
        VectorDone();

        CompactComb(matrix);
        SyncStaticPipelines<HardEvent::V_MTE3>();
        StoreExact(comb_[0], reduce_, kCompactFloats);
        SyncStaticPipelines<HardEvent::MTE3_MTE2>();
    }

private:
    __aicore__ inline void StoreGatesEarly(
        const LocalTensor<float>& gates)
    {
        constexpr uint64_t gateBytes = uint64_t(kHeight) * sizeof(float);
        constexpr uint64_t maxU64 = ~uint64_t(0);
        constexpr uint64_t maxU32 = ~uint32_t(0);
        const uint64_t preAddr =
            reinterpret_cast<uint64_t>(pre_.GetPhyAddr());
        const uint64_t postAddr =
            reinterpret_cast<uint64_t>(post_.GetPhyAddr());

        // Combine only when complete [address,address+20) intervals are known
        // to be ordered and the GM gap fits DataCopyExtParams::dstStride.
        bool canCombine = preAddr <= maxU64 - gateBytes &&
            postAddr <= maxU64 - gateBytes && postAddr >= preAddr;
        uint64_t gap64 = 0;
        if (canCombine) {
            gap64 = postAddr - preAddr;
            canCombine = gap64 >= gateBytes && gap64 - gateBytes <= maxU32;
        }
        if (canCombine) {
            const DataCopyExtParams gatePair{uint16_t(2),
                static_cast<uint32_t>(gateBytes), uint32_t(0),
                static_cast<uint32_t>(gap64 - gateBytes), uint32_t(0)};
            DataCopyPad(pre_[0], gates, gatePair);
        } else {
            StoreExact(pre_[0], gates, kHeight);
            StoreExact(post_[0], gates[kPitch], kHeight);
        }
    }

    __aicore__ inline void BuildInputIndex()
    {
        // Each uint64 stores two little-endian uint32 byte offsets. Real
        // columns select row*5+column; padded columns select raw float 35.
        auto packedIndex = inputIndex_.ReinterpretCast<uint64_t>();
        for (uint32_t row = 0; row < kInputRows; ++row) {
            for (uint32_t pair = 0; pair < kPitch / 2; ++pair) {
                const uint32_t column0 = pair * 2;
                const uint32_t column1 = column0 + 1;
                const uint32_t source0 = column0 < kHeight
                    ? row * kHeight + column0 : kRawFloats;
                const uint32_t source1 = column1 < kHeight
                    ? row * kHeight + column1 : kRawFloats;
                const uint64_t byte0 =
                    uint64_t(source0) * sizeof(float);
                const uint64_t byte1 =
                    uint64_t(source1) * sizeof(float);
                packedIndex.SetValue(row * (kPitch / 2) + pair,
                    byte0 | (byte1 << 32U));
            }
        }
    }

    __aicore__ inline void CompactComb(const LocalTensor<float>& matrix)
    {
        auto compact = reduce_;
        auto pattern = compactPattern_.ReinterpretCast<uint32_t>();
        // The isolated pattern was published by Init's early S_V dependency.
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 2201 && !ASCENDC_CPU_DEBUG && !defined(__MSTX_DFX_REPORT__)
        SetMaskCount();
        SetVectorMask<uint32_t, MaskMode::COUNTER>(
            uint64_t(0), uint64_t(kMatrixFloats));
        vreducev2((__ubuf__ uint32_t*)compact.GetPhyAddr(),
            (__ubuf__ uint32_t*)matrix.GetPhyAddr(),
            (__ubuf__ uint32_t*)pattern.GetPhyAddr(), uint16_t(1), uint8_t(1),
            uint8_t(0), uint16_t(kBlockFloats), uint8_t(kBlockFloats));
#else
        uint64_t reservedCount = 0;
        GatherMaskParams fallbackParams{1, 1, uint16_t(kBlockFloats),
            uint8_t(kBlockFloats)};
        GatherMask(compact, matrix, pattern, true, kMatrixFloats,
            fallbackParams, reservedCount);
#endif
        SetMaskNorm();
        ResetMask();
        VectorDone();
    }

    template <HardEvent Event>
    __aicore__ static inline void SyncStaticPipelines()
    {
        SetFlag<Event>(int32_t(0));
        WaitFlag<Event>(int32_t(0));
    }

    GlobalTensor<float> x_, pre_, post_, comb_;
    LocalTensor<float> input_, work_, reduce_, stats_, broadcast_,
        compactPattern_;
    LocalTensor<uint32_t> inputIndex_;
    float eps_;
};

// For matrices at least one vector register wide, factorization removes the
// per-iteration dense normalization divisions. The strict row/column factors
// are accumulated independently, while every row/column sum still walks the
// original indices and every normalization still uses Div for its scale.
constexpr uint32_t kResidentScaledKernelUbBankPaddingBytes = 256;

// Balanced FP32 column reduction for dense power-of-two row matrices.
// Stage zero writes the dead product buffer; later stages update its prefix
// with dst == src0 exactly, while src1 is the disjoint upper half. The final
// level writes the separate column vector. The source matrix stays intact.
// Every level completes before its output becomes the next level's input.
template <uint32_t ActiveRows, uint32_t Columns>
__aicore__ inline void ReduceColumnsBinaryTreeStage(const LocalTensor<float>& source,
    const LocalTensor<float>& scratch, const LocalTensor<float>& dst)
{
    static_assert(ActiveRows >= 2 && (ActiveRows & (ActiveRows - 1)) == 0,
        "Column binary tree requires a power-of-two active row count");
    static_assert(Columns % kVectorFloats == 0,
        "Column binary tree requires complete FP32 vectors per row");
    constexpr int32_t halfElements = static_cast<int32_t>((ActiveRows / 2) * Columns);
    if constexpr (ActiveRows == 2) {
        Add(dst, source, source[Columns], static_cast<int32_t>(Columns));
        VectorDone();
    } else {
        Add(scratch, source, source[halfElements], halfElements);
        VectorDone();
        ReduceColumnsBinaryTreeStage<ActiveRows / 2, Columns>(scratch, scratch, dst);
    }
}
template <uint32_t CompleteVectorTiles = 0, bool UseBr8Roots = false>
class ResidentScaledMatrixKernel {
public:
    __aicore__ inline void Init(GM_ADDR mixes, GM_ADDR pre, GM_ADDR post,
        GM_ADDR comb, uint64_t n, uint32_t h, uint32_t iters, float eps,
        uint32_t tokenGroup, TPipe* pipe)
    {
        pipe_ = pipe;
        h_ = CompleteVectorTiles == 0 ? h : CompleteVectorTiles * kVectorFloats;
        pitch_ = CompleteVectorTiles == 0 ? (h + 7) / 8 * 8 : CompleteVectorTiles * kVectorFloats;
        w_ = h_ * h_ + 2 * h_;
        iters_ = iters;
        eps_ = eps;
        TokenRange(n, tokenGroup, first_, end_);
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(mixes));
        pre_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(pre));
        post_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(post));
        comb_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(comb));
        pipe_->InitBuffer(matrixQueue_, 1, h_ * pitch_ * sizeof(float));
        pipe_->InitBuffer(gatesQueue_, 1, 2 * pitch_ * sizeof(float));
        pipe_->InitBuffer(ubBankPadBeforeScratch_, kResidentScaledKernelUbBankPaddingBytes);
        pipe_->InitBuffer(productBuf_, h_ * pitch_ * sizeof(float));
        pipe_->InitBuffer(factorsBuf_, 5 * pitch_ * sizeof(float));
        const uint32_t rowScratchVectors = h_ < kVectorFloats ? 1U :
            ((h_ > kVectorFloats && h_ % kVectorFloats == 0) ? 3U : 2U);
        pipe_->InitBuffer(broadcastBuf_, rowScratchVectors *
            kBlockFloats * pitch_ * sizeof(float));
        product_ = productBuf_.Get<float>();
        factors_ = factorsBuf_.Get<float>();
        broadcast_ = broadcastBuf_.Get<float>();
        ones_ = factors_;
        rowScale_ = factors_[pitch_];
        colScale_ = factors_[2 * pitch_];
        sum_ = factors_[3 * pitch_];
        scaledSum_ = factors_[4 * pitch_];
        Duplicate(ones_, 1.0f, pitch_);
        Duplicate(rowScale_, 1.0f, pitch_);
        VectorDone();
    }

    __aicore__ inline void Process()
    {
        for (uint64_t token = first_; token < end_; ++token) {
            auto gates = gatesQueue_.AllocTensor<float>();
            LoadExact(gates, x_[token * w_], h_);
            LoadExact(gates[pitch_], x_[token * w_ + h_], h_);
            gatesQueue_.EnQue(gates);
            auto matrix = matrixQueue_.AllocTensor<float>();
            DataCopyExtParams rows{static_cast<uint16_t>(h_),
                static_cast<uint32_t>(h_ * sizeof(float)), 0, 0, 0};
            DataCopyPadExtParams<float> padding{
                true, 0, static_cast<uint8_t>(pitch_ - h_), 0.0f};
            DataCopyPad(matrix, x_[token * w_ + 2 * h_], rows, padding);
            matrixQueue_.EnQue(matrix);
            gates = gatesQueue_.DeQue<float>();
            matrix = matrixQueue_.DeQue<float>();

            SigmoidInPlace(gates, broadcast_, product_, 2 * pitch_);
            Adds(gates, gates, eps_, h_);
            Muls(gates[pitch_], gates[pitch_], 2.0f, h_);
            VectorDone();

            RowSoftmax(matrix);
            ReduceColumns(matrix, sum_);
            Adds(sum_, sum_, eps_, h_);
            VectorDone();
            DivideVector(rowScale_, ones_, sum_);
            ScaleColumns(matrix, rowScale_, product_);

            for (uint32_t iter = 1; iter < iters_; ++iter) {
                ReduceRows(product_, sum_);
                Adds(sum_, sum_, eps_, h_);
                VectorDone();
                DivideVector(rowScale_, ones_, sum_);
                ScaleRows(product_, rowScale_, matrix);

                ReduceColumns(matrix, sum_);
                Adds(sum_, sum_, eps_, h_);
                VectorDone();
                DivideVector(rowScale_, ones_, sum_);
                ScaleColumns(matrix, rowScale_, product_);
            }

            SyncPipelines<HardEvent::V_MTE3>(*pipe_);
            StoreExact(pre_[token * h_], gates, h_);
            StoreExact(post_[token * h_], gates[pitch_], h_);
            DataCopyPad(comb_[token * h_ * h_], product_, rows);
            SyncPipelines<HardEvent::MTE3_V>(*pipe_);
            gatesQueue_.FreeTensor(gates);
            matrixQueue_.FreeTensor(matrix);
        }
    }

private:
    __aicore__ inline void Broadcast(const LocalTensor<float>& source)
    {
        Brcb(broadcast_, source, static_cast<uint8_t>(pitch_ / kBlockFloats),
            {1, 8});
        VectorDone();
    }

    __aicore__ inline void DivideVector(const LocalTensor<float>& dst,
        const LocalTensor<float>& numerator, const LocalTensor<float>& denominator)
    {
        const uint32_t firstCount = h_ < kVectorFloats ? h_ : kVectorFloats;
        Div(dst, numerator, denominator, uint64_t(firstCount));
        if (h_ > kVectorFloats) {
            Div(dst[kVectorFloats], numerator[kVectorFloats],
                denominator[kVectorFloats], uint64_t(h_ - kVectorFloats));
        }
        VectorDone();
    }

    __aicore__ inline void CompactAdjacentPairsNoSync(const LocalTensor<float>& dst,
        const LocalTensor<float>& source, uint32_t elements)
    {
        const uint32_t fullRepeats = elements / kVectorFloats;
        if (fullRepeats != 0) {
            // PairReduceSum dstRepStride units are 128 bytes.
            PairReduceSum(dst, source, static_cast<int32_t>(fullRepeats),
                static_cast<int32_t>(kVectorFloats), 1, 1, 8);
        }
        const uint32_t tail = elements % kVectorFloats;
        if (tail != 0) {
            PairReduceSum(dst[fullRepeats * (kVectorFloats / 2)],
                source[fullRepeats * kVectorFloats], 1,
                static_cast<int32_t>(tail), 1, 1, 8);
        }
    }

    __aicore__ inline void ReduceRows(const LocalTensor<float>& source,
        const LocalTensor<float>& dst)
    {
        // Complete FP32 vector tiles decompose both independent halves.
        // Non-full widths decompose only their first complete 64-float tile.
        if (h_ % kVectorFloats != 0) {
            if (h_ < kVectorFloats) {
                WholeReduceSum(dst, source, static_cast<int32_t>(h_),
                    static_cast<int32_t>(h_), 1, 1,
                    static_cast<int32_t>(pitch_ / kBlockFloats));
                VectorDone();
                return;
            }
            // For a non-full width, decompose only the first complete
            // 64-float tile. Keep the original masked tail tree unchanged.
            BlockReduceSum(broadcast_, source, static_cast<int32_t>(h_),
                static_cast<int32_t>(kVectorFloats), 1, 1,
                static_cast<int32_t>(pitch_ / kBlockFloats));
            WholeReduceSum(scaledSum_, source[kVectorFloats],
                static_cast<int32_t>(h_ - kVectorFloats),
                static_cast<int32_t>(h_), 1, 1,
                static_cast<int32_t>(pitch_ / kBlockFloats));
            VectorDone();
            auto pairScratch = broadcast_[8 * pitch_];
            CompactAdjacentPairsNoSync(pairScratch, broadcast_, h_ * 8);
            VectorDone();
            CompactAdjacentPairsNoSync(broadcast_, pairScratch, h_ * 4);
            VectorDone();
            CompactAdjacentPairsNoSync(dst, broadcast_, h_ * 2);
            VectorDone();
            Add(dst, dst, scaledSum_, h_);
            VectorDone();
            return;
        }
        // Complete rows contain one or two contiguous FP32 vector tiles.
        // Pack roots in row/half order so each Pair layer can cover both
        // independent halves in one contiguous instruction sequence.
        const uint32_t rootsCount = h_ * h_ / kBlockFloats;
        auto roots = broadcast_;
        auto compact = broadcast_[rootsCount];
        SetMaskCount();
        SetVectorMask<float, MaskMode::COUNTER>(uint64_t(0), uint64_t(h_ * h_));
        BlockReduceSum<float, false>(roots, source, 1,
            static_cast<int32_t>(MASK_PLACEHOLDER), 1, 1, 8);
        SetMaskNorm();
        ResetMask();
        VectorDone();
        if constexpr (UseBr8Roots) {
            // The next three adjacent-Pair layers form one eight-leaf tree
            // inside each 32-byte root block. Issue that same tree as BR8.
            // This changes the instruction grouping, never the row/half pairing.
            SetMaskCount();
            SetVectorMask<float, MaskMode::COUNTER>(uint64_t(0), uint64_t(rootsCount));
            if (h_ > kVectorFloats) {
                BlockReduceSum<float, false>(compact, roots, 1,
                    static_cast<int32_t>(MASK_PLACEHOLDER), 1, 1, 8);
            } else {
                BlockReduceSum<float, false>(dst, roots, 1,
                    static_cast<int32_t>(MASK_PLACEHOLDER), 1, 1, 8);
            }
            SetMaskNorm();
            ResetMask();
            VectorDone();
            if (h_ > kVectorFloats) {
                // Keep original first64 + second64 operands and rounding point.
                CompactAdjacentPairsNoSync(dst, compact, rootsCount / kBlockFloats);
                VectorDone();
            }
        } else {
            CompactAdjacentPairsNoSync(compact, roots, rootsCount);
            VectorDone();
            CompactAdjacentPairsNoSync(roots, compact, rootsCount / 2);
            VectorDone();
            if (h_ > kVectorFloats) {
                CompactAdjacentPairsNoSync(compact, roots, rootsCount / 4);
                VectorDone();
                // Adjacent values now are the same row's first64 and second64
                // roots. This is the original final first-half + second-half Add.
                CompactAdjacentPairsNoSync(dst, compact, rootsCount / 8);
            } else {
                CompactAdjacentPairsNoSync(dst, roots, rootsCount / 4);
            }
            VectorDone();
        }
    }

    __aicore__ inline void ReduceColumns(const LocalTensor<float>& source,
        const LocalTensor<float>& dst)
    {
        Adds(dst, source, 0.0f, h_);
        VectorDone();
        const uint8_t rowStride = static_cast<uint8_t>(pitch_ / kBlockFloats);
        const uint32_t firstCount = h_ < kVectorFloats ? h_ : kVectorFloats;
        const BinaryRepeatParams accumulate{1, 1, 1, 0, rowStride, 0};
        const uint8_t remainingRows = static_cast<uint8_t>(h_ - 1);
        Add(dst, source[pitch_], dst, uint64_t(firstCount),
            remainingRows, accumulate);
        if (h_ > kVectorFloats) {
            Add(dst[kVectorFloats], source[pitch_ + kVectorFloats],
                dst[kVectorFloats], uint64_t(h_ - kVectorFloats),
                remainingRows, accumulate);
        }
        VectorDone();
    }

    __aicore__ inline void ScaleColumns(const LocalTensor<float>& source,
        const LocalTensor<float>& scale, const LocalTensor<float>& dst)
    {
        const uint8_t rowStride = static_cast<uint8_t>(pitch_ / kBlockFloats);
        const uint8_t repeats = static_cast<uint8_t>(h_);
        const uint32_t firstCount = h_ < kVectorFloats ? h_ : kVectorFloats;
        const BinaryRepeatParams steps{1, 1, 1, rowStride, rowStride, 0};
        Mul(dst, source, scale, uint64_t(firstCount), repeats, steps);
        if (h_ > kVectorFloats) {
            Mul(dst[kVectorFloats], source[kVectorFloats],
                scale[kVectorFloats], uint64_t(h_ - kVectorFloats), repeats, steps);
        }
        VectorDone();
    }

    __aicore__ inline void ScaleRows(const LocalTensor<float>& source,
        const LocalTensor<float>& scale, const LocalTensor<float>& dst)
    {
        Broadcast(scale);
        const uint8_t rowStride = static_cast<uint8_t>(pitch_ / kBlockFloats);
        const uint8_t repeats = static_cast<uint8_t>(h_);
        const uint32_t firstCount = h_ < kVectorFloats ? h_ : kVectorFloats;
        const BinaryRepeatParams steps{1, 1, 0, rowStride, rowStride, 1};
        Mul(dst, source, broadcast_, uint64_t(firstCount), repeats, steps);
        if (h_ > kVectorFloats) {
            Mul(dst[kVectorFloats], source[kVectorFloats],
                broadcast_, uint64_t(h_ - kVectorFloats), repeats, steps);
        }
        VectorDone();
    }

    __aicore__ inline void ScaleRowsInPlace(const LocalTensor<float>& matrix,
        const LocalTensor<float>& scale)
    {
        ScaleRows(matrix, scale, matrix);
    }

    __aicore__ inline void UpdateScale(const LocalTensor<float>& scale,
        const LocalTensor<float>& unscaledSum)
    {
        Mul(scaledSum_, scale, unscaledSum, h_);
        Adds(scaledSum_, scaledSum_, eps_, h_);
        VectorDone();
        DivideVector(scale, scale, scaledSum_);
    }

    __aicore__ inline void ReduceRowSums(const LocalTensor<float>& matrix)
    {
        ReduceRows(matrix, sum_);
    }

    __aicore__ inline void RowSoftmax(const LocalTensor<float>& matrix)
    {
        const uint8_t rowStride = static_cast<uint8_t>(pitch_ / kBlockFloats);
        const uint8_t repeats = static_cast<uint8_t>(h_);
        const uint32_t firstCount = h_ < kVectorFloats ? h_ : kVectorFloats;
        WholeReduceMax(sum_, matrix, static_cast<int32_t>(firstCount),
            static_cast<int32_t>(h_), 1, 1, static_cast<int32_t>(rowStride),
            ReduceOrder::ORDER_ONLY_VALUE);
        if (h_ > kVectorFloats) {
            WholeReduceMax(scaledSum_, matrix[kVectorFloats],
                static_cast<int32_t>(h_ - kVectorFloats),
                static_cast<int32_t>(h_), 1, 1,
                static_cast<int32_t>(rowStride),
                ReduceOrder::ORDER_ONLY_VALUE);
            VectorDone();
            Max(sum_, sum_, scaledSum_, h_);
        }
        VectorDone();
        Broadcast(sum_);
        const BinaryRepeatParams subtractMax{1, 1, 0, rowStride, rowStride, 1};
        Sub(matrix, matrix, broadcast_, uint64_t(firstCount), repeats, subtractMax);
        if (h_ > kVectorFloats) {
            Sub(matrix[kVectorFloats], matrix[kVectorFloats], broadcast_,
                uint64_t(h_ - kVectorFloats), repeats, subtractMax);
        }
        VectorDone();
        const UnaryRepeatParams elementwise{1, 1, rowStride, rowStride};
        if (h_ % kVectorFloats == 0) {
            // Complete rows have no padding. Keep the same per-element vexp
            // while issuing one contiguous count-mode range.
            Exp(matrix, matrix, h_ * h_);
        } else {
            Exp(matrix, matrix, uint64_t(firstCount), repeats, elementwise);
            if (h_ > kVectorFloats) {
                Exp(matrix[kVectorFloats], matrix[kVectorFloats],
                    uint64_t(h_ - kVectorFloats), repeats, elementwise);
            }
        }
        VectorDone();
        ReduceRowSums(matrix);
        Broadcast(sum_);
        const BinaryRepeatParams divideRows{1, 1, 0, rowStride, rowStride, 1};
        Div(matrix, matrix, broadcast_, uint64_t(firstCount), repeats, divideRows);
        if (h_ > kVectorFloats) {
            Div(matrix[kVectorFloats], matrix[kVectorFloats], broadcast_,
                uint64_t(h_ - kVectorFloats), repeats, divideRows);
        }
        VectorDone();
        if (h_ % kVectorFloats == 0) {
            Adds(matrix, matrix, eps_, h_ * h_);
        } else {
            Adds(matrix, matrix, eps_, uint64_t(firstCount), repeats, elementwise);
            if (h_ > kVectorFloats) {
                Adds(matrix[kVectorFloats], matrix[kVectorFloats], eps_,
                    uint64_t(h_ - kVectorFloats), repeats, elementwise);
            }
        }
        VectorDone();
    }

    TPipe* pipe_;
    TQue<QuePosition::VECIN, 1> matrixQueue_, gatesQueue_;
    TBuf<TPosition::VECCALC> ubBankPadBeforeScratch_;
    TBuf<TPosition::VECCALC> productBuf_, factorsBuf_, broadcastBuf_;
    GlobalTensor<float> x_, pre_, post_, comb_;
    LocalTensor<float> product_, factors_, broadcast_;
    LocalTensor<float> ones_, rowScale_, colScale_, sum_, scaledSum_;
    uint64_t first_, end_;
    uint32_t h_, pitch_, w_, iters_;
    float eps_;
};

// P2 B2: independent padded tokens, with the original nonaligned q1 math.
// Physical row i contains [token0 P][token1 P]...[token(valid-1) P].
// Only scheduling and exact in-place storage change; no sum crosses tokens.
class WideOriginalScaledTokenBatchKernel {
public:
    __aicore__ inline void Init(GM_ADDR mixes, GM_ADDR pre, GM_ADDR post,
        GM_ADDR comb, uint64_t n, uint32_t h, uint32_t iters, float eps,
        uint32_t tokenGroup, uint32_t q, TPipe* pipe)
    {
        pipe_ = pipe;
        h_ = h;
        q_ = q;
        pitch_ = (h + 7) / 8 * 8;
        // Column E=valid*P can exceed roundUp8(valid*H). Reserve q*P for
        // every factor panel; this also covers every real row statistic.
        statsSize_ = q_ * pitch_;
        gateSize_ = 2 * q_ * pitch_;
        w_ = h_ * h_ + 2 * h_;
        iters_ = iters;
        eps_ = eps;
        TokenRange(n, tokenGroup, first_, end_);
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(mixes));
        pre_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(pre));
        post_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(post));
        comb_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(comb));
        pipe_->InitBuffer(matrixQueue_, 1, q_ * h_ * pitch_ * sizeof(float));
        pipe_->InitBuffer(gatesQueue_, 1, gateSize_ * sizeof(float));
        pipe_->InitBuffer(ubBankPadBeforeScratch_, kResidentScaledKernelUbBankPaddingBytes);
        pipe_->InitBuffer(factorsBuf_, 4 * statsSize_ * sizeof(float));
        pipe_->InitBuffer(scratchBuf_, 16 * statsSize_ * sizeof(float));
        factors_ = factorsBuf_.Get<float>();
        scratch_ = scratchBuf_.Get<float>();
        ones_ = factors_;
        rowScale_ = factors_[statsSize_];
        sum_ = factors_[2 * statsSize_];
        tailSum_ = factors_[3 * statsSize_];
        Duplicate(ones_, 1.0f, statsSize_);
        VectorDone();
    }

    __aicore__ inline void Process()
    {
        for (uint64_t token = first_; token < end_; token += q_) {
            const uint32_t valid = static_cast<uint32_t>(
                end_ - token < q_ ? end_ - token : q_);
            rows_ = valid * h_;
            columnElements_ = valid * pitch_;
            matrixRowStride_ = static_cast<uint8_t>(pitch_ / kBlockFloats);
            columnRowStride_ = static_cast<uint8_t>(columnElements_ / kBlockFloats);
            auto gates = gatesQueue_.AllocTensor<float>();
            auto matrix = matrixQueue_.AllocTensor<float>();
            // The default Normal copy mode pads each individual H-float row
            // to P before the extra (valid-1)*P UB gap. No dummy token loads.
            const uint32_t ubRowGap = (valid - 1) * pitch_ / kBlockFloats;
            const DataCopyExtParams loadRows{static_cast<uint16_t>(h_),
                static_cast<uint32_t>(h_ * sizeof(float)), 0, ubRowGap, 0};
            const DataCopyExtParams storeRows{static_cast<uint16_t>(h_),
                static_cast<uint32_t>(h_ * sizeof(float)), ubRowGap, 0, 0};
            const DataCopyPadExtParams<float> padding{
                true, 0, static_cast<uint8_t>(pitch_ - h_), 0.0f};
            for (uint32_t t = 0; t < valid; ++t) {
                const uint64_t inputBase = (token + t) * w_;
                LoadExact(gates[2 * t * pitch_], x_[inputBase], h_);
                LoadExact(gates[(2 * t + 1) * pitch_], x_[inputBase + h_], h_);
                DataCopyPad(matrix[t * pitch_], x_[inputBase + 2 * h_], loadRows, padding);
            }
            gatesQueue_.EnQue(gates);
            matrixQueue_.EnQue(matrix);
            gates = gatesQueue_.DeQue<float>();
            matrix = matrixQueue_.DeQue<float>();
            SigmoidInPlace(gates, scratch_, scratch_[gateSize_], 2 * valid * pitch_);
            for (uint32_t t = 0; t < valid; ++t) {
                Adds(gates[2 * t * pitch_], gates[2 * t * pitch_], eps_, h_);
                Muls(gates[(2 * t + 1) * pitch_], gates[(2 * t + 1) * pitch_], 2.0f, h_);
            }
            VectorDone();

            RowSoftmax(matrix);
            NormalizeColumns(matrix);
            for (uint32_t iter = 1; iter < iters_; ++iter) {
                NormalizeRows(matrix);
                NormalizeColumns(matrix);
            }

            SyncPipelines<HardEvent::V_MTE3>(*pipe_);
            for (uint32_t t = 0; t < valid; ++t) {
                StoreExact(pre_[(token + t) * h_], gates[2 * t * pitch_], h_);
                StoreExact(post_[(token + t) * h_], gates[(2 * t + 1) * pitch_], h_);
                DataCopyPad(comb_[(token + t) * h_ * h_], matrix[t * pitch_], storeRows);
            }
            SyncPipelines<HardEvent::MTE3_V>(*pipe_);
            gatesQueue_.FreeTensor(gates);
            matrixQueue_.FreeTensor(matrix);
        }
    }

private:
    // Every chunk starts on an eight-row boundary, keeping WR statistic
    // destinations 32B aligned. The final repeat count is always <=248.
    static constexpr uint32_t kRowRepeatChunk = 248;

    __aicore__ inline uint32_t RowRepeats(uint32_t first) const
    {
        return rows_ - first < kRowRepeatChunk ? rows_ - first : kRowRepeatChunk;
    }

    __aicore__ inline void Broadcast(const LocalTensor<float>& source)
    {
        const uint8_t repeats = static_cast<uint8_t>((rows_ + 7) / kBlockFloats);
        Brcb(scratch_, source, repeats, {1, 8});
        VectorDone();
    }

    __aicore__ inline void CompactAdjacentPairsNoSync(const LocalTensor<float>& dst,
        const LocalTensor<float>& source, uint32_t elements)
    {
        const uint32_t fullRepeats = elements / kVectorFloats;
        if (fullRepeats != 0) {
            // Same PairReduceSum overload and 128B dstRepStride unit as q1.
            PairReduceSum(dst, source, static_cast<int32_t>(fullRepeats),
                static_cast<int32_t>(kVectorFloats), 1, 1, 8);
        }
        const uint32_t tail = elements % kVectorFloats;
        if (tail != 0) {
            PairReduceSum(dst[fullRepeats * (kVectorFloats / 2)],
                source[fullRepeats * kVectorFloats], 1,
                static_cast<int32_t>(tail), 1, 1, 8);
        }
    }

    __aicore__ inline void ReduceRows(const LocalTensor<float>& matrix)
    {
        // Exact original q1 tree for every physical row:
        // first64 BlockReduceSum -> Pair -> Pair -> Pair; masked tail WR;
        // then original first64_root + tail_root. No padded column is read.
        for (uint32_t first = 0; first < rows_; first += kRowRepeatChunk) {
            const int32_t repeats = static_cast<int32_t>(RowRepeats(first));
            const uint32_t offset = first * pitch_;
            BlockReduceSum(scratch_[first * kBlockFloats], matrix[offset],
                repeats, static_cast<int32_t>(kVectorFloats), 1, 1,
                static_cast<int32_t>(matrixRowStride_));
            WholeReduceSum(tailSum_[first], matrix[offset + kVectorFloats],
                static_cast<int32_t>(h_ - kVectorFloats), repeats, 1, 1,
                static_cast<int32_t>(matrixRowStride_));
        }
        VectorDone();
        auto pairScratch = scratch_[8 * statsSize_];
        CompactAdjacentPairsNoSync(pairScratch, scratch_, rows_ * 8);
        VectorDone();
        CompactAdjacentPairsNoSync(scratch_, pairScratch, rows_ * 4);
        VectorDone();
        CompactAdjacentPairsNoSync(sum_, scratch_, rows_ * 2);
        VectorDone();
        Add(sum_, sum_, tailSum_, rows_);
        VectorDone();
    }

    template <bool divide>
    __aicore__ inline void ApplyRows(const LocalTensor<float>& matrix)
    {
        const BinaryRepeatParams steps{1, 1, 0,
            matrixRowStride_, matrixRowStride_, 1};
        // Both passes retain the q1 mask: 64 then H-64, including partial
        // eight-column tails. Neither pass touches padded columns.
        for (uint32_t first = 0; first < rows_; first += kRowRepeatChunk) {
            const uint8_t repeats = static_cast<uint8_t>(RowRepeats(first));
            const uint32_t offset = first * pitch_;
            if constexpr (divide) {
                Div(matrix[offset], matrix[offset], scratch_[first * 8],
                    uint64_t(kVectorFloats), repeats, steps);
                Div(matrix[offset + kVectorFloats], matrix[offset + kVectorFloats],
                    scratch_[first * 8], uint64_t(h_ - kVectorFloats), repeats, steps);
            } else {
                Mul(matrix[offset], matrix[offset], scratch_[first * 8],
                    uint64_t(kVectorFloats), repeats, steps);
                Mul(matrix[offset + kVectorFloats], matrix[offset + kVectorFloats],
                    scratch_[first * 8], uint64_t(h_ - kVectorFloats), repeats, steps);
            }
        }
        VectorDone();
    }

    __aicore__ inline void NormalizeRows(const LocalTensor<float>& matrix)
    {
        ReduceRows(matrix);
        Adds(sum_, sum_, eps_, rows_);
        VectorDone();
        Div(rowScale_, ones_, sum_, static_cast<int32_t>(rows_));
        VectorDone();
        Broadcast(rowScale_);
        ApplyRows<false>(matrix);
    }

    __aicore__ inline void NormalizeColumns(const LocalTensor<float>& matrix)
    {
        const uint32_t fullElements = columnElements_ / kVectorFloats * kVectorFloats;
        const uint32_t tail = columnElements_ - fullElements;
        // Each lane is a fixed (token,column); E includes only real tokens.
        // Padding lanes are independent. They may become NaN for exceptional
        // eps, but masked row consumers and exact H-wide stores exclude them.
        // The real lanes keep q1's row0+0 and source[row]+accumulated chain.
        Adds(sum_, matrix, 0.0f, static_cast<int32_t>(columnElements_));
        VectorDone();
        const BinaryRepeatParams accumulate{1, 1, 1, 0, columnRowStride_, 0};
        for (uint32_t col = 0; col < fullElements; col += kVectorFloats) {
            Add(sum_[col], matrix[columnElements_ + col], sum_[col],
                uint64_t(kVectorFloats), static_cast<uint8_t>(h_ - 1), accumulate);
        }
        if (tail != 0) {
            Add(sum_[fullElements], matrix[columnElements_ + fullElements], sum_[fullElements],
                uint64_t(tail), static_cast<uint8_t>(h_ - 1), accumulate);
        }
        VectorDone();
        Adds(sum_, sum_, eps_, static_cast<int32_t>(columnElements_));
        VectorDone();
        Div(rowScale_, ones_, sum_, static_cast<int32_t>(columnElements_));
        VectorDone();
        const BinaryRepeatParams steps{1, 1, 1,
            columnRowStride_, columnRowStride_, 0};
        for (uint32_t col = 0; col < fullElements; col += kVectorFloats) {
            Mul(matrix[col], matrix[col], rowScale_[col],
                uint64_t(kVectorFloats), static_cast<uint8_t>(h_), steps);
        }
        if (tail != 0) {
            Mul(matrix[fullElements], matrix[fullElements], rowScale_[fullElements],
                uint64_t(tail), static_cast<uint8_t>(h_), steps);
        }
        VectorDone();
    }

    __aicore__ inline void RowSoftmax(const LocalTensor<float>& matrix)
    {
        for (uint32_t first = 0; first < rows_; first += kRowRepeatChunk) {
            const int32_t repeats = static_cast<int32_t>(RowRepeats(first));
            const uint32_t offset = first * pitch_;
            WholeReduceMax(sum_[first], matrix[offset],
                static_cast<int32_t>(kVectorFloats), repeats, 1, 1,
                static_cast<int32_t>(matrixRowStride_), ReduceOrder::ORDER_ONLY_VALUE);
            WholeReduceMax(tailSum_[first], matrix[offset + kVectorFloats],
                static_cast<int32_t>(h_ - kVectorFloats), repeats, 1, 1,
                static_cast<int32_t>(matrixRowStride_), ReduceOrder::ORDER_ONLY_VALUE);
        }
        VectorDone();
        Max(sum_, sum_, tailSum_, rows_);
        VectorDone();
        Broadcast(sum_);
        const BinaryRepeatParams subtractMax{1, 1, 0,
            matrixRowStride_, matrixRowStride_, 1};
        const UnaryRepeatParams elementwise{1, 1, matrixRowStride_, matrixRowStride_};
        for (uint32_t first = 0; first < rows_; first += kRowRepeatChunk) {
            const uint8_t repeats = static_cast<uint8_t>(RowRepeats(first));
            const uint32_t offset = first * pitch_;
            Sub(matrix[offset], matrix[offset], scratch_[first * 8],
                uint64_t(kVectorFloats), repeats, subtractMax);
            Sub(matrix[offset + kVectorFloats], matrix[offset + kVectorFloats],
                scratch_[first * 8], uint64_t(h_ - kVectorFloats), repeats, subtractMax);
        }
        VectorDone();
        for (uint32_t first = 0; first < rows_; first += kRowRepeatChunk) {
            const uint8_t repeats = static_cast<uint8_t>(RowRepeats(first));
            const uint32_t offset = first * pitch_;
            Exp(matrix[offset], matrix[offset], uint64_t(kVectorFloats), repeats, elementwise);
            Exp(matrix[offset + kVectorFloats], matrix[offset + kVectorFloats],
                uint64_t(h_ - kVectorFloats), repeats, elementwise);
        }
        VectorDone();
        ReduceRows(matrix);
        Broadcast(sum_);
        ApplyRows<true>(matrix);
        for (uint32_t first = 0; first < rows_; first += kRowRepeatChunk) {
            const uint8_t repeats = static_cast<uint8_t>(RowRepeats(first));
            const uint32_t offset = first * pitch_;
            Adds(matrix[offset], matrix[offset], eps_, uint64_t(kVectorFloats), repeats, elementwise);
            Adds(matrix[offset + kVectorFloats], matrix[offset + kVectorFloats], eps_,
                uint64_t(h_ - kVectorFloats), repeats, elementwise);
        }
        VectorDone();
    }

    TPipe* pipe_;
    TQue<QuePosition::VECIN, 1> matrixQueue_, gatesQueue_;
    TBuf<TPosition::VECCALC> ubBankPadBeforeScratch_, factorsBuf_, scratchBuf_;
    GlobalTensor<float> x_, pre_, post_, comb_;
    LocalTensor<float> factors_, scratch_, ones_, rowScale_, sum_, tailSum_;
    uint64_t first_, end_;
    uint32_t h_, pitch_, q_, w_, iters_, statsSize_, gateSize_, rows_, columnElements_;
    uint8_t matrixRowStride_, columnRowStride_;
    float eps_;
};

// B4 keeps the B1 input half swap and entire allocation geometry.
// Root halves are contiguous: first all row roots of columns0..63, then
// all row roots of columns64..127. RootB keeps B1's existing +64*192 offset.
// D1 appends an independent next-token gate bank (2*P floats, 1 KiB) and
// its sigmoid numerator/denominator scratch (4*P floats, 2 KiB) after the
// existing half-swap factors panel. The original matrix/gates/pad/product/
// factors starts are unchanged, so every bank-phase assumption still holds.
// Host admission uses this total; any shortfall keeps the original entry.
constexpr uint32_t kH128HalfSwapArenaBytes = 0x26A00U + 0xC00U;
constexpr uint32_t kH128HalfSwapRootPitch = 192U;

template <uint32_t ActiveRows>
__aicore__ inline void ReduceH128HalfMajorAdjacentRoots(
    const LocalTensor<float>& source, const LocalTensor<float>& writePanel,
    const LocalTensor<float>& otherPanel, const LocalTensor<float>& dst)
{
    static_assert(ActiveRows >= 2 && (ActiveRows & (ActiveRows - 1)) == 0,
        "H128 half-major roots require a power of two");
    constexpr uint8_t repeats = static_cast<uint8_t>(ActiveRows);
    const BinaryRepeatParams steps{1, 1, 1, 8, 16, 16};
    if constexpr (ActiveRows == 2) {
        Add(dst, source, source[kVectorFloats],
            uint64_t(kVectorFloats), repeats, steps);
        VectorDone();
    } else {
        Add(writePanel, source, source[kVectorFloats],
            uint64_t(kVectorFloats), repeats, steps);
        VectorDone();
        ReduceH128HalfMajorAdjacentRoots<ActiveRows / 2>(
            writePanel, otherPanel, writePanel, dst);
    }
}

// H128 panel-slot route. One static token slot contains the complete 128x64
// left and right comb panels. The production layout uses two segmented GM
// descriptors; the control macro keeps the same panels and arithmetic but
// copies one row at a time to isolate the transfer mechanism.
constexpr uint32_t kH128SlotRows = 128U;
constexpr uint32_t kH128SlotColumns = 64U;
constexpr uint32_t kH128SlotHalfFloats = kH128SlotRows * kH128SlotColumns;
constexpr uint32_t kH128SlotRootFloats =
    kH128SlotRows * (kH128SlotColumns / kBlockFloats);
constexpr uint32_t kH128PanelSlotArenaBytes =
    sizeof(float) * (2U * kH128SlotHalfFloats + 2U * kH128SlotRows +
        kH128SlotHalfFloats + kH128SlotRootFloats + 2U * kH128SlotRows +
        4U * kH128SlotRows) +
    kResidentScaledKernelUbBankPaddingBytes;

class H128PanelSlotKernel {
public:
    __aicore__ inline void Init(GM_ADDR mixes, GM_ADDR pre, GM_ADDR post,
        GM_ADDR comb, uint64_t n, uint32_t h, uint32_t iters, float eps,
        uint32_t tokenGroup, TPipe* pipe)
    {
        uint64_t first = 0;
        uint64_t end = 0;
        TokenRange(n, tokenGroup, first, end);
        InitRange(mixes, pre, post, comb, first, end, h, iters, eps, pipe);
    }

    // B-compatible owner-range entry. B may assign one or more complete H128
    // tokens; gates, runtime iters and eps stay local to the slot core.
    __aicore__ inline void InitRange(GM_ADDR mixes, GM_ADDR pre, GM_ADDR post,
        GM_ADDR comb, uint64_t first, uint64_t end, uint32_t h, uint32_t iters,
        float eps, TPipe* pipe)
    {
        pipe_ = pipe;
        h_ = h;
        iters_ = iters;
        eps_ = eps;
        first_ = first;
        end_ = end;
        w_ = h_ * h_ + 2U * h_;
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(mixes));
        pre_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(pre));
        post_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(post));
        comb_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(comb));
        pipe_->InitBuffer(matrixQueue_, 1,
            2U * kH128SlotHalfFloats * sizeof(float));
        pipe_->InitBuffer(gatesQueue_, 1, 2U * kH128SlotRows * sizeof(float));
        pipe_->InitBuffer(ubBankPadBeforeScratch_,
            kResidentScaledKernelUbBankPaddingBytes);
        pipe_->InitBuffer(workBuf_, kH128SlotHalfFloats * sizeof(float));
        pipe_->InitBuffer(rootBuf_, kH128SlotRootFloats * sizeof(float));
        pipe_->InitBuffer(statsBuf_, 2U * kH128SlotRows * sizeof(float));
        pipe_->InitBuffer(gateScratchBuf_, 4U * kH128SlotRows * sizeof(float));
        work_ = workBuf_.Get<float>();
        roots_ = rootBuf_.Get<float>();
        stats_ = statsBuf_.Get<float>();
        rowStat_ = stats_;
        colStat_ = stats_[kH128SlotRows];
        gateScratch_ = gateScratchBuf_.Get<float>();
    }

    __aicore__ inline void Process()
    {
        for (uint64_t token = first_; token < end_; ++token) {
            auto matrix = matrixQueue_.AllocTensor<float>();
            auto gates = gatesQueue_.AllocTensor<float>();
            left_ = matrix;
            right_ = matrix[kH128SlotHalfFloats];
            gates_ = gates;
            LoadToken(token);
            matrixQueue_.EnQue(matrix);
            gatesQueue_.EnQue(gates);
            matrix = matrixQueue_.DeQue<float>();
            gates = gatesQueue_.DeQue<float>();
            left_ = matrix;
            right_ = matrix[kH128SlotHalfFloats];
            gates_ = gates;

            SigmoidInPlace(gates_, gateScratch_,
                gateScratch_[2U * kH128SlotRows], 2U * kH128SlotRows);
            Adds(gates_, gates_, eps_, kH128SlotRows);
            Muls(gates_[kH128SlotRows], gates_[kH128SlotRows], 2.0f,
                kH128SlotRows);
            VectorDone();

            RowSoftmax();
            NormalizeColumnsInPlace();
            for (uint32_t iter = 1; iter < iters_; ++iter) {
                NormalizeRowsInPlace();
                NormalizeColumnsInPlace();
            }

            SyncPipelines<HardEvent::V_MTE3>(*pipe_);
            StoreToken(token);
            SyncPipelines<HardEvent::MTE3_V>(*pipe_);
            matrixQueue_.FreeTensor(matrix);
            gatesQueue_.FreeTensor(gates);
        }
    }

private:
    static constexpr bool kSegmented =
        SINKHORN_NORM_H128_SEGMENTED_DESCRIPTORS != 0;
    static constexpr bool kStoreGates =
        SINKHORN_NORM_H128_STORE_GATES != 0;

    __aicore__ inline void LoadToken(uint64_t token)
    {
        const uint64_t inputBase = token * w_;
        LoadExact(gates_, x_[inputBase], kH128SlotRows);
        LoadExact(gates_[kH128SlotRows], x_[inputBase + kH128SlotRows],
            kH128SlotRows);
        const uint64_t combBase = inputBase + 2U * kH128SlotRows;
        if constexpr (kSegmented) {
            // Two row-stride descriptors turn GM left/right halves into dense
            // local panels. Every row is 256 bytes; the skipped half is 256B.
            const DataCopyExtParams segments{
                static_cast<uint16_t>(kH128SlotRows),
                static_cast<uint32_t>(kH128SlotColumns * sizeof(float)),
                static_cast<uint32_t>(kH128SlotColumns * sizeof(float)), 0U, 0U};
            const DataCopyPadExtParams<float> noPadding{false, 0U, 0U, 0.0f};
            DataCopyPad(left_, x_[combBase], segments, noPadding);
            DataCopyPad(right_, x_[combBase + kH128SlotColumns],
                segments, noPadding);
        } else {
            // Control: identical dense panels and arithmetic, row-wise copies.
            for (uint32_t row = 0; row < kH128SlotRows; ++row) {
                const uint64_t rowBase = combBase + row * kH128SlotRows;
                LoadExact(left_[row * kH128SlotColumns], x_[rowBase],
                    kH128SlotColumns);
                LoadExact(right_[row * kH128SlotColumns],
                    x_[rowBase + kH128SlotColumns], kH128SlotColumns);
            }
        }
    }

    __aicore__ inline void StoreToken(uint64_t token)
    {
        if constexpr (kStoreGates) {
            StoreExact(pre_[token * kH128SlotRows], gates_, kH128SlotRows);
            StoreExact(post_[token * kH128SlotRows], gates_[kH128SlotRows],
                kH128SlotRows);
        }
        const uint64_t combBase = token * h_ * h_;
        if constexpr (kSegmented) {
            const DataCopyExtParams segments{
                static_cast<uint16_t>(kH128SlotRows),
                static_cast<uint32_t>(kH128SlotColumns * sizeof(float)), 0U,
                static_cast<uint32_t>(kH128SlotColumns * sizeof(float)), 0U};
            DataCopyPad(comb_[combBase], left_, segments);
            DataCopyPad(comb_[combBase + kH128SlotColumns], right_, segments);
        } else {
            for (uint32_t row = 0; row < kH128SlotRows; ++row) {
                const uint64_t rowBase = combBase + row * kH128SlotRows;
                StoreExact(comb_[rowBase], left_[row * kH128SlotColumns],
                    kH128SlotColumns);
                StoreExact(comb_[rowBase + kH128SlotColumns],
                    right_[row * kH128SlotColumns], kH128SlotColumns);
            }
        }
    }

    __aicore__ inline void ReduceRowsInPlace(bool addEps)
    {
        // The two halves are added lane-wise, then two BR levels produce one
        // scalar for each complete 128-column row.
        Add(work_, left_, right_, kH128SlotHalfFloats);
        VectorDone();
        BlockReduceSum(roots_, work_, static_cast<int32_t>(kH128SlotRows),
            static_cast<int32_t>(kH128SlotColumns), 1, 1, 8);
        VectorDone();
        BlockReduceSum(rowStat_, roots_,
            static_cast<int32_t>(kH128SlotRows / kBlockFloats),
            static_cast<int32_t>(kH128SlotColumns), 1, 1, 8);
        VectorDone();
        if (addEps) {
            Adds(rowStat_, rowStat_, eps_, kH128SlotRows);
            VectorDone();
        }
        Brcb(work_, rowStat_,
            static_cast<uint8_t>(kH128SlotRows / kBlockFloats), {1, 8});
        VectorDone();
        const BinaryRepeatParams rows{1, 1, 0,
            kH128SlotColumns / kBlockFloats,
            kH128SlotColumns / kBlockFloats, 1};
        Div(left_, left_, work_, uint64_t(kH128SlotColumns),
            static_cast<uint8_t>(kH128SlotRows), rows);
        Div(right_, right_, work_, uint64_t(kH128SlotColumns),
            static_cast<uint8_t>(kH128SlotRows), rows);
        VectorDone();
    }

    __aicore__ inline void RowSoftmax()
    {
        Max(work_, left_, right_, kH128SlotHalfFloats);
        VectorDone();
        BlockReduceMax(roots_, work_, static_cast<int32_t>(kH128SlotRows),
            static_cast<int32_t>(kH128SlotColumns), 1, 1, 8);
        VectorDone();
        BlockReduceMax(rowStat_, roots_,
            static_cast<int32_t>(kH128SlotRows / kBlockFloats),
            static_cast<int32_t>(kH128SlotColumns), 1, 1, 8);
        VectorDone();
        Brcb(work_, rowStat_,
            static_cast<uint8_t>(kH128SlotRows / kBlockFloats), {1, 8});
        VectorDone();
        const BinaryRepeatParams rows{1, 1, 0,
            kH128SlotColumns / kBlockFloats,
            kH128SlotColumns / kBlockFloats, 1};
        Sub(left_, left_, work_, uint64_t(kH128SlotColumns),
            static_cast<uint8_t>(kH128SlotRows), rows);
        Sub(right_, right_, work_, uint64_t(kH128SlotColumns),
            static_cast<uint8_t>(kH128SlotRows), rows);
        VectorDone();
        Exp(left_, left_, kH128SlotHalfFloats);
        Exp(right_, right_, kH128SlotHalfFloats);
        VectorDone();
        ReduceRowsInPlace(false);
        Adds(left_, left_, eps_, kH128SlotHalfFloats);
        Adds(right_, right_, eps_, kH128SlotHalfFloats);
        VectorDone();
    }

    __aicore__ inline void NormalizeRowsInPlace()
    {
        ReduceRowsInPlace(true);
    }

    __aicore__ inline void NormalizeColumnsInPlace()
    {
        // Separate balanced FP32 trees cover all 128 rows in each half.
        ReduceColumnsBinaryTreeStage<kH128SlotRows, kH128SlotColumns>(
            left_, work_, colStat_);
        ReduceColumnsBinaryTreeStage<kH128SlotRows, kH128SlotColumns>(
            right_, work_, colStat_[kH128SlotColumns]);
        Adds(colStat_, colStat_, eps_, 2U * kH128SlotColumns);
        VectorDone();
        const BinaryRepeatParams columns{1, 1, 1,
            kH128SlotColumns / kBlockFloats,
            kH128SlotColumns / kBlockFloats, 0};
        Div(left_, left_, colStat_, uint64_t(kH128SlotColumns),
            static_cast<uint8_t>(kH128SlotRows), columns);
        Div(right_, right_, colStat_[kH128SlotColumns],
            uint64_t(kH128SlotColumns), static_cast<uint8_t>(kH128SlotRows),
            columns);
        VectorDone();
    }

    TPipe* pipe_;
    TQue<QuePosition::VECIN, 1> matrixQueue_, gatesQueue_;
    TBuf<TPosition::VECCALC> ubBankPadBeforeScratch_, workBuf_, rootBuf_,
        statsBuf_, gateScratchBuf_;
    GlobalTensor<float> x_, pre_, post_, comb_;
    LocalTensor<float> left_, right_, gates_, work_, roots_, stats_,
        rowStat_, colStat_, gateScratch_;
    uint64_t first_, end_;
    uint32_t h_, w_, iters_;
    float eps_;
};

// F128 keeps A1's 128x64 left/right geometry and adds B-style reciprocal
// vectors. F1 owns two complete matrix/gate slots and prefetches the next
// token while the current vector program runs. F0 compiles one slot and
// retains the same arithmetic without prefetch, making it the paired control.
constexpr uint32_t kF128MatrixSlotFloats = 2U * kH128SlotHalfFloats;
constexpr uint32_t kF128GateSlotFloats = 2U * kH128SlotRows;
constexpr uint32_t kF128SlotCount =
    SINKHORN_NORM_F128_TWO_SLOT_PREFETCH != 0 ? 2U : 1U;
constexpr uint32_t kF128ScratchBytes =
    kResidentScaledKernelUbBankPaddingBytes +
    sizeof(float) * (10240U + 3U * kH128SlotRows);
constexpr uint32_t kF128PanelArenaBytes =
    sizeof(float) * kF128SlotCount *
        (kF128MatrixSlotFloats + kF128GateSlotFloats) +
    kF128ScratchBytes;
static_assert(kF128PanelArenaBytes <= 179968U,
    "F128 arena exceeds the requested 179968-byte ceiling");
static_assert(kH128SlotRows == 128U && kH128SlotColumns == 64U,
    "F128 panel geometry is fixed to two 128x64 halves");

class F128PanelSlotKernel {
public:
    __aicore__ inline void Init(GM_ADDR mixes, GM_ADDR pre, GM_ADDR post,
        GM_ADDR comb, uint64_t n, uint32_t h, uint32_t iters, float eps,
        uint32_t tokenGroup, TPipe* pipe)
    {
        uint64_t first = 0;
        uint64_t end = 0;
        TokenRange(n, tokenGroup, first, end);
        InitRange(mixes, pre, post, comb, first, end, h, iters, eps, pipe);
    }

    __aicore__ inline void InitRange(GM_ADDR mixes, GM_ADDR pre, GM_ADDR post,
        GM_ADDR comb, uint64_t first, uint64_t end, uint32_t h, uint32_t iters,
        float eps, TPipe* pipe)
    {
        pipe_ = pipe;
        h_ = h;
        iters_ = iters;
        eps_ = eps;
        first_ = first;
        end_ = end;
        w_ = h_ * h_ + 2U * h_;
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(mixes));
        pre_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(pre));
        post_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(post));
        comb_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(comb));
        if constexpr (SINKHORN_NORM_H128_OUTPUT_L2_BYPASS != 0) {
            pre_.SetL2CacheHint<CacheRwMode::WRITE>(
                CacheMode::CACHE_MODE_DISABLE);
            post_.SetL2CacheHint<CacheRwMode::WRITE>(
                CacheMode::CACHE_MODE_DISABLE);
            comb_.SetL2CacheHint<CacheRwMode::WRITE>(
                CacheMode::CACHE_MODE_DISABLE);
        }
        pipe_->InitBuffer(matrixSlotsBuf_,
            kF128SlotCount * kF128MatrixSlotFloats * sizeof(float));
        pipe_->InitBuffer(gateSlotsBuf_,
            kF128SlotCount * kF128GateSlotFloats * sizeof(float));
        pipe_->InitBuffer(ubBankPadBeforeScratch_,
            kResidentScaledKernelUbBankPaddingBytes);
        pipe_->InitBuffer(workBuf_, 10240U * sizeof(float));
        pipe_->InitBuffer(statsBuf_, kH128SlotRows * sizeof(float));
        pipe_->InitBuffer(onesBuf_, kH128SlotRows * sizeof(float));
        pipe_->InitBuffer(invBuf_, kH128SlotRows * sizeof(float));
        matrixSlots_ = matrixSlotsBuf_.Get<float>();
        gateSlots_ = gateSlotsBuf_.Get<float>();
        work_ = workBuf_.Get<float>();
        roots_ = work_[2048];
        rowStat_ = statsBuf_.Get<float>();
        gateScratch_ = work_;
        ones_ = onesBuf_.Get<float>();
        inv_ = invBuf_.Get<float>();
        Duplicate(ones_, 1.0f, kH128SlotRows);
        VectorDone();
    }

    __aicore__ inline void Process()
    {
        if constexpr (SINKHORN_NORM_F128_TWO_SLOT_PREFETCH != 0) {
            ProcessPrefetched();
        } else {
            ProcessControl();
        }
    }

private:
    __aicore__ inline LocalTensor<float> MatrixSlot(uint32_t slot)
    {
        return matrixSlots_[slot * kF128MatrixSlotFloats];
    }

    __aicore__ inline LocalTensor<float> GateSlot(uint32_t slot)
    {
        return gateSlots_[slot * kF128GateSlotFloats];
    }

    __aicore__ inline void LoadSlot(uint32_t slot, uint64_t token)
    {
        auto gates = GateSlot(slot);
        auto matrix = MatrixSlot(slot);
        auto left = matrix;
        auto right = matrix[kH128SlotHalfFloats];
        const uint64_t inputBase = token * w_;
        LoadExact(gates, x_[inputBase], kH128SlotRows);
        LoadExact(gates[kH128SlotRows], x_[inputBase + kH128SlotRows],
            kH128SlotRows);
        const uint64_t combBase = inputBase + 2U * kH128SlotRows;
        const DataCopyExtParams segments{
            static_cast<uint16_t>(kH128SlotRows),
            static_cast<uint32_t>(kH128SlotColumns * sizeof(float)),
            static_cast<uint32_t>(kH128SlotColumns * sizeof(float)), 0U, 0U};
        const DataCopyPadExtParams<float> noPadding{false, 0U, 0U, 0.0f};
        // Both matrix and gate descriptors are launched together. F1 overlaps
        // this complete next-token MTE2 with the current token's vector work.
        DataCopyPad(left, x_[combBase], segments, noPadding);
        DataCopyPad(right, x_[combBase + kH128SlotColumns], segments, noPadding);
    }

    __aicore__ inline void AcquireSlotEvents()
    {
        static_assert(kF128SlotCount == 1U || kF128SlotCount == 2U,
            "early next-token overlap requires two persistent slots");
        for (uint32_t slot = 0; slot < kF128SlotCount; ++slot) {
            readyEvents_[slot] = static_cast<int32_t>(
                pipe_->AllocEventID<HardEvent::MTE2_V>());
            vectorConsumedEvents_[slot] = static_cast<int32_t>(
                pipe_->AllocEventID<HardEvent::V_MTE2>());
            outputCompleteEvents_[slot] = static_cast<int32_t>(
                pipe_->AllocEventID<HardEvent::MTE3_MTE2>());
        }
    }

    __aicore__ inline void ReleaseSlotEvents()
    {
        for (uint32_t slot = 0; slot < kF128SlotCount; ++slot) {
            pipe_->ReleaseEventID<HardEvent::MTE2_V>(
                static_cast<TEventID>(readyEvents_[slot]));
            pipe_->ReleaseEventID<HardEvent::V_MTE2>(
                static_cast<TEventID>(vectorConsumedEvents_[slot]));
            pipe_->ReleaseEventID<HardEvent::MTE3_MTE2>(
                static_cast<TEventID>(outputCompleteEvents_[slot]));
        }
    }

    __aicore__ inline void SignalLoad(uint32_t slot)
    {
        SetFlag<HardEvent::MTE2_V>(readyEvents_[slot]);
    }

    __aicore__ inline void WaitLoad(uint32_t slot)
    {
        WaitFlag<HardEvent::MTE2_V>(readyEvents_[slot]);
    }

    __aicore__ inline void SignalVectorConsumed(uint32_t slot)
    {
        SetFlag<HardEvent::V_MTE2>(vectorConsumedEvents_[slot]);
    }

    __aicore__ inline void SignalOutputComplete(uint32_t slot)
    {
        SetFlag<HardEvent::MTE3_MTE2>(outputCompleteEvents_[slot]);
    }

    __aicore__ inline void WaitSlotReusable(uint32_t slot)
    {
        WaitFlag<HardEvent::V_MTE2>(vectorConsumedEvents_[slot]);
        WaitFlag<HardEvent::MTE3_MTE2>(outputCompleteEvents_[slot]);
    }

    __aicore__ inline void StoreSlot(uint32_t slot, uint64_t token)
    {
        auto gates = GateSlot(slot);
        auto matrix = MatrixSlot(slot);
        auto left = matrix;
        auto right = matrix[kH128SlotHalfFloats];
        SyncPipelines<HardEvent::V_MTE3>(*pipe_);
        StoreExact(pre_[token * kH128SlotRows], gates, kH128SlotRows);
        StoreExact(post_[token * kH128SlotRows],
            gates[kH128SlotRows], kH128SlotRows);
        const uint64_t combBase = token * h_ * h_;
        const DataCopyExtParams segments{
            static_cast<uint16_t>(kH128SlotRows),
            static_cast<uint32_t>(kH128SlotColumns * sizeof(float)), 0U,
            static_cast<uint32_t>(kH128SlotColumns * sizeof(float)), 0U};
        DataCopyPad(comb_[combBase], left, segments);
        DataCopyPad(comb_[combBase + kH128SlotColumns], right, segments);
    }

    __aicore__ inline void ProcessPrefetched()
    {
        if (first_ >= end_) {
            return;
        }
        AcquireSlotEvents();
        uint32_t slot = 0;
        uint64_t token = first_;
        LoadSlot(slot, token);
        SignalLoad(slot);
        while (true) {
            WaitLoad(slot);
            auto gates = GateSlot(slot);
            auto matrix = MatrixSlot(slot);
            auto left = matrix;
            auto right = matrix[kH128SlotHalfFloats];

            const bool hasNext = token + 1U < end_;
            const uint32_t nextSlot = slot ^ 1U;
            if (hasNext) {
                // The opposite slot is unused for the first lookahead. Later,
                // both its previous vector reads and all of its MTE3 output
                // reads must complete before its MTE2 rewrite.
                if (token != first_) {
                    WaitSlotReusable(nextSlot);
                }
                // Launch the complete next-token gate and matrix MTE2
                // immediately before this token's vector work. The per-slot
                // MTE2_V event orders it for the next loop iteration.
                LoadSlot(nextSlot, token + 1U);
                SignalLoad(nextSlot);
            }

            // F10 arithmetic and cache policy are unchanged.
            PrepareGates(gates);
            RowSoftmax(left, right);
            NormalizeColumns(left, right);
            for (uint32_t iter = 1; iter < iters_; ++iter) {
                NormalizeRows(left, right);
                NormalizeColumns(left, right);
            }

            SignalVectorConsumed(slot);
            StoreSlot(slot, token);
            SignalOutputComplete(slot);

            if (!hasNext) {
                // Drain exactly the final slot's outstanding consume/output
                // events. Prior slots were drained immediately before reuse.
                WaitSlotReusable(slot);
                if (token != first_) WaitSlotReusable(slot ^ 1U);
                break;
            }
            token += 1U;
            slot = nextSlot;
        }
        ReleaseSlotEvents();
    }

    __aicore__ inline void ProcessControl()
    {
        for (uint64_t token = first_; token < end_; ++token) {
            auto gates = GateSlot(0);
            auto matrix = MatrixSlot(0);
            auto left = matrix;
            auto right = matrix[kH128SlotHalfFloats];
            SyncPipelines<HardEvent::V_MTE2>(*pipe_);
            LoadSlot(0, token);
            SyncPipelines<HardEvent::MTE2_V>(*pipe_);
            PrepareGates(gates);
            RowSoftmax(left, right);
            NormalizeColumns(left, right);
            for (uint32_t iter = 1; iter < iters_; ++iter) {
                NormalizeRows(left, right);
                NormalizeColumns(left, right);
            }
            StoreSlot(0, token);
            SyncPipelines<HardEvent::MTE3_V>(*pipe_);
        }
    }

    __aicore__ inline void PrepareGates(const LocalTensor<float>& gates)
    {
        SigmoidInPlace(gates, gateScratch_, gateScratch_[2U * kH128SlotRows],
            2U * kH128SlotRows);
        Adds(gates, gates, eps_, kH128SlotRows);
        Muls(gates[kH128SlotRows], gates[kH128SlotRows], 2.0f,
            kH128SlotRows);
        VectorDone();
    }

    __aicore__ inline void ReduceRows(const LocalTensor<float>& left,
        const LocalTensor<float>& right, bool addEps)
    {
        SetMaskCount();
        SetVectorMask<float, MaskMode::COUNTER>(uint64_t(0), uint64_t(16384));
        BlockReduceSum<float, false>(work_, left, 1, static_cast<int32_t>(MASK_PLACEHOLDER), 1, 1, 8);
        SetMaskNorm(); ResetMask();
        VectorDone();
        BlockReduceSum(roots_, work_, int32_t(32), int32_t(64), 1, 1, 8);
        VectorDone();
        Add(rowStat_, roots_, roots_[128], int32_t(128));
        VectorDone();
        if (addEps) {
            Adds(rowStat_, rowStat_, eps_, kH128SlotRows);
            VectorDone();
        }
        NativeInverse(rowStat_);
        Brcb(work_, inv_, static_cast<uint8_t>(kH128SlotRows / kBlockFloats),
            {1, 8});
        VectorDone();
        const BinaryRepeatParams rows{1, 1, 0,
            kH128SlotColumns / kBlockFloats,
            kH128SlotColumns / kBlockFloats, 1};
        Mul(left, left, work_, uint64_t(kH128SlotColumns),
            static_cast<uint8_t>(kH128SlotRows), rows);
        Mul(right, right, work_, uint64_t(kH128SlotColumns),
            static_cast<uint8_t>(kH128SlotRows), rows);
        VectorDone();
    }

    __aicore__ inline void NativeInverse(const LocalTensor<float>& sum)
    {
        Div(inv_, ones_, sum, static_cast<int32_t>(kH128SlotRows));
        VectorDone();
    }

    __aicore__ inline void RowSoftmax(const LocalTensor<float>& left,
        const LocalTensor<float>& right)
    {
        SetMaskCount();
        SetVectorMask<float, MaskMode::COUNTER>(uint64_t(0), uint64_t(16384));
        BlockReduceMax<float, false>(work_, left, 1, static_cast<int32_t>(MASK_PLACEHOLDER), 1, 1, 8);
        SetMaskNorm(); ResetMask();
        VectorDone();
        BlockReduceMax(roots_, work_, int32_t(32), int32_t(64), 1, 1, 8);
        VectorDone();
        Max(rowStat_, roots_, roots_[128], int32_t(128));
        VectorDone();
        Brcb(work_, rowStat_,
            static_cast<uint8_t>(kH128SlotRows / kBlockFloats), {1, 8});
        VectorDone();
        const BinaryRepeatParams rows{1, 1, 0,
            kH128SlotColumns / kBlockFloats,
            kH128SlotColumns / kBlockFloats, 1};
        Sub(left, left, work_, uint64_t(kH128SlotColumns),
            static_cast<uint8_t>(kH128SlotRows), rows);
        Sub(right, right, work_, uint64_t(kH128SlotColumns),
            static_cast<uint8_t>(kH128SlotRows), rows);
        VectorDone();
        Exp(left, left, kH128SlotHalfFloats);
        Exp(right, right, kH128SlotHalfFloats);
        VectorDone();
        ReduceRows(left, right, false);
        Adds(left, left, eps_, kH128SlotHalfFloats);
        Adds(right, right, eps_, kH128SlotHalfFloats);
        VectorDone();
    }

    __aicore__ inline void NormalizeRows(const LocalTensor<float>& left,
        const LocalTensor<float>& right)
    {
        ReduceRows(left, right, true);
    }

    __aicore__ inline void PairColumnPanelTree(
        const LocalTensor<float>& left, const LocalTensor<float>& right)
    {
        // One complete live panel pair. First fold into [0,8192).
        const BinaryRepeatParams dense{1,1,1,8,16,16};
        Add(work_, left, left[64], uint64_t(64), uint8_t(128), dense);
        VectorDone();
        // R's 4096 inputs are dead once its 2048 outputs are in [8192,10240).
        Add(work_[8192], work_[4096], work_[4160], uint64_t(64), uint8_t(32), dense);
        VectorDone();
        // The dead R tail now safely holds compact L: [6144,8192).
        Add(work_[6144], work_, work_[64], uint64_t(64), uint8_t(32), dense);
        VectorDone();
        Add(work_, work_[6144], work_[6208], uint64_t(64), uint8_t(32), dense);
        VectorDone();
        Add(work_[6144], work_, work_[64], uint64_t(64), uint8_t(16), dense);
        VectorDone();
        Add(work_, work_[6144], work_[6208], uint64_t(64), uint8_t(8), dense);
        VectorDone();
        Add(work_[6144], work_, work_[64], uint64_t(64), uint8_t(4), dense);
        VectorDone();
        Add(roots_, work_[6144], work_[6208], uint64_t(64), uint8_t(2), dense);
        VectorDone();
        Adds(roots_, roots_, eps_, 128);
        VectorDone();
        Div(inv_, ones_, roots_, 128);
        VectorDone();
        const BinaryRepeatParams columns{1, 1, 1,
            kH128SlotColumns / kBlockFloats,
            kH128SlotColumns / kBlockFloats, 0};
        Mul(left, left, inv_, uint64_t(kH128SlotColumns),
            static_cast<uint8_t>(kH128SlotRows), columns);
        Mul(right, right, inv_[kH128SlotColumns],
            uint64_t(kH128SlotColumns),
            static_cast<uint8_t>(kH128SlotRows), columns);
        VectorDone();
    }

    __aicore__ inline void NormalizeColumns(const LocalTensor<float>& left,
        const LocalTensor<float>& right)
    {
        PairColumnPanelTree(left, right);
    }

    TPipe* pipe_;
    TBuf<TPosition::VECCALC> matrixSlotsBuf_, gateSlotsBuf_,
        ubBankPadBeforeScratch_, workBuf_, rootBuf_, statsBuf_,
        gateScratchBuf_, onesBuf_, invBuf_;
    GlobalTensor<float> x_, pre_, post_, comb_;
    LocalTensor<float> matrixSlots_, gateSlots_, work_, roots_, rowStat_,
        gateScratch_, ones_, inv_;
    uint64_t first_, end_;
    uint32_t h_, w_, iters_;
    float eps_;
    int32_t readyEvents_[2] = {-1, -1};
    int32_t vectorConsumedEvents_[2] = {-1, -1};
    int32_t outputCompleteEvents_[2] = {-1, -1};
};

// v8: static VECIN matrix with end-of-token input/output overlap.
template <uint32_t CompleteVectorTiles = 0, bool UseBr8Roots = false,
    bool UseHalfSwapArena = false>
class MatrixPrefetchScaledMatrixKernel {
public:
    static_assert(CompleteVectorTiles == 2 && UseBr8Roots,
        "Matrix prefetch requires complete two-vector BR8 rows");
    __aicore__ inline void Init(GM_ADDR mixes, GM_ADDR pre, GM_ADDR post,
        GM_ADDR comb, uint64_t n, uint32_t h, uint32_t iters, float eps,
        uint32_t tokenGroup, TPipe* pipe)
    {
        pipe_ = pipe;
        h_ = CompleteVectorTiles == 0 ? h : CompleteVectorTiles * kVectorFloats;
        pitch_ = CompleteVectorTiles == 0 ? (h + 7) / 8 * 8 : CompleteVectorTiles * kVectorFloats;
        w_ = h_ * h_ + 2 * h_;
        iters_ = iters;
        eps_ = eps;
        TokenRange(n, tokenGroup, first_, end_);
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(mixes));
        pre_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(pre));
        post_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(post));
        comb_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(comb));
        pipe_->InitBuffer(matrixBuf_, h_ * pitch_ * sizeof(float));
        pipe_->InitBuffer(gatesQueue_, 1, 2 * pitch_ * sizeof(float));
        gateTailReady_ = false;
        if constexpr (UseHalfSwapArena) {
            // Expected relative offsets: matrix 0, gates 0x10000,
            // pad 0x10400, product 0x14000, factors 0x26000.
            // D1 appends gateTail at 0x26A00 and its sigmoid scratch at
            // 0x26E00, preserving every earlier physical start.
            pipe_->InitBuffer(ubBankPadBeforeScratch_, 0x3C00U);
            pipe_->InitBuffer(productBuf_, 0x12000U);
            pipe_->InitBuffer(factorsBuf_, 0xA00U);
            pipe_->InitBuffer(gateTailBuf_, 2 * pitch_ * sizeof(float));
            pipe_->InitBuffer(gateTailScratchBuf_, 4 * pitch_ * sizeof(float));
            product_ = productBuf_.Get<float>();
            factors_ = factorsBuf_.Get<float>();
            gateTail_ = gateTailBuf_.Get<float>();
            sigmoidNum_ = gateTailScratchBuf_.Get<float>();
            sigmoidDen_ = sigmoidNum_[2 * pitch_];
            auto pad = ubBankPadBeforeScratch_.Get<float>();
            halfSwapReady_ = eps_ > 0.0f && HalfSwapPhysicalLayoutReady();
            gateTailReady_ = halfSwapReady_ && GateTailPhysicalLayoutReady();
            if (halfSwapReady_) {
                sum_ = pad;
                ones_ = pad[0x300U / sizeof(float)];
                oddColScale_ = pad[0x600U / sizeof(float)];
                broadcast_ = pad[0x1000U / sizeof(float)];
                rowScale_ = factors_[0x100U / sizeof(float)];
                compact_ = factors_[0x400U / sizeof(float)];
                scaledSum_ = factors_[0x800U / sizeof(float)];
                colScale_ = oddColScale_;
            } else {
                // The enlarged allocations also fit the unmodified M2 dense
                // path, including its 12-KiB row scratch. No remapping then.
                broadcast_ = pad;
                ones_ = factors_;
                rowScale_ = factors_[pitch_];
                colScale_ = factors_[2 * pitch_];
                sum_ = factors_[3 * pitch_];
                scaledSum_ = factors_[4 * pitch_];
            }
        } else {
            pipe_->InitBuffer(ubBankPadBeforeScratch_, kResidentScaledKernelUbBankPaddingBytes);
            pipe_->InitBuffer(productBuf_, h_ * pitch_ * sizeof(float));
            pipe_->InitBuffer(factorsBuf_, 5 * pitch_ * sizeof(float));
            const uint32_t rowScratchVectors = h_ < kVectorFloats ? 1U :
                ((h_ > kVectorFloats && h_ % kVectorFloats == 0) ? 3U : 2U);
            pipe_->InitBuffer(broadcastBuf_, rowScratchVectors *
                kBlockFloats * pitch_ * sizeof(float));
            product_ = productBuf_.Get<float>();
            factors_ = factorsBuf_.Get<float>();
            broadcast_ = broadcastBuf_.Get<float>();
            ones_ = factors_;
            rowScale_ = factors_[pitch_];
            colScale_ = factors_[2 * pitch_];
            sum_ = factors_[3 * pitch_];
            scaledSum_ = factors_[4 * pitch_];
        }
        Duplicate(ones_, 1.0f, pitch_);
        Duplicate(rowScale_, 1.0f, pitch_);
        VectorDone();
    }

    __aicore__ inline void Process()
    {
        if constexpr (UseHalfSwapArena) {
            if (halfSwapReady_) {
                ProcessImpl<true>();
            } else {
                ProcessImpl<false>();
            }
        } else {
            ProcessImpl<false>();
        }
    }

private:
    template <bool HalfSwap>
    __aicore__ inline void LoadMatrixToken(const LocalTensor<float>& matrix,
        uint64_t token)
    {
        if constexpr (UseHalfSwapArena && HalfSwap) {
            LoadHalfSwapped(matrix, x_[token * w_ + 2 * h_]);
        } else {
            DataCopyExtParams rows{static_cast<uint16_t>(h_),
                static_cast<uint32_t>(h_ * sizeof(float)), 0, 0, 0};
            DataCopyPadExtParams<float> padding{
                true, 0, static_cast<uint8_t>(pitch_ - h_), 0.0f};
            DataCopyPad(matrix, x_[token * w_ + 2 * h_], rows, padding);
        }
    }

    template <bool HalfSwap>
    __aicore__ inline void ComputeMatrixToken(const LocalTensor<float>& matrix)
    {
        RowSoftmax<HalfSwap>(matrix);
        ReduceColumns<HalfSwap>(matrix, sum_);
        Adds(sum_, sum_, eps_, h_);
        VectorDone();
        DivideVector<HalfSwap>(rowScale_, ones_, sum_);
        ScaleColumns<HalfSwap>(matrix, rowScale_, product_);

        for (uint32_t iter = 1; iter < iters_; ++iter) {
            ReduceRows<HalfSwap, true>(product_, sum_);
            Adds(sum_, sum_, eps_, h_);
            VectorDone();
            DivideVector<HalfSwap>(rowScale_, ones_, sum_);
            ScaleRows(product_, rowScale_, matrix);

            ReduceColumns<HalfSwap>(matrix, sum_);
            Adds(sum_, sum_, eps_, h_);
            VectorDone();
            DivideVector<HalfSwap>(rowScale_, ones_, sum_);
            ScaleColumns<HalfSwap>(matrix, rowScale_, product_);
        }
    }

    template <bool HalfSwap>
    __aicore__ inline void StoreOutputToken(uint64_t token,
        const LocalTensor<float>& gates)
    {
        StoreExact(pre_[token * h_], gates, h_);
        StoreExact(post_[token * h_], gates[pitch_], h_);
        if constexpr (UseHalfSwapArena) {
            if constexpr (HalfSwap) {
                StoreHalfSwapped(comb_[token * h_ * h_], product_);
            } else {
                DataCopyExtParams rows{static_cast<uint16_t>(h_),
                    static_cast<uint32_t>(h_ * sizeof(float)), 0, 0, 0};
                DataCopyPad(comb_[token * h_ * h_], product_, rows);
            }
        } else {
            DataCopyExtParams rows{static_cast<uint16_t>(h_),
                static_cast<uint32_t>(h_ * sizeof(float)), 0, 0, 0};
            DataCopyPad(comb_[token * h_ * h_], product_, rows);
        }
    }

    // Bank 0 is the original VECIN queue slot. Bank 1 is the appended
    // gateTail TBuf. tailScratch selects the overlap path: its sigmoid uses
    // only the appended numerator/denominator, never the product_ panel that
    // the current token's comb MTE3 is still reading.
    __aicore__ inline LocalTensor<float> PrepareGateToken(uint32_t bank,
        uint64_t token, bool tailScratch)
    {
        LocalTensor<float> gates;
        if (tailScratch) {
            // The selected bank was last consumed by an older token. Order
            // that bank's previous vector use before its MTE2 rewrite; the
            // previous MTE3 output read is ordered by the caller's
            // MTE3_MTE2 wait from two tokens earlier.
            SyncPipelines<HardEvent::V_MTE2>(*pipe_);
        }
        if (bank == 0) {
            gates = gatesQueue_.AllocTensor<float>();
            LoadExact(gates, x_[token * w_], h_);
            LoadExact(gates[pitch_], x_[token * w_ + h_], h_);
            gatesQueue_.EnQue(gates);
            // SDK VECIN queue MTE2_V covers all earlier matrix and gate DMA.
            gates = gatesQueue_.DeQue<float>();
        } else {
            gates = gateTail_;
            LoadExact(gates, x_[token * w_], h_);
            LoadExact(gates[pitch_], x_[token * w_ + h_], h_);
            SyncPipelines<HardEvent::MTE2_V>(*pipe_);
        }
        if (tailScratch) {
            SigmoidInPlace(gates, sigmoidNum_, sigmoidDen_, 2 * pitch_);
        } else {
            SigmoidInPlace(gates, broadcast_, product_, 2 * pitch_);
        }
        Adds(gates, gates, eps_, h_);
        Muls(gates[pitch_], gates[pitch_], 2.0f, h_);
        VectorDone();
        return gates;
    }

    template <bool HalfSwap>
    __aicore__ inline void ProcessImpl()
    {
        if (first_ >= end_) {
            return;
        }
        auto matrix = matrixBuf_.Get<float>();
        // Prime only the first owned token. The later gates MTE2_V is ready.
        LoadMatrixToken<HalfSwap>(matrix, first_);

        const bool gateOverlap = HalfSwap && gateTailReady_;
        LocalTensor<float> gates;
        if (gateOverlap) {
            // First token has no predecessor to overlap with. Prepare it in
            // the queue bank with the same independent sigmoid scratch.
            gates = PrepareGateToken(0, first_, true);
        }

        for (uint64_t token = first_; token < end_; ++token) {
            if (!gateOverlap) {
                gates = PrepareGateToken(0, token, false);
            }

            ComputeMatrixToken<HalfSwap>(matrix);

            if (token + 1 < end_) {
                // Last ScaleColumns consumed matrix and wrote product_.
                // Recycle matrix only after all prior V accesses have finished.
                SyncPipelines<HardEvent::V_MTE2>(*pipe_);
                LoadMatrixToken<HalfSwap>(matrix, token + 1);
            }

            SyncPipelines<HardEvent::V_MTE3>(*pipe_);
            StoreOutputToken<HalfSwap>(token, gates);

            if (gateOverlap) {
                const uint32_t bank =
                    static_cast<uint32_t>((token - first_) & 1U);
                if (token + 1 < end_) {
                    // Current comb MTE3 is in flight. Fill the opposite gate
                    // bank and run its sigmoid/pre/post on independent
                    // scratch before waiting for MTE3_V to reuse product_.
                    LocalTensor<float> nextGates =
                        PrepareGateToken(bank ^ 1U, token + 1, true);
                    SyncPipelines<HardEvent::MTE3_V>(*pipe_);
                    if (bank == 0) {
                        gatesQueue_.FreeTensor(gates);
                    }
                    // Make the current bank's output reads visible to the
                    // MTE2 preload that will reuse it two tokens later.
                    SyncPipelines<HardEvent::MTE3_MTE2>(*pipe_);
                    gates = nextGates;
                } else {
                    SyncPipelines<HardEvent::MTE3_V>(*pipe_);
                    if (bank == 0) {
                        gatesQueue_.FreeTensor(gates);
                    }
                }
            } else {
                SyncPipelines<HardEvent::MTE3_V>(*pipe_);
                gatesQueue_.FreeTensor(gates);
            }
        }
    }

    __aicore__ inline bool HalfSwapPhysicalLayoutReady()
    {
#if defined(ASCENDC_CPU_DEBUG) && ASCENDC_CPU_DEBUG == 1
        return false;
#else
        const uint64_t matrixAddress = matrixBuf_.Get<float>().GetPhyAddr();
        const uint64_t padAddress = ubBankPadBeforeScratch_.Get<float>().GetPhyAddr();
        const uint64_t productAddress = product_.GetPhyAddr();
        const uint64_t factorsAddress = factors_.GetPhyAddr();
        // Exact relative geometry implies all span separation, phases and
        // root-panel bank bands used below. No physical result is assumed.
        return (matrixAddress & 0xFFFFU) == 0 &&
            padAddress == matrixAddress + 0x10400U &&
            productAddress == matrixAddress + 0x14000U &&
            factorsAddress == matrixAddress + 0x26000U;
#endif
    }

    __aicore__ inline bool GateTailPhysicalLayoutReady()
    {
#if defined(ASCENDC_CPU_DEBUG) && ASCENDC_CPU_DEBUG == 1
        return false;
#else
        const uint64_t factorsAddress = factors_.GetPhyAddr();
        const uint64_t gateTailAddress = gateTail_.GetPhyAddr();
        const uint64_t sigmoidAddress = sigmoidNum_.GetPhyAddr();
        // The two appended panels must start exactly where the unchanged
        // factors panel ends. This proves both are disjoint from product_,
        // from the queue gate bank, and from each other. Shape is rechecked
        // so a non-H128 instantiation can never enter the overlap path.
        return h_ == 2 * kVectorFloats && pitch_ == h_ &&
            gateTailAddress == factorsAddress + 0xA00U &&
            sigmoidAddress == gateTailAddress + 2U * pitch_ * sizeof(float) &&
            (sigmoidAddress & 0x1FU) == 0;
#endif
    }

    __aicore__ inline void LoadHalfSwapped(const LocalTensor<float>& dst,
        const GlobalTensor<float>& src)
    {
        // Ext DMA: GM stride is bytes; UB stride is 32-byte blocks.
        const DataCopyExtParams evenRows{64, 512, 512, 16, 0};
        const DataCopyExtParams oddHalves{64, 256, 768, 24, 0};
        const DataCopyPadExtParams<float> noPadding{false, 0, 0, 0.0f};
        DataCopyPad(dst, src, evenRows, noPadding);
        DataCopyPad(dst[192], src[128], oddHalves, noPadding);
        DataCopyPad(dst[128], src[192], oddHalves, noPadding);
    }

    __aicore__ inline void StoreHalfSwapped(const GlobalTensor<float>& dst,
        const LocalTensor<float>& src)
    {
        // Inverse permutation: UB stride blocks, GM stride bytes.
        const DataCopyExtParams evenRows{64, 512, 16, 512, 0};
        const DataCopyExtParams oddHalves{64, 256, 24, 768, 0};
        DataCopyPad(dst, src, evenRows);
        DataCopyPad(dst[128], src[192], oddHalves);
        DataCopyPad(dst[192], src[128], oddHalves);
    }

    __aicore__ inline void ReduceHalfSwappedColumns(
        const LocalTensor<float>& source, const LocalTensor<float>& dst)
    {
        // Undo the odd input-row half exchange while writing root halves
        // contiguously. Each half contains64 complete64-lane row roots.
        const BinaryRepeatParams first{1, 1, 1, 8, 32, 32};
        Add(product_, source, source[192], uint64_t(kVectorFloats), 64, first);
        Add(product_[64U * kVectorFloats], source[kVectorFloats], source[128],
            uint64_t(kVectorFloats), 64, first);
        VectorDone();
        ReduceH128HalfMajorAdjacentRoots<64>(product_,
            product_[64U * kH128HalfSwapRootPitch], product_, dst);
    }

    __aicore__ inline void Broadcast(const LocalTensor<float>& source)
    {
        Brcb(broadcast_, source, static_cast<uint8_t>(pitch_ / kBlockFloats),
            {1, 8});
        VectorDone();
    }

    template <bool HalfSwap>
    __aicore__ inline void DivideVector(const LocalTensor<float>& dst,
        const LocalTensor<float>& numerator, const LocalTensor<float>& denominator)
    {
        if constexpr (CompleteVectorTiles == 2 && UseBr8Roots) {
            // Same native lane-wise Div for both contiguous FP32 vectors.
            Div(dst, numerator, denominator, int32_t(2 * kVectorFloats));
            VectorDone();
            return;
        }
        const uint32_t firstCount = h_ < kVectorFloats ? h_ : kVectorFloats;
        Div(dst, numerator, denominator, uint64_t(firstCount));
        if (h_ > kVectorFloats) {
            Div(dst[kVectorFloats], numerator[kVectorFloats],
                denominator[kVectorFloats], uint64_t(h_ - kVectorFloats));
        }
        VectorDone();
    }

    __aicore__ inline void CompactAdjacentPairsNoSync(const LocalTensor<float>& dst,
        const LocalTensor<float>& source, uint32_t elements)
    {
        const uint32_t fullRepeats = elements / kVectorFloats;
        if (fullRepeats != 0) {
            // PairReduceSum dstRepStride units are 128 bytes.
            PairReduceSum(dst, source, static_cast<int32_t>(fullRepeats),
                static_cast<int32_t>(kVectorFloats), 1, 1, 8);
        }
        const uint32_t tail = elements % kVectorFloats;
        if (tail != 0) {
            PairReduceSum(dst[fullRepeats * (kVectorFloats / 2)],
                source[fullRepeats * kVectorFloats], 1,
                static_cast<int32_t>(tail), 1, 1, 8);
        }
    }

    template <bool HalfSwap, bool SourceIsProduct = false>
    __aicore__ inline void ReduceRows(const LocalTensor<float>& source,
        const LocalTensor<float>& dst)
    {
        // Complete FP32 vector tiles decompose both independent halves.
        // Non-full widths decompose only their first complete 64-float tile.
        if (!HalfSwap && h_ % kVectorFloats != 0) {
            if (h_ < kVectorFloats) {
                WholeReduceSum(dst, source, static_cast<int32_t>(h_),
                    static_cast<int32_t>(h_), 1, 1,
                    static_cast<int32_t>(pitch_ / kBlockFloats));
                VectorDone();
                return;
            }
            // For a non-full width, decompose only the first complete
            // 64-float tile. Keep the original masked tail tree unchanged.
            BlockReduceSum(broadcast_, source, static_cast<int32_t>(h_),
                static_cast<int32_t>(kVectorFloats), 1, 1,
                static_cast<int32_t>(pitch_ / kBlockFloats));
            WholeReduceSum(scaledSum_, source[kVectorFloats],
                static_cast<int32_t>(h_ - kVectorFloats),
                static_cast<int32_t>(h_), 1, 1,
                static_cast<int32_t>(pitch_ / kBlockFloats));
            VectorDone();
            auto pairScratch = broadcast_[8 * pitch_];
            CompactAdjacentPairsNoSync(pairScratch, broadcast_, h_ * 8);
            VectorDone();
            CompactAdjacentPairsNoSync(broadcast_, pairScratch, h_ * 4);
            VectorDone();
            CompactAdjacentPairsNoSync(dst, broadcast_, h_ * 2);
            VectorDone();
            Add(dst, dst, scaledSum_, h_);
            VectorDone();
            return;
        }
        // Complete rows contain one or two contiguous FP32 vector tiles.
        // Pack roots in row/half order so each Pair layer can cover both
        // independent halves in one contiguous instruction sequence.
        const uint32_t rootsCount = h_ * h_ / kBlockFloats;
        auto roots = broadcast_;
        auto compact = broadcast_[rootsCount];
        if constexpr (UseHalfSwapArena) {
            if constexpr (HalfSwap) {
                // The opposing matrix is dead at both call sites. The next
                // ScaleRows/ScaleColumns fully writes it before any read.
                if constexpr (SourceIsProduct) {
                    roots = matrixBuf_.Get<float>();
                } else {
                    roots = product_;
                }
                compact = compact_;
            }
        }
        SetMaskCount();
        SetVectorMask<float, MaskMode::COUNTER>(uint64_t(0), uint64_t(h_ * h_));
        BlockReduceSum<float, false>(roots, source, 1,
            static_cast<int32_t>(MASK_PLACEHOLDER), 1, 1, 8);
        SetMaskNorm();
        ResetMask();
        VectorDone();
        if constexpr (UseBr8Roots) {
            // The next three adjacent-Pair layers form one eight-leaf tree
            // inside each 32-byte root block. Issue that same tree as BR8.
            // This changes the instruction grouping, never the row/half pairing.
            SetMaskCount();
            SetVectorMask<float, MaskMode::COUNTER>(uint64_t(0), uint64_t(rootsCount));
            if (HalfSwap || h_ > kVectorFloats) {
                BlockReduceSum<float, false>(compact, roots, 1,
                    static_cast<int32_t>(MASK_PLACEHOLDER), 1, 1, 8);
            } else {
                BlockReduceSum<float, false>(dst, roots, 1,
                    static_cast<int32_t>(MASK_PLACEHOLDER), 1, 1, 8);
            }
            SetMaskNorm();
            ResetMask();
            VectorDone();
            if (HalfSwap || h_ > kVectorFloats) {
                // Keep original first64 + second64 operands and rounding point.
                CompactAdjacentPairsNoSync(dst, compact, rootsCount / kBlockFloats);
                VectorDone();
            }
        } else {
            CompactAdjacentPairsNoSync(compact, roots, rootsCount);
            VectorDone();
            CompactAdjacentPairsNoSync(roots, compact, rootsCount / 2);
            VectorDone();
            if (HalfSwap || h_ > kVectorFloats) {
                CompactAdjacentPairsNoSync(compact, roots, rootsCount / 4);
                VectorDone();
                // Adjacent values now are the same row's first64 and second64
                // roots. This is the original final first-half + second-half Add.
                CompactAdjacentPairsNoSync(dst, compact, rootsCount / 8);
            } else {
                CompactAdjacentPairsNoSync(dst, roots, rootsCount / 4);
            }
            VectorDone();
        }
    }

    template <bool HalfSwap>
    __aicore__ inline void ReduceColumns(const LocalTensor<float>& source,
        const LocalTensor<float>& dst)
    {
        if constexpr (UseHalfSwapArena && HalfSwap) {
            ReduceHalfSwappedColumns(source, dst);
            return;
        }
        if constexpr (CompleteVectorTiles != 0 &&
            (CompleteVectorTiles & (CompleteVectorTiles - 1)) == 0) {
            // Only the column addition tree changes. The unchanged Process
            // calls this after RowSoftmax/ScaleRows has finished reading
            // product_, and ScaleColumns fully rewrites product_ afterwards.
            // Preserve the original trajectory for nonpositive eps, whose
            // legal domain and denominator stability are not specified.
            if (eps_ > 0.0f) {
                if constexpr (UseHalfSwapArena) {
                    if constexpr (HalfSwap) {
                        ReduceHalfSwappedColumns(source, dst);
                        return;
                    }
                }
                ReduceColumnsBinaryTreeStage<CompleteVectorTiles * kVectorFloats,
                    CompleteVectorTiles * kVectorFloats>(source, product_, dst);
                return;
            }
        }
        Adds(dst, source, 0.0f, h_);
        VectorDone();
        const uint8_t rowStride = static_cast<uint8_t>(pitch_ / kBlockFloats);
        const uint32_t firstCount = h_ < kVectorFloats ? h_ : kVectorFloats;
        const BinaryRepeatParams accumulate{1, 1, 1, 0, rowStride, 0};
        const uint8_t remainingRows = static_cast<uint8_t>(h_ - 1);
        Add(dst, source[pitch_], dst, uint64_t(firstCount),
            remainingRows, accumulate);
        if (h_ > kVectorFloats) {
            Add(dst[kVectorFloats], source[pitch_ + kVectorFloats],
                dst[kVectorFloats], uint64_t(h_ - kVectorFloats),
                remainingRows, accumulate);
        }
        VectorDone();
    }

    template <bool HalfSwap>
    __aicore__ inline void ScaleColumns(const LocalTensor<float>& source,
        const LocalTensor<float>& scale, const LocalTensor<float>& dst)
    {
        if constexpr (UseHalfSwapArena) {
            if constexpr (HalfSwap) {
                // Preserve FP32 factors by a vector Copy. The second copy's
                // phase is chosen for the exchanged odd-row logical halves.
                Copy(oddColScale_, scale, uint64_t(kVectorFloats), 2,
                    CopyRepeatParams{1, 1, 8, 8});
                VectorDone();
                const BinaryRepeatParams parity{1, 1, 1, 32, 32, 0};
                Mul(dst, source, scale, uint64_t(kVectorFloats), 64, parity);
                Mul(dst[64], source[64], scale[64],
                    uint64_t(kVectorFloats), 64, parity);
                Mul(dst[128], source[128], oddColScale_[64],
                    uint64_t(kVectorFloats), 64, parity);
                Mul(dst[192], source[192], oddColScale_,
                    uint64_t(kVectorFloats), 64, parity);
                VectorDone();
                return;
            }
        }
        const uint8_t rowStride = static_cast<uint8_t>(pitch_ / kBlockFloats);
        const uint8_t repeats = static_cast<uint8_t>(h_);
        const uint32_t firstCount = h_ < kVectorFloats ? h_ : kVectorFloats;
        const BinaryRepeatParams steps{1, 1, 1, rowStride, rowStride, 0};
        Mul(dst, source, scale, uint64_t(firstCount), repeats, steps);
        if (h_ > kVectorFloats) {
            Mul(dst[kVectorFloats], source[kVectorFloats],
                scale[kVectorFloats], uint64_t(h_ - kVectorFloats), repeats, steps);
        }
        VectorDone();
    }

    __aicore__ inline void ScaleRows(const LocalTensor<float>& source,
        const LocalTensor<float>& scale, const LocalTensor<float>& dst)
    {
        Broadcast(scale);
        const uint8_t rowStride = static_cast<uint8_t>(pitch_ / kBlockFloats);
        const uint8_t repeats = static_cast<uint8_t>(h_);
        const uint32_t firstCount = h_ < kVectorFloats ? h_ : kVectorFloats;
        const BinaryRepeatParams steps{1, 1, 0, rowStride, rowStride, 1};
        Mul(dst, source, broadcast_, uint64_t(firstCount), repeats, steps);
        if (h_ > kVectorFloats) {
            Mul(dst[kVectorFloats], source[kVectorFloats],
                broadcast_, uint64_t(h_ - kVectorFloats), repeats, steps);
        }
        VectorDone();
    }

    __aicore__ inline void ScaleRowsInPlace(const LocalTensor<float>& matrix,
        const LocalTensor<float>& scale)
    {
        ScaleRows(matrix, scale, matrix);
    }

    template <bool HalfSwap>
    __aicore__ inline void UpdateScale(const LocalTensor<float>& scale,
        const LocalTensor<float>& unscaledSum)
    {
        Mul(scaledSum_, scale, unscaledSum, h_);
        Adds(scaledSum_, scaledSum_, eps_, h_);
        VectorDone();
        DivideVector<HalfSwap>(scale, scale, scaledSum_);
    }

    template <bool HalfSwap>
    __aicore__ inline void ReduceRowSums(const LocalTensor<float>& matrix)
    {
        ReduceRows<HalfSwap>(matrix, sum_);
    }

    template <bool HalfSwap>
    __aicore__ inline void RowSoftmax(const LocalTensor<float>& matrix)
    {
        const uint8_t rowStride = static_cast<uint8_t>(pitch_ / kBlockFloats);
        const uint8_t repeats = static_cast<uint8_t>(h_);
        const uint32_t firstCount = h_ < kVectorFloats ? h_ : kVectorFloats;
        WholeReduceMax(sum_, matrix, static_cast<int32_t>(firstCount),
            static_cast<int32_t>(h_), 1, 1, static_cast<int32_t>(rowStride),
            ReduceOrder::ORDER_ONLY_VALUE);
        if (HalfSwap || h_ > kVectorFloats) {
            WholeReduceMax(scaledSum_, matrix[kVectorFloats],
                static_cast<int32_t>(h_ - kVectorFloats),
                static_cast<int32_t>(h_), 1, 1,
                static_cast<int32_t>(rowStride),
                ReduceOrder::ORDER_ONLY_VALUE);
            VectorDone();
            Max(sum_, sum_, scaledSum_, h_);
        }
        VectorDone();
        Broadcast(sum_);
        const BinaryRepeatParams subtractMax{1, 1, 0, rowStride, rowStride, 1};
        Sub(matrix, matrix, broadcast_, uint64_t(firstCount), repeats, subtractMax);
        if (HalfSwap || h_ > kVectorFloats) {
            Sub(matrix[kVectorFloats], matrix[kVectorFloats], broadcast_,
                uint64_t(h_ - kVectorFloats), repeats, subtractMax);
        }
        VectorDone();
        const UnaryRepeatParams elementwise{1, 1, rowStride, rowStride};
        if (HalfSwap || h_ % kVectorFloats == 0) {
            // Complete rows have no padding. Keep the same per-element vexp
            // while issuing one contiguous count-mode range.
            Exp(matrix, matrix, h_ * h_);
        } else {
            Exp(matrix, matrix, uint64_t(firstCount), repeats, elementwise);
            if (HalfSwap || h_ > kVectorFloats) {
                Exp(matrix[kVectorFloats], matrix[kVectorFloats],
                    uint64_t(h_ - kVectorFloats), repeats, elementwise);
            }
        }
        VectorDone();
        ReduceRowSums<HalfSwap>(matrix);
        if (HalfSwap || eps_ > 0.0f) {
            DivideVector<HalfSwap>(rowScale_, ones_, sum_);
            ScaleRowsInPlace(matrix, rowScale_);
        } else {
            Broadcast(sum_);
            const BinaryRepeatParams divideRows{1, 1, 0, rowStride, rowStride, 1};
            Div(matrix, matrix, broadcast_, uint64_t(firstCount), repeats, divideRows);
            if (HalfSwap || h_ > kVectorFloats) {
                Div(matrix[kVectorFloats], matrix[kVectorFloats], broadcast_,
                    uint64_t(h_ - kVectorFloats), repeats, divideRows);
            }
            VectorDone();
        }
        if (HalfSwap || h_ % kVectorFloats == 0) {
            Adds(matrix, matrix, eps_, h_ * h_);
        } else {
            Adds(matrix, matrix, eps_, uint64_t(firstCount), repeats, elementwise);
            if (HalfSwap || h_ > kVectorFloats) {
                Adds(matrix[kVectorFloats], matrix[kVectorFloats], eps_,
                    uint64_t(h_ - kVectorFloats), repeats, elementwise);
            }
        }
        VectorDone();
    }

    TPipe* pipe_;
    TBuf<TPosition::VECIN> matrixBuf_;
    TQue<QuePosition::VECIN, 1> gatesQueue_;
    TBuf<TPosition::VECCALC> ubBankPadBeforeScratch_;
    TBuf<TPosition::VECCALC> productBuf_, factorsBuf_, broadcastBuf_;
    TBuf<TPosition::VECCALC> gateTailBuf_, gateTailScratchBuf_;
    GlobalTensor<float> x_, pre_, post_, comb_;
    LocalTensor<float> product_, factors_, broadcast_;
    LocalTensor<float> ones_, rowScale_, colScale_, sum_, scaledSum_;
    LocalTensor<float> oddColScale_, compact_;
    LocalTensor<float> gateTail_, sigmoidNum_, sigmoidDen_;
    bool halfSwapReady_ = false;
    bool gateTailReady_ = false;
    uint64_t first_, end_;
    uint32_t h_, pitch_, w_, iters_;
    float eps_;
};

// Pack independent scaled matrices as [row, active token, column].
// Native Div(1,sum) followed by Mul is retained; the matrix allocation is
// reused in place. Row reductions keep the parent's first64/tail trees.
class ResidentScaledTokenBatchKernel {
public:
    __aicore__ inline void Init(GM_ADDR mixes, GM_ADDR pre, GM_ADDR post,
        GM_ADDR comb, uint64_t n, uint32_t h, uint32_t iters, float eps,
        uint32_t tokenGroup, uint32_t q, uint32_t columnTreeEnabled, TPipe* pipe)
    {
        pipe_ = pipe;
        h_ = h;
        q_ = q;
        pitch_ = (h + 7) / 8 * 8;
        statsSize_ = (q_ * h_ + 7) / 8 * 8;
        gateSize_ = 2 * q_ * pitch_;
        w_ = h * h + 2 * h;
        iters_ = iters;
        eps_ = eps;
        // Host grants this optional allocation only after a successful actual UB
        // query, preserving the already selected q and device-entry priority.
        // Repeat the metadata/eps guards defensively; no tensor-data branch.
        columnTreeEnabled_ = columnTreeEnabled != 0 &&
            h_ > kVectorFloats && h_ < 2 * kVectorFloats &&
            h_ % kBlockFloats == 0 && pitch_ == h_ &&
            eps_ >= 0.00000095367431640625f && eps_ <= 0.0625f;
        TokenRange(n, tokenGroup, first_, end_);
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(mixes));
        pre_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(pre));
        post_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(post));
        comb_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(comb));
        pipe_->InitBuffer(matrixQueue_, 1, q_ * h_ * pitch_ * sizeof(float));
        pipe_->InitBuffer(gatesQueue_, 1, gateSize_ * sizeof(float));
        pipe_->InitBuffer(ubBankPadBeforeScratch_, kResidentScaledKernelUbBankPaddingBytes);
        pipe_->InitBuffer(factorsBuf_, 4 * statsSize_ * sizeof(float));
        const uint32_t originalScratchFloats = 16 * statsSize_;
        const uint32_t treeScratchFloats = ((h_ + 1) / 2) * q_ * pitch_;
        const uint32_t scratchFloats = columnTreeEnabled_ &&
            treeScratchFloats > originalScratchFloats ?
            treeScratchFloats : originalScratchFloats;
        pipe_->InitBuffer(scratchBuf_, scratchFloats * sizeof(float));
        factors_ = factorsBuf_.Get<float>();
        scratch_ = scratchBuf_.Get<float>();
        ones_ = factors_;
        rowScale_ = factors_[statsSize_];
        sum_ = factors_[2 * statsSize_];
        tailSum_ = factors_[3 * statsSize_];
        Duplicate(ones_, 1.0f, statsSize_);
        VectorDone();
    }

    // Route B: explicit owner range and compile-time batch shape. The original
    // Process/Init entry remains available for every other metadata family.
    __aicore__ inline void InitRange(GM_ADDR mixes, GM_ADDR pre, GM_ADDR post,
        GM_ADDR comb, uint64_t first, uint64_t end, uint32_t h, uint32_t iters,
        float eps, uint32_t q, uint32_t columnTreeEnabled, TPipe* pipe)
    {
        pipe_ = pipe; h_ = h; q_ = q; first_ = first; end_ = end;
        pitch_ = (h + 7) / 8 * 8;
        statsSize_ = (q_ * h_ + 7) / 8 * 8;
        gateSize_ = 2 * q_ * pitch_; w_ = h * h + 2 * h;
        iters_ = iters; eps_ = eps;
        columnTreeEnabled_ = columnTreeEnabled != 0 &&
            h_ > kVectorFloats && h_ < 2 * kVectorFloats &&
            h_ % kBlockFloats == 0 && pitch_ == h_ &&
            eps_ >= 0.00000095367431640625f && eps_ <= 0.0625f;
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(mixes));
        pre_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(pre));
        post_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(post));
        comb_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(comb));
        pipe_->InitBuffer(matrixQueue_, 1, q_ * h_ * pitch_ * sizeof(float));
        pipe_->InitBuffer(gatesQueue_, 1, gateSize_ * sizeof(float));
        pipe_->InitBuffer(ubBankPadBeforeScratch_, kResidentScaledKernelUbBankPaddingBytes);
        pipe_->InitBuffer(factorsBuf_, 4 * statsSize_ * sizeof(float));
        const uint32_t originalScratchFloats = 16 * statsSize_;
        const uint32_t treeScratchFloats = ((h_ + 1) / 2) * q_ * pitch_;
        const uint32_t scratchFloats = columnTreeEnabled_ &&
            treeScratchFloats > originalScratchFloats ? treeScratchFloats : originalScratchFloats;
        pipe_->InitBuffer(scratchBuf_, scratchFloats * sizeof(float));
        factors_ = factorsBuf_.Get<float>(); scratch_ = scratchBuf_.Get<float>();
        ones_ = factors_; rowScale_ = factors_[statsSize_];
        sum_ = factors_[2 * statsSize_]; tailSum_ = factors_[3 * statsSize_];
        Duplicate(ones_, 1.0f, statsSize_); VectorDone();
    }

    template <uint32_t FixedQ, uint32_t FixedValid>
    __aicore__ inline void ProcessFixed()
    {
        static_assert(FixedValid >= 2U && FixedValid <= FixedQ && FixedQ <= 3U,
            "compact H88 valid owner range");
        constexpr uint32_t fixedHeight = 88U;
        constexpr uint32_t fixedPitch = 88U;
        rows_ = FixedValid * fixedHeight;
        columnElements_ = FixedValid * fixedPitch;
        matrixRowStride_ = 11;
        columnRowStride_ = static_cast<uint8_t>(columnElements_ / kBlockFloats);
        auto gates = gatesQueue_.AllocTensor<float>();
        auto matrix = matrixQueue_.AllocTensor<float>();
        const uint32_t ubRowGap = (FixedValid - 1U) * fixedPitch / kBlockFloats;
        const DataCopyExtParams loadRows{static_cast<uint16_t>(fixedHeight),
            static_cast<uint32_t>(fixedHeight * sizeof(float)), 0, ubRowGap, 0};
        const DataCopyExtParams storeRows{static_cast<uint16_t>(fixedHeight),
            static_cast<uint32_t>(fixedHeight * sizeof(float)), ubRowGap, 0, 0};
        const DataCopyPadExtParams<float> padding{
            true, 0, static_cast<uint8_t>(fixedPitch - fixedHeight), 0.0f};
        for (uint32_t t = 0; t < FixedValid; ++t) {
            const uint64_t inputBase = (first_ + t) * w_;
            LoadExact(gates[2U * t * fixedPitch], x_[inputBase], fixedHeight);
            LoadExact(gates[(2U * t + 1U) * fixedPitch], x_[inputBase + fixedHeight], fixedHeight);
            DataCopyPad(matrix[t * fixedPitch], x_[inputBase + 2U * fixedHeight], loadRows, padding);
        }
        gatesQueue_.EnQue(gates); matrixQueue_.EnQue(matrix);
        gates = gatesQueue_.DeQue<float>(); matrix = matrixQueue_.DeQue<float>();
        SigmoidInPlace(gates, scratch_, scratch_[gateSize_], 2U * FixedValid * fixedPitch);
        for (uint32_t t = 0; t < FixedValid; ++t) {
            Adds(gates[2U * t * fixedPitch], gates[2U * t * fixedPitch], eps_, fixedHeight);
            Muls(gates[(2U * t + 1U) * fixedPitch], gates[(2U * t + 1U) * fixedPitch], 2.0f, fixedHeight);
        }
        VectorDone(); RowSoftmax(matrix); NormalizeColumns(matrix);
        for (uint32_t iter = 1; iter < iters_; ++iter) {
            NormalizeRows(matrix); NormalizeColumns(matrix);
        }
        SyncPipelines<HardEvent::V_MTE3>(*pipe_);
        for (uint32_t t = 0; t < FixedValid; ++t) {
            StoreExact(pre_[(first_ + t) * fixedHeight], gates[2U * t * fixedPitch], fixedHeight);
            StoreExact(post_[(first_ + t) * fixedHeight], gates[(2U * t + 1U) * fixedPitch], fixedHeight);
            DataCopyPad(comb_[(first_ + t) * fixedHeight * fixedHeight], matrix[t * fixedPitch], storeRows);
        }
        SyncPipelines<HardEvent::MTE3_V>(*pipe_);
        gatesQueue_.FreeTensor(gates); matrixQueue_.FreeTensor(matrix);
    }

    __aicore__ inline void Process()
    {
        for (uint64_t token = first_; token < end_; token += q_) {
            const uint32_t valid = static_cast<uint32_t>(
                end_ - token < q_ ? end_ - token : q_);
            rows_ = valid * h_;
            columnElements_ = valid * pitch_;
            matrixRowStride_ = static_cast<uint8_t>(pitch_ / kBlockFloats);
            columnRowStride_ = static_cast<uint8_t>(columnElements_ / kBlockFloats);
            auto gates = gatesQueue_.AllocTensor<float>();
            auto matrix = matrixQueue_.AllocTensor<float>();
            // Metadata enables this layout only for H%8==0. Each transfer
            // copies exactly one input row; no inactive token is loaded.
            const uint32_t ubRowGap = (valid - 1) * pitch_ / kBlockFloats;
            const DataCopyExtParams loadRows{static_cast<uint16_t>(h_),
                static_cast<uint32_t>(h_ * sizeof(float)), 0, ubRowGap, 0};
            const DataCopyExtParams storeRows{static_cast<uint16_t>(h_),
                static_cast<uint32_t>(h_ * sizeof(float)), ubRowGap, 0, 0};
            const DataCopyPadExtParams<float> padding{
                true, 0, static_cast<uint8_t>(pitch_ - h_), 0.0f};
            for (uint32_t t = 0; t < valid; ++t) {
                const uint64_t inputBase = (token + t) * w_;
                LoadExact(gates[2 * t * pitch_], x_[inputBase], h_);
                LoadExact(gates[(2 * t + 1) * pitch_], x_[inputBase + h_], h_);
                DataCopyPad(matrix[t * pitch_], x_[inputBase + 2 * h_], loadRows, padding);
            }
            gatesQueue_.EnQue(gates);
            matrixQueue_.EnQue(matrix);
            gates = gatesQueue_.DeQue<float>();
            matrix = matrixQueue_.DeQue<float>();
            SigmoidInPlace(gates, scratch_, scratch_[gateSize_], 2 * valid * pitch_);
            for (uint32_t t = 0; t < valid; ++t) {
                Adds(gates[2 * t * pitch_], gates[2 * t * pitch_], eps_, h_);
                Muls(gates[(2 * t + 1) * pitch_], gates[(2 * t + 1) * pitch_], 2.0f, h_);
            }
            VectorDone();
            RowSoftmax(matrix);
            NormalizeColumns(matrix);
            for (uint32_t iter = 1; iter < iters_; ++iter) {
                NormalizeRows(matrix);
                NormalizeColumns(matrix);
            }
            SyncPipelines<HardEvent::V_MTE3>(*pipe_);
            for (uint32_t t = 0; t < valid; ++t) {
                StoreExact(pre_[(token + t) * h_], gates[2 * t * pitch_], h_);
                StoreExact(post_[(token + t) * h_], gates[(2 * t + 1) * pitch_], h_);
                DataCopyPad(comb_[(token + t) * h_ * h_], matrix[t * pitch_], storeRows);
            }
            SyncPipelines<HardEvent::MTE3_V>(*pipe_);
            gatesQueue_.FreeTensor(gates);
            matrixQueue_.FreeTensor(matrix);
        }
    }

private:
    // Chunk starts are multiples of eight rows, so scalar-stat destinations
    // remain 32-byte aligned. 248 is the largest such repeat count below 255.
    static constexpr uint32_t kRowRepeatChunk = 248;

    __aicore__ inline uint32_t RowRepeats(uint32_t first) const
    {
        return rows_ - first < kRowRepeatChunk ? rows_ - first : kRowRepeatChunk;
    }

    __aicore__ inline void Broadcast(const LocalTensor<float>& source)
    {
        Brcb(scratch_, source, static_cast<uint8_t>(rows_ / kBlockFloats), {1, 8});
        VectorDone();
    }

    // Each contiguous eight-root block is exactly the three original
    // adjacent PairReduceSum levels. Full vector repeats combine eight rows.
    // No cross-row arithmetic and no extra +0 level are introduced.
    __aicore__ inline void CompactEightRootsNoSync(const LocalTensor<float>& dst,
        const LocalTensor<float>& source, uint32_t rows)
    {
        const uint32_t fullRepeats = rows / kBlockFloats;
        if (fullRepeats != 0) {
            BlockReduceSum(dst, source, static_cast<int32_t>(fullRepeats),
                static_cast<int32_t>(kVectorFloats), 1, 1, 8);
        }
        const uint32_t tailRows = rows % kBlockFloats;
        if (tailRows != 0) {
            BlockReduceSum(dst[fullRepeats * kBlockFloats],
                source[fullRepeats * kVectorFloats], 1,
                static_cast<int32_t>(tailRows * kBlockFloats), 1, 1, 8);
        }
    }

    __aicore__ inline void ReduceRows(const LocalTensor<float>& matrix)
    {
        // B1: fold real eight-column tail blocks lane-wise, then reduce once.
        // This positive-eps family admits a new FP32 sum tree; other eps values
        // retain the complete original path below. No matrix padding is read.
        if (h_ > kVectorFloats && h_ < 2 * kVectorFloats &&
            h_ % kBlockFloats == 0 && pitch_ == h_ &&
            eps_ >= 0.00000095367431640625f && eps_ <= 0.0625f) {
            auto foldedTail = scratch_[8 * statsSize_];
            const uint32_t tailBlocks = (h_ - kVectorFloats) / kBlockFloats;
            const uint8_t tailRepeats = static_cast<uint8_t>(rows_ / kBlockFloats);
            // B2: the existing admitted full-column tree owns at least
            // (H/2)*statsSize_ scratch floats. 32*statsSize_ suffice for head
            // roots plus three disjoint compact tail panels; no allocation.
            // Tails of one to three blocks keep the complete B1 path below.
            if (columnTreeEnabled_ && tailBlocks >= 4) {
                auto pair23 = scratch_[16 * statsSize_];
                auto pair45 = scratch_[24 * statsSize_];
                for (uint32_t first = 0; first < rows_; first += kRowRepeatChunk) {
                    const uint32_t repeats = RowRepeats(first);
                    BlockReduceSum(scratch_[first * 8], matrix[first * pitch_],
                        static_cast<int32_t>(repeats), static_cast<int32_t>(kVectorFloats),
                        1, 1, static_cast<int32_t>(matrixRowStride_));
                }
                const BinaryRepeatParams firstPair{1, matrixRowStride_, matrixRowStride_,
                    8, static_cast<uint8_t>(pitch_), static_cast<uint8_t>(pitch_)};
                Add(foldedTail, matrix[kVectorFloats],
                    matrix[kVectorFloats + kBlockFloats], uint64_t(kVectorFloats),
                    tailRepeats, firstPair);
                Add(pair23, matrix[kVectorFloats + 2 * kBlockFloats],
                    matrix[kVectorFloats + 3 * kBlockFloats], uint64_t(kVectorFloats),
                    tailRepeats, firstPair);
                if (tailBlocks >= 6) {
                    Add(pair45, matrix[kVectorFloats + 4 * kBlockFloats],
                        matrix[kVectorFloats + 5 * kBlockFloats], uint64_t(kVectorFloats),
                        tailRepeats, firstPair);
                }
                VectorDone();

                // Head compaction and both independent tail merges share one
                // barrier. Every in-place compact Add has exact lane overlap.
                CompactEightRootsNoSync(sum_, scratch_, rows_);
                const BinaryRepeatParams compactPair{1, 1, 1, 8, 8, 8};
                const BinaryRepeatParams matrixTail{1, 1, matrixRowStride_,
                    8, 8, static_cast<uint8_t>(pitch_)};
                Add(foldedTail, foldedTail, pair23, uint64_t(kVectorFloats),
                    tailRepeats, compactPair);
                if (tailBlocks == 7) {
                    Add(pair45, pair45, matrix[kVectorFloats + 6 * kBlockFloats],
                        uint64_t(kVectorFloats), tailRepeats, matrixTail);
                }
                VectorDone();
                if (tailBlocks == 5) {
                    Add(foldedTail, foldedTail, matrix[kVectorFloats + 4 * kBlockFloats],
                        uint64_t(kVectorFloats), tailRepeats, matrixTail);
                    VectorDone();
                } else if (tailBlocks >= 6) {
                    Add(foldedTail, foldedTail, pair45, uint64_t(kVectorFloats),
                        tailRepeats, compactPair);
                    VectorDone();
                }
                BlockReduceSum(tailSum_, foldedTail, static_cast<int32_t>(tailRepeats),
                    static_cast<int32_t>(kVectorFloats), 1, 1, 8);
                VectorDone();
                Add(sum_, sum_, tailSum_, rows_);
                VectorDone();
                return;
            }

            // Head roots and compact tail occupy disjoint 8*statsSize_ halves.
            for (uint32_t first = 0; first < rows_; first += kRowRepeatChunk) {
                const uint32_t repeats = RowRepeats(first);
                BlockReduceSum(scratch_[first * 8], matrix[first * pitch_],
                    static_cast<int32_t>(repeats), static_cast<int32_t>(kVectorFloats),
                    1, 1, static_cast<int32_t>(matrixRowStride_));
            }
            if (tailBlocks == 1) {
                // One real block needs no copy or arithmetic seed.
                BlockReduceSum(tailSum_, matrix[kVectorFloats],
                    static_cast<int32_t>(tailRepeats), static_cast<int32_t>(kVectorFloats),
                    1, static_cast<int32_t>(matrixRowStride_), static_cast<int32_t>(pitch_));
            } else {
                // Vector block b visits physical row 8*repeat+b. Compact dst
                // block b stores that row's eight folded real-column lanes.
                const BinaryRepeatParams firstFold{1, matrixRowStride_, matrixRowStride_,
                    8, static_cast<uint8_t>(pitch_), static_cast<uint8_t>(pitch_)};
                Add(foldedTail, matrix[kVectorFloats],
                    matrix[kVectorFloats + kBlockFloats], uint64_t(kVectorFloats),
                    tailRepeats, firstFold);
            }
            VectorDone();

            CompactEightRootsNoSync(sum_, scratch_, rows_);
            const BinaryRepeatParams nextFold{1, 1, matrixRowStride_,
                8, 8, static_cast<uint8_t>(pitch_)};
            // The third-block Add is independent of head compact and shares
            // its barrier. Remaining folds each consume the preceding result.
            if (tailBlocks > 2) {
                Add(foldedTail, foldedTail,
                    matrix[kVectorFloats + 2 * kBlockFloats], uint64_t(kVectorFloats),
                    tailRepeats, nextFold);
            }
            VectorDone();
            for (uint32_t block = 3; block < tailBlocks; ++block) {
                Add(foldedTail, foldedTail,
                    matrix[kVectorFloats + block * kBlockFloats], uint64_t(kVectorFloats),
                    tailRepeats, nextFold);
                VectorDone();
            }
            if (tailBlocks > 1) {
                BlockReduceSum(tailSum_, foldedTail, static_cast<int32_t>(tailRepeats),
                    static_cast<int32_t>(kVectorFloats), 1, 1, 8);
                VectorDone();
            }
            Add(sum_, sum_, tailSum_, rows_);
            VectorDone();
            return;
        }

        // The allocated scratch has 16*statsSize_ floats. Head BR roots use
        // only [0,8*rows_); tail block planes fit in the disjoint second half.
        auto tailRoots = scratch_[8 * statsSize_];
        const uint32_t tailBlocks = (h_ - kVectorFloats) / kBlockFloats;
        for (uint32_t first = 0; first < rows_; first += kRowRepeatChunk) {
            const uint32_t repeats = RowRepeats(first);
            BlockReduceSum(scratch_[first * 8], matrix[first * pitch_],
                static_cast<int32_t>(repeats), static_cast<int32_t>(kVectorFloats),
                1, 1, static_cast<int32_t>(matrixRowStride_));
        }
        for (uint32_t block = 0; block < tailBlocks; ++block) {
            BlockReduceSum(tailRoots[block * rows_],
                matrix[kVectorFloats + block * kBlockFloats],
                static_cast<int32_t>(rows_ / kBlockFloats),
                static_cast<int32_t>(kVectorFloats), 1,
                static_cast<int32_t>(matrixRowStride_), static_cast<int32_t>(pitch_));
        }
        VectorDone();

        // Compact consumes only head roots. The first tail wave consumes
        // only the second scratch half; both can precede the same barrier.
        CompactEightRootsNoSync(sum_, scratch_, rows_);
        for (uint32_t block = 0; block < tailBlocks; block += 2) {
            if (block + 1 < tailBlocks) {
                Add(tailRoots[block * rows_], tailRoots[block * rows_],
                    tailRoots[(block + 1) * rows_], rows_);
            } else {
                Adds(tailRoots[block * rows_], tailRoots[block * rows_],
                    0.0f, rows_);
            }
        }
        VectorDone();
        for (uint32_t block = 0; block < tailBlocks; block += 4) {
            if (block + 2 < tailBlocks) {
                Add(tailRoots[block * rows_], tailRoots[block * rows_],
                    tailRoots[(block + 2) * rows_], rows_);
            } else {
                Adds(tailRoots[block * rows_], tailRoots[block * rows_],
                    0.0f, rows_);
            }
        }
        VectorDone();
        if (tailBlocks > 4) {
            Add(tailSum_, tailRoots, tailRoots[4 * rows_], rows_);
        } else {
            Adds(tailSum_, tailRoots, 0.0f, rows_);
        }
        VectorDone();
        Add(sum_, sum_, tailSum_, rows_);
        VectorDone();
    }

    template <bool divide>
    __aicore__ inline void ApplyTailRowsNoSync(const LocalTensor<float>& matrix)
    {
        // The unchanged first64 pass has just established a full64 NORMAL
        // mask. Each tail repeat now visits one eight-column block in eight
        // physical rows, with exactly the parent's per-lane factor address.
        const BinaryRepeatParams tailSteps{matrixRowStride_, matrixRowStride_, 1,
            static_cast<uint8_t>(pitch_), static_cast<uint8_t>(pitch_), 8};
        const uint8_t repeats = static_cast<uint8_t>(rows_ / kBlockFloats);
        for (uint32_t column = kVectorFloats; column < h_; column += kBlockFloats) {
            if (divide) {
                Div<float, false>(matrix[column], matrix[column], scratch_,
                    MASK_PLACEHOLDER, repeats, tailSteps);
            } else {
                Mul<float, false>(matrix[column], matrix[column], scratch_,
                    MASK_PLACEHOLDER, repeats, tailSteps);
            }
        }
    }

    template <bool divide>
    __aicore__ inline void ApplyRows(const LocalTensor<float>& matrix)
    {
        const BinaryRepeatParams steps{1, 1, 0,
            matrixRowStride_, matrixRowStride_, 1};
        if (rows_ <= kRowRepeatChunk) {
            const uint8_t repeats = static_cast<uint8_t>(rows_);
            if (divide) {
                Div(matrix, matrix, scratch_, uint64_t(kVectorFloats), repeats, steps);
            } else {
                Mul(matrix, matrix, scratch_, uint64_t(kVectorFloats), repeats, steps);
            }
            ApplyTailRowsNoSync<divide>(matrix);
            VectorDone();
            return;
        }
        // Each physical row/chunk has disjoint matrix lanes. Group identical
        // masks; preserve every lane's native operation and the final barrier.
        SetMaskNorm();
        SetVectorMask<float, MaskMode::NORMAL>(uint64_t(0), uint64_t(-1));
        for (uint32_t first = 0; first < rows_; first += kRowRepeatChunk) {
            const uint8_t repeats = static_cast<uint8_t>(RowRepeats(first));
            const uint32_t offset = first * pitch_;
            if (divide) {
                Div<float, false>(matrix[offset], matrix[offset], scratch_[first * 8],
                    MASK_PLACEHOLDER, repeats, steps);
            } else {
                Mul<float, false>(matrix[offset], matrix[offset], scratch_[first * 8],
                    MASK_PLACEHOLDER, repeats, steps);
            }
        }
        ApplyTailRowsNoSync<divide>(matrix);
        ResetMask();
        VectorDone();
    }

    __aicore__ inline void NormalizeRows(const LocalTensor<float>& matrix)
    {
        ReduceRows(matrix);
        Adds(sum_, sum_, eps_, rows_);
        VectorDone();
        Div(rowScale_, ones_, sum_, rows_);
        VectorDone();
        Broadcast(rowScale_);
        ApplyRows<false>(matrix);
    }

    __aicore__ inline void ReduceColumnsHalfFold(const LocalTensor<float>& matrix)
    {
        // Natural admitted family has H%8==0: the first split is even.
        // Keep the real matrix intact; only this first level reads it.
        uint32_t liveRows = (h_ + 1) / 2;
        Add(scratch_, matrix, matrix[liveRows * columnElements_],
            static_cast<int32_t>((h_ / 2) * columnElements_));
        VectorDone();
        while (liveRows > 2) {
            const uint32_t nextRows = (liveRows + 1) / 2;
            const uint32_t pairedRows = liveRows - nextRows;
            // dst == src0 exactly over [0,pairedRows*E); src1 starts at
            // nextRows*E, beyond both dst and any odd left-half carry.
            // For odd liveRows, row pairedRows remains live without a copy.
            Add(scratch_, scratch_, scratch_[nextRows * columnElements_],
                static_cast<int32_t>(pairedRows * columnElements_));
            VectorDone();
            liveRows = nextRows;
        }
        // H>64 guarantees that the loop reaches exactly two live rows.
        // Write the final merge directly to the existing statistic panel.
        Add(sum_, scratch_, scratch_[columnElements_],
            static_cast<int32_t>(columnElements_));
        VectorDone();
    }

    __aicore__ inline void NormalizeColumns(const LocalTensor<float>& matrix)
    {
        const uint32_t fullElements = columnElements_ / kVectorFloats * kVectorFloats;
        const uint32_t tail = columnElements_ - fullElements;
        if (columnTreeEnabled_) {
            ReduceColumnsHalfFold(matrix);
        } else {
            // Each vector lane remains a single (token,column). Preserve the
            // parent's real FP32 +0 seed and source[row] + accumulated order.
            Adds(sum_, matrix, 0.0f, columnElements_);
            VectorDone();
            const BinaryRepeatParams accumulate{1, 1, 1, 0, columnRowStride_, 0};
            SetMaskNorm();
            SetVectorMask<float, MaskMode::NORMAL>(uint64_t(0), uint64_t(-1));
            for (uint32_t col = 0; col < fullElements; col += kVectorFloats) {
                Add<float, false>(sum_[col], matrix[columnElements_ + col], sum_[col],
                    MASK_PLACEHOLDER, static_cast<uint8_t>(h_ - 1), accumulate);
            }
            if (tail != 0) {
                SetVectorMask<float, MaskMode::NORMAL>(static_cast<int32_t>(tail));
                Add<float, false>(sum_[fullElements], matrix[columnElements_ + fullElements],
                    sum_[fullElements], MASK_PLACEHOLDER, static_cast<uint8_t>(h_ - 1), accumulate);
            }
            ResetMask();
            VectorDone();
        }
        Adds(sum_, sum_, eps_, columnElements_);
        VectorDone();
        Div(rowScale_, ones_, sum_, columnElements_);
        VectorDone();
        const BinaryRepeatParams steps{1, 1, 1,
            columnRowStride_, columnRowStride_, 0};
        SetMaskNorm();
        SetVectorMask<float, MaskMode::NORMAL>(uint64_t(0), uint64_t(-1));
        for (uint32_t col = 0; col < fullElements; col += kVectorFloats) {
            Mul<float, false>(matrix[col], matrix[col], rowScale_[col],
                MASK_PLACEHOLDER, static_cast<uint8_t>(h_), steps);
        }
        if (tail != 0) {
            SetVectorMask<float, MaskMode::NORMAL>(static_cast<int32_t>(tail));
            Mul<float, false>(matrix[fullElements], matrix[fullElements], rowScale_[fullElements],
                MASK_PLACEHOLDER, static_cast<uint8_t>(h_), steps);
        }
        ResetMask();
        VectorDone();
    }

    __aicore__ inline void RowSoftmax(const LocalTensor<float>& matrix)
    {
        for (uint32_t first = 0; first < rows_; first += kRowRepeatChunk) {
            const uint32_t repeats = RowRepeats(first);
            WholeReduceMax(sum_[first], matrix[first * pitch_],
                static_cast<int32_t>(kVectorFloats), static_cast<int32_t>(repeats),
                1, 1, static_cast<int32_t>(matrixRowStride_), ReduceOrder::ORDER_ONLY_VALUE);
            WholeReduceMax(tailSum_[first], matrix[first * pitch_ + kVectorFloats],
                static_cast<int32_t>(h_ - kVectorFloats), static_cast<int32_t>(repeats),
                1, 1, static_cast<int32_t>(matrixRowStride_), ReduceOrder::ORDER_ONLY_VALUE);
        }
        VectorDone();
        Max(sum_, sum_, tailSum_, rows_);
        VectorDone();
        Broadcast(sum_);
        const BinaryRepeatParams subtractMax{1, 1, 0,
            matrixRowStride_, matrixRowStride_, 1};
        const UnaryRepeatParams elementwise{1, 1, matrixRowStride_, matrixRowStride_};
        for (uint32_t first = 0; first < rows_; first += kRowRepeatChunk) {
            const uint8_t repeats = static_cast<uint8_t>(RowRepeats(first));
            const uint32_t offset = first * pitch_;
            Sub(matrix[offset], matrix[offset], scratch_[first * 8],
                uint64_t(kVectorFloats), repeats, subtractMax);
            Sub(matrix[offset + kVectorFloats], matrix[offset + kVectorFloats],
                scratch_[first * 8], uint64_t(h_ - kVectorFloats), repeats, subtractMax);
        }
        VectorDone();
        for (uint32_t first = 0; first < rows_; first += kRowRepeatChunk) {
            const uint8_t repeats = static_cast<uint8_t>(RowRepeats(first));
            const uint32_t offset = first * pitch_;
            Exp(matrix[offset], matrix[offset], uint64_t(kVectorFloats), repeats, elementwise);
            Exp(matrix[offset + kVectorFloats], matrix[offset + kVectorFloats],
                uint64_t(h_ - kVectorFloats), repeats, elementwise);
        }
        VectorDone();
        ReduceRows(matrix);
        Broadcast(sum_);
        ApplyRows<true>(matrix);
        for (uint32_t first = 0; first < rows_; first += kRowRepeatChunk) {
            const uint8_t repeats = static_cast<uint8_t>(RowRepeats(first));
            const uint32_t offset = first * pitch_;
            Adds(matrix[offset], matrix[offset], eps_, uint64_t(kVectorFloats), repeats, elementwise);
            Adds(matrix[offset + kVectorFloats], matrix[offset + kVectorFloats], eps_,
                uint64_t(h_ - kVectorFloats), repeats, elementwise);
        }
        VectorDone();
    }

    TPipe* pipe_;
    TQue<QuePosition::VECIN, 1> matrixQueue_, gatesQueue_;
    TBuf<TPosition::VECCALC> ubBankPadBeforeScratch_, factorsBuf_, scratchBuf_;
    GlobalTensor<float> x_, pre_, post_, comb_;
    LocalTensor<float> factors_, scratch_, ones_, rowScale_, sum_, tailSum_;
    uint64_t first_, end_;
    uint32_t h_, pitch_, q_, w_, iters_, statsSize_, gateSize_, rows_, columnElements_;
    uint8_t matrixRowStride_, columnRowStride_;
    bool columnTreeEnabled_;
    float eps_;
};


// F0: static dual-direction factor kernel. This leaf is instantiated only for
// H88 by the launcher; the H96 template remains available but is not admitted
// by host dispatch. One token stays resident, with one UB pool, q1 ownership,
// and a complete MTE3 drain before the next token. F1/F2 stay out of F0.
constexpr uint64_t kF0StaticFactorPoolBytes = 169344U;

inline uint64_t F0StaticFactorBytes()
{
    return kF0StaticFactorPoolBytes;
}

inline bool F0StaticFactorUbReady(uint64_t availableUbBytes)
{
    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform == nullptr) {
        return false;
    }
    uint64_t physicalUbBytes = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, physicalUbBytes);
    if (physicalUbBytes <= 16U * 1024U) {
        return false;
    }
    const uint64_t queriedUbBytes =
        (physicalUbBytes - 16U * 1024U) / 32U * 32U;
    return F0StaticFactorBytes() <= availableUbBytes &&
        F0StaticFactorBytes() <= queriedUbBytes;
}

template <uint32_t H>
class F0StaticFactorQ1Kernel {
    static_assert(H == 88U || H == 96U,
        "F0 static-factor template is defined for H88/H96 templates");

public:
    __aicore__ inline void Init(GM_ADDR mixes, GM_ADDR pre, GM_ADDR post,
        GM_ADDR comb, uint64_t n, uint32_t iters, float eps,
        uint32_t tokenGroup, TPipe* pipe)
    {
        pipe_ = pipe;
        iters_ = iters;
        eps_ = eps;
        TokenRange(n, tokenGroup, first_, end_);
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(mixes));
        pre_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(pre));
        post_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(post));
        comb_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(comb));

        pipe_->InitBuffer(poolBuf_, kPoolBytes);
        rawPool_ = poolBuf_.Get<float>();
        // The physical base is runtime-defined. Shift by 0..15 aligned blocks
        // until C is group zero. The 512-byte reserve covers the worst shift;
        // fixed relative offsets then place reciprocal vectors at group 8 and
        // the product stream at group 4.
        const uint64_t rawAddress =
            reinterpret_cast<uint64_t>(rawPool_.GetPhyAddr());
        phaseBlocks_ = static_cast<uint32_t>((16U -
            ((rawAddress / 32U) % 16U)) % 16U);
        pool_ = rawPool_[phaseBlocks_ * kBlockFloats];

        c_ = Byte<kCByte>();
        ct_ = Byte<kCTByte>();
        den0_ = Byte<kDen0Byte>();
        den1_ = Byte<kDen1Byte>();
        den2_ = Byte<kDen2Byte>();
        invR_ = Byte<kInvRByte>();
        invC_ = Byte<kInvCByte>();
        epsR_ = Byte<kEpsRByte>();
        epsC_ = Byte<kEpsCByte>();
        ones_ = Byte<kOnesByte>();
        gates_ = Byte<kGatesByte>();
        broadcast_ = Byte<kBroadcastByte>();
        rootVector_ = Byte<kRootsByte>();
        work_ = Byte<kWorkByte>();

        Duplicate(c_, 0.0f, kRows * kPitch);
        Duplicate(ct_, 0.0f, kRows * kPitch);
        Duplicate(gates_, 0.0f, 2U * kPitch);
        Duplicate(broadcast_, 0.0f, kBroadcastFloats);
        Duplicate(rootVector_, 0.0f, kRootFloats);
        Duplicate(work_, 0.0f, kWorkFloats);
        Duplicate(den0_, 1.0f, kPitch);
        Duplicate(den1_, 1.0f, kPitch);
        Duplicate(den2_, 1.0f, kPitch);
        Duplicate(invR_, 1.0f, kPitch);
        Duplicate(invC_, 1.0f, kPitch);
        Duplicate(epsR_, 1.0f, kPitch);
        Duplicate(epsC_, 1.0f, kPitch);
        Duplicate(ones_, 1.0f, kPitch);
        VectorDone();

        // H88 retains one identity dummy block. Every other C/CT exterior
        // lane stays zero; real reductions consume H rows and H columns only.
        if constexpr (H == 88U) {
            for (uint32_t i = 0; i < 8U; ++i) {
                c_.SetValue((H + i) * kPitch + H + i, 1.0f);
                ct_.SetValue((H + i) * kPitch + H + i, 1.0f);
            }
        }
        SyncPipelines<HardEvent::S_V>(*pipe_);
        VectorDone();
    }

    __aicore__ inline void Process()
    {
        for (uint64_t token = first_; token < end_; ++token) {
            LoadToken(token);
            ComputeGates();
            PrepareScaledE();
            TransposeCToCT();
            RunFactorizedSinkhornImpl(0U, false);
            MaterializeAndStore(token);
        }
    }

protected:
    static constexpr uint32_t kLocalBlockFloats = 8U;
    static constexpr uint32_t kRows = 96U;
    static constexpr uint32_t kPitch = 128U;
    static constexpr uint32_t kH = H;
    static constexpr uint32_t kTail = H - 64U;
    static constexpr uint32_t kTailRoots = (kTail + 7U) / 8U;
    static constexpr uint32_t kProductPitch = 64U;
    static constexpr uint32_t kStageSrcPitch = 136U;
    static constexpr uint32_t kStageSrcFloats = 16U * kStageSrcPitch;
    static constexpr uint32_t kStageDstFloats = 128U * 16U;
    static constexpr uint32_t kStageFloats = kStageSrcFloats + kStageDstFloats;

    static constexpr uint32_t kCByte = 0U;
    static constexpr uint32_t kDen0Byte = 49408U;
    static constexpr uint32_t kDen1Byte = 50432U;
    static constexpr uint32_t kDen2Byte = 51456U;
    static constexpr uint32_t kInvRByte = 52480U;
    static constexpr uint32_t kInvCByte = 53504U;
    static constexpr uint32_t kEpsRByte = 54528U;
    static constexpr uint32_t kEpsCByte = 55552U;
    static constexpr uint32_t kOnesByte = 56576U;
    static constexpr uint32_t kGatesByte = 57344U;
    static constexpr uint32_t kBroadcastByte = 59392U;
    static constexpr uint32_t kCTByte = 65536U;
    static constexpr uint32_t kRootsByte = 114688U;
    static constexpr uint32_t kWorkByte = 131200U;
    static constexpr uint32_t kPlannedEndByte = 168832U;
    static constexpr uint32_t kPoolBytes = 169344U;

    static constexpr uint32_t kRootFloats = 768U;
    static constexpr uint32_t kBroadcastFloats = 1024U;
    static constexpr uint32_t kWorkFloats = 9408U;
    static constexpr uint32_t kRawFloats = H * 96U;
    static constexpr uint32_t kProductFloats = 96U * 64U;

    static_assert(kCByte + kRows * kPitch * sizeof(float) == 49152U,
        "C must occupy [0,49152)");
    static_assert(kCTByte + kRows * kPitch * sizeof(float) == kRootsByte,
        "CT must end at root vectors");
    static_assert(kRootsByte + kRootFloats * sizeof(float) <= kWorkByte,
        "root vector must end before the work gap");
    static_assert(kWorkByte / sizeof(float) + kWorkFloats ==
        kPlannedEndByte / sizeof(float), "work must end at planned high water");
    static_assert(kStageFloats <= kWorkFloats,
        "transpose stage must fit the work union");
    static_assert(kProductFloats <= kWorkFloats,
        "product must fit the work union");
    static_assert(kRawFloats <= kWorkFloats,
        "future raw token must fit the work union");
    static_assert(kPlannedEndByte + 512U == kPoolBytes,
        "512-byte phase reserve must be the final pool bytes");

    template <uint32_t ByteOffset>
    __aicore__ inline LocalTensor<float> Byte()
    {
        static_assert(ByteOffset % 4U == 0U,
            "float offset must be word aligned");
        return pool_[ByteOffset / sizeof(float)];
    }

    __aicore__ inline void LoadToken(uint64_t token)
    {
        SyncPipelines<HardEvent::V_MTE2>(*pipe_);
        const uint64_t inputBase = token * kW;
        LoadExact(gates_, x_[inputBase], kH);
        LoadExact(gates_[kPitch], x_[inputBase + kH], kH);
        const DataCopyExtParams loadRows{static_cast<uint16_t>(kH),
            static_cast<uint32_t>(kH * sizeof(float)), 0U,
            static_cast<uint32_t>((kPitch - kH) / kLocalBlockFloats), 0U};
        const DataCopyPadExtParams<float> padding{true, 0U, 0U, 0.0f};
        DataCopyPad(c_, x_[inputBase + 2U * kH], loadRows, padding);
        SyncPipelines<HardEvent::MTE2_V>(*pipe_);
    }

    __aicore__ inline void ComputeGates()
    {
        // Before product/transpose modes, the work union supplies sigmoid
        // numerator and denominator scratch. Gate data remains live to drain.
        SigmoidInPlace(gates_, work_, work_[2U * kPitch], 2U * kPitch);
        Adds(gates_, gates_, eps_, kH);
        Muls(gates_[kPitch], gates_[kPitch], 2.0f, kH);
        VectorDone();
    }

    __aicore__ inline void BroadcastRows(const LocalTensor<float>& scale,
        const LocalTensor<float>& destination)
    {
        Brcb(destination, scale,
            static_cast<uint8_t>(kH / kLocalBlockFloats), {1, 8});
        VectorDone();
    }

    __aicore__ inline void ApplyRowVector(const LocalTensor<float>& matrix,
        const LocalTensor<float>& rowValues, bool multiply)
    {
        BroadcastRows(rowValues, broadcast_);
        const BinaryRepeatParams rows{1, 1, 0,
            static_cast<uint8_t>(kPitch / kLocalBlockFloats),
            static_cast<uint8_t>(kPitch / kLocalBlockFloats), 1};
        if (multiply) {
            Mul(matrix, matrix, broadcast_, uint64_t(64U),
                static_cast<uint8_t>(kH), rows);
            Mul(matrix[64U], matrix[64U], broadcast_, uint64_t(kTail),
                static_cast<uint8_t>(kH), rows);
        } else {
            Add(matrix, matrix, broadcast_, uint64_t(64U),
                static_cast<uint8_t>(kH), rows);
            Add(matrix[64U], matrix[64U], broadcast_, uint64_t(kTail),
                static_cast<uint8_t>(kH), rows);
        }
        VectorDone();
    }

    __aicore__ inline void ReduceRows(const LocalTensor<float>& src,
        const LocalTensor<float>& dst)
    {
        // Continuous roots: BR8 writes eight roots per real row; a second BR8
        // consumes the contiguous H*8 root panel. Column padding is unread.
        auto headRoots = rootVector_;
        auto tailRoots = broadcast_;
        BlockReduceSum(headRoots, src, static_cast<int32_t>(kH), 64,
            1, 1, static_cast<int32_t>(kPitch / kLocalBlockFloats));
        BlockReduceSum(tailRoots, src[64U], static_cast<int32_t>(kH),
            static_cast<int32_t>(kTail), 1, 1,
            static_cast<int32_t>(kPitch / kLocalBlockFloats));
        VectorDone();
        const BinaryRepeatParams compactRows{1, 1, 1, 1, 1, 1};
        Add(headRoots, headRoots, tailRoots, uint64_t(kTailRoots),
            static_cast<uint8_t>(kH), compactRows);
        VectorDone();
        BlockReduceSum(dst, headRoots, static_cast<int32_t>(kH / 8U),
            64, 1, 1, 8);
        VectorDone();
    }

    __aicore__ inline void PrepareScaledE()
    {
        const uint8_t stride =
            static_cast<uint8_t>(kPitch / kLocalBlockFloats);
        const uint8_t repeats = static_cast<uint8_t>(kH);
        const BinaryRepeatParams rows{1, 1, 0, stride, stride, 1};
        const UnaryRepeatParams elementwise{1, 1, stride, stride};

        // Stable row softmax over real H columns.
        // help_234 RowStatistic: fold true tail into a dense 64-wide panel,
        // then use two BR8 max levels instead of serial whole-row vcmax.
        Adds(work_, c_, 0.0f, uint64_t(64U), repeats, {1, 1, 8, stride});
        VectorDone();
        Max(work_, work_, c_[64U], uint64_t(kTail), repeats,
            {1, 1, 1, 8, 8, stride});
        VectorDone();
        BlockReduceMax(rootVector_, work_, static_cast<int32_t>(kH),
            64, 1, 1, 8);
        VectorDone();
        BlockReduceMax(invR_, rootVector_, static_cast<int32_t>(kH / 8U),
            64, 1, 1, 8);
        VectorDone();
        BroadcastRows(invR_, broadcast_);
        Sub(c_, c_, broadcast_, uint64_t(64U), repeats, rows);
        Sub(c_[64U], c_[64U], broadcast_, uint64_t(kTail), repeats, rows);
        VectorDone();
        Exp(c_, c_, uint64_t(64U), repeats, elementwise);
        Exp(c_[64U], c_[64U], uint64_t(kTail), repeats, elementwise);
        VectorDone();

        // r0=S and C=E+eps*S; therefore C/r0=softmax(Z)+eps.
        ReduceRows(c_, den0_);
        Muls(epsR_, den0_, eps_, kH);
        VectorDone();
        ApplyRowVector(c_, epsR_, false);
    }

    __aicore__ inline void TransposeCToCT()
    {
        auto stageSrc = work_;
        auto stageDst = work_[kStageSrcFloats];
        alignas(32) uint64_t srcVa[16];
        alignas(32) uint64_t dstVa[16];
        const TransDataTo5HDParams params{false, false, static_cast<uint8_t>(kH / kLocalBlockFloats), 16U, 1U};
        const UnaryRepeatParams copyToStage{
            1, 1, static_cast<uint8_t>(kStageSrcPitch / 8U),
            static_cast<uint8_t>(kPitch / 8U)};
        const UnaryRepeatParams copyToCT{
            1, 1, static_cast<uint8_t>(kPitch / 8U), 2U};

        // The stage addresses are fixed across all six source-row tiles.
        for (uint32_t i = 0; i < 16U; ++i) {
            srcVa[i] = reinterpret_cast<uint64_t>(
                stageSrc[i * kStageSrcPitch].GetPhyAddr());
        }
        for (uint32_t j = 0; j < 8U; ++j) {
            dstVa[2U * j] = reinterpret_cast<uint64_t>(
                stageDst[j * 16U].GetPhyAddr());
            dstVa[2U * j + 1U] = reinterpret_cast<uint64_t>(
                stageDst[j * 16U + 8U].GetPhyAddr());
        }

        // Six blocks of sixteen source rows. FP32 maps 16x8 to 8x16; H/8
        // repeats cover the real H columns. dstVa pair (2*j,2*j+1) includes
        // the +8-float half.
        for (uint32_t block = 0; block < kRows; block += 16U) {
            Adds(stageSrc, c_[block * kPitch], 0.0f, uint64_t(64U),
                16U, copyToStage);
            Adds(stageSrc[64U], c_[block * kPitch + 64U], 0.0f,
                uint64_t(kTail), 16U, copyToStage);
            VectorDone();
            TransDataTo5HD<float>(dstVa, srcVa, params);
            VectorDone();
            // stageDst is [source-column][16 source rows]. Copy one 16-column
            // slice into CT[source-column][source-row range].
            Adds(ct_[block], stageDst, 0.0f, uint64_t(16U),
                static_cast<uint8_t>(kH), copyToCT);
            VectorDone();
        }
    }

    __aicore__ inline void ReduceProduct(const LocalTensor<float>& dst)
    {
        auto roots = rootVector_;
        BlockReduceSum(roots, work_, static_cast<int32_t>(kH), 64,
            1, 1, static_cast<int32_t>(kProductPitch / 8U));
        VectorDone();
        BlockReduceSum(dst, roots, static_cast<int32_t>(kH / 8U),
            64, 1, 1, 8);
        VectorDone();
    }

    __aicore__ inline void WeightedRows(const LocalTensor<float>& src,
        const LocalTensor<float>& weights, const LocalTensor<float>& dst)
    {
        const uint8_t repeats = static_cast<uint8_t>(kH);
        const BinaryRepeatParams headSteps{1, 1, 1, 8,
            static_cast<uint8_t>(kPitch / 8U), 0};
        const BinaryRepeatParams tailSteps{1, 1, 1, 8,
            static_cast<uint8_t>(kPitch / 8U), 0};
        // Work-mode 96x64 product. Mul writes head64; in-place MulAddDst adds
        // the real H-64 tail to lanes 0..tail-1 while preserving lanes above.
        Mul(work_, src, weights, uint64_t(64U), repeats, headSteps);
        VectorDone();
        MulAddDst(work_, src[64U], weights[64U], uint64_t(kTail),
            repeats, tailSteps);
        VectorDone();
        ReduceProduct(dst);
    }

    __aicore__ inline void NativeInverse(const LocalTensor<float>& dst,
        const LocalTensor<float>& den)
    {
        Div(dst, ones_, den, static_cast<int32_t>(kH));
        VectorDone();
    }

    __aicore__ inline void BeginRawPrefetch(uint64_t nextToken)
    {
        // The last CT weighted-dot has consumed product from work_. Protect
        // that read before overloading the union with the next raw token.
        SyncPipelines<HardEvent::V_MTE2>(*pipe_);
        LoadExact(work_, x_[nextToken * kW], kW);
    }

    __aicore__ inline void RunFactorizedSinkhornImpl(uint64_t nextToken,
        bool hasNext)
    {
        LocalTensor<float> rowDen = den0_;   // r0 = S
        LocalTensor<float> colDen = den1_;   // c0 = 1
        LocalTensor<float> spare = den2_;
        // Initial column: c1 = CT @ (1/r0) + eps*c0.
        NativeInverse(invR_, rowDen);
        WeightedRows(ct_, invR_, spare);
        Adds(spare, spare, eps_, static_cast<int32_t>(kH));
        VectorDone();
        LocalTensor<float> swap = colDen;
        colDen = spare;
        spare = swap;

        for (uint32_t iter = 1U; iter < iters_; ++iter) {
            NativeInverse(invC_, colDen);
            WeightedRows(c_, invC_, spare);
            Axpy(spare, rowDen, eps_, static_cast<int32_t>(kH));
            VectorDone();
            swap = rowDen;
            rowDen = spare;
            spare = swap;

            NativeInverse(invR_, rowDen);
            WeightedRows(ct_, invR_, spare);
            Axpy(spare, colDen, eps_, static_cast<int32_t>(kH));
            VectorDone();
            swap = colDen;
            colDen = spare;
            spare = swap;
        }

        // Final CT dot is complete. Product work is now dead, so start next
        // raw MTE2 before final row/column materialization of current C.
        if (hasNext) {
            BeginRawPrefetch(nextToken);
        }

        NativeInverse(invC_, colDen);
        ApplyRowVector(c_, invR_, true);
        const uint8_t stride =
            static_cast<uint8_t>(kPitch / kLocalBlockFloats);
        const BinaryRepeatParams columns{1, 1, 1, stride, stride, 0};
        // Final materialization stays in C. CT is never reused as output.
        Mul(c_, c_, invC_, uint64_t(64U),
            static_cast<uint8_t>(kH), columns);
        Mul(c_[64U], c_[64U], invC_[64U], uint64_t(kTail),
            static_cast<uint8_t>(kH), columns);
        VectorDone();
    }

    __aicore__ inline void MaterializeAndStore(uint64_t token)
    {
        SyncPipelines<HardEvent::V_MTE3>(*pipe_);
        StoreExact(pre_[token * kH], gates_, kH);
        StoreExact(post_[token * kH], gates_[kPitch], kH);
        const DataCopyExtParams storeRows{static_cast<uint16_t>(kH),
            static_cast<uint32_t>(kH * sizeof(float)),
            static_cast<uint32_t>((kPitch - kH) / kLocalBlockFloats), 0U, 0U};
        DataCopyPad(comb_[token * kH * kH], c_, storeRows);
        // Intentionally no prefetch or role exchange. The complete store drain
        // precedes the next token; gate buffers remain live until this drain.
        SyncPipelines<HardEvent::MTE3_V>(*pipe_);
    }

    TPipe* pipe_ = nullptr;
    TBuf<TPosition::VECCALC> poolBuf_;
    GlobalTensor<float> x_, pre_, post_, comb_;
    LocalTensor<float> rawPool_, pool_;
    LocalTensor<float> c_, ct_, den0_, den1_, den2_;
    LocalTensor<float> invR_, invC_, epsR_, epsC_, ones_;
    LocalTensor<float> gates_, broadcast_, rootVector_, work_;
    uint64_t first_ = 0;
    uint64_t end_ = 0;
    uint32_t iters_ = 1;
    uint32_t phaseBlocks_ = 0;
    float eps_ = 0.0f;
    static constexpr uint32_t kW = H * H + 2U * H;
};



// Route B: one UB-sized denominator-factor pipeline shared by H56/H64/H100.
// C=r0*(softmax+eps) and CT are resident. Each iteration advances only the
// row/column denominator vectors through weighted C/C^T reductions; the final
// matrix is materialized once. A dead transpose/product union slot receives
// the next raw token, and ping-pong gate slots hide the previous MTE3 drain.
constexpr uint32_t AlignUBFactorOffset(uint32_t value, uint32_t alignment)
{
    return (value + alignment - 1U) / alignment * alignment;
}

constexpr uint32_t MaxUBFactorValue(uint32_t first, uint32_t second)
{
    return first > second ? first : second;
}

template <uint32_t H>
class UBFactorPrefetchKernel {
    static_assert(H == 56U || H == 64U || H == 100U,
        "route B factor template is defined for H56/H64/H100");

public:
    static constexpr uint32_t PoolBytes()
    {
        return kPoolBytes;
    }

    __aicore__ inline void Init(GM_ADDR mixes, GM_ADDR pre, GM_ADDR post,
        GM_ADDR comb, uint64_t n, uint32_t iters, float eps,
        uint32_t tokenGroup, TPipe* pipe)
    {
        pipe_ = pipe;
        iters_ = iters;
        eps_ = eps;
        TokenRange(n, tokenGroup, first_, end_);
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(mixes));
        pre_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(pre));
        post_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(post));
        comb_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(comb));

        pipe_->InitBuffer(poolBuf_, kPoolBytes);
        rawPool_ = poolBuf_.Get<float>();
        const uint64_t rawAddress =
            reinterpret_cast<uint64_t>(rawPool_.GetPhyAddr());
        phaseBlocks_ = static_cast<uint32_t>((16U -
            ((rawAddress / 32U) % 16U)) % 16U);
        pool_ = rawPool_[phaseBlocks_ * kBlockFloats];

        c_ = Byte<kCByte>();
        ct_ = Byte<kCTByte>();
        den0_ = Byte<kDen0Byte>();
        den1_ = Byte<kDen1Byte>();
        den2_ = Byte<kDen2Byte>();
        invR_ = Byte<kInvRByte>();
        invC_ = Byte<kInvCByte>();
        epsR_ = Byte<kEpsRByte>();
        epsC_ = Byte<kEpsCByte>();
        ones_ = Byte<kOnesByte>();
        gates0_ = Byte<kGatesByte>();
        gates1_ = gates0_[2U * kPitch];
        gates_ = gates0_;
        broadcast_ = Byte<kBroadcastByte>();
        rootVector_ = Byte<kRootsByte>();
        work_ = Byte<kWorkByte>();

        Duplicate(c_, 0.0f, kRows * kPitch);
        Duplicate(ct_, 0.0f, kRows * kPitch);
        Duplicate(gates0_, 0.0f, 4U * kPitch);
        Duplicate(broadcast_, 0.0f, kBroadcastFloats);
        Duplicate(rootVector_, 0.0f, kRootFloats);
        Duplicate(work_, 0.0f, kWorkFloats);
        Duplicate(den0_, 1.0f, kPitch);
        Duplicate(den1_, 1.0f, kPitch);
        Duplicate(den2_, 1.0f, kPitch);
        Duplicate(invR_, 1.0f, kPitch);
        Duplicate(invC_, 1.0f, kPitch);
        Duplicate(epsR_, 1.0f, kPitch);
        Duplicate(epsC_, 1.0f, kPitch);
        Duplicate(ones_, 1.0f, kPitch);
        VectorDone();
    }

    __aicore__ inline void Process()
    {
        if (first_ >= end_) {
            return;
        }
        uint64_t token = first_;
        LoadToken(token);
        while (true) {
            ComputeGates();
            PrepareScaledE();
            WaitPendingOutputBeforeTranspose();
            TransposeCToCT();

            const bool hasNext = token + 1U < end_;
            const uint64_t nextToken = hasNext ? token + 1U : 0U;
            RunFactorizedSinkhornImpl(nextToken, hasNext);
            LaunchOutputStores(token, hasNext);
            if (!hasNext) {
                break;
            }
            PrepareNextFromRaw();
            token = nextToken;
        }
    }

private:
    static constexpr uint32_t kLocalBlockFloats = 8U;
    static constexpr uint32_t kPitch = H == 100U ? 120U : 64U;
    static constexpr uint32_t kRows = (H + 15U) / 16U * 16U;
    static constexpr uint32_t kH = H;
    static constexpr uint32_t kTail = H > 64U ? H - 64U : 0U;
    static constexpr uint32_t kTailRoots = (kTail + 7U) / 8U;
    static constexpr uint32_t kHGroups = (H + 7U) / 8U;
    static constexpr uint32_t kHBlockRounded = kHGroups * kLocalBlockFloats;
    static constexpr uint32_t kRightPad = kHBlockRounded - H;
    static constexpr uint32_t kDstGapBlocks =
        (kPitch - kHBlockRounded) / kLocalBlockFloats;
    static constexpr uint32_t kProductPitch = 64U;
    static constexpr uint32_t kStageSrcPitch = kPitch + 8U;
    static constexpr uint32_t kStageSrcFloats = 16U * kStageSrcPitch;
    static constexpr uint32_t kStageDstFloats = 128U * 16U;
    static constexpr uint32_t kStageFloats = kStageSrcFloats + kStageDstFloats;
    static constexpr uint32_t kProductFloats = H * kProductPitch;
    static constexpr uint32_t kGateWorkFloats = 4U * kPitch;
    static constexpr uint32_t kWorkFloats = MaxUBFactorValue(
        kProductFloats,
        MaxUBFactorValue(kStageFloats, kGateWorkFloats));
    static constexpr uint32_t kBroadcastFloats = kPitch * kLocalBlockFloats;
    static constexpr uint32_t kRootFloats = kPitch * kLocalBlockFloats;

    static constexpr uint32_t kCByte = 0U;
    static constexpr uint32_t kCTByte =
        AlignUBFactorOffset(kCByte + kRows * kPitch * sizeof(float), 512U);
    static constexpr uint32_t kDen0Byte =
        AlignUBFactorOffset(kCTByte + kRows * kPitch * sizeof(float), 32U);
    static constexpr uint32_t kDen1Byte =
        AlignUBFactorOffset(kDen0Byte + kPitch * sizeof(float), 32U);
    static constexpr uint32_t kDen2Byte =
        AlignUBFactorOffset(kDen1Byte + kPitch * sizeof(float), 32U);
    static constexpr uint32_t kInvRByte =
        AlignUBFactorOffset(kDen2Byte + kPitch * sizeof(float), 32U);
    static constexpr uint32_t kInvCByte =
        AlignUBFactorOffset(kInvRByte + kPitch * sizeof(float), 32U);
    static constexpr uint32_t kEpsRByte =
        AlignUBFactorOffset(kInvCByte + kPitch * sizeof(float), 32U);
    static constexpr uint32_t kEpsCByte =
        AlignUBFactorOffset(kEpsRByte + kPitch * sizeof(float), 32U);
    static constexpr uint32_t kOnesByte =
        AlignUBFactorOffset(kEpsCByte + kPitch * sizeof(float), 32U);
    static constexpr uint32_t kGatesByte =
        AlignUBFactorOffset(kOnesByte + kPitch * sizeof(float), 32U);
    static constexpr uint32_t kBroadcastByte =
        AlignUBFactorOffset(kGatesByte + 4U * kPitch * sizeof(float), 32U);
    static constexpr uint32_t kRootsByte =
        AlignUBFactorOffset(kBroadcastByte + kBroadcastFloats * sizeof(float), 32U);
    static constexpr uint32_t kWorkByte =
        AlignUBFactorOffset(kRootsByte + kRootFloats * sizeof(float), 512U);
    static constexpr uint32_t kPlannedEndByte =
        kWorkByte + kWorkFloats * sizeof(float);
    static constexpr uint32_t kPoolBytes =
        AlignUBFactorOffset(kPlannedEndByte, 512U) + 512U;

    static_assert(kRows >= H, "rounded row panel covers H");
    static_assert(kTailRoots <= 8U, "H100 tail fits one BR8 root");
    static_assert(kProductFloats <= kWorkFloats, "product fits work union");
    static_assert(kStageFloats <= kWorkFloats, "transpose stage fits work union");
    static_assert(kGateWorkFloats <= kWorkFloats, "gate scratch fits work union");
    static_assert(kBroadcastFloats >= H * kLocalBlockFloats,
        "row broadcasts cover H");
    static_assert(kRootFloats >= H * kLocalBlockFloats,
        "reduction roots cover H");

    template <uint32_t ByteOffset>
    __aicore__ inline LocalTensor<float> Byte()
    {
        static_assert(ByteOffset % 4U == 0U,
            "float offset must be word aligned");
        return pool_[ByteOffset / sizeof(float)];
    }

    __aicore__ inline void LoadToken(uint64_t token)
    {
        SyncPipelines<HardEvent::V_MTE2>(*pipe_);
        const uint64_t inputBase = token * kW;
        LoadExact(gates_, x_[inputBase], kH);
        LoadExact(gates_[kPitch], x_[inputBase + kH], kH);
        const DataCopyExtParams loadRows{static_cast<uint16_t>(kH),
            static_cast<uint32_t>(kH * sizeof(float)), 0U,
            static_cast<uint32_t>(kDstGapBlocks), 0U};
        const DataCopyPadExtParams<float> padding{true, 0U, static_cast<uint8_t>(kRightPad), 0.0f};
        DataCopyPad(c_, x_[inputBase + 2U * kH], loadRows, padding);
        SyncPipelines<HardEvent::MTE2_V>(*pipe_);
    }

    __aicore__ inline void ComputeGates()
    {
        SigmoidInPlace(gates_, work_, work_[2U * kPitch], 2U * kPitch);
        Adds(gates_, gates_, eps_, kH);
        Muls(gates_[kPitch], gates_[kPitch], 2.0f, kH);
        VectorDone();
    }

    __aicore__ inline void BroadcastRows(const LocalTensor<float>& scale,
        const LocalTensor<float>& destination)
    {
        Brcb(destination, scale,
            static_cast<uint8_t>(kHGroups), {1, 8});
        VectorDone();
    }

    __aicore__ inline void ApplyRowVector(const LocalTensor<float>& matrix,
        const LocalTensor<float>& rowValues, bool multiply)
    {
        BroadcastRows(rowValues, broadcast_);
        const BinaryRepeatParams rows{1, 1, 0,
            static_cast<uint8_t>(kPitch / kLocalBlockFloats),
            static_cast<uint8_t>(kPitch / kLocalBlockFloats), 1};
        if (multiply) {
            Mul(matrix, matrix, broadcast_, uint64_t(64U),
                static_cast<uint8_t>(kH), rows);
            if constexpr (H > 64U) {
                Mul(matrix[64U], matrix[64U], broadcast_, uint64_t(kTail),
                    static_cast<uint8_t>(kH), rows);
            }
        } else {
            Add(matrix, matrix, broadcast_, uint64_t(64U),
                static_cast<uint8_t>(kH), rows);
            if constexpr (H > 64U) {
                Add(matrix[64U], matrix[64U], broadcast_, uint64_t(kTail),
                    static_cast<uint8_t>(kH), rows);
            }
        }
        VectorDone();
    }

    __aicore__ inline void ReduceRows(const LocalTensor<float>& src,
        const LocalTensor<float>& dst)
    {
        auto headRoots = rootVector_;
        BlockReduceSum(headRoots, src, static_cast<int32_t>(kH), 64,
            1, 1, static_cast<int32_t>(kPitch / kLocalBlockFloats));
        if constexpr (H > 64U) {
            auto tailRoots = broadcast_;
            BlockReduceSum(tailRoots, src[64U], static_cast<int32_t>(kH),
                static_cast<int32_t>(kTail), 1, 1,
                static_cast<int32_t>(kPitch / kLocalBlockFloats));
            VectorDone();
            const BinaryRepeatParams compactRows{1, 1, 1, 1, 1, 1};
            Add(headRoots, headRoots, tailRoots, uint64_t(kTailRoots),
                static_cast<uint8_t>(kH), compactRows);
        }
        VectorDone();
        BlockReduceSum(dst, headRoots, static_cast<int32_t>(kHGroups),
            64, 1, 1, 8);
        VectorDone();
    }

    __aicore__ inline void PrepareScaledE()
    {
        const uint8_t stride =
            static_cast<uint8_t>(kPitch / kLocalBlockFloats);
        const uint8_t repeats = static_cast<uint8_t>(kH);
        const BinaryRepeatParams rows{1, 1, 0, stride, stride, 1};
        const UnaryRepeatParams elementwise{1, 1, stride, stride};

        Adds(work_, c_, 0.0f, uint64_t(64U), repeats, {1, 1, 8, stride});
        if constexpr (H > 64U) {
            Max(work_, work_, c_[64U], uint64_t(kTail), repeats,
                {1, 1, 1, 8, 8, stride});
        }
        VectorDone();
        BlockReduceMax(rootVector_, work_, static_cast<int32_t>(kH),
            64, 1, 1, 8);
        VectorDone();
        BlockReduceMax(invR_, rootVector_, static_cast<int32_t>(kHGroups),
            64, 1, 1, 8);
        VectorDone();
        BroadcastRows(invR_, broadcast_);
        Sub(c_, c_, broadcast_, uint64_t(64U), repeats, rows);
        if constexpr (H > 64U) {
            Sub(c_[64U], c_[64U], broadcast_, uint64_t(kTail), repeats, rows);
        }
        VectorDone();
        Exp(c_, c_, uint64_t(64U), repeats, elementwise);
        if constexpr (H > 64U) {
            Exp(c_[64U], c_[64U], uint64_t(kTail), repeats, elementwise);
        }
        if constexpr (H < 64U) {
            // H56 uses a 64-lane VEC count. Exp(0) would contribute ones from
            // columns 56..63, so explicitly mask those eight lanes before
            // either the row sum or the later weighted reductions consume them.
            Muls(c_[kH], c_[kH], 0.0f, uint64_t(kPitch - kH),
                repeats, elementwise);
        }
        VectorDone();

        ReduceRows(c_, den0_);
        Muls(epsR_, den0_, eps_, kH);
        VectorDone();
        ApplyRowVector(c_, epsR_, false);
        if constexpr (H < 64U) {
            // ApplyRowVector deliberately covers a full 64-lane row. Restore
            // neutral padding after adding eps*S so no padded lane can enter a
            // later weighted column dot or transpose tile.
            Muls(c_[kH], c_[kH], 0.0f, uint64_t(kPitch - kH),
                repeats, elementwise);
            VectorDone();
        }
    }

    __aicore__ inline void TransposeCToCT()
    {
        auto stageSrc = work_;
        auto stageDst = work_[kStageSrcFloats];
        // The union held matrix products earlier. Clear all staging lanes so
        // H100's final four vector lanes are neutral before the ceil(H/8)
        // transpose repeats consume the 96..103 tile.
        if constexpr (H == 100U) {
            Duplicate(stageSrc, 0.0f, kStageSrcFloats);
            VectorDone();
        }
        alignas(32) uint64_t srcVa[16];
        alignas(32) uint64_t dstVa[16];
        const TransDataTo5HDParams params{false, false,
            static_cast<uint8_t>(kHGroups), 16U, 1U};
        const UnaryRepeatParams copyToStage{
            1, 1, static_cast<uint8_t>(kStageSrcPitch / 8U),
            static_cast<uint8_t>(kPitch / 8U)};
        const UnaryRepeatParams copyToCT{
            1, 1, static_cast<uint8_t>(kPitch / 8U), 2U};

        for (uint32_t i = 0; i < 16U; ++i) {
            srcVa[i] = reinterpret_cast<uint64_t>(
                stageSrc[i * kStageSrcPitch].GetPhyAddr());
        }
        for (uint32_t j = 0; j < 8U; ++j) {
            dstVa[2U * j] = reinterpret_cast<uint64_t>(
                stageDst[j * 16U].GetPhyAddr());
            dstVa[2U * j + 1U] = reinterpret_cast<uint64_t>(
                stageDst[j * 16U + 8U].GetPhyAddr());
        }

        for (uint32_t block = 0; block < kRows; block += 16U) {
            Adds(stageSrc, c_[block * kPitch], 0.0f, uint64_t(64U),
                16U, copyToStage);
            if constexpr (H > 64U) {
                Adds(stageSrc[64U], c_[block * kPitch + 64U], 0.0f,
                    uint64_t(kTail), 16U, copyToStage);
            }
            VectorDone();
            TransDataTo5HD<float>(dstVa, srcVa, params);
            VectorDone();
            Adds(ct_[block], stageDst, 0.0f, uint64_t(16U),
                static_cast<uint8_t>(kH), copyToCT);
            VectorDone();
        }
        if constexpr (H < kRows) {
            // The last source-row tile includes dummy rows. Their source values
            // are zero, but clear the corresponding CT rows explicitly so an
            // old CT incarnation can never leak them into a weighted dot.
            auto dummyRows = ct_[kH * kPitch];
            Muls(dummyRows, dummyRows, 0.0f,
                uint32_t((kRows - kH) * kPitch));
            VectorDone();
        }
    }

    __aicore__ inline void ReduceProduct(const LocalTensor<float>& dst)
    {
        auto roots = rootVector_;
        BlockReduceSum(roots, work_, static_cast<int32_t>(kH), 64,
            1, 1, static_cast<int32_t>(kProductPitch / 8U));
        VectorDone();
        BlockReduceSum(dst, roots, static_cast<int32_t>(kHGroups),
            64, 1, 1, 8);
        VectorDone();
    }

    __aicore__ inline void WeightedRows(const LocalTensor<float>& src,
        const LocalTensor<float>& weights, const LocalTensor<float>& dst)
    {
        const uint8_t repeats = static_cast<uint8_t>(kH);
        const BinaryRepeatParams headSteps{1, 1, 1, 8,
            static_cast<uint8_t>(kPitch / 8U), 0};
        const BinaryRepeatParams tailSteps{1, 1, 1, 8,
            static_cast<uint8_t>(kPitch / 8U), 0};
        Mul(work_, src, weights, uint64_t(64U), repeats, headSteps);
        if constexpr (H > 64U) {
            VectorDone();
            MulAddDst(work_, src[64U], weights[64U], uint64_t(kTail),
                repeats, tailSteps);
        }
        if constexpr (H < 64U) {
            // Mul has a 64-lane mask for H56. Zero lanes 56..63 in the compact
            // product before the row-ordered reduction so padded weights and
            // CT dummy rows cannot contribute.
            const UnaryRepeatParams compactProduct{1, 1, 8, 8};
            Muls(work_[kH], work_[kH], 0.0f, uint64_t(kPitch - kH),
                repeats, compactProduct);
        }
        VectorDone();
        ReduceProduct(dst);
    }

    __aicore__ inline void NativeInverse(const LocalTensor<float>& dst,
        const LocalTensor<float>& den)
    {
        Div(dst, ones_, den, static_cast<int32_t>(kH));
        VectorDone();
    }

    __aicore__ inline void BeginRawPrefetch(uint64_t nextToken)
    {
        // H100 makes a contiguous [pre=H][post=H] raw staging view unsafe:
        // its post slice begins at byte 400, which is not a 32-byte VEC
        // boundary. Load gates directly into the inactive ping-pong slot and
        // load the next matrix directly into dead CT at the padded pitch.
        // H56/H64 use this same path, so no dense H-wide row has to be
        // represented by an integer VEC repeat stride.
        SyncPipelines<HardEvent::V_MTE2>(*pipe_);
        auto nextGates = currentGateSecond_ ? gates0_ : gates1_;
        const uint64_t inputBase = nextToken * kW;
        LoadExact(nextGates, x_[inputBase], kH);
        LoadExact(nextGates[kPitch], x_[inputBase + kH], kH);
        // CT has finished its final weighted dot. Reuse it directly as the
        // padded next matrix. DataCopyPad advances through the dense H-wide GM
        // rows while applying the real pitch to the UB destination, so H100
        // never asks a VEC repeat stride to represent 100/8 blocks.
        auto nextMatrix = ct_;
        const DataCopyExtParams loadRows{static_cast<uint16_t>(kH),
            static_cast<uint32_t>(kH * sizeof(float)), 0U,
            static_cast<uint32_t>(kDstGapBlocks), 0U};
        const DataCopyPadExtParams<float> padding{true, 0U, static_cast<uint8_t>(kRightPad), 0.0f};
        DataCopyPad(nextMatrix, x_[inputBase + 2U * kH], loadRows, padding);
    }

    __aicore__ inline void RunFactorizedSinkhornImpl(uint64_t nextToken,
        bool hasNext)
    {
        LocalTensor<float> rowDen = den0_;
        LocalTensor<float> colDen = den1_;
        LocalTensor<float> spare = den2_;

        NativeInverse(invR_, rowDen);
        WeightedRows(ct_, invR_, spare);
        Adds(spare, spare, eps_, static_cast<int32_t>(kH));
        VectorDone();
        LocalTensor<float> swap = colDen;
        colDen = spare;
        spare = swap;

        for (uint32_t iter = 1U; iter < iters_; ++iter) {
            NativeInverse(invC_, colDen);
            WeightedRows(c_, invC_, spare);
            Axpy(spare, rowDen, eps_, static_cast<int32_t>(kH));
            VectorDone();
            swap = rowDen;
            rowDen = spare;
            spare = swap;

            NativeInverse(invR_, rowDen);
            WeightedRows(ct_, invR_, spare);
            Axpy(spare, colDen, eps_, static_cast<int32_t>(kH));
            VectorDone();
            swap = colDen;
            colDen = spare;
            spare = swap;
        }

        if (hasNext) {
            BeginRawPrefetch(nextToken);
        }

        NativeInverse(invC_, colDen);
        ApplyRowVector(c_, invR_, true);
        const uint8_t stride =
            static_cast<uint8_t>(kPitch / kLocalBlockFloats);
        const BinaryRepeatParams columns{1, 1, 1, stride, stride, 0};
        Mul(c_, c_, invC_, uint64_t(64U),
            static_cast<uint8_t>(kH), columns);
        if constexpr (H > 64U) {
            Mul(c_[64U], c_[64U], invC_[64U], uint64_t(kTail),
                static_cast<uint8_t>(kH), columns);
        }
        VectorDone();
    }

    __aicore__ inline void WaitPendingOutputBeforeTranspose()
    {
        if (pendingOutput_) {
            WaitFlag<HardEvent::MTE3_V>(pendingOutputEvent_);
            pendingOutput_ = false;
            pendingOutputEvent_ = -1;
        }
    }

    __aicore__ inline void LaunchOutputStores(uint64_t token, bool deferDrain)
    {
        SyncPipelines<HardEvent::V_MTE3>(*pipe_);
        StoreExact(pre_[token * kH], gates_, kH);
        StoreExact(post_[token * kH], gates_[kPitch], kH);
        const DataCopyExtParams storeRows{static_cast<uint16_t>(kH),
            static_cast<uint32_t>(kH * sizeof(float)),
            static_cast<uint32_t>(kDstGapBlocks), 0U, 0U};
        DataCopyPad(comb_[token * kH * kH], c_, storeRows);

        if (deferDrain) {
            pendingOutputEvent_ =
                static_cast<int32_t>(pipe_->FetchEventID(HardEvent::MTE3_V));
            SetFlag<HardEvent::MTE3_V>(pendingOutputEvent_);
            pendingOutput_ = true;
        } else {
            SyncPipelines<HardEvent::MTE3_V>(*pipe_);
        }
    }

    __aicore__ inline void PrepareNextFromRaw()
    {
        auto nextGates = currentGateSecond_ ? gates0_ : gates1_;
        // BeginRawPrefetch already wrote the next matrix into the dead CT
        // buffer with a padded destination pitch. Wait for DMA completion
        // before exposing it as C for the next token.
        SyncPipelines<HardEvent::MTE2_V>(*pipe_);
        auto oldC = c_;
        c_ = ct_;
        ct_ = oldC;
        gates_ = nextGates;
        currentGateSecond_ = !currentGateSecond_;
    }

    TPipe* pipe_ = nullptr;
    TBuf<TPosition::VECCALC> poolBuf_;
    GlobalTensor<float> x_, pre_, post_, comb_;
    LocalTensor<float> rawPool_, pool_;
    LocalTensor<float> c_, ct_, den0_, den1_, den2_;
    LocalTensor<float> invR_, invC_, epsR_, epsC_, ones_;
    LocalTensor<float> gates0_, gates1_, gates_, broadcast_;
    LocalTensor<float> rootVector_, work_;
    uint64_t first_ = 0;
    uint64_t end_ = 0;
    uint32_t iters_ = 1;
    uint32_t phaseBlocks_ = 0;
    bool currentGateSecond_ = false;
    bool pendingOutput_ = false;
    int32_t pendingOutputEvent_ = -1;
    float eps_ = 0.0f;
    static constexpr uint32_t kW = H * H + 2U * H;
};

template <uint32_t H>
inline bool UBFactorUbReady(uint64_t availableUbBytes)
{
    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform == nullptr) {
        return false;
    }
    uint64_t physicalUbBytes = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, physicalUbBytes);
    if (physicalUbBytes <= 16U * 1024U) {
        return false;
    }
    const uint64_t queriedUbBytes =
        (physicalUbBytes - 16U * 1024U) / 32U * 32U;
    return UBFactorPrefetchKernel<H>::PoolBytes() <= availableUbBytes &&
        UBFactorPrefetchKernel<H>::PoolBytes() <= queriedUbBytes;
}

// F2 owner pipeline. It extends the reviewed F0 arithmetic core and changes
// only token IO lifetime, C/CT roles, and gate-slot ownership.
class F2IoPipelineFactorKernel : public F0StaticFactorQ1Kernel<88U> {
    using Base = F0StaticFactorQ1Kernel<88U>;

public:
    __aicore__ inline void Init(GM_ADDR mixes, GM_ADDR pre, GM_ADDR post,
        GM_ADDR comb, uint64_t n, uint32_t iters, float eps,
        uint32_t tokenGroup, TPipe* pipe)
    {
        Base::Init(mixes, pre, post, comb, n, iters, eps, tokenGroup, pipe);
        gates0_ = Base::gates_;
        gates1_ = Base::gates_[2U * Base::kPitch];
        Duplicate(gates1_, 0.0f, 2U * Base::kPitch);
        VectorDone();
        currentGateSecond_ = false;
        pendingOutputEvent_ = -1;
        pendingOutput_ = false;
    }

    __aicore__ inline void Process()
    {
        if (first_ >= end_) {
            return;
        }
        uint64_t token = first_;
        LoadToken(token);
        while (true) {
            ComputeGates();
            PrepareScaledE();
            WaitPendingOutputBeforeTranspose();
            TransposeCToCT();

            const bool hasNext = token + 1U < end_;
            const uint64_t nextToken = hasNext ? token + 1U : 0U;
            RunFactorizedSinkhornImpl(nextToken, hasNext);
            LaunchOutputStores(token, hasNext);
            if (!hasNext) {
                break;
            }
            PrepareNextFromRaw();
            token = nextToken;
        }
    }

private:
    __aicore__ inline void WaitPendingOutputBeforeTranspose()
    {
        if (pendingOutput_) {
            WaitFlag<HardEvent::MTE3_V>(pendingOutputEvent_);
            pendingOutput_ = false;
            pendingOutputEvent_ = -1;
        }
    }

    __aicore__ inline void LaunchOutputStores(uint64_t token, bool deferDrain)
    {
        SyncPipelines<HardEvent::V_MTE3>(*pipe_);
        StoreExact(pre_[token * Base::kH], gates_, Base::kH);
        StoreExact(post_[token * Base::kH], gates_[Base::kPitch], Base::kH);
        const DataCopyExtParams storeRows{static_cast<uint16_t>(Base::kH),
            static_cast<uint32_t>(Base::kH * sizeof(float)),
            static_cast<uint32_t>((Base::kPitch - Base::kH) /
                Base::kLocalBlockFloats), 0U, 0U};
        DataCopyPad(comb_[token * Base::kH * Base::kH], c_, storeRows);

        if (deferDrain) {
            pendingOutputEvent_ =
                static_cast<int32_t>(pipe_->FetchEventID(HardEvent::MTE3_V));
            SetFlag<HardEvent::MTE3_V>(pendingOutputEvent_);
            pendingOutput_ = true;
        } else {
            SyncPipelines<HardEvent::MTE3_V>(*pipe_);
        }
    }

    __aicore__ inline void PrepareNextFromRaw()
    {
        SyncPipelines<HardEvent::MTE2_V>(*pipe_);
        auto nextMatrix = ct_;
        auto nextGates = currentGateSecond_ ? gates0_ : gates1_;

        Adds(nextGates, work_, 0.0f, Base::kH);
        Adds(nextGates[Base::kPitch], work_[Base::kH], 0.0f, Base::kH);

        const UnaryRepeatParams repackRows{1, 1,
            static_cast<uint8_t>(Base::kPitch / Base::kLocalBlockFloats),
            static_cast<uint8_t>(Base::kH / Base::kLocalBlockFloats)};
        Adds(nextMatrix, work_[2U * Base::kH], 0.0f, uint64_t(64U),
            static_cast<uint8_t>(Base::kH), repackRows);
        Adds(nextMatrix[64U], work_[2U * Base::kH + 64U], 0.0f,
            uint64_t(Base::kTail), static_cast<uint8_t>(Base::kH),
            repackRows);
        VectorDone();

        auto oldC = c_;
        c_ = ct_;
        ct_ = oldC;
        gates_ = nextGates;
        currentGateSecond_ = !currentGateSecond_;
    }

    LocalTensor<float> gates0_, gates1_;
    bool currentGateSecond_ = false;
    bool pendingOutput_ = false;
    int32_t pendingOutputEvent_ = -1;
};

// Dedicated H==64 interleaved scaled batch. The physical matrix is
// [row = H][token = valid][lane = 64]: one physical row holds valid*64
// contiguous floats, so consecutive 64-float chunks enumerate every token
// row exactly once. Row reductions keep the C6 H64 BR8 tree; column
// normalization walks physical rows 0..63 in order for every real column
// lane, sharing one vector recurrence across the batched tokens.
class H64InterleavedScaledBatchKernel {
public:
    __aicore__ inline void Init(GM_ADDR mixes, GM_ADDR pre, GM_ADDR post,
        GM_ADDR comb, uint64_t n, uint32_t h, uint32_t iters, float eps,
        uint32_t tokenGroup, uint32_t q, TPipe* pipe)
    {
        pipe_ = pipe;
        h_ = h;
        q_ = q;
        pitch_ = (h + 7) / 8 * 8;
        panel_ = q_ * h_;
        w_ = h_ * h_ + 2 * h_;
        iters_ = iters;
        eps_ = eps;
        TokenRange(n, tokenGroup, first_, end_);
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(mixes));
        pre_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(pre));
        post_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(post));
        comb_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(comb));
        pipe_->InitBuffer(matrixQueue_, 1, q_ * h_ * pitch_ * sizeof(float));
        pipe_->InitBuffer(gatesQueue_, 1, 2 * panel_ * sizeof(float));
        pipe_->InitBuffer(ubBankPadBeforeScratch_, kResidentScaledKernelUbBankPaddingBytes);
        pipe_->InitBuffer(factorsBuf_, 3 * panel_ * sizeof(float));
        pipe_->InitBuffer(rootsBuf_, 8 * panel_ * sizeof(float));
        pipe_->InitBuffer(broadcastBuf_, 8 * panel_ * sizeof(float));
        pipe_->InitBuffer(gateScratchBuf_, 4 * panel_ * sizeof(float));
        factors_ = factorsBuf_.Get<float>();
        roots_ = rootsBuf_.Get<float>();
        broadcast_ = broadcastBuf_.Get<float>();
        gateScratch_ = gateScratchBuf_.Get<float>();
        ones_ = factors_;
        rowScale_ = factors_[panel_];
        sum_ = factors_[2 * panel_];
        Duplicate(ones_, 1.0f, panel_);
        VectorDone();
    }

    __aicore__ inline void Process()
    {
        for (uint64_t token = first_; token < end_; token += q_) {
            const uint32_t valid = static_cast<uint32_t>(
                end_ - token < q_ ? end_ - token : q_);
            rows_ = valid * h_;
            columnElements_ = valid * pitch_;
            auto gates = gatesQueue_.AllocTensor<float>();
            auto matrix = matrixQueue_.AllocTensor<float>();
            // Each input token occupies one 64-float slot per physical row.
            // No dummy token is loaded; the tail batch leaves the reserved
            // q slots beyond valid untouched.
            const uint32_t ubRowGap = (valid - 1) * pitch_ / kBlockFloats;
            const DataCopyExtParams loadRows{static_cast<uint16_t>(h_),
                static_cast<uint32_t>(h_ * sizeof(float)), 0, ubRowGap, 0};
            const DataCopyExtParams storeRows{static_cast<uint16_t>(h_),
                static_cast<uint32_t>(h_ * sizeof(float)), ubRowGap, 0, 0};
            const DataCopyPadExtParams<float> padding{
                true, 0, static_cast<uint8_t>(pitch_ - h_), 0.0f};
            for (uint32_t t = 0; t < valid; ++t) {
                const uint64_t inputBase = (token + t) * w_;
                LoadExact(gates[2 * t * pitch_], x_[inputBase], h_);
                LoadExact(gates[(2 * t + 1) * pitch_], x_[inputBase + h_], h_);
                DataCopyPad(matrix[t * pitch_], x_[inputBase + 2 * h_], loadRows, padding);
            }
            gatesQueue_.EnQue(gates);
            matrixQueue_.EnQue(matrix);
            gates = gatesQueue_.DeQue<float>();
            matrix = matrixQueue_.DeQue<float>();

            const uint32_t gateCount = 2 * valid * pitch_;
            SigmoidInPlace(gates, gateScratch_, gateScratch_[2 * panel_], gateCount);
            for (uint32_t t = 0; t < valid; ++t) {
                Adds(gates[2 * t * pitch_], gates[2 * t * pitch_], eps_, h_);
                Muls(gates[(2 * t + 1) * pitch_], gates[(2 * t + 1) * pitch_], 2.0f, h_);
            }
            VectorDone();

            RowSoftmax(matrix);
            NormalizeColumns(matrix);
            for (uint32_t iter = 1; iter < iters_; ++iter) {
                NormalizeRows(matrix);
                NormalizeColumns(matrix);
            }

            SyncPipelines<HardEvent::V_MTE3>(*pipe_);
            for (uint32_t t = 0; t < valid; ++t) {
                StoreExact(pre_[(token + t) * h_], gates[2 * t * pitch_], h_);
                StoreExact(post_[(token + t) * h_], gates[(2 * t + 1) * pitch_], h_);
                DataCopyPad(comb_[(token + t) * h_ * h_], matrix[t * pitch_], storeRows);
            }
            SyncPipelines<HardEvent::MTE3_V>(*pipe_);
            gatesQueue_.FreeTensor(gates);
            matrixQueue_.FreeTensor(matrix);
        }
    }

private:
    // 248 is the largest multiple of eight below 255; chunk starts keep every
    // scalar statistic destination 32-byte aligned.
    static constexpr uint32_t kRowRepeatChunk = 248;

    __aicore__ inline uint32_t RowRepeats(uint32_t first) const
    {
        return rows_ - first < kRowRepeatChunk ? rows_ - first : kRowRepeatChunk;
    }

    __aicore__ inline void Broadcast(const LocalTensor<float>& source)
    {
        // One 32-byte block per token row, holding eight copies of its scalar.
        Brcb(broadcast_, source, static_cast<uint8_t>(rows_ / kBlockFloats), {1, 8});
        VectorDone();
    }

    // Exact C6 H64 BR8 row tree, batched to q*valid rows. The first
    // count-mode BlockReduceSum packs eight lane roots per token row; the
    // second sums each eight-root block, which is the same three adjacent
    // pair levels as ResidentScaledMatrixKernel<1, true>. No whole-row
    // WholeReduceSum is used and no cross-row arithmetic is introduced.
    __aicore__ inline void ReduceRows(const LocalTensor<float>& matrix)
    {
        SetMaskCount();
        SetVectorMask<float, MaskMode::COUNTER>(uint64_t(0),
            uint64_t(rows_ * kVectorFloats));
        BlockReduceSum<float, false>(roots_, matrix, 1,
            static_cast<int32_t>(MASK_PLACEHOLDER), 1, 1, 8);
        SetMaskNorm();
        ResetMask();
        VectorDone();
        const uint32_t rootsCount = rows_ * kBlockFloats;
        SetMaskCount();
        SetVectorMask<float, MaskMode::COUNTER>(uint64_t(0), uint64_t(rootsCount));
        BlockReduceSum<float, false>(sum_, roots_, 1,
            static_cast<int32_t>(MASK_PLACEHOLDER), 1, 1, 8);
        SetMaskNorm();
        ResetMask();
        VectorDone();
    }

    // Per token row, one 32-byte block of the broadcast panel is reused for
    // all 64 lanes (src1 block stride 0) while repeats walk physical rows.
    __aicore__ inline void ApplyRowMaxSubtract(const LocalTensor<float>& matrix)
    {
        const BinaryRepeatParams steps{1, 1, 0,
            static_cast<uint8_t>(pitch_ / kBlockFloats),
            static_cast<uint8_t>(pitch_ / kBlockFloats), 1};
        for (uint32_t first = 0; first < rows_; first += kRowRepeatChunk) {
            const uint8_t repeats = static_cast<uint8_t>(RowRepeats(first));
            Sub(matrix[first * pitch_], matrix[first * pitch_],
                broadcast_[first * kBlockFloats], uint64_t(kVectorFloats),
                repeats, steps);
        }
        VectorDone();
    }

    template <bool divide>
    __aicore__ inline void ApplyRowScale(const LocalTensor<float>& matrix)
    {
        const BinaryRepeatParams steps{1, 1, 0,
            static_cast<uint8_t>(pitch_ / kBlockFloats),
            static_cast<uint8_t>(pitch_ / kBlockFloats), 1};
        for (uint32_t first = 0; first < rows_; first += kRowRepeatChunk) {
            const uint8_t repeats = static_cast<uint8_t>(RowRepeats(first));
            if (divide) {
                Div(matrix[first * pitch_], matrix[first * pitch_],
                    broadcast_[first * kBlockFloats], uint64_t(kVectorFloats),
                    repeats, steps);
            } else {
                Mul(matrix[first * pitch_], matrix[first * pitch_],
                    broadcast_[first * kBlockFloats], uint64_t(kVectorFloats),
                    repeats, steps);
            }
        }
        VectorDone();
    }

    __aicore__ inline void RowSoftmax(const LocalTensor<float>& matrix)
    {
        for (uint32_t first = 0; first < rows_; first += kRowRepeatChunk) {
            const uint8_t repeats = static_cast<uint8_t>(RowRepeats(first));
            WholeReduceMax(sum_[first], matrix[first * pitch_],
                static_cast<int32_t>(kVectorFloats), static_cast<int32_t>(repeats),
                1, 1, static_cast<int32_t>(pitch_ / kBlockFloats),
                ReduceOrder::ORDER_ONLY_VALUE);
        }
        VectorDone();
        Broadcast(sum_);
        ApplyRowMaxSubtract(matrix);
        // Complete H==64 rows have no padding: exp the whole active prefix.
        Exp(matrix, matrix, static_cast<int32_t>(rows_ * kVectorFloats));
        VectorDone();
        ReduceRows(matrix);
        Broadcast(sum_);
        ApplyRowScale<true>(matrix);
        Adds(matrix, matrix, eps_, static_cast<int32_t>(rows_ * kVectorFloats));
        VectorDone();
    }

    __aicore__ inline void NormalizeColumns(const LocalTensor<float>& matrix)
    {
        const uint32_t elements = columnElements_;
        // Physical row r owns the same [token][lane] columns for every token.
        // Seed with row 0, then add physical rows 1..63 in original order.
        Adds(sum_, matrix, 0.0f, elements);
        VectorDone();
        const uint8_t rowStride = static_cast<uint8_t>(elements / kBlockFloats);
        const BinaryRepeatParams accumulate{1, 1, 1, 0, rowStride, 0};
        for (uint32_t col = 0; col < elements; col += kVectorFloats) {
            Add(sum_[col], matrix[elements + col], sum_[col],
                uint64_t(kVectorFloats), static_cast<uint8_t>(h_ - 1), accumulate);
        }
        VectorDone();
        Adds(sum_, sum_, eps_, elements);
        VectorDone();
        Div(rowScale_, ones_, sum_, elements);
        VectorDone();
        const BinaryRepeatParams steps{1, 1, 1, rowStride, rowStride, 0};
        for (uint32_t col = 0; col < elements; col += kVectorFloats) {
            Mul(matrix[col], matrix[col], rowScale_[col], uint64_t(kVectorFloats),
                static_cast<uint8_t>(h_), steps);
        }
        VectorDone();
    }

    __aicore__ inline void NormalizeRows(const LocalTensor<float>& matrix)
    {
        ReduceRows(matrix);
        Adds(sum_, sum_, eps_, rows_);
        VectorDone();
        Div(rowScale_, ones_, sum_, rows_);
        VectorDone();
        Broadcast(rowScale_);
        ApplyRowScale<false>(matrix);
    }

    TPipe* pipe_;
    TQue<QuePosition::VECIN, 1> matrixQueue_, gatesQueue_;
    TBuf<TPosition::VECCALC> ubBankPadBeforeScratch_, factorsBuf_, rootsBuf_;
    TBuf<TPosition::VECCALC> broadcastBuf_, gateScratchBuf_;
    GlobalTensor<float> x_, pre_, post_, comb_;
    LocalTensor<float> factors_, roots_, broadcast_, gateScratch_;
    LocalTensor<float> ones_, rowScale_, sum_;
    uint64_t first_, end_;
    uint32_t h_, pitch_, q_, panel_, w_, iters_, rows_, columnElements_;
    float eps_;
};

// Multiple independent row-major matrices share each stage barrier. No sum
// crosses token boundaries. Each row retains its original 64-element trees,
// and each column retains rows 0,1,...,H-1 recurrence order.
// Only UB allocation offsets change; shared padding is included in host accounting.
constexpr uint32_t kResidentTokenBatchKernelUbBankPaddingBytes = 256;
constexpr uint32_t kMaxResidentTokenBatch = 8;
// The high bit carries a host-checked UB allocation choice, not input data.
constexpr uint32_t kShortRowDivPanelFlag = uint32_t(1) << 31;
// Optional physical tail rows are selected only after the original q and Div
// panel choices. The host accounts their bytes; capacity failure keeps old WR.
constexpr uint32_t kShortRowTailBrFlag = uint32_t(1) << 30;
// Bulk input staging is admitted independently for full q8 compact batches.
// It reuses the dead broadcast allocation for the contiguous input panel.
constexpr uint32_t kBulkInputGatherFlag = uint32_t(1) << 29;
// Cpack output metadata travels in the existing packed q word.
constexpr uint32_t kLowIterOutputPackFlag = uint32_t(1) << 28;
// Transpose only the reduction view: one BR repeat reads the same eight-column
// block from eight independent physical rows and writes eight adjacent roots.
// The caller supplies dead broadcast storage, with at least eight root planes.
// All active roots are written by this invocation; no empty-block BR value is read.
__aicore__ inline void ReduceShortRowsStridedBlockTree(
    const LocalTensor<float>& matrix, const LocalTensor<float>& stats,
    const LocalTensor<float>& roots, uint32_t h, uint32_t pitch,
    uint32_t rows, uint32_t planeStride, uint64_t partialBlockMask,
    bool pruneInactiveZeros = false)
{
    const uint32_t fullRows = rows / kBlockFloats * kBlockFloats;
    const uint32_t groups = fullRows / kBlockFloats;
    const uint32_t blocks = pitch / kBlockFloats;
    // Scalar mask words are {low, high} for the installed C220 BR overload.
    const uint64_t mask[2] = {partialBlockMask, uint64_t(0)};
    for (uint32_t block = 0; block < blocks; ++block) {
        auto destination = roots[block * planeStride];
        auto source = matrix[block * kBlockFloats];
        if ((block + 1) * kBlockFloats <= h) {
            BlockReduceSum(destination, source, static_cast<int32_t>(groups),
                static_cast<int32_t>(kVectorFloats), 1,
                static_cast<int32_t>(pitch / kBlockFloats),
                static_cast<int32_t>(pitch));
        } else {
            // Every one of the eight source blocks has at least one live lane.
            // Padding, including possible NaNs after eps=0 Div, is masked out.
            BlockReduceSum(destination, source, static_cast<int32_t>(groups),
                mask, 1, static_cast<int32_t>(pitch / kBlockFloats),
                static_cast<int32_t>(pitch));
        }
    }
    const uint32_t tail = rows - fullRows;
    if (tail != 0) {
        // Do not issue BR for fictitious rows. The statistic base is 32B aligned.
        WholeReduceSum(stats[fullRows], matrix[fullRows * pitch],
            static_cast<int32_t>(h), static_cast<int32_t>(tail),
            1, 1, static_cast<int32_t>(pitch / kBlockFloats));
    }
    VectorDone();
    // Preserve the active binary tree above BR. The guarded upper-short family
    // may retain an active root directly when its right subtree is absent.
    // The fallback retains every original +0 node, including signed-zero effects.
    for (uint32_t step = 1; step < kBlockFloats; step *= 2) {
        for (uint32_t block = 0; block < blocks; block += 2 * step) {
            auto left = roots[block * planeStride];
            auto destination = step == kBlockFloats / 2 ? stats : left;
            if (block + step < blocks) {
                Add(destination, left, roots[(block + step) * planeStride], fullRows);
            } else if (!pruneInactiveZeros) {
                Adds(destination, left, 0.0f, fullRows);
            }
        }
        if (step < kBlockFloats / 2) {
            VectorDone();
        }
    }
    // The existing caller barrier orders final stats writes before eps/Brcb.
}

// RC3 binds compact roots only for the selected physical block width. The
// enclosing short-row class remains the exact A2 type.
template <uint32_t Blocks>
struct CompactRootViews {
    LocalTensor<float> root0;
    LocalTensor<float> root1;
    LocalTensor<float> root2;
    LocalTensor<float> root3;
    LocalTensor<float> root4;
    LocalTensor<float> root5;

    __aicore__ inline CompactRootViews(
        const LocalTensor<float>& scratch, uint32_t phaseFloats)
        : root0(scratch[phaseFloats]),
          root1(scratch[phaseFloats + 448U]),
          root2(scratch[phaseFloats + 2U * 448U]),
          root3(scratch[phaseFloats + 3U * 448U]),
          root4(scratch[phaseFloats + 4U * 448U +
              (Blocks == 5U ? kVectorFloats : 0U)]),
          root5(scratch[phaseFloats + 5U * 448U])
    {}
};

class ResidentTokenBatchKernel {
public:
    __aicore__ inline void Init(GM_ADDR mixes, GM_ADDR pre, GM_ADDR post,
        GM_ADDR comb, uint64_t n, uint32_t h, uint32_t iters, float eps,
        uint32_t tokenGroup, uint32_t q, TPipe* pipe,
        uint32_t matrixCoreCount = 0)
    {
        pipe_ = pipe;
        h_ = h;
        q_ = q & ~(kShortRowDivPanelFlag | kShortRowTailBrFlag |
            kBulkInputGatherFlag | kLowIterOutputPackFlag);
        rowDivPanel_ = (q & kShortRowDivPanelFlag) != 0;
        shortTailBr_ = (q & kShortRowTailBrFlag) != 0;
        bulkInputGather_ = (q & kBulkInputGatherFlag) != 0;
        lowIterOutputPack_ = (q & kLowIterOutputPackFlag) != 0;
        pitch_ = (h + 7) / 8 * 8;
        if (h_ > kBlockFloats && pitch_ <= kVectorFloats / 2) {
            const uint32_t lastBlockColumns = h_ - pitch_ + kBlockFloats;
            // Each mask byte selects real columns of one physical row.
            shortRowLastBlockMask_ = ((uint64_t(1) << lastBlockColumns) - 1)
                * uint64_t(0x0101010101010101ULL);
        }
        // Cache the repeated per-row partial-block mask outside strict iters.
        const uint32_t shortTail = h_ % kBlockFloats;
        shortRowBlockMask_ = shortTail == 0 ? ~uint64_t(0) :
            ((uint64_t(1) << shortTail) - 1) * uint64_t(0x0101010101010101ULL);
        matrixSize_ = h_ * pitch_;
        statsSize_ = (q_ * h_ + 7) / 8 * 8;
        gateSize_ = 2 * q_ * pitch_;
        w_ = h * h + 2 * h;
        iters_ = iters;
        eps_ = eps;
        // Metadata-only FP32 range guard; all other eps retain the D1b path.
        // With H<64 these bounds keep positive-stage sums and native inverses
        // normal and finite, with more than 50 exponent bits of headroom.
        upperShortMath_ = h_ < kVectorFloats && pitch_ > kVectorFloats / 2
            && eps_ >= 0x1p-60f && eps_ <= 0x1p+60f;
        // R1: reassociate only the natural two-to-four-block row family.
        // Positive ordinary eps avoids cancellation/singular denominators;
        // zero, negative and extreme eps keep the complete M1 reduction.
        lowerShortFold8_ = h_ > kBlockFloats && pitch_ <= kVectorFloats / 2
            && eps_ >= 0x1p-20f && eps_ <= 0x1p-4f;
        // Build only metadata-derived scalar masks on device. The host tiling
        // keeps q_ <= kMaxResidentTokenBatch; short rows have pitch <= 64.
        if (UseNonalignedInterleave(q_)) {
            InitShortColumnMasks();
        }
        // Freeze the full-batch column metadata before selecting and building
        // the output pattern. Process refreshes it for each final partial batch.
        PrepareColumnMetadata(q_);
        const uint32_t gateTokenGroup = DeviceOutputTokenGroup(h_);
        splitOwnership_ = tokenGroup < gateTokenGroup;
        separationRole_ = 0;
        if (matrixCoreCount == 0) {
            TokenRange(n, tokenGroup, first_, end_);
            if (splitOwnership_) {
                TokenRange(n, gateTokenGroup, gateFirst_, gateEnd_);
            }
        } else {
            // C1: the launch includes surplus gate blocks. Preserve the exact
            // former matrix partition using its explicit original core count;
            // GetBlockNum() now includes gates and MUST NOT partition matrices.
            const uint64_t block = GetBlockIdx();
            first_ = end_ = gateFirst_ = gateEnd_ = 0;
            if (block < matrixCoreCount) {
                separationRole_ = 1;
                const uint64_t groups = (n + tokenGroup - 1) / tokenGroup;
                first_ = (groups * block / matrixCoreCount) * tokenGroup;
                end_ = (groups * (block + 1) / matrixCoreCount) * tokenGroup;
                if (end_ > n) {
                    end_ = n;
                }
            } else {
                separationRole_ = 2;
                // Host grants exactly one surplus block per complete aligned
                // gate group, including one final possibly partial group.
                const uint64_t gateBlock = block - matrixCoreCount;
                gateFirst_ = gateBlock * gateTokenGroup;
                gateEnd_ = gateFirst_ + gateTokenGroup;
                if (gateEnd_ > n) {
                    gateEnd_ = n;
                }
            }
        }
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(mixes));
        pre_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(pre));
        post_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(post));
        comb_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(comb));
        const uint32_t physicalRows = shortTailBr_ ? statsSize_ : q_ * h_;
        pipe_->InitBuffer(matrixQueue_, 1, physicalRows * pitch_ * sizeof(float));
        pipe_->InitBuffer(gatesQueue_, 1, gateSize_ * sizeof(float));
        // Shared UB address padding; never read as tensor data.
        pipe_->InitBuffer(ubBankPadBeforeWork_, uint32_t(256));
        pipe_->InitBuffer(workBuf_, 2 * gateSize_ * sizeof(float));
        pipe_->InitBuffer(statsBuf_, statsSize_ * sizeof(float));
        const uint32_t broadcastPitch = rowDivPanel_ ? pitch_ : 8;
        uint32_t broadcastFloats = broadcastPitch * statsSize_;
        uint32_t bulkIndexFloats = 0;
        if (bulkInputGather_) {
            const uint32_t rawFloats = q_ * w_;
            if (rawFloats > broadcastFloats) {
                broadcastFloats = rawFloats;
            }
            // Matrix output is the interleaved [H, token8, pitch] panel.
            bulkIndexFloats = q_ * matrixSize_ + gateSize_;
        }
        pipe_->InitBuffer(broadcastBuf_, broadcastFloats * sizeof(float));
        if (bulkInputGather_) {
            pipe_->InitBuffer(inputIndexBuf_, bulkIndexFloats * sizeof(int32_t));
        } else if (lowIterOutputPack_) {
            pipe_->InitBuffer(inputIndexBuf_,
                q_ * h_ * h_ * sizeof(int32_t));
        }
        work_ = workBuf_.Get<float>();
        stats_ = statsBuf_.Get<float>();
        broadcast_ = broadcastBuf_.Get<float>();
        if (UseDenseCompactOutput(kBlockFloats)) {
            InitGatherMaskPattern();
        }
        if (bulkInputGather_) {
            bulkIndex_ = inputIndexBuf_.Get<int32_t>();
            BuildBulkInputIndices();
        } else if (lowIterOutputPack_) {
            outputIndex_ = inputIndexBuf_.Get<int32_t>();
            BuildLowIterOutputIndices();
        }
        Duplicate(stats_, 0.0f, statsSize_);
        VectorDone();
    }

    __aicore__ inline void Process()
    {
        if (separationRole_ == 1) {
            ProcessOwnedMatrices();
            return;
        }
        if (separationRole_ == 2) {
            ProcessOwnedGates();
            return;
        }
        if (splitOwnership_) {
            ProcessOwnedGates();
            ProcessOwnedMatrices();
            return;
        }
        for (uint64_t token = first_; token < end_; token += q_) {
            const uint32_t valid = static_cast<uint32_t>(
                end_ - token < q_ ? end_ - token : q_);
            PrepareColumnMetadata(valid);
            auto gates = gatesQueue_.AllocTensor<float>();
            auto matrix = matrixQueue_.AllocTensor<float>();
            // Each interleaved row stores [active token, padded column].
            // Nonaligned short rows join only when block packing reduces issue
            // count; valid rather than q_ keeps tail batches free of row gaps.
            const bool interleavedRows = h_ % kBlockFloats == 0
                || batchNonalignedInterleave_;
            const uint32_t ubRowGap = interleavedRows
                ? (valid - 1) * pitch_ / kBlockFloats : 0;
            const DataCopyExtParams loadRows{static_cast<uint16_t>(h_),
                static_cast<uint32_t>(h_ * sizeof(float)), 0, ubRowGap, 0};
            const DataCopyExtParams storeRows{static_cast<uint16_t>(h_),
                static_cast<uint32_t>(h_ * sizeof(float)), ubRowGap, 0, 0};
            const DataCopyPadExtParams<float> padding{
                true, 0, static_cast<uint8_t>(pitch_ - h_), 0.0f};
            const bool bulkInput = UseBulkInputGather(valid);
            if (bulkInput) {
                LoadBulkInput(token, gates, matrix);
                // These tensors were produced by Vector instructions after the
                // VECIN allocation. Pair explicit V_V events in the owning
                // queues so their state reaches DEQUE before FreeTensor.
                gatesQueue_.template EnQue<
                    TPosition::VECCALC, TPosition::VECCALC>(gates);
                gates = gatesQueue_.template DeQue<
                    TPosition::VECCALC, TPosition::VECCALC, float>();
                matrixQueue_.template EnQue<
                    TPosition::VECCALC, TPosition::VECCALC>(matrix);
                matrix = matrixQueue_.template DeQue<
                    TPosition::VECCALC, TPosition::VECCALC, float>();
            } else {
                for (uint32_t t = 0; t < valid; ++t) {
                    const uint64_t inputBase = (token + t) * w_;
                    LoadExact(gates[2 * t * pitch_], x_[inputBase], h_);
                    LoadExact(gates[(2 * t + 1) * pitch_], x_[inputBase + h_], h_);
                    const uint32_t matrixOffset = interleavedRows
                        ? t * pitch_ : t * matrixSize_;
                    DataCopyPad(matrix[matrixOffset], x_[inputBase + 2 * h_], loadRows, padding);
                }
                gatesQueue_.EnQue(gates);
                matrixQueue_.EnQue(matrix);
                gates = gatesQueue_.DeQue<float>();
                matrix = matrixQueue_.DeQue<float>();
            }
            InitShortTailRows(matrix, valid);
            SigmoidInPlace(gates, work_, work_[gateSize_], 2 * valid * pitch_);
            for (uint32_t t = 0; t < valid; ++t) {
                Adds(gates[2 * t * pitch_], gates[2 * t * pitch_], eps_, h_);
                Muls(gates[(2 * t + 1) * pitch_], gates[(2 * t + 1) * pitch_], 2.0f, h_);
            }
            VectorDone();
            RowSoftmax(matrix, valid);
            RunPostSoftmaxSinkhorn(matrix, valid);
            SyncPipelines<HardEvent::V_MTE3>(*pipe_);
if (UseLowIterMatrixCompact(valid)) {
    // Gate source has a pitch-H gap after each real row; its GM
    // destination is tightly packed, so only source stride is set.
    const DataCopyExtParams gateOutput{
        static_cast<uint16_t>(kBlockFloats),
        static_cast<uint32_t>(h_ * sizeof(float)),
        static_cast<uint16_t>(pitch_ / kBlockFloats), 0, 0};
    DataCopyPad(pre_[token * h_], gates, gateOutput);
    DataCopyPad(post_[token * h_], gates[pitch_], gateOutput);

    // Gather maps [row,token,pitch] to [token,row,H].
    const uint32_t outputFloats = kBlockFloats * h_ * h_;
    Gather(broadcast_, matrix,
        outputIndex_.ReinterpretCast<uint32_t>(), uint32_t(0),
        outputFloats);
    VectorDone();
    SyncPipelines<HardEvent::V_MTE3>(*pipe_);
    const DataCopyExtParams matrixOutput{
        1, static_cast<uint32_t>(
            outputFloats * sizeof(float)), 0, 0, 0};
    DataCopyPad(comb_[token * h_ * h_], broadcast_, matrixOutput);
}
            else if (UseTokenMajorCompactStore(valid)) {
                // The final compact path GatherMask-compressed each padded
                // [token, row, pitch] span into a contiguous matrix panel.
                // The two gate descriptors similarly skip the post/pre rows.
                const DataCopyExtParams gateOutput{
                    static_cast<uint16_t>(kBlockFloats),
                    static_cast<uint32_t>(h_ * sizeof(float)),
                    static_cast<uint16_t>(pitch_ / kBlockFloats), 0, 0};
                const DataCopyExtParams matrixOutput{
                    1, static_cast<uint32_t>(
                        kBlockFloats * h_ * h_ * sizeof(float)), 0, 0, 0};
                DataCopyPad(pre_[token * h_], gates, gateOutput);
                DataCopyPad(post_[token * h_], gates[pitch_], gateOutput);
                DataCopyPad(comb_[token * h_ * h_], broadcast_, matrixOutput);
            } else {
                for (uint32_t t = 0; t < valid; ++t) {
                    StoreExact(pre_[(token + t) * h_], gates[2 * t * pitch_], h_);
                    StoreExact(post_[(token + t) * h_], gates[(2 * t + 1) * pitch_], h_);
                    const uint32_t matrixOffset = interleavedRows
                        ? t * pitch_ : t * matrixSize_;
                    DataCopyPad(comb_[(token + t) * h_ * h_], matrix[matrixOffset], storeRows);
                }
            }
            SyncPipelines<HardEvent::MTE3_V>(*pipe_);
            gatesQueue_.FreeTensor(gates);
            matrixQueue_.FreeTensor(matrix);
        }
    }

protected:
    __aicore__ inline bool UseBulkInputGather(uint32_t valid)
    {
        return bulkInputGather_ && !splitOwnership_ && valid == kBlockFloats
            && UseRowInnerCompactDen(valid);
    }

    // Build the complete byte-offset map once per invocation. The first pitch
    // words are padding-safe column seeds derived only from metadata. Device
    // Adds expand those seeds into the original matrix and gate layouts.
    __aicore__ inline void BuildBulkInputIndices()
    {
        const uint32_t matrixPanel = q_ * matrixSize_;
        auto gateIndex = bulkIndex_[matrixPanel];
        for (uint32_t column = 0; column < pitch_; ++column) {
            const uint32_t sourceColumn = column < h_ ? column : h_ - 1;
            gateIndex.SetValue(column,
                static_cast<int32_t>(sourceColumn * sizeof(float)));
        }
        SyncPipelines<HardEvent::S_V>(*pipe_);
        // H<=128 keeps every byte offset below 2^31.
        Adds(gateIndex[pitch_], gateIndex,
            static_cast<int32_t>(h_ * sizeof(float)), pitch_);
        VectorDone();
        uint32_t tokenPrefix = 1;
        while (tokenPrefix < q_) {
            const uint32_t tokens = q_ - tokenPrefix < tokenPrefix
                ? q_ - tokenPrefix : tokenPrefix;
            Adds(gateIndex[2 * tokenPrefix * pitch_], gateIndex,
                static_cast<int32_t>(tokenPrefix * w_ * sizeof(float)),
                2 * tokens * pitch_);
            VectorDone();
            tokenPrefix += tokens;
        }
        // Matrix layout for the compact path is [row, token, padded column].
        // Skip the post row in each gate pair while writing the first matrix row.
        const UnaryRepeatParams preToMatrix{1, 1,
            static_cast<uint8_t>(pitch_ / kBlockFloats),
            static_cast<uint8_t>(2 * pitch_ / kBlockFloats)};
        Adds(bulkIndex_, gateIndex,
            static_cast<int32_t>(2 * h_ * sizeof(float)),
            uint64_t(pitch_), static_cast<uint8_t>(q_), preToMatrix);
        VectorDone();
        const uint32_t firstRow = q_ * pitch_;
        uint32_t rowPrefix = 1;
        while (rowPrefix < h_) {
            const uint32_t rows = h_ - rowPrefix < rowPrefix
                ? h_ - rowPrefix : rowPrefix;
            Adds(bulkIndex_[rowPrefix * firstRow], bulkIndex_[0],
                static_cast<int32_t>(rowPrefix * h_ * sizeof(float)),
                rows * firstRow);
            VectorDone();
            rowPrefix += rows;
        }
    }

    __aicore__ inline void LoadBulkInput(uint64_t token,
        const LocalTensor<float>& gates, const LocalTensor<float>& matrix)
    {
        // One contiguous GM transfer replaces 8 strided matrix copies and 16
        // short gate copies. Broadcast is dead before softmax and becomes live
        // again only after both Gathers have completed their raw reads.
        LoadExact(broadcast_, x_[token * w_], q_ * w_);
        SyncPipelines<HardEvent::MTE2_V>(*pipe_);
        const uint32_t matrixPanel = q_ * matrixSize_;
        auto matrixIndex = bulkIndex_.ReinterpretCast<uint32_t>();
        auto gateIndex =
            bulkIndex_[matrixPanel].ReinterpretCast<uint32_t>();
        // Level-2 Gather encodes a uint8 repeat count; keep each call within
        // 255 vector repeats even though admitted A2 compact panels need one.
        constexpr uint32_t gatherChunk = 255U * kVectorFloats;
        for (uint32_t offset = 0; offset < matrixPanel; offset += gatherChunk) {
            const uint32_t remaining = matrixPanel - offset;
            const uint32_t count = remaining < gatherChunk ? remaining : gatherChunk;
            Gather(matrix[offset], broadcast_, matrixIndex[offset],
                uint32_t(0), count);
        }
        Gather(gates, broadcast_, gateIndex, uint32_t(0), gateSize_);
        // Completing every Gather read is required before the same output
        // tensors are overwritten by the padding Duplicate.
        VectorDone();
        // Padding indices always point at column H-1, so no Gather lane can
        // escape the real input panel. Restore the original LoadPad values.
        const uint64_t paddingMask =
            ((uint64_t(1) << pitch_) - 1) & ~((uint64_t(1) << h_) - 1);
        Duplicate(gates, 0.0f, paddingMask, static_cast<uint8_t>(2 * q_),
            uint16_t(1), static_cast<uint8_t>(pitch_ / kBlockFloats));
        const uint32_t matrixRows = q_ * h_;
        for (uint32_t row = 0; row < matrixRows; row += 248) {
            const uint32_t remaining = matrixRows - row;
            const uint8_t repeats = static_cast<uint8_t>(
                remaining < 248 ? remaining : 248);
            Duplicate(matrix[row * pitch_], 0.0f, paddingMask, repeats,
                uint16_t(1), static_cast<uint8_t>(pitch_ / kBlockFloats));
        }
        SetMaskNorm();
        VectorDone();
    }

    // Gate and matrix ownership are independent contiguous partitions. Each
    // uses its own output-width group; no two cores share a 32-byte output block.
    // The same invocation computes all real gates from this input exactly once.
    __aicore__ inline void ProcessOwnedGates()
    {
        for (uint64_t token = gateFirst_; token < gateEnd_; token += q_) {
            const uint32_t valid = static_cast<uint32_t>(
                gateEnd_ - token < q_ ? gateEnd_ - token : q_);
            auto gates = gatesQueue_.AllocTensor<float>();
            for (uint32_t t = 0; t < valid; ++t) {
                const uint64_t inputBase = (token + t) * w_;
                LoadExact(gates[2 * t * pitch_], x_[inputBase], h_);
                LoadExact(gates[(2 * t + 1) * pitch_], x_[inputBase + h_], h_);
            }
            gatesQueue_.EnQue(gates);
            gates = gatesQueue_.DeQue<float>();
            SigmoidInPlace(gates, work_, work_[gateSize_], 2 * valid * pitch_);
            for (uint32_t t = 0; t < valid; ++t) {
                Adds(gates[2 * t * pitch_], gates[2 * t * pitch_], eps_, h_);
                Muls(gates[(2 * t + 1) * pitch_], gates[(2 * t + 1) * pitch_], 2.0f, h_);
            }
            VectorDone();
            SyncPipelines<HardEvent::V_MTE3>(*pipe_);
            for (uint32_t t = 0; t < valid; ++t) {
                StoreExact(pre_[(token + t) * h_], gates[2 * t * pitch_], h_);
                StoreExact(post_[(token + t) * h_], gates[(2 * t + 1) * pitch_], h_);
            }
            SyncPipelines<HardEvent::MTE3_V>(*pipe_);
            gatesQueue_.FreeTensor(gates);
        }
    }

    // Matrix math is the original batched path: only gate loads, arithmetic,
    // stores and queue operations moved into ProcessOwnedGates above.
    __aicore__ inline void ProcessOwnedMatrices()
    {
        for (uint64_t token = first_; token < end_; token += q_) {
            const uint32_t valid = static_cast<uint32_t>(
                end_ - token < q_ ? end_ - token : q_);
            PrepareColumnMetadata(valid);
            auto matrix = matrixQueue_.AllocTensor<float>();
            const bool interleavedRows = h_ % kBlockFloats == 0
                || batchNonalignedInterleave_;
            const uint32_t ubRowGap = interleavedRows
                ? (valid - 1) * pitch_ / kBlockFloats : 0;
            const DataCopyExtParams loadRows{static_cast<uint16_t>(h_),
                static_cast<uint32_t>(h_ * sizeof(float)), 0, ubRowGap, 0};
            const DataCopyExtParams storeRows{static_cast<uint16_t>(h_),
                static_cast<uint32_t>(h_ * sizeof(float)), ubRowGap, 0, 0};
            const DataCopyPadExtParams<float> padding{
                true, 0, static_cast<uint8_t>(pitch_ - h_), 0.0f};
            for (uint32_t t = 0; t < valid; ++t) {
                const uint64_t inputBase = (token + t) * w_;
                const uint32_t matrixOffset = interleavedRows
                    ? t * pitch_ : t * matrixSize_;
                DataCopyPad(matrix[matrixOffset], x_[inputBase + 2 * h_], loadRows, padding);
            }
            matrixQueue_.EnQue(matrix);
            matrix = matrixQueue_.DeQue<float>();
            InitShortTailRows(matrix, valid);
            RowSoftmax(matrix, valid);
            RunPostSoftmaxSinkhorn(matrix, valid);
            SyncPipelines<HardEvent::V_MTE3>(*pipe_);
            for (uint32_t t = 0; t < valid; ++t) {
                const uint32_t matrixOffset = interleavedRows
                    ? t * pitch_ : t * matrixSize_;
                DataCopyPad(comb_[(token + t) * h_ * h_], matrix[matrixOffset], storeRows);
            }
            SyncPipelines<HardEvent::MTE3_V>(*pipe_);
            matrixQueue_.FreeTensor(matrix);
        }
    }

    // A general instruction-count guard, using only dimensions and the
    // current active batch. No hidden-shape or iteration-specific dispatch.
    __aicore__ inline bool UseNonalignedInterleave(uint32_t valid)
    {
        return h_ > 8 && h_ < 64 && h_ % kBlockFloats != 0 && q_ > 1
            && (valid * pitch_ + kVectorFloats - 1) / kVectorFloats < valid;
    }

    __aicore__ inline void InitShortColumnMasks()
    {
        for (uint32_t tile = 0; tile < kMaxResidentTokenBatch; ++tile) {
            shortColumnMasks_[tile] = 0;
        }
        const uint64_t columns = (uint64_t(1) << h_) - 1;
        for (uint32_t t = 0; t < q_; ++t) {
            const uint32_t start = t * pitch_;
            const uint32_t tile = start / kVectorFloats;
            const uint32_t shift = start % kVectorFloats;
            shortColumnMasks_[tile] |= columns << shift;
            if (shift + h_ > kVectorFloats) {
                // This branch implies shift > 0, so the shift is never 64.
                shortColumnMasks_[tile + 1] |= columns >> (kVectorFloats - shift);
            }
        }
    }

    // Batch dimensions and padding masks are invariant across strict iters.
    // Keep full-q masks intact: a partial final batch uses its own truncated
    // copy; the next vector consumer establishes its own mask state.
    __aicore__ inline void PrepareColumnMetadata(uint32_t valid)
    {
        // Cache C's unchanged four-times-Div issue policy for this valid batch.
        // Every softmax/iteration caller below uses the same rows=valid*H.
        const uint32_t rows = valid * h_;
        const uint32_t broadcasts = (rows + 7) / 8;
        const uint32_t packedDivs = (rows * pitch_ + 63) / 64;
        batchRowDivPanel_ = rowDivPanel_ && broadcasts * (pitch_ / 8)
            + 4U * packedDivs < broadcasts + 4U * rows;
        batchNonalignedInterleave_ = UseNonalignedInterleave(valid);
        if (!batchNonalignedInterleave_) {
            return;
        }
        batchColumnElements_ = valid * pitch_;
        batchColumnStride_ = static_cast<uint8_t>(batchColumnElements_ / kBlockFloats);
        for (uint32_t column = 0; column < batchColumnElements_; column += kVectorFloats) {
            uint64_t mask = shortColumnMasks_[column / kVectorFloats];
            const uint32_t remaining = batchColumnElements_ - column;
            if (remaining < kVectorFloats) {
                // remaining is 8..56; neither branch shifts by 64.
                mask &= (uint64_t(1) << remaining) - 1;
            }
            batchColumnMasks_[column / kVectorFloats] = mask;
        }
    }

    __aicore__ inline void InitShortTailRows(const LocalTensor<float>& matrix, uint32_t valid)
    {
        if (shortTailBr_) {
            const uint32_t rows = valid * h_;
            const uint32_t physicalRows = (rows + 7) / 8 * 8;
            if (physicalRows != rows) {
                // At most seven physical rows; these are never matrix data.
                // All max/Sub/Exp/Div/eps and column/store footprints below
                // still use real rows. RowSoftmax's first V barrier orders
                // this initialization before the first tail BR can read it.
                Duplicate(matrix[rows * pitch_], 0.0f, (physicalRows - rows) * pitch_);
            }
        }
    }

    // 248 is the largest multiple of 8 below the repeat field maximum 255.
    // It keeps compact statistic slice bases and matrix rows 32-byte aligned.
    __aicore__ inline uint32_t RowChunk(uint32_t remaining)
    {
        return remaining < 248 ? remaining : 248;
    }

    __aicore__ inline void ReduceRowSums(const LocalTensor<float>& matrix, uint32_t rows)
    {
        // R1: physical rows are contiguous in both existing matrix layouts.
        // If no padded tail rows were allocated, preserve the WHOLE old path
        // for a non-multiple-of-eight batch; never read an invented row.
        if (lowerShortFold8_ && rows >= kBlockFloats
            && (shortTailBr_ || rows % kBlockFloats == 0)) {
            const uint32_t foldedRows = shortTailBr_ ? (rows + 7) / 8 * 8 : rows;
            const uint8_t roots = static_cast<uint8_t>(pitch_ / kBlockFloats);
            const uint8_t repeats = static_cast<uint8_t>(foldedRows / kBlockFloats);
            const uint8_t rowRepStride = static_cast<uint8_t>(pitch_);
            // One vector repeat processes eight rows. Compact row r occupies
            // broadcast_[8*r:8*r+8]; at most 8*statsSize_ floats are needed.
            // The last block's unmasked destination lanes MUST keep the seed.
            uint64_t lastBlockMask[2] = {shortRowLastBlockMask_, uint64_t(0)};
            if (roots == 2 && h_ % kBlockFloats != 0) {
                const UnaryRepeatParams seedFold{1, roots, 8, rowRepStride};
                Adds(broadcast_, matrix, 0.0f, uint64_t(kVectorFloats),
                    repeats, seedFold);
                VectorDone();
                const BinaryRepeatParams addTail{1, 1, roots, 8, 8, rowRepStride};
                Add(broadcast_, broadcast_, matrix[kBlockFloats], lastBlockMask,
                    repeats, addTail);
                VectorDone();
            } else {
                // Blocks zero and one are fully real here, including H=16.
                const BinaryRepeatParams firstFold{
                    1, roots, roots, 8, rowRepStride, rowRepStride};
                Add(broadcast_, matrix, matrix[kBlockFloats],
                    uint64_t(kVectorFloats), repeats, firstFold);
                VectorDone();
                const BinaryRepeatParams nextFold{1, 1, roots, 8, 8, rowRepStride};
                for (uint32_t root = 2; root < roots; ++root) {
                    if (root + 1 == roots) {
                        Add(broadcast_, broadcast_, matrix[root * kBlockFloats],
                            lastBlockMask, repeats, nextFold);
                    } else {
                        Add(broadcast_, broadcast_, matrix[root * kBlockFloats],
                            uint64_t(kVectorFloats), repeats, nextFold);
                    }
                    VectorDone();
                }
            }
            // Every compact lane is initialized. BR consumes contiguous rows
            // and writes eight scalar sums per repeat; caller orders the read.
            BlockReduceSum(stats_, broadcast_, static_cast<int32_t>(repeats),
                static_cast<int32_t>(kVectorFloats), 1, 1, 8);
            return;
        }
        // A sub-half-vector row has two to four 8-float roots. One BR
        // repeat processes one column block from eight independent physical
        // rows, then writes their eight roots contiguously. This keeps native
        // row pitch and never consumes matrix padding, even when it is NaN.
        if (h_ > kBlockFloats && pitch_ <= kVectorFloats / 2
            && rows >= kBlockFloats) {
            const uint32_t roots = pitch_ / kBlockFloats;
            const uint32_t fullRows = rows / kBlockFloats * kBlockFloats;
            const uint32_t reducedRows = shortTailBr_
                ? (rows + 7) / 8 * 8 : fullRows;
            const int32_t repeats = static_cast<int32_t>(reducedRows / kBlockFloats);
            const int32_t blockStride = static_cast<int32_t>(pitch_ / kBlockFloats);
            const int32_t repeatStride = static_cast<int32_t>(pitch_);
            // broadcast_ is dead after ApplyRows/ElementwiseRows, and has at
            // least 8*statsSize_ floats. Each root panel uses statsSize_.
            for (uint32_t root = 0; root + 1 < roots; ++root) {
                BlockReduceSum(broadcast_[root * statsSize_], matrix[root * kBlockFloats],
                    repeats, static_cast<int32_t>(kVectorFloats), 1,
                    blockStride, repeatStride);
            }
            const uint64_t lastBlockMask[2] = {shortRowLastBlockMask_, uint64_t(0)};
            BlockReduceSum(broadcast_[(roots - 1) * statsSize_],
                matrix[(roots - 1) * kBlockFloats], repeats, lastBlockMask,
                1, blockStride, repeatStride);
            // With physical tail rows, every BR source block has live lanes:
            // real-row roots or explicitly initialized, isolated zero rows.
            // Capacity fallback keeps the original masked WR tail exactly.
            if (!shortTailBr_ && fullRows < rows) {
                WholeReduceSum(stats_[fullRows], matrix[fullRows * pitch_],
                    static_cast<int32_t>(h_), static_cast<int32_t>(rows - fullRows),
                    1, 1, blockStride);
            }
            VectorDone();
            // Retain all three upper levels of the original 64-lane adjacent
            // tree. Missing right subtrees are +0, including their zero-sign
            // effect; fully absent subtrees have the constant root +0.
            Add(broadcast_, broadcast_, broadcast_[statsSize_], reducedRows);
            if (roots > 2) {
                if (roots > 3) {
                    Add(broadcast_[2 * statsSize_], broadcast_[2 * statsSize_],
                        broadcast_[3 * statsSize_], reducedRows);
                } else {
                    Adds(broadcast_[2 * statsSize_], broadcast_[2 * statsSize_],
                        0.0f, reducedRows);
                }
            }
            VectorDone();
            if (roots > 2) {
                Add(broadcast_, broadcast_, broadcast_[2 * statsSize_], reducedRows);
            } else {
                Adds(broadcast_, broadcast_, 0.0f, reducedRows);
            }
            VectorDone();
            Adds(stats_, broadcast_, 0.0f, reducedRows);
            return;
        }
        // Natural upper-half-vector family: five to eight block roots per row.
        // The resident batch has q<=8, hence at most 63 BR repeats per call.
        // broadcast_ is dead here: ApplyRows and ElementwiseRows already ended
        // with V barriers, and the next Brcb follows this sum's caller barrier.
        if (h_ < kVectorFloats && pitch_ / kBlockFloats > kBlockFloats / 2
            && rows >= kBlockFloats) {
            ReduceShortRowsStridedBlockTree(matrix, stats_, broadcast_, h_,
                pitch_, rows, statsSize_, shortRowBlockMask_, upperShortMath_);
            return;
        }
        const int32_t count = static_cast<int32_t>(h_ < 64 ? h_ : 64);
        for (uint32_t row = 0; row < rows; row += 248) {
            const int32_t repeats = static_cast<int32_t>(RowChunk(rows - row));
            WholeReduceSum(stats_[row], matrix[row * pitch_], count,
                repeats, 1, 1, static_cast<int32_t>(pitch_ / 8));
            if (h_ > 64) {
                WholeReduceSum(work_[row], matrix[row * pitch_ + 64],
                    static_cast<int32_t>(h_ - 64), repeats, 1, 1,
                    static_cast<int32_t>(pitch_ / 8));
            }
        }
        if (h_ > 64) {
            VectorDone();
            Add(stats_, stats_, work_, rows);
        }
    }

    // A full denominator panel packs native Div into contiguous vectors.
    // The WR tree and each valid element's denominator stay unchanged. Four
    // is a provisional relative Div/Brcb issue-cost policy, not a hardware
    // latency claim. Resource checks select the broad sub-vector-row family;
    // measured full-kernel performance must validate this tradeoff.
    __aicore__ inline bool UseRowDivPanel(uint32_t rows)
    {
        // Per-batch cache; the four-times-Div predicate is prepared before
        // initial softmax and before any strict iteration on this valid batch.
        return batchRowDivPanel_;
    }

    __aicore__ inline void BroadcastRows(uint32_t rows, bool forDivision = false)
    {
        const uint8_t repeats = static_cast<uint8_t>((rows + 7) / 8);
        if (forDivision && UseRowDivPanel(rows)) {
            // Each call fills the next 32-byte column block of every row.
            // Brcb reads eight stats per repeat: allocate statsSize_*pitch_
            // so rounded tail rows, including their last column block, fit.
            const BrcbRepeatParams steps{static_cast<uint16_t>(pitch_ / 8),
                static_cast<uint16_t>(pitch_)};
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 2201 && !ASCENDC_CPU_DEBUG && !defined(__MSTX_DFX_REPORT__)
            if ASCEND_IS_AIV {
                // CANN 9.0 C220 BrcbImpl resets the same full mask before
                // every vbrcb. Keep it across this contiguous, disjoint panel
                // sequence; use that exact uint32 bit-broadcast intrinsic.
                ResetMask();
                auto source = (__ubuf__ uint32_t*)stats_.GetPhyAddr();
                for (uint32_t column = 0; column < pitch_; column += 8) {
                    auto destination = (__ubuf__ uint32_t*)broadcast_[column].GetPhyAddr();
                    vbrcb(destination, source, steps.dstBlkStride, steps.dstRepStride, repeats);
                }
            }
#else
            for (uint32_t column = 0; column < pitch_; column += 8) {
                Brcb(broadcast_[column], stats_, repeats, steps);
            }
#endif
        } else {
            Brcb(broadcast_, stats_, repeats, {1, 8});
        }
        VectorDone();
    }

    template <bool Divide>
    __aicore__ inline void ApplyRows(const LocalTensor<float>& matrix, uint32_t rows)
    {
        if (Divide && UseRowDivPanel(rows)) {
            // Div is still the C220 vdiv operation. Padding may become NaN
            // for eps=0; WR(H), lane-local columns and StoreExact isolate it.
            Div(matrix, matrix, broadcast_, static_cast<int32_t>(rows * pitch_));
            VectorDone();
            return;
        }
        const uint8_t stride = static_cast<uint8_t>(pitch_ / 8);
        const BinaryRepeatParams steps{1, 1, 0, stride, stride, 1};
        const uint64_t count = h_ < 64 ? h_ : 64;
        for (uint32_t row = 0; row < rows; row += 248) {
            const uint8_t repeats = static_cast<uint8_t>(RowChunk(rows - row));
            auto dst = matrix[row * pitch_];
            auto denominator = broadcast_[row * 8];
            if (Divide) {
                Div(dst, dst, denominator, count, repeats, steps);
                if (h_ > 64) {
                    Div(dst[64], dst[64], denominator, uint64_t(h_ - 64), repeats, steps);
                }
            } else {
                Sub(dst, dst, denominator, count, repeats, steps);
                if (h_ > 64) {
                    Sub(dst[64], dst[64], denominator, uint64_t(h_ - 64), repeats, steps);
                }
            }
        }
        VectorDone();
    }

    template <bool Exponentiate>
    __aicore__ inline void ElementwiseRows(const LocalTensor<float>& matrix, uint32_t rows)
    {
        if (h_ < kVectorFloats
            && (rows * pitch_ + kVectorFloats - 1) / kVectorFloats < rows) {
            // DataCopyPad initializes all active rows, including their padding.
            // Both row-major layouts occupy this contiguous active prefix.
            // WR(H) and H-wide stores exclude padding; column recurrences keep
            // it lane-local even when Exp/Div/Adds makes it non-finite.
            const int32_t elements = static_cast<int32_t>(rows * pitch_);
            if (Exponentiate) {
                Exp(matrix, matrix, elements);
            } else {
                Adds(matrix, matrix, eps_, elements);
            }
            VectorDone();
            return;
        }
        const uint8_t stride = static_cast<uint8_t>(pitch_ / 8);
        const UnaryRepeatParams steps{1, 1, stride, stride};
        const uint64_t count = h_ < 64 ? h_ : 64;
        for (uint32_t row = 0; row < rows; row += 248) {
            const uint8_t repeats = static_cast<uint8_t>(RowChunk(rows - row));
            auto dst = matrix[row * pitch_];
            if (Exponentiate) {
                Exp(dst, dst, count, repeats, steps);
                if (h_ > 64) {
                    Exp(dst[64], dst[64], uint64_t(h_ - 64), repeats, steps);
                }
            } else {
                Adds(dst, dst, eps_, count, repeats, steps);
                if (h_ > 64) {
                    Adds(dst[64], dst[64], eps_, uint64_t(h_ - 64), repeats, steps);
                }
            }
        }
        VectorDone();
    }

    __aicore__ inline void RowSoftmax(const LocalTensor<float>& matrix, uint32_t valid)
    {
        const uint32_t rows = valid * h_;
        if (upperShortMath_) {
            // Gate work is dead in every matrix owner, including split owners.
            // Initialize per batch, after gates; the first max barrier orders it.
            Duplicate(work_[3 * q_ * pitch_], 1.0f, q_ * pitch_);
        }
        const int32_t count = static_cast<int32_t>(h_ < 64 ? h_ : 64);
        for (uint32_t row = 0; row < rows; row += 248) {
            const int32_t repeats = static_cast<int32_t>(RowChunk(rows - row));
            WholeReduceMax(stats_[row], matrix[row * pitch_], count,
                repeats, 1, 1, static_cast<int32_t>(pitch_ / 8), ReduceOrder::ORDER_ONLY_VALUE);
            if (h_ > 64) {
                WholeReduceMax(work_[row], matrix[row * pitch_ + 64],
                    static_cast<int32_t>(h_ - 64), repeats, 1, 1,
                    static_cast<int32_t>(pitch_ / 8), ReduceOrder::ORDER_ONLY_VALUE);
            }
        }
        VectorDone();
        if (h_ > 64) {
            Max(stats_, stats_, work_, rows);
            VectorDone();
        }
        BroadcastRows(rows);
        ApplyRows<false>(matrix, rows);
        ElementwiseRows<true>(matrix, rows);
        ReduceRowSums(matrix, rows);
        VectorDone();
        BroadcastRows(rows, true);
        ApplyRows<true>(matrix, rows);
        ElementwiseRows<false>(matrix, rows);
    }

    // A full eight-token batch can exchange only the two inner block axes.
    // This uses the already allocated full panel; q, ownership and UB bytes
    // stay unchanged. The actual iteration count must amortize both copies.
    __aicore__ inline bool UseRowInnerCompactDen(uint32_t valid)
    {
        const uint32_t blocks = pitch_ / kBlockFloats;
        return q_ == kBlockFloats && valid == kBlockFloats
            && (pitch_ == 5 * kBlockFloats || pitch_ == 6 * kBlockFloats)
            && upperShortMath_ && batchRowDivPanel_
            && (h_ % kBlockFloats == 0 || batchNonalignedInterleave_)
            && statsSize_ == valid * h_ && iters_ > 1
            && (iters_ - 1) * (blocks - 1) > 2 * blocks;
    }

    // Token-major output reuses the compact column result that is already in
    // the packed [row, column-block, token, lane] order. Its Mul destination
    // uses BinaryRepeatParams.dstBlkStride = H*P/8, whose uint8 field limits
    // this writeback to H <= 42 for the admitted P40/P48 family.
// The ordinary q8 short-row path stores [row, token, pitch]. This one-time
// map reorders complete real elements to tight [token, row, H] while
// dropping only padding. Input, q, arithmetic and ownership are unchanged.
__aicore__ inline void BuildLowIterOutputIndices()
{
    for (uint32_t token = 0; token < q_; ++token) {
        for (uint32_t row = 0; row < h_; ++row) {
            for (uint32_t column = 0; column < h_; ++column) {
                outputIndex_.SetValue(
                    (token * h_ + row) * h_ + column,
                    static_cast<int32_t>(
                        ((row * q_ + token) * pitch_ + column)
                        * sizeof(float)));
            }
        }
    }
    SyncPipelines<HardEvent::S_V>(*pipe_);
}

__aicore__ inline bool UseLowIterMatrixCompact(uint32_t valid)
{
    return lowIterOutputPack_ && !splitOwnership_
        && q_ == kBlockFloats && valid == q_
        && h_ > kBlockFloats && h_ < kVectorFloats
        && h_ % kBlockFloats != 0
        && pitch_ <= 2U * kBlockFloats
        && iters_ <= 3U && batchNonalignedInterleave_
        && batchRowDivPanel_;
}

    __aicore__ inline bool UseTokenMajorCompactStore(uint32_t valid)
    {
        return !splitOwnership_ && UseRowInnerCompactDen(valid)
            && h_ * pitch_ / kBlockFloats <= 255U;
    }

    __aicore__ inline bool UseDenseCompactOutput(uint32_t valid)
    {
        return UseTokenMajorCompactStore(valid);
    }

    // Method 1 compresses each padded row of every token into one contiguous
    // [token, H, H] panel. The 8*P-bit custom pattern is reused for all H row
    // groups. Its worst admitted size is 48 bytes, so the existing 256-byte
    // bank-alignment TBuf covers it without moving any other UB base.
    __aicore__ inline void InitGatherMaskPattern()
    {
        gatherPattern_ = ubBankPadBeforeWork_.Get<uint32_t>();
        const uint32_t bits = q_ * pitch_;
        const uint32_t words = (bits + 31U) / 32U;
        const uint64_t rowMask = (uint64_t(1) << h_) - 1U;
        for (uint32_t word = 0; word < words; ++word) {
            const uint32_t offset = word * 32U % pitch_;
            uint64_t pattern = rowMask >> offset;
            if (offset + 32U > pitch_) {
                // P is at least 40 and H is at most 42 here, so this is the
                // only possible row crossing inside one 32-bit pattern word.
                // The second shift is at most 16 and the final set bit is < 64.
                pattern |= rowMask << (pitch_ - offset);
            }
            gatherPattern_.SetValue(word, static_cast<uint32_t>(pattern));
        }
        SyncPipelines<HardEvent::S_V>(*pipe_);
    }

    // [H, token8, block, lane8] -> [H, block, token8, lane8].
    // C220 masked Copy<float> copies uint32 storage words with no FP operation.
    // Different block calls write disjoint destinations in another allocation.
    __aicore__ inline void PackRowInnerMatrix(const LocalTensor<float>& packed,
        const LocalTensor<float>& matrix)
    {
        const uint16_t blocks = static_cast<uint16_t>(pitch_ / kBlockFloats);
        const uint16_t rowStride = static_cast<uint16_t>(pitch_);
        const CopyRepeatParams steps{1, blocks, rowStride, rowStride};
        SetMaskNorm();
        for (uint32_t block = 0; block < blocks; ++block) {
            Copy<float>(packed[block * kVectorFloats], matrix[block * kBlockFloats],
                uint64_t(kVectorFloats), static_cast<uint8_t>(h_), steps);
        }
        // The first column seed must not read the packed matrix before Copy.
        VectorDone();
    }

    template <uint32_t Blocks>
    __aicore__ inline void PackRowInnerMatrixFixed(
        const LocalTensor<float>& packed,
        const LocalTensor<float>& matrix)
    {
        constexpr uint16_t blocks = Blocks;
        constexpr uint16_t rowStride = Blocks * kBlockFloats;
        const CopyRepeatParams steps{1, blocks, rowStride, rowStride};
        SetMaskNorm();
        for (uint32_t block = 0; block < Blocks; ++block) {
            Copy<float>(packed[block * kVectorFloats],
                matrix[block * kBlockFloats], uint64_t(kVectorFloats),
                static_cast<uint8_t>(h_), steps);
        }
        VectorDone();
    }

    __aicore__ inline void UnpackRowInnerMatrix(const LocalTensor<float>& matrix,
        const LocalTensor<float>& packed)
    {
        const uint16_t blocks = static_cast<uint16_t>(pitch_ / kBlockFloats);
        const uint16_t rowStride = static_cast<uint16_t>(pitch_);
        const CopyRepeatParams steps{blocks, 1, rowStride, rowStride};
        SetMaskNorm();
        for (uint32_t block = 0; block < blocks; ++block) {
            Copy<float>(matrix[block * kBlockFloats], packed[block * kVectorFloats],
                uint64_t(kVectorFloats), static_cast<uint8_t>(h_), steps);
        }
        // The existing caller V_MTE3 event orders these writes before stores.
    }

    __aicore__ inline void ReduceRowInnerSums(const LocalTensor<float>& packed,
        const LocalTensor<float>& roots)
    {
        const uint32_t rows = kBlockFloats * h_;
        const uint32_t blocks = pitch_ / kBlockFloats;
        const uint64_t mask[2] = {shortRowBlockMask_, uint64_t(0)};
        for (uint32_t block = 0; block < blocks; ++block) {
            auto destination = roots[block * statsSize_];
            auto source = packed[block * kVectorFloats];
            if ((block + 1) * kBlockFloats <= h_) {
                BlockReduceSum(destination, source, static_cast<int32_t>(h_),
                    static_cast<int32_t>(kVectorFloats), 1, 1,
                    static_cast<int32_t>(pitch_));
            } else {
                BlockReduceSum(destination, source, static_cast<int32_t>(h_),
                    mask, 1, 1, static_cast<int32_t>(pitch_));
            }
        }
        VectorDone();
        // Each BR preserves the original eight-column tree and produces roots
        // in (row, token) order. Retain B5's exact step1/2/4 merge sequence,
        // including its existing upperShortMath inactive-zero pruning policy.
        for (uint32_t step = 1; step < kBlockFloats; step *= 2) {
            for (uint32_t block = 0; block < blocks; block += 2 * step) {
                auto left = roots[block * statsSize_];
                auto destination = step == kBlockFloats / 2 ? stats_ : left;
                if (block + step < blocks) {
                    Add(destination, left, roots[(block + step) * statsSize_], rows);
                } else if (!upperShortMath_) {
                    Adds(destination, left, 0.0f, rows);
                }
            }
            if (step < kBlockFloats / 2) {
                VectorDone();
            }
        }
        // The caller barrier orders the final root reads/stats write before
        // this same scratch allocation becomes the compact denominator.
    }

    // Compact-only root layout. Root zero shares the final statistics phase;
    // adjacent root slots alternate by 256 bytes without changing any Add.
    __aicore__ inline uint32_t RowInnerRootPhaseFloats(
        const LocalTensor<float>& scratch)
    {
        const uint64_t phaseBytes =
            (stats_.GetPhyAddr() - scratch.GetPhyAddr()) & uint64_t(511);
        return static_cast<uint32_t>(phaseBytes / sizeof(float));
    }

    __aicore__ inline uint32_t RowInnerRootOffset(uint32_t block,
        uint32_t blocks, uint32_t phaseFloats)
    {
        constexpr uint32_t rootPitchFloats = 448;
        return phaseFloats + block * rootPitchFloats +
            ((blocks == 5U && block == 4U) ? kVectorFloats : 0U);
    }

    __aicore__ inline void ReduceRowInnerSumsColored(
        const LocalTensor<float>& packed, const LocalTensor<float>& roots,
        uint32_t phaseFloats)
    {
        const uint32_t rows = kBlockFloats * h_;
        const uint32_t blocks = pitch_ / kBlockFloats;
        const uint64_t mask[2] = {shortRowBlockMask_, uint64_t(0)};
        for (uint32_t block = 0; block < blocks; ++block) {
            auto destination =
                roots[RowInnerRootOffset(block, blocks, phaseFloats)];
            auto source = packed[block * kVectorFloats];
            if ((block + 1) * kBlockFloats <= h_) {
                BlockReduceSum(destination, source, static_cast<int32_t>(h_),
                    static_cast<int32_t>(kVectorFloats), 1, 1,
                    static_cast<int32_t>(pitch_));
            } else {
                BlockReduceSum(destination, source, static_cast<int32_t>(h_),
                    mask, 1, 1, static_cast<int32_t>(pitch_));
            }
        }
        VectorDone();
        auto root0 = roots[RowInnerRootOffset(0, blocks, phaseFloats)];
        auto root1 = roots[RowInnerRootOffset(1, blocks, phaseFloats)];
        auto root2 = roots[RowInnerRootOffset(2, blocks, phaseFloats)];
        auto root3 = roots[RowInnerRootOffset(3, blocks, phaseFloats)];
        auto root4 = roots[RowInnerRootOffset(4, blocks, phaseFloats)];
        const BinaryRepeatParams countModeSteps{1, 1, 1, 8, 8, 8};
        SetMaskCount();
        SetVectorMask<float, MaskMode::COUNTER>(uint64_t(0), uint64_t(rows));
        // Preserve the binary tree and operand order. Complete right-side
        // overlap carries each pair result into the next colored stage.
        Add<float, false>(root0, root0, root1,
            MASK_PLACEHOLDER, 1, countModeSteps);
        Add<float, false>(root3, root2, root3,
            MASK_PLACEHOLDER, 1, countModeSteps);
        if (blocks == 6U) {
            auto root5 = roots[RowInnerRootOffset(5, blocks, phaseFloats)];
            Add<float, false>(root5, root4, root5,
                MASK_PLACEHOLDER, 1, countModeSteps);
        }
        VectorDone();
        Add<float, false>(root0, root0, root3,
            MASK_PLACEHOLDER, 1, countModeSteps);
        VectorDone();
        auto tail = blocks == 5U ? root4 :
            roots[RowInnerRootOffset(5, blocks, phaseFloats)];
        Add<float, false>(stats_, root0, tail,
            MASK_PLACEHOLDER, 1, countModeSteps);
        // The caller barrier orders the final root reads/stats write before
        // this same scratch allocation becomes the compact denominator.
    }

    template <uint32_t Blocks>
    __aicore__ inline void ReduceRowInnerSumsColoredFixed(
        const LocalTensor<float>& packed,
        const CompactRootViews<Blocks>& rootViews)
    {
        constexpr uint32_t pitch = Blocks * kBlockFloats;
        const uint32_t rows = kBlockFloats * h_;
        const uint64_t mask[2] = {shortRowBlockMask_, uint64_t(0)};
        BlockReduceSum(rootViews.root0, packed, static_cast<int32_t>(h_),
            static_cast<int32_t>(kVectorFloats), 1, 1,
            static_cast<int32_t>(pitch));
        BlockReduceSum(rootViews.root1, packed[kVectorFloats],
            static_cast<int32_t>(h_), static_cast<int32_t>(kVectorFloats),
            1, 1, static_cast<int32_t>(pitch));
        BlockReduceSum(rootViews.root2, packed[2U * kVectorFloats],
            static_cast<int32_t>(h_), static_cast<int32_t>(kVectorFloats),
            1, 1, static_cast<int32_t>(pitch));
        BlockReduceSum(rootViews.root3, packed[3U * kVectorFloats],
            static_cast<int32_t>(h_), static_cast<int32_t>(kVectorFloats),
            1, 1, static_cast<int32_t>(pitch));
        if (Blocks == 6U || h_ >= 40U) {
            BlockReduceSum(rootViews.root4, packed[4U * kVectorFloats],
                static_cast<int32_t>(h_), static_cast<int32_t>(kVectorFloats),
                1, 1, static_cast<int32_t>(pitch));
        }
        if (Blocks == 6U) {
            if (h_ == 48U) {
                BlockReduceSum(rootViews.root5, packed[5U * kVectorFloats],
                    static_cast<int32_t>(h_),
                    static_cast<int32_t>(kVectorFloats), 1, 1,
                    static_cast<int32_t>(pitch));
            } else {
                BlockReduceSum(rootViews.root5, packed[5U * kVectorFloats],
                    static_cast<int32_t>(h_), mask, 1, 1,
                    static_cast<int32_t>(pitch));
            }
        } else if (h_ < 40U) {
            BlockReduceSum(rootViews.root4, packed[4U * kVectorFloats],
                static_cast<int32_t>(h_), mask, 1, 1,
                static_cast<int32_t>(pitch));
        }
        VectorDone();
        const BinaryRepeatParams countModeSteps{1, 1, 1, 8, 8, 8};
        SetMaskCount();
        SetVectorMask<float, MaskMode::COUNTER>(uint64_t(0), uint64_t(rows));
        Add<float, false>(rootViews.root0, rootViews.root0, rootViews.root1,
            MASK_PLACEHOLDER, 1, countModeSteps);
        Add<float, false>(rootViews.root3, rootViews.root2, rootViews.root3,
            MASK_PLACEHOLDER, 1, countModeSteps);
        if (Blocks == 6U) {
            Add<float, false>(rootViews.root5, rootViews.root4, rootViews.root5,
                MASK_PLACEHOLDER, 1, countModeSteps);
        }
        VectorDone();
        Add<float, false>(rootViews.root0, rootViews.root0, rootViews.root3,
            MASK_PLACEHOLDER, 1, countModeSteps);
        VectorDone();
        if (Blocks == 5U) {
            Add<float, false>(stats_, rootViews.root0, rootViews.root4,
                MASK_PLACEHOLDER, 1, countModeSteps);
        } else {
            Add<float, false>(stats_, rootViews.root0, rootViews.root5,
                MASK_PLACEHOLDER, 1, countModeSteps);
        }
    }

    __aicore__ inline void NormalizeRowInner(const LocalTensor<float>& packed,
        const LocalTensor<float>& scratch, uint32_t denominatorOffset,
        uint8_t denominatorStride, uint32_t rootPhaseFloats)
    {
        const uint32_t rows = kBlockFloats * h_;
        ReduceRowInnerSumsColored(packed, scratch, rootPhaseFloats);
        VectorDone();
        const UnaryRepeatParams unaryCountModeSteps{1, 1, 8, 8};
        const BinaryRepeatParams binaryCountModeSteps{1, 1, 1, 8, 8, 8};
        Adds<float, false>(stats_, stats_, eps_, MASK_PLACEHOLDER, 1,
            unaryCountModeSteps);
        VectorDone();
        // Keep one native Div per row, but multiply the eight independent
        // tokens after Brcb instead of repeating a Div across every block.
        // RowSoftmax initialized work_[3*q_*pitch_] with finite FP32 ones.
        Div<float, false>(stats_, work_[3 * q_ * pitch_], stats_,
            MASK_PLACEHOLDER, 1, binaryCountModeSteps);
        VectorDone();
        SetMaskNorm();
        ResetMask();
        // Broadcast each H row's eight real token reciprocals twice. The A
        // copies are 256 bytes ahead of the packed base; the B copies are
        // another 256 bytes ahead. Consecutive logical rows advance both
        // copies by the packed row phase, so block parity always selects two
        // group-disjoint 256-byte read windows. All roots are dead before
        // either copy overwrites the scratch allocation.
        auto denominatorA = scratch[denominatorOffset];
        auto denominatorB = denominatorA[kVectorFloats];
        const BrcbRepeatParams broadcastSteps{1, denominatorStride};
        Brcb(denominatorA, stats_, static_cast<uint8_t>(h_), broadcastSteps);
        Brcb(denominatorB, stats_, static_cast<uint8_t>(h_), broadcastSteps);
        VectorDone();
        const uint8_t rowStride = static_cast<uint8_t>(pitch_);
        const BinaryRepeatParams mulSteps{
            1, 1, 1, rowStride, rowStride, denominatorStride};
        for (uint32_t block = 0; block < pitch_ / kBlockFloats; ++block) {
            auto part = packed[block * kVectorFloats];
            const uint32_t copyOffset = (block & 1U) * kVectorFloats;
            auto denominator = scratch[denominatorOffset + copyOffset];
            // Each full repeat applies the same eight native row reciprocals.
            Mul(part, part, denominator, uint64_t(kVectorFloats),
                static_cast<uint8_t>(h_), mulSteps);
        }
        VectorDone();
    }

    template <uint32_t Blocks>
    __aicore__ inline void NormalizeRowInnerFixed(
        const LocalTensor<float>& packed, const LocalTensor<float>& scratch,
        const CompactRootViews<Blocks>& rootViews,
        uint32_t denominatorOffset)
    {
        ReduceRowInnerSumsColoredFixed<Blocks>(packed, rootViews);
        VectorDone();
        const UnaryRepeatParams unaryCountModeSteps{1, 1, 8, 8};
        const BinaryRepeatParams binaryCountModeSteps{1, 1, 1, 8, 8, 8};
        Adds<float, false>(stats_, stats_, eps_, MASK_PLACEHOLDER, 1,
            unaryCountModeSteps);
        VectorDone();
        Div<float, false>(stats_, work_[3 * q_ * pitch_], stats_,
            MASK_PLACEHOLDER, 1, binaryCountModeSteps);
        VectorDone();
        SetMaskNorm();
        ResetMask();
        auto denominatorA = scratch[denominatorOffset];
        auto denominatorB = denominatorA[kVectorFloats];
        constexpr uint8_t denominatorStride = Blocks == 5U ? 24U : 16U;
        const BrcbRepeatParams broadcastSteps{1, denominatorStride};
        Brcb(denominatorA, stats_, static_cast<uint8_t>(h_),
            broadcastSteps);
        Brcb(denominatorB, stats_, static_cast<uint8_t>(h_),
            broadcastSteps);
        VectorDone();
        constexpr uint8_t rowStride =
            static_cast<uint8_t>(Blocks * kBlockFloats);
        const BinaryRepeatParams mulSteps{
            1, 1, 1, rowStride, rowStride, denominatorStride};
        for (uint32_t block = 0; block < Blocks; ++block) {
            auto part = packed[block * kVectorFloats];
            const uint32_t copyOffset = (block & 1U) * kVectorFloats;
            auto denominator = scratch[denominatorOffset + copyOffset];
            Mul(part, part, denominator, uint64_t(kVectorFloats),
                static_cast<uint8_t>(h_), mulSteps);
        }
        VectorDone();
    }

    // A3 fixed 32-row core with early tail folding. The compact family is
    // H33..48, so r=H-32 is always 1..16. First form 16 roots from the fixed
    // core, fold the r tail rows into the first r roots, then finish 16->8->4
    // ->2->1. Each real row contributes exactly once and scratch uses 16*E.
    __aicore__ inline void ReduceColumnsCompactTree(
        const LocalTensor<float>& packed, const LocalTensor<float>& scratch,
        uint32_t valid)
    {
        const uint32_t rowElements = valid * pitch_;
        const uint32_t tailRows = h_ - 32U;
        const BinaryRepeatParams countModeSteps{1, 1, 1, 8, 8, 8};
        SetMaskCount();
        // 1: fold rows 0..15 with rows 16..31 into 16 core roots.
        SetVectorMask<float, MaskMode::COUNTER>(
            uint64_t(0), uint64_t(16) * rowElements);
        Add<float, false>(scratch, packed, packed[16 * rowElements],
            MASK_PLACEHOLDER, 1, countModeSteps);
        VectorDone();
        // 2: fold each of the r tail rows into one of the first r roots.
        SetVectorMask<float, MaskMode::COUNTER>(
            uint64_t(0), uint64_t(tailRows) * rowElements);
        Add<float, false>(scratch, scratch, packed[32 * rowElements],
            MASK_PLACEHOLDER, 1, countModeSteps);
        VectorDone();
        // 3: 16 -> 8 roots.
        SetVectorMask<float, MaskMode::COUNTER>(
            uint64_t(0), uint64_t(8) * rowElements);
        Add<float, false>(scratch, scratch, scratch[8 * rowElements],
            MASK_PLACEHOLDER, 1, countModeSteps);
        VectorDone();
        // 4: 8 -> 4 roots.
        SetVectorMask<float, MaskMode::COUNTER>(
            uint64_t(0), uint64_t(4) * rowElements);
        Add<float, false>(scratch, scratch, scratch[4 * rowElements],
            MASK_PLACEHOLDER, 1, countModeSteps);
        VectorDone();
        // 5: 4 -> 2 roots.
        SetVectorMask<float, MaskMode::COUNTER>(
            uint64_t(0), uint64_t(2) * rowElements);
        Add<float, false>(scratch, scratch, scratch[2 * rowElements],
            MASK_PLACEHOLDER, 1, countModeSteps);
        VectorDone();
        // 6: 2 -> 1 root, directly into the denominator work panel.
        SetVectorMask<float, MaskMode::COUNTER>(
            uint64_t(0), uint64_t(rowElements));
        Add<float, false>(work_, scratch, scratch[rowElements],
            MASK_PLACEHOLDER, 1, countModeSteps);
        VectorDone();
    }

    template <uint32_t Blocks>
    __aicore__ inline void ReduceColumnsCompactTreeFixed(
        const LocalTensor<float>& packed, const LocalTensor<float>& scratch)
    {
        constexpr uint32_t rowElements =
            Blocks * kBlockFloats * kBlockFloats;
        const uint32_t tailRows = h_ - 32U;
        // P40 owns five 64-float blocks per logical row. H33..40 uses nine
        // repeat blocks per row in scratch, leaving one unused 32-byte block
        // between logical 64-float vectors. The existing matrix panel is large
        // enough for the 23040-byte conservative span; no allocation moves.
        if constexpr (Blocks == 5U) {
            if (h_ <= 40U) {
                constexpr uint32_t scratchRowElements =
                    (rowElements / kVectorFloats) * 9U * kBlockFloats;
                const BinaryRepeatParams packedToScratchSteps{
                    1, 1, 1, 9, 8, 8};
                const BinaryRepeatParams scratchPackedToScratchSteps{
                    1, 1, 1, 9, 9, 8};
                const BinaryRepeatParams scratchToScratchSteps{
                    1, 1, 1, 9, 9, 9};
                const BinaryRepeatParams scratchToWorkSteps{
                    1, 1, 1, 8, 9, 9};
                SetMaskCount();
                SetVectorMask<float, MaskMode::COUNTER>(
                    uint64_t(0), uint64_t(16) * rowElements);
                Add<float, false>(scratch, packed, packed[16U * rowElements],
                    MASK_PLACEHOLDER, 1, packedToScratchSteps);
                VectorDone();
                SetVectorMask<float, MaskMode::COUNTER>(
                    uint64_t(0), uint64_t(tailRows) * rowElements);
                Add<float, false>(scratch, scratch,
                    packed[32U * rowElements], MASK_PLACEHOLDER, 1,
                    scratchPackedToScratchSteps);
                VectorDone();
                SetVectorMask<float, MaskMode::COUNTER>(
                    uint64_t(0), uint64_t(8) * rowElements);
                Add<float, false>(scratch, scratch,
                    scratch[8U * scratchRowElements], MASK_PLACEHOLDER, 1,
                    scratchToScratchSteps);
                VectorDone();
                SetVectorMask<float, MaskMode::COUNTER>(
                    uint64_t(0), uint64_t(4) * rowElements);
                Add<float, false>(scratch, scratch,
                    scratch[4U * scratchRowElements], MASK_PLACEHOLDER, 1,
                    scratchToScratchSteps);
                VectorDone();
                SetVectorMask<float, MaskMode::COUNTER>(
                    uint64_t(0), uint64_t(2) * rowElements);
                Add<float, false>(scratch, scratch,
                    scratch[2U * scratchRowElements], MASK_PLACEHOLDER, 1,
                    scratchToScratchSteps);
                VectorDone();
                SetVectorMask<float, MaskMode::COUNTER>(
                    uint64_t(0), uint64_t(rowElements));
                Add<float, false>(work_, scratch,
                    scratch[scratchRowElements], MASK_PLACEHOLDER, 1,
                    scratchToWorkSteps);
                VectorDone();
                return;
            }
        }
        const BinaryRepeatParams countModeSteps{1, 1, 1, 8, 8, 8};
        SetMaskCount();
        SetVectorMask<float, MaskMode::COUNTER>(
            uint64_t(0), uint64_t(16) * rowElements);
        Add<float, false>(scratch, packed, packed[16U * rowElements],
            MASK_PLACEHOLDER, 1, countModeSteps);
        VectorDone();
        SetVectorMask<float, MaskMode::COUNTER>(
            uint64_t(0), uint64_t(tailRows) * rowElements);
        Add<float, false>(scratch, scratch, packed[32U * rowElements],
            MASK_PLACEHOLDER, 1, countModeSteps);
        VectorDone();
        SetVectorMask<float, MaskMode::COUNTER>(
            uint64_t(0), uint64_t(8) * rowElements);
        Add<float, false>(scratch, scratch, scratch[8U * rowElements],
            MASK_PLACEHOLDER, 1, countModeSteps);
        VectorDone();
        SetVectorMask<float, MaskMode::COUNTER>(
            uint64_t(0), uint64_t(4) * rowElements);
        Add<float, false>(scratch, scratch, scratch[4U * rowElements],
            MASK_PLACEHOLDER, 1, countModeSteps);
        VectorDone();
        SetVectorMask<float, MaskMode::COUNTER>(
            uint64_t(0), uint64_t(2) * rowElements);
        Add<float, false>(scratch, scratch, scratch[2U * rowElements],
            MASK_PLACEHOLDER, 1, countModeSteps);
        VectorDone();
        SetVectorMask<float, MaskMode::COUNTER>(
            uint64_t(0), uint64_t(rowElements));
        Add<float, false>(work_, scratch, scratch[rowElements],
            MASK_PLACEHOLDER, 1, countModeSteps);
        VectorDone();
    }

    // Initial and middle compact column stages: tree-reduce into work_, then
    // retain the original +eps, native Div and lane-local Mul sequence.
    __aicore__ inline void NormalizeColumnsCompactTree(
        const LocalTensor<float>& packed, const LocalTensor<float>& scratch,
        uint32_t valid)
    {
        const uint32_t rowElements = valid * pitch_;
        ReduceColumnsCompactTree(packed, scratch, valid);
        const UnaryRepeatParams unaryCountModeSteps{1, 1, 8, 8};
        const BinaryRepeatParams binaryCountModeSteps{1, 1, 1, 8, 8, 8};
        Adds<float, false>(work_, work_, eps_, MASK_PLACEHOLDER, 1,
            unaryCountModeSteps);
        VectorDone();
        if (upperShortMath_) {
            Div<float, false>(work_, work_[3 * q_ * pitch_], work_,
                MASK_PLACEHOLDER, 1, binaryCountModeSteps);
            VectorDone();
        }
        SetMaskNorm();
        ResetMask();
        const uint32_t blocks = pitch_ / kBlockFloats;
        const uint8_t rowStride = static_cast<uint8_t>(rowElements / kBlockFloats);
        const BinaryRepeatParams steps{1, 1, 1, rowStride, rowStride, 0};
        for (uint32_t block = 0; block < blocks; ++block) {
            auto part = packed[block * kVectorFloats];
            Mul(part, part, work_[block * kVectorFloats],
                uint64_t(kVectorFloats), static_cast<uint8_t>(h_), steps);
        }
        VectorDone();
    }

    template <uint32_t Blocks>
    __aicore__ inline void NormalizeColumnsCompactTreeFixed(
        const LocalTensor<float>& packed, const LocalTensor<float>& scratch)
    {
        ReduceColumnsCompactTreeFixed<Blocks>(packed, scratch);
        const UnaryRepeatParams unaryCountModeSteps{1, 1, 8, 8};
        const BinaryRepeatParams binaryCountModeSteps{1, 1, 1, 8, 8, 8};
        Adds<float, false>(work_, work_, eps_, MASK_PLACEHOLDER, 1,
            unaryCountModeSteps);
        VectorDone();
        if (upperShortMath_) {
            Div<float, false>(work_, work_[3 * q_ * pitch_], work_,
                MASK_PLACEHOLDER, 1, binaryCountModeSteps);
            VectorDone();
        }
        SetMaskNorm();
        ResetMask();
        constexpr uint8_t rowStride =
            static_cast<uint8_t>(Blocks * kBlockFloats);
        const BinaryRepeatParams steps{1, 1, 1, rowStride, rowStride, 0};
        for (uint32_t block = 0; block < Blocks; ++block) {
            auto part = packed[block * kVectorFloats];
            Mul(part, part, work_[block * kVectorFloats],
                uint64_t(kVectorFloats), static_cast<uint8_t>(h_), steps);
        }
        VectorDone();
    }

    // The last compact column scale writes into the dead matrix panel. The
    // token-major variant keeps the packed operand and denominator while its
    // destination lane blocks are separated by H*P; the next repeat advances
    // by P for the next real row. All FP32 operands and the native Mul remain.
    // Larger H*P strides and every non-compact path retain the original panel
    // layout and per-token stores.
    __aicore__ inline void NormalizeColumnsCompactToPanel(
        const LocalTensor<float>& packed, const LocalTensor<float>& panel,
        uint32_t valid, bool tokenMajor)
    {
        const uint32_t rowElements = valid * pitch_;
        const uint8_t rowStride = static_cast<uint8_t>(rowElements / kBlockFloats);
        // panel is a complete dead panel here and can hold every tree level.
        // No output is written until the tree has produced the final sums.
        ReduceColumnsCompactTree(packed, panel, valid);
        const UnaryRepeatParams unaryCountModeSteps{1, 1, 8, 8};
        const BinaryRepeatParams binaryCountModeSteps{1, 1, 1, 8, 8, 8};
        Adds<float, false>(work_, work_, eps_, MASK_PLACEHOLDER, 1,
            unaryCountModeSteps);
        VectorDone();
        if (upperShortMath_) {
            Div<float, false>(work_, work_[3 * q_ * pitch_], work_,
                MASK_PLACEHOLDER, 1, binaryCountModeSteps);
            VectorDone();
        }
        SetMaskNorm();
        ResetMask();
        const uint32_t blocks = pitch_ / kBlockFloats;
        const uint8_t dstBlockStride = tokenMajor
            ? static_cast<uint8_t>(h_ * pitch_ / kBlockFloats)
            : static_cast<uint8_t>(blocks);
        const uint8_t dstRepStride = tokenMajor
            ? static_cast<uint8_t>(pitch_ / kBlockFloats)
            : rowStride;
        const BinaryRepeatParams outSteps{dstBlockStride, 1, 1,
            dstRepStride, rowStride, 0};
        for (uint32_t block = 0; block < blocks; ++block) {
            Mul(panel[block * kBlockFloats], packed[block * kVectorFloats],
                work_[block * kVectorFloats], uint64_t(kVectorFloats),
                static_cast<uint8_t>(h_), outSteps);
        }
        VectorDone();
    }

    template <uint32_t Blocks>
    __aicore__ inline void NormalizeColumnsCompactToPanelFixed(
        const LocalTensor<float>& packed, const LocalTensor<float>& panel)
    {
        constexpr uint32_t rowElements =
            Blocks * kBlockFloats * kBlockFloats;
        constexpr uint8_t rowStride =
            static_cast<uint8_t>(Blocks * kBlockFloats);
        ReduceColumnsCompactTreeFixed<Blocks>(packed, panel);
        const UnaryRepeatParams unaryCountModeSteps{1, 1, 8, 8};
        const BinaryRepeatParams binaryCountModeSteps{1, 1, 1, 8, 8, 8};
        Adds<float, false>(work_, work_, eps_, MASK_PLACEHOLDER, 1,
            unaryCountModeSteps);
        VectorDone();
        if (upperShortMath_) {
            Div<float, false>(work_, work_[3 * q_ * pitch_], work_,
                MASK_PLACEHOLDER, 1, binaryCountModeSteps);
            VectorDone();
        }
        SetMaskNorm();
        ResetMask();
        const uint8_t dstBlockStride =
            static_cast<uint8_t>(h_ * pitch_ / kBlockFloats);
        constexpr uint8_t dstRepStride = Blocks;
        const BinaryRepeatParams outSteps{dstBlockStride, 1, 1,
            dstRepStride, rowStride, 0};
        for (uint32_t block = 0; block < Blocks; ++block) {
            Mul(panel[block * kBlockFloats],
                packed[block * kVectorFloats],
                work_[block * kVectorFloats], uint64_t(kVectorFloats),
                static_cast<uint8_t>(h_), outSteps);
        }
        VectorDone();
    }

    template <uint32_t Blocks>
    __aicore__ inline void RunCompactSinkhornFixed(
        const LocalTensor<float>& matrix, uint32_t valid)
    {
        auto packed = broadcast_;
        PackRowInnerMatrixFixed<Blocks>(packed, matrix);
        const uint32_t rowRootPhaseFloats =
            RowInnerRootPhaseFloats(matrix);
        const CompactRootViews<Blocks> rowRoots(matrix, rowRootPhaseFloats);
        NormalizeColumnsCompactTreeFixed<Blocks>(packed, matrix);
        const uint32_t denominatorByteOffset = static_cast<uint32_t>(
            (packed.GetPhyAddr() + 256U - matrix.GetPhyAddr()) & 511U);
        const uint32_t denominatorOffset =
            denominatorByteOffset / sizeof(float);
        const bool tokenMajorStore = UseTokenMajorCompactStore(valid);
        for (uint32_t iter = 1; iter + 1U < iters_; ++iter) {
            NormalizeRowInnerFixed<Blocks>(packed, matrix, rowRoots,
                denominatorOffset);
            NormalizeColumnsCompactTreeFixed<Blocks>(packed, matrix);
        }
        NormalizeRowInnerFixed<Blocks>(packed, matrix, rowRoots,
            denominatorOffset);
        if (tokenMajorStore) {
            NormalizeColumnsCompactToPanelFixed<Blocks>(packed, matrix);
        } else {
            // H43+ exceeds A2's uint8 token-major destination stride. Keep the
            // original A2 non-token-major final layout byte for byte.
            NormalizeColumnsCompactToPanel(packed, matrix, valid, false);
        }
        if (tokenMajorStore && UseDenseCompactOutput(valid)) {
            const GatherMaskParams gatherParams{
                1, static_cast<uint16_t>(h_),
                static_cast<uint16_t>(pitch_), 0};
            uint64_t rsvdCnt = 0;
            GatherMask<float, uint32_t, GatherMaskMode::VERSION_V2>(
                broadcast_, matrix, gatherPattern_, true,
                static_cast<uint32_t>(kBlockFloats * pitch_),
                gatherParams, rsvdCnt);
            VectorDone();
        }
    }

    __aicore__ inline void RunPostSoftmaxSinkhorn(const LocalTensor<float>& matrix,
        uint32_t valid)
    {
        if (UseRowInnerCompactDen(valid)) {
            if (pitch_ == 5U * kBlockFloats) {
                RunCompactSinkhornFixed<5U>(matrix, valid);
            } else {
                RunCompactSinkhornFixed<6U>(matrix, valid);
            }
            return;
        }
        // Every other batch retains the complete original B5 mathematics.
        NormalizeColumns(matrix, valid);
        for (uint32_t iter = 1; iter < iters_; ++iter) {
            NormalizeRows(matrix, valid);
            NormalizeColumns(matrix, valid);
        }
    }

    __aicore__ inline void NormalizeRows(const LocalTensor<float>& matrix, uint32_t valid)
    {
        const uint32_t rows = valid * h_;
        ReduceRowSums(matrix, rows);
        VectorDone();
        Adds(stats_, stats_, eps_, rows);
        VectorDone();
        BroadcastRows(rows, true);
        ApplyRows<true>(matrix, rows);
    }

    __aicore__ inline void NormalizeColumns(const LocalTensor<float>& matrix, uint32_t valid)
    {
        if (batchNonalignedInterleave_) {
            const uint32_t rowElements = batchColumnElements_;
            const uint8_t rowStride = batchColumnStride_;
            const UnaryRepeatParams once{1, 1, 8, 8};
            const BinaryRepeatParams accumulate{1, 1, 1, 0, rowStride, 0};
            const BinaryRepeatParams steps{1, 1, 1, rowStride, rowStride, 0};
            // DataCopyPad initializes every active padded row. A column lane
            // keeps the same (token, column) through the row recurrence, so
            // padding may be computed independently, even if it becomes NaN.
            // WR(H) and the H-wide stores never consume those padding lanes.
            // Keep every real lane's seed +0, row order, +eps and native Div.
            if (rowElements <= kVectorFloats || rowElements % kVectorFloats == 0) {
                // One partial vector or only full vectors can share one NORMAL
                // mask across all four stages. The incoming count API already
                // restored NORMAL; false-template calls do not change it.
                const uint64_t mask = rowElements < kVectorFloats
                    ? (uint64_t(1) << rowElements) - 1 : ~uint64_t(0);
                const uint8_t tiles = static_cast<uint8_t>(
                    (rowElements + kVectorFloats - 1) / kVectorFloats);
                SetVectorMask<float, MaskMode::NORMAL>(uint64_t(0), mask);
                // This writes all E=valid*pitch accumulator lanes before read.
                Adds<float, false>(work_, matrix, 0.0f, MASK_PLACEHOLDER, tiles, once);
                VectorDone();
                for (uint32_t column = 0; column < rowElements; column += kVectorFloats) {
                    Add<float, false>(work_[column], matrix[rowElements + column],
                        work_[column], MASK_PLACEHOLDER, static_cast<uint8_t>(h_ - 1), accumulate);
                }
                VectorDone();
                Adds<float, false>(work_, work_, eps_, MASK_PLACEHOLDER, tiles, once);
                VectorDone();
                if (upperShortMath_) {
                    // Stage-local native inverse; no implicit cumulative factor.
                    Div(work_, work_[3 * q_ * pitch_], work_,
                        static_cast<int32_t>(rowElements));
                    VectorDone();
                    // Div(count) restores full NORMAL mask; restore this panel's
                    // partial/full mask before the false-template Mul consumers.
                    SetMaskNorm();
                    SetVectorMask<float, MaskMode::NORMAL>(uint64_t(0), mask);
                }
                for (uint32_t column = 0; column < rowElements; column += kVectorFloats) {
                    if (upperShortMath_) {
                        Mul<float, false>(matrix[column], matrix[column], work_[column],
                            MASK_PLACEHOLDER, static_cast<uint8_t>(h_), steps);
                    } else {
                        Div<float, false>(matrix[column], matrix[column], work_[column],
                            MASK_PLACEHOLDER, static_cast<uint8_t>(h_), steps);
                    }
                }
                VectorDone();
                // The next WR/count consumer establishes its own mask. DMA
                // and event synchronization do not consume the vector mask.
                return;
            }
            // Mixed final vectors use exact contiguous counts: neither an
            // inactive token nor the first lane of the next row is accessed.
            Adds(work_, matrix, 0.0f, rowElements);
            VectorDone();
            for (uint32_t column = 0; column < rowElements; column += kVectorFloats) {
                const uint32_t remaining = rowElements - column;
                const uint64_t count = remaining < kVectorFloats ? remaining : kVectorFloats;
                Add(work_[column], matrix[rowElements + column], work_[column], count,
                    static_cast<uint8_t>(h_ - 1), accumulate);
            }
            VectorDone();
            Adds(work_, work_, eps_, rowElements);
            VectorDone();
            if (upperShortMath_) {
                Div(work_, work_[3 * q_ * pitch_], work_,
                    static_cast<int32_t>(rowElements));
                VectorDone();
            }
            for (uint32_t column = 0; column < rowElements; column += kVectorFloats) {
                const uint32_t remaining = rowElements - column;
                const uint64_t count = remaining < kVectorFloats ? remaining : kVectorFloats;
                if (upperShortMath_) {
                    // Mixed E panels (e.g. E160) retain an exact last count.
                    Mul(matrix[column], matrix[column], work_[column], count,
                        static_cast<uint8_t>(h_), steps);
                } else {
                    Div(matrix[column], matrix[column], work_[column], count,
                        static_cast<uint8_t>(h_), steps);
                }
            }
            VectorDone();
            return;
        }
        if (h_ % kBlockFloats == 0) {
            const uint32_t rowElements = valid * pitch_;
            const uint8_t rowStride = static_cast<uint8_t>(rowElements / kBlockFloats);
            // Layout [row, active token, column]. Use the same Add recurrence
            // as the original path: dst==src1, zero dst/src1 repeat strides,
            // and a disjoint src0 matrix. This is Add's documented exception.
            Adds(work_, matrix, 0.0f, rowElements);
            VectorDone();
            const BinaryRepeatParams accumulate{1, 1, 1, 0, rowStride, 0};
            for (uint32_t column = 0; column < rowElements; column += kVectorFloats) {
                const uint32_t remaining = rowElements - column;
                const uint64_t count = remaining < kVectorFloats ? remaining : kVectorFloats;
                Add(work_[column], matrix[rowElements + column], work_[column], count,
                    static_cast<uint8_t>(h_ - 1), accumulate);
            }
            VectorDone();
            Adds(work_, work_, eps_, rowElements);
            VectorDone();
            const BinaryRepeatParams steps{1, 1, 1, rowStride, rowStride, 0};
            if (upperShortMath_) {
                Div(work_, work_[3 * q_ * pitch_], work_,
                    static_cast<int32_t>(rowElements));
                VectorDone();
            }
            for (uint32_t column = 0; column < rowElements; column += kVectorFloats) {
                const uint32_t remaining = rowElements - column;
                const uint64_t count = remaining < kVectorFloats ? remaining : kVectorFloats;
                if (upperShortMath_) {
                    Mul(matrix[column], matrix[column], work_[column], count,
                        static_cast<uint8_t>(h_), steps);
                } else {
                    Div(matrix[column], matrix[column], work_[column], count,
                        static_cast<uint8_t>(h_), steps);
                }
            }
            VectorDone();
            return;
        }
        // One padded H-vector per token. None of these accumulators overlap.
        for (uint32_t t = 0; t < valid; ++t) {
            Adds(work_[t * pitch_], matrix[t * matrixSize_], 0.0f, h_);
        }
        VectorDone();
        const uint8_t rowStride = static_cast<uint8_t>(pitch_ / 8);
        const uint64_t count = h_ < 64 ? h_ : 64;
        const BinaryRepeatParams accumulate{1, 1, 1, 0, rowStride, 0};
        for (uint32_t t = 0; t < valid; ++t) {
            auto sums = work_[t * pitch_];
            auto input = matrix[t * matrixSize_];
            Add(sums, input[pitch_], sums, count, static_cast<uint8_t>(h_ - 1), accumulate);
            if (h_ > 64) {
                Add(sums[64], input[pitch_ + 64], sums[64], uint64_t(h_ - 64),
                    static_cast<uint8_t>(h_ - 1), accumulate);
            }
        }
        VectorDone();
        for (uint32_t t = 0; t < valid; ++t) {
            Adds(work_[t * pitch_], work_[t * pitch_], eps_, h_);
        }
        VectorDone();
        const BinaryRepeatParams steps{1, 1, 1, rowStride, rowStride, 0};
        if (upperShortMath_) {
            for (uint32_t t = 0; t < valid; ++t) {
                auto sums = work_[t * pitch_];
                Div(sums, work_[3 * q_ * pitch_], sums, static_cast<int32_t>(h_));
            }
            VectorDone();
        }
        for (uint32_t t = 0; t < valid; ++t) {
            auto input = matrix[t * matrixSize_];
            auto sums = work_[t * pitch_];
            if (upperShortMath_) {
                Mul(input, input, sums, count, static_cast<uint8_t>(h_), steps);
            } else {
                Div(input, input, sums, count, static_cast<uint8_t>(h_), steps);
            }
            if (h_ > 64) {
                Div(input[64], input[64], sums[64], uint64_t(h_ - 64),
                    static_cast<uint8_t>(h_), steps);
            }
        }
        VectorDone();
    }

    TPipe* pipe_;
    TQue<QuePosition::VECIN, 1> matrixQueue_, gatesQueue_;
    TBuf<TPosition::VECCALC> workBuf_, statsBuf_, broadcastBuf_;
    TBuf<TPosition::VECCALC> inputIndexBuf_;
    GlobalTensor<float> x_, pre_, post_, comb_;
    LocalTensor<float> work_, stats_, broadcast_;
    LocalTensor<int32_t> bulkIndex_;
    LocalTensor<int32_t> outputIndex_;
    LocalTensor<uint32_t> gatherPattern_;
    uint64_t first_, end_, gateFirst_, gateEnd_;
    bool splitOwnership_;
    uint32_t separationRole_;
    uint64_t shortRowLastBlockMask_;
    uint64_t shortRowBlockMask_;
    uint64_t shortColumnMasks_[kMaxResidentTokenBatch];
    uint64_t batchColumnMasks_[kMaxResidentTokenBatch];
    uint32_t batchColumnElements_;
    uint8_t batchColumnStride_;
    bool batchNonalignedInterleave_;
    uint32_t h_, q_, pitch_, matrixSize_, statsSize_, gateSize_, w_, iters_;
    bool rowDivPanel_, batchRowDivPanel_, shortTailBr_;
    bool bulkInputGather_;
    bool lowIterOutputPack_;
    bool upperShortMath_;
    bool lowerShortFold8_;
    float eps_;
    TBuf<TPosition::VECCALC> ubBankPadBeforeWork_;
};



// A1: one runtime-H q2 short-row entry. Reuse original gate/softmax helpers.
// No generic Init/Process/RunPostSoftmaxSinkhorn call in the native entry.
// Allocation order/bytes match q2 ResidentTokenBatchKernel exactly.
// M3: retain M2's runtime-pitch false/true policies and add exactly one
// separated P24 policy. H/iters/eps remain runtime; no per-H expansion.
template <bool SeparateRoles, uint32_t FixedPitch = 0U>
class CompactShortNativeKernel : public ResidentTokenBatchKernel {
public:
    static_assert(FixedPitch == 0U || (SeparateRoles && FixedPitch == 24U),
        "CompactShortNativeKernel permits only generic or separated P24");
    __aicore__ inline void Init(GM_ADDR mixes, GM_ADDR pre, GM_ADDR post,
        GM_ADDR comb, uint64_t n, uint32_t h, uint32_t iters, float eps,
        uint32_t tokenGroup, uint32_t flags, TPipe* pipe,
        uint32_t matrixCoreCount = 0)
    {
        pipe_=pipe;h_=h;q_=2U;iters_=iters;eps_=eps;
        const uint32_t pitch = FixedPitch != 0U ? FixedPitch : (h+7U)/8U*8U;
        pitch_=pitch;matrixSize_=h*pitch;
        statsSize_=(2U*h+7U)/8U*8U;const uint32_t gateSize=4U*pitch;gateSize_=gateSize;w_=h*h+2U*h;
        rowDivPanel_=true;shortTailBr_=(flags&kShortRowTailBrFlag)!=0;
        bulkInputGather_=false;upperShortMath_=false;lowerShortFold8_=true;
        shortRowLastBlockMask_=((uint64_t(1)<<(h-pitch+8U))-1U)*
            uint64_t(0x0101010101010101ULL);
        const uint32_t tail=h%8U;
        shortRowBlockMask_=tail==0 ? ~uint64_t(0):
            ((uint64_t(1)<<tail)-1U)*uint64_t(0x0101010101010101ULL);
        if(UseNonalignedInterleave(2U)) InitShortColumnMasks();
        PrepareColumnMetadata(2U);
        const uint32_t gateGroup=DeviceOutputTokenGroup(h);
        splitOwnership_=tokenGroup<gateGroup;
        // M2: derived Init initializes the role for BOTH template policies.
        // Compile out mixed ownership in the separated policy, retaining the
        // exact explicit-count matrix and one-group-per-gate-core partition.
        separationRole_=0;
        if constexpr (!SeparateRoles){
            TokenRange(n,tokenGroup,first_,end_);
            if(splitOwnership_) TokenRange(n,gateGroup,gateFirst_,gateEnd_);
        }else{
            const uint64_t block=GetBlockIdx();
            first_=end_=gateFirst_=gateEnd_=0;
            if(block<matrixCoreCount){
                separationRole_=1;
                // The launch also contains gate blocks. Keep the ORIGINAL
                // A1 matrix partition by explicit count, never GetBlockNum().
                const uint64_t groups=(n+tokenGroup-1U)/tokenGroup;
                first_=(groups*block/matrixCoreCount)*tokenGroup;
                end_=(groups*(block+1U)/matrixCoreCount)*tokenGroup;
                if(end_>n) end_=n;
            }else{
                separationRole_=2;
                // One surplus block owns one aligned gate output group.
                const uint64_t gateBlock=block-matrixCoreCount;
                gateFirst_=gateBlock*gateGroup;
                gateEnd_=gateFirst_+gateGroup;
                if(gateEnd_>n) gateEnd_=n;
            }
        }
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(mixes));
        pre_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(pre));
        post_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(post));
        comb_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(comb));
        const uint32_t physicalRows=shortTailBr_?statsSize_:2U*h;
        pipe_->InitBuffer(matrixQueue_,1,physicalRows*pitch*sizeof(float));
        pipe_->InitBuffer(gatesQueue_,1,gateSize*sizeof(float));
        pipe_->InitBuffer(ubBankPadBeforeWork_,uint32_t(256));
        pipe_->InitBuffer(workBuf_,2U*gateSize*sizeof(float));
        pipe_->InitBuffer(statsBuf_,statsSize_*sizeof(float));
        pipe_->InitBuffer(broadcastBuf_,pitch*statsSize_*sizeof(float));
        work_=workBuf_.Get<float>();stats_=statsBuf_.Get<float>();
        broadcast_=broadcastBuf_.Get<float>();
        roots_=pitch/8U;foldRepeats_=statsSize_/8U;
        rows_=2U*h;columnElements_=2U*pitch;columnStride_=(2U*pitch)/8U;
        matrixElements_=rows_*pitch;
        rowMask_=rows_==64U?~uint64_t(0):(uint64_t(1)<<rows_)-1U;
        columnMask_=(2U*pitch)==64U?~uint64_t(0):
            (uint64_t(1)<<(2U*pitch))-1U;
        Duplicate(stats_,0.0f,statsSize_);VectorDone();
    }

    __aicore__ inline void Process()
    {
        const uint32_t pitch = FixedPitch != 0U ? FixedPitch : pitch_;
        if constexpr (SeparateRoles){
            if(separationRole_==2){
                ProcessOwnedGates();
                return;
            }
        }else{
            if(splitOwnership_) ProcessOwnedGates();
        }
        const uint32_t gap=pitch/8U;
        const DataCopyExtParams load{static_cast<uint16_t>(h_),h_*4U,0,gap,0};
        const DataCopyExtParams store{static_cast<uint16_t>(h_),h_*4U,gap,0,0};
        const DataCopyPadExtParams<float> pad{
            true,0,static_cast<uint8_t>(pitch-h_),0.0f};
        for(uint64_t token=first_;token<end_;token+=2U){
            auto matrix=matrixQueue_.AllocTensor<float>();
            for(uint32_t t=0;t<2U;++t)
                DataCopyPad(matrix[t*pitch],x_[(token+t)*w_+2U*h_],load,pad);
            matrixQueue_.EnQue(matrix);matrix=matrixQueue_.DeQue<float>();
            if constexpr (!SeparateRoles){
                if(!splitOwnership_){
                    auto gates=gatesQueue_.AllocTensor<float>();
                    for(uint32_t t=0;t<2U;++t){
                        LoadExact(gates[2U*t*pitch],x_[(token+t)*w_],h_);
                        LoadExact(gates[(2U*t+1U)*pitch],x_[(token+t)*w_+h_],h_);
                    }
                    gatesQueue_.EnQue(gates);gates=gatesQueue_.DeQue<float>();
                    SigmoidInPlace(gates,work_,work_[gateSize_],gateSize_);
                    for(uint32_t t=0;t<2U;++t){
                        Adds(gates[2U*t*pitch],gates[2U*t*pitch],eps_,h_);
                        Muls(gates[(2U*t+1U)*pitch],gates[(2U*t+1U)*pitch],2.0f,h_);
                    }
                    VectorDone();SyncPipelines<HardEvent::V_MTE3>(*pipe_);
                    for(uint32_t t=0;t<2U;++t){
                        StoreExact(pre_[(token+t)*h_],gates[2U*t*pitch],h_);
                        StoreExact(post_[(token+t)*h_],gates[(2U*t+1U)*pitch],h_);
                    }
                    SyncPipelines<HardEvent::MTE3_V>(*pipe_);gatesQueue_.FreeTensor(gates);
                }
            }
            InitShortTailRows(matrix,2U);RowSoftmax(matrix,2U);
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 2201 && !ASCENDC_CPU_DEBUG && !defined(__MSTX_DFX_REPORT__)
            nm_=(__ubuf__ float*)matrix.GetPhyAddr();
            nb_=(__ubuf__ float*)broadcast_.GetPhyAddr();
            ns_=(__ubuf__ float*)stats_.GetPhyAddr();
            nw_=(__ubuf__ float*)work_.GetPhyAddr();
#endif
            Columns(matrix);
            for(uint32_t iter=1U;iter<iters_;++iter){Rows(matrix);Columns(matrix);}
            SetMaskNorm();ResetMask();SyncPipelines<HardEvent::V_MTE3>(*pipe_);
            for(uint32_t t=0;t<2U;++t)
                DataCopyPad(comb_[(token+t)*h_*h_],matrix[t*pitch],store);
            SyncPipelines<HardEvent::MTE3_V>(*pipe_);matrixQueue_.FreeTensor(matrix);
        }
    }

private:
    __aicore__ inline void Rows(const LocalTensor<float>& matrix)
    {
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 2201 && !ASCENDC_CPU_DEBUG && !defined(__MSTX_DFX_REPORT__)
        if ASCEND_IS_AIV {
            const uint32_t pitch = FixedPitch != 0U ? FixedPitch : pitch_;
            const uint32_t roots = FixedPitch != 0U ? FixedPitch/8U : roots_;
            const uint32_t matrixElements = FixedPitch != 0U
                ? 2U*h_*FixedPitch : matrixElements_;
            SetMaskNorm();ResetMask();
            if(roots==2U && h_%8U!=0){
                vadds(nb_,nm_,0.0f,foldRepeats_,1,roots,8,pitch);VectorDone();
                SetVectorMask<float>(uint64_t(0),shortRowLastBlockMask_);
                vadd(nb_,nb_,nm_+8U,foldRepeats_,1,1,roots,8,8,pitch);
                VectorDone();
            }else{
                vadd(nb_,nm_,nm_+8U,foldRepeats_,1,roots,roots,8,pitch,pitch);
                VectorDone();
                for(uint32_t root=2U;root<roots;++root){
                    if(root+1U==roots)
                        SetVectorMask<float>(uint64_t(0),shortRowLastBlockMask_);
                    else ResetMask();
                    vadd(nb_,nb_,nm_+root*8U,foldRepeats_,1,1,roots,8,8,pitch);
                    VectorDone();
                }
            }
            ResetMask();vcgadd(ns_,nb_,foldRepeats_,1,1,8);VectorDone();
            SetVectorMask<float>(uint64_t(0),rowMask_);
            vadds(ns_,ns_,eps_,1,1,1,8,8);VectorDone();ResetMask();
            for(uint32_t column=0;column<pitch;column+=8U)
                vbrcb((__ubuf__ uint32_t*)(nb_+column),
                    (__ubuf__ uint32_t*)ns_,roots,pitch,foldRepeats_);
            VectorDone();SetMaskCount();
            SetVectorMask<float,MaskMode::COUNTER>(uint64_t(0),uint64_t(matrixElements));
            vdiv(nm_,nm_,nb_,1,1,1,1,8,8,8);VectorDone();
            SetMaskNorm();ResetMask();
        }
#else
        NormalizeRows(matrix,2U);
#endif
    }

    __aicore__ inline void Columns(const LocalTensor<float>& matrix)
    {
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 2201 && !ASCENDC_CPU_DEBUG && !defined(__MSTX_DFX_REPORT__)
        if ASCEND_IS_AIV {
            const uint32_t columnElements = FixedPitch != 0U
                ? 2U*FixedPitch : columnElements_;
            const uint32_t columnStride = FixedPitch != 0U
                ? (2U*FixedPitch)/8U : columnStride_;
            const uint64_t columnMask = FixedPitch == 24U
                ? uint64_t(0x0000FFFFFFFFFFFFULL) : columnMask_;
            SetMaskNorm();SetVectorMask<float>(uint64_t(0),columnMask);
            vadds(nw_,nm_,0.0f,1,1,1,8,8);VectorDone();
            // Exactly row0+0; row1+acc; ...; row(H-1)+acc.
            vadd(nw_,nm_+columnElements,nw_,h_-1U,1,1,1,0,columnStride,0);
            VectorDone();vadds(nw_,nw_,eps_,1,1,1,8,8);VectorDone();
            vdiv(nm_,nm_,nw_,h_,1,1,1,columnStride,columnStride,0);
            VectorDone();
        }
#else
        NormalizeColumns(matrix,2U);
#endif
    }
    uint32_t roots_,foldRepeats_,rows_,columnElements_,columnStride_,matrixElements_;
    uint64_t rowMask_,columnMask_;
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 2201 && !ASCENDC_CPU_DEBUG && !defined(__MSTX_DFX_REPORT__)
    __ubuf__ float *nm_,*nb_,*ns_,*nw_;
#endif
};

// A: private capacity flag; passed only to the existing static P24 entries.
constexpr uint32_t kP24RowDenLayoutFlag = 1U << 24;

// B2: independent static-UB P24 entry. No framework objects or event pool.
// Preserve the original q2 allocation order/offsets and256B bank pad.
template <uint32_t Height>
class CompactShortStaticP24Kernel {
    static_assert(Height == 18U || Height == 22U, "Complete natural P24 family only");
public:
    __aicore__ inline void Init(GM_ADDR mixes, GM_ADDR pre, GM_ADDR post,
        GM_ADDR comb, uint64_t n, uint32_t /*h*/, uint32_t iters, float eps,
        uint32_t tokenGroup, uint32_t flags, uint32_t matrixCoreCount)
    {
        constexpr uint32_t h = Height;
#if defined(__has_builtin)
#if __has_builtin(__builtin_assume)
        // B4: the existing natural P24 host admission proves this H interval.
        __builtin_assume(h >= 17U && h <= 24U);
#endif
#endif
        iters_=iters;eps_=eps;
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(mixes));
        pre_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(pre));
        post_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(post));
        comb_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(comb));
        const uint32_t statsSize=(2U*h+7U)/8U*8U;
        shortTailBr_=(flags&kShortRowTailBrFlag)!=0;
        const uint32_t physicalRows=shortTailBr_?statsSize:2U*h;
        matrixFloats_=physicalRows*24U;
        // matrix[0],gates,256B pad,work,stats,broadcast: M3 exact order.
        gateAddr_=matrixFloats_*4U;
        workAddr_=gateAddr_+96U*4U+256U;
        work_=LocalTensor<float>(TPosition::VECCALC,workAddr_,192U);
        const uint64_t block=GetBlockIdx();
        matrixRole_=block<matrixCoreCount;
        if(!matrixRole_){
            // Role branch precedes matrix-only metadata and vector init.
            const uint32_t gateGroup=DeviceOutputTokenGroup(h);
            gateFirst_=(block-matrixCoreCount)*gateGroup;
            gateEnd_=gateFirst_+gateGroup;
            if(gateEnd_>n) gateEnd_=n;
            return;
        }
        if(tokenGroup==2U && n==uint64_t(2U)*matrixCoreCount){
            first_=2U*block;end_=first_+2U;
        }else{
            const uint64_t groups=(n+tokenGroup-1U)/tokenGroup;
            first_=(groups*block/matrixCoreCount)*tokenGroup;
            end_=(groups*(block+1U)/matrixCoreCount)*tokenGroup;
            if(end_>n) end_=n;
        }
        statsSize_=statsSize;
        matrixSize_=h*24U;rows_=2U*h;
        foldRepeats_=statsSize/8U;matrixElements_=rows_*24U;
        shortRowLastBlockMask_=((uint64_t(1)<<(h-16U))-1U)*
            uint64_t(0x0101010101010101ULL);
        rowMask_=(uint64_t(1)<<rows_)-1U;
        const uint32_t broadcasts=(rows_+7U)/8U;
        const uint32_t packedDivs=(rows_*24U+63U)/64U;
        batchRowDivPanel_=broadcasts*3U+4U*packedDivs <
            broadcasts+4U*rows_;
        const uint32_t statsAddr=workAddr_+192U*4U;
        stats_=LocalTensor<float>(TPosition::VECCALC,statsAddr,statsSize);
        const uint32_t broadcastAddr=statsAddr+statsSize*4U;
        broadcast_=LocalTensor<float>(TPosition::VECCALC,
            broadcastAddr,24U*statsSize);
        // Select only an address: insufficient capacity keeps exact M1 nb.
        const uint32_t rowDenAddr=(flags&kP24RowDenLayoutFlag)!=0
            ? (broadcastAddr+255U)/512U*512U+256U : broadcastAddr;
        rowDen_=LocalTensor<float>(TPosition::VECCALC,rowDenAddr,24U*statsSize);
        // Max8 reads rounded dummy matrix rows. Initialize them before DMA,
        // sharing the original stats-init barrier; no dummy RAW is deferred.
        auto matrix=LocalTensor<float>(TPosition::VECCALC,0U,matrixFloats_);
        InitShortTailRows(matrix,2U);
        Duplicate(stats_,0.0f,statsSize_);VectorDone();
    }

    __aicore__ inline void Process()
    {
        if(!matrixRole_){ProcessGates();return;}
        auto matrix=LocalTensor<float>(TPosition::VECCALC,0U,matrixFloats_);
        const DataCopyExtParams load{static_cast<uint16_t>(h_),h_*4U,0,3U,0};
        const DataCopyExtParams store{static_cast<uint16_t>(h_),h_*4U,3U,0,0};
        const DataCopyPadExtParams<float> pad{
            true,0,static_cast<uint8_t>(24U-h_),0.0f};
        for(uint64_t token=first_;token<end_;token+=2U){
            for(uint32_t t=0;t<2U;++t)
                DataCopyPad(matrix[t*24U],x_[(token+t)*w_+2U*h_],load,pad);
            StaticSync<HardEvent::MTE2_V,0>();
            // Real-prefix DMA and all dense updates exclude the dummy tail.
            // Rounded Sub sees dummy max=0, so its initialized zeros persist.
            RowSoftmax(matrix,2U);
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 2201 && !ASCENDC_CPU_DEBUG && !defined(__MSTX_DFX_REPORT__)
            nm_=(__ubuf__ float*)matrix.GetPhyAddr();
            nb_=(__ubuf__ float*)broadcast_.GetPhyAddr();
            nd_=(__ubuf__ float*)rowDen_.GetPhyAddr();
            ns_=(__ubuf__ float*)stats_.GetPhyAddr();
            nw_=(__ubuf__ float*)work_.GetPhyAddr();
#endif
            Columns(matrix);
            for(uint32_t iter=1U;iter<iters_;++iter){Rows(matrix);Columns(matrix);}
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 2201 && !ASCENDC_CPU_DEBUG && !defined(__MSTX_DFX_REPORT__)
            // C2: final Columns exits Normal, including actualiters=1.
#else
            SetMaskNorm();
#endif
            ResetMask();StaticSync<HardEvent::V_MTE3,1>();
            for(uint32_t t=0;t<2U;++t)
                DataCopyPad(comb_[(token+t)*h_*h_],matrix[t*24U],store);
            // Retain final output safety wait. Also stop next batch DMA from
            // overwriting this same UB while its output transfer is in flight.
            StaticSync<HardEvent::MTE3_V,2>();
            if(token+2U<end_) StaticSync<HardEvent::MTE3_MTE2,3>();
        }
    }

private:
    template <HardEvent Event, int32_t Id>
    __aicore__ inline void StaticSync()
    {
        static_assert(Id>=0 && Id<=5,"Static entry reserves only IDs0..5");
        SetFlag<Event>(Id);WaitFlag<Event>(Id);
    }

    __aicore__ inline void ProcessGates()
    {
        auto gates=LocalTensor<float>(TPosition::VECCALC,gateAddr_,96U);
        for(uint64_t token=gateFirst_;token<gateEnd_;token+=2U){
            const uint32_t valid=static_cast<uint32_t>(
                gateEnd_-token<2U?gateEnd_-token:2U);
            for(uint32_t t=0;t<valid;++t){
                LoadExact(gates[2U*t*24U],x_[(token+t)*w_],h_);
                LoadExact(gates[(2U*t+1U)*24U],x_[(token+t)*w_+h_],h_);
            }
            StaticSync<HardEvent::MTE2_V,0>();
            SigmoidInPlace(gates,work_,work_[96U],2U*valid*24U);
            for(uint32_t t=0;t<valid;++t){
                Adds(gates[2U*t*24U],gates[2U*t*24U],eps_,h_);
                Muls(gates[(2U*t+1U)*24U],gates[(2U*t+1U)*24U],2.0f,h_);
            }
            VectorDone();StaticSync<HardEvent::V_MTE3,1>();
            for(uint32_t t=0;t<valid;++t){
                StoreExact(pre_[(token+t)*h_],gates[2U*t*24U],h_);
                StoreExact(post_[(token+t)*h_],gates[(2U*t+1U)*24U],h_);
            }
            StaticSync<HardEvent::MTE3_V,2>();
            if(token+2U<gateEnd_) StaticSync<HardEvent::MTE3_MTE2,3>();
        }
    }

    __aicore__ inline void InitShortTailRows(const LocalTensor<float>& matrix, uint32_t valid)
    {
        if (shortTailBr_) {
            const uint32_t rows = valid * h_;
            const uint32_t physicalRows = (rows + 7) / 8 * 8;
            if (physicalRows != rows) {
                // Called once in matrix-role Init, before its existing
                // stats-init VectorDone. Max8 may now read these dummy rows.
                // DMA/Exp/Div/eps/columns/stores touch only the real prefix.
                // Rounded Sub subtracts zero dummy maxima, preserving zeros.
                Duplicate(matrix[rows * pitch_], 0.0f, (physicalRows - rows) * pitch_);
            }
        }
    }

    __aicore__ inline uint32_t RowChunk(uint32_t remaining)
    {
        return remaining < 248 ? remaining : 248;
    }

    __aicore__ inline void ReduceRowSums(const LocalTensor<float>& matrix, uint32_t rows)
    {
        // R1: physical rows are contiguous in both existing matrix layouts.
        // If no padded tail rows were allocated, preserve the WHOLE old path
        // for a non-multiple-of-eight batch; never read an invented row.
        if (lowerShortFold8_ && rows >= kBlockFloats
            && (shortTailBr_ || rows % kBlockFloats == 0)) {
            const uint32_t foldedRows = shortTailBr_ ? (rows + 7) / 8 * 8 : rows;
            const uint8_t roots = static_cast<uint8_t>(pitch_ / kBlockFloats);
            const uint8_t repeats = static_cast<uint8_t>(foldedRows / kBlockFloats);
            const uint8_t rowRepStride = static_cast<uint8_t>(pitch_);
            // One vector repeat processes eight rows. Compact row r occupies
            // broadcast_[8*r:8*r+8]; at most 8*statsSize_ floats are needed.
            // The last block's unmasked destination lanes MUST keep the seed.
            uint64_t lastBlockMask[2] = {shortRowLastBlockMask_, uint64_t(0)};
            if (roots == 2 && h_ % kBlockFloats != 0) {
                const UnaryRepeatParams seedFold{1, roots, 8, rowRepStride};
                Adds(broadcast_, matrix, 0.0f, uint64_t(kVectorFloats),
                    repeats, seedFold);
                VectorDone();
                const BinaryRepeatParams addTail{1, 1, roots, 8, 8, rowRepStride};
                Add(broadcast_, broadcast_, matrix[kBlockFloats], lastBlockMask,
                    repeats, addTail);
                VectorDone();
            } else {
                // Blocks zero and one are fully real here, including H=16.
                const BinaryRepeatParams firstFold{
                    1, roots, roots, 8, rowRepStride, rowRepStride};
                Add(broadcast_, matrix, matrix[kBlockFloats],
                    uint64_t(kVectorFloats), repeats, firstFold);
                VectorDone();
                const BinaryRepeatParams nextFold{1, 1, roots, 8, 8, rowRepStride};
                for (uint32_t root = 2; root < roots; ++root) {
                    if (root + 1 == roots) {
                        Add(broadcast_, broadcast_, matrix[root * kBlockFloats],
                            lastBlockMask, repeats, nextFold);
                    } else {
                        Add(broadcast_, broadcast_, matrix[root * kBlockFloats],
                            uint64_t(kVectorFloats), repeats, nextFold);
                    }
                    VectorDone();
                }
            }
            // Every compact lane is initialized. BR consumes contiguous rows
            // and writes eight scalar sums per repeat; caller orders the read.
            BlockReduceSum(stats_, broadcast_, static_cast<int32_t>(repeats),
                static_cast<int32_t>(kVectorFloats), 1, 1, 8);
            return;
        }
    }

    __aicore__ inline bool UseRowDivPanel(uint32_t rows)
    {
        // Per-batch cache; the four-times-Div predicate is prepared before
        // initial softmax and before any strict iteration on this valid batch.
        return batchRowDivPanel_;
    }

    __aicore__ inline void BroadcastRows(uint32_t rows, bool forDivision = false)
    {
        const uint8_t repeats = static_cast<uint8_t>((rows + 7) / 8);
        if (forDivision && UseRowDivPanel(rows)) {
            // Each call fills the next 32-byte column block of every row.
            // Brcb reads eight stats per repeat: allocate statsSize_*pitch_
            // so rounded tail rows, including their last column block, fit.
            const BrcbRepeatParams steps{static_cast<uint16_t>(pitch_ / 8),
                static_cast<uint16_t>(pitch_)};
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 2201 && !ASCENDC_CPU_DEBUG && !defined(__MSTX_DFX_REPORT__)
            if ASCEND_IS_AIV {
                // CANN 9.0 C220 BrcbImpl resets the same full mask before
                // every vbrcb. Keep it across this contiguous, disjoint panel
                // sequence; use that exact uint32 bit-broadcast intrinsic.
                ResetMask();
                auto source = (__ubuf__ uint32_t*)stats_.GetPhyAddr();
                for (uint32_t column = 0; column < pitch_; column += 8) {
                    auto destination = (__ubuf__ uint32_t*)broadcast_[column].GetPhyAddr();
                    vbrcb(destination, source, steps.dstBlkStride, steps.dstRepStride, repeats);
                }
            }
#else
            for (uint32_t column = 0; column < pitch_; column += 8) {
                Brcb(broadcast_[column], stats_, repeats, steps);
            }
#endif
        } else {
            Brcb(broadcast_, stats_, repeats, {1, 8});
        }
        VectorDone();
    }

    template <bool Divide>
    __aicore__ inline void ApplyRows(const LocalTensor<float>& matrix, uint32_t rows)
    {
        if (Divide && UseRowDivPanel(rows)) {
            // Div is still the C220 vdiv operation. Padding may become NaN
            // for eps=0; WR(H), lane-local columns and StoreExact isolate it.
            Div(matrix, matrix, broadcast_, static_cast<int32_t>(rows * pitch_));
            VectorDone();
            return;
        }
        const uint8_t stride = static_cast<uint8_t>(pitch_ / 8);
        const BinaryRepeatParams steps{1, 1, 0, stride, stride, 1};
        const uint64_t count = h_ < 64 ? h_ : 64;
        for (uint32_t row = 0; row < rows; row += 248) {
            const uint8_t repeats = static_cast<uint8_t>(RowChunk(rows - row));
            auto dst = matrix[row * pitch_];
            auto denominator = broadcast_[row * 8];
            if (Divide) {
                Div(dst, dst, denominator, count, repeats, steps);
                if (h_ > 64) {
                    Div(dst[64], dst[64], denominator, uint64_t(h_ - 64), repeats, steps);
                }
            } else {
                Sub(dst, dst, denominator, count, repeats, steps);
                if (h_ > 64) {
                    Sub(dst[64], dst[64], denominator, uint64_t(h_ - 64), repeats, steps);
                }
            }
        }
        VectorDone();
    }

    template <bool Exponentiate>
    __aicore__ inline void ElementwiseRows(const LocalTensor<float>& matrix, uint32_t rows)
    {
        if (h_ < kVectorFloats
            && (rows * pitch_ + kVectorFloats - 1) / kVectorFloats < rows) {
            // DataCopyPad initializes all active rows, including their padding.
            // Both row-major layouts occupy this contiguous active prefix.
            // WR(H) and H-wide stores exclude padding; column recurrences keep
            // it lane-local even when Exp/Div/Adds makes it non-finite.
            const int32_t elements = static_cast<int32_t>(rows * pitch_);
            if (Exponentiate) {
                Exp(matrix, matrix, elements);
            } else {
                Adds(matrix, matrix, eps_, elements);
            }
            VectorDone();
            return;
        }
        const uint8_t stride = static_cast<uint8_t>(pitch_ / 8);
        const UnaryRepeatParams steps{1, 1, stride, stride};
        const uint64_t count = h_ < 64 ? h_ : 64;
        for (uint32_t row = 0; row < rows; row += 248) {
            const uint8_t repeats = static_cast<uint8_t>(RowChunk(rows - row));
            auto dst = matrix[row * pitch_];
            if (Exponentiate) {
                Exp(dst, dst, count, repeats, steps);
                if (h_ > 64) {
                    Exp(dst[64], dst[64], uint64_t(h_ - 64), repeats, steps);
                }
            } else {
                Adds(dst, dst, eps_, count, repeats, steps);
                if (h_ > 64) {
                    Adds(dst[64], dst[64], eps_, uint64_t(h_ - 64), repeats, steps);
                }
            }
        }
        VectorDone();
    }

    // C1: only the separated fixed-P24 entry selects this Sub schedule.
    // Eight physical rows per repeat, compact eight-lane max per row.
    // Rounded dummy rows have initialized +0 data and +0 max statistics.
    __aicore__ inline void ApplySoftmaxSubP24(const LocalTensor<float>& matrix,
        uint32_t rows)
    {
        const uint8_t repeats = static_cast<uint8_t>((rows + 7U) / 8U);
        const BinaryRepeatParams steps{3, 3, 1, 24, 24, 8};
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 2201 && !ASCENDC_CPU_DEBUG && !defined(__MSTX_DFX_REPORT__)
        // C2: Brcb established full FP32 mask; vsub preserves it.
        Sub<float,false>(matrix, matrix, broadcast_, uint64_t(64), repeats, steps);
        Sub<float,false>(matrix[8U], matrix[8U], broadcast_, uint64_t(64), repeats, steps);
#else
        Sub(matrix, matrix, broadcast_, uint64_t(64), repeats, steps);
        Sub(matrix[8U], matrix[8U], broadcast_, uint64_t(64), repeats, steps);
#endif
        uint64_t lastBlockMask[2] = {shortRowLastBlockMask_, uint64_t(0)};
        Sub(matrix[16U], matrix[16U], broadcast_, lastBlockMask, repeats, steps);
        VectorDone();
    }

    __aicore__ inline void RowSoftmax(const LocalTensor<float>& matrix, uint32_t valid)
    {
        const uint32_t rows = valid * h_;
        if (upperShortMath_) {
            // Gate work is dead in every matrix owner, including split owners.
            // Initialize per batch, after gates; the first max barrier orders it.
            Duplicate(work_[3 * q_ * pitch_], 1.0f, q_ * pitch_);
        }
        if (shortTailBr_ || rows % kBlockFloats == 0U) {
            // Eight physical rows per repeat. Fold only real column lanes;
            // zero-padded columns must never enter an all-negative row max.
            const uint8_t repeats=static_cast<uint8_t>((rows+7U)/8U);
            const BinaryRepeatParams firstFold{1,3,3,8,24,24};
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 2201 && !ASCENDC_CPU_DEBUG && !defined(__MSTX_DFX_REPORT__)
            // C2: Init or previous Process ResetMask supplies full FP32 lanes.
            Max<float,false>(broadcast_,matrix,matrix[8U],uint64_t(64),repeats,firstFold);
#else
            Max(broadcast_,matrix,matrix[8U],uint64_t(64),repeats,firstFold);
#endif
            VectorDone();
            uint64_t tailMask[2]={shortRowLastBlockMask_,uint64_t(0)};
            const BinaryRepeatParams tailFold{1,1,3,8,8,24};
            Max(broadcast_,broadcast_,matrix[16U],tailMask,repeats,tailFold);
            VectorDone();
            BlockReduceMax(stats_,broadcast_,static_cast<int32_t>(repeats),
                static_cast<int32_t>(64),1,1,8);
            VectorDone();
        } else {
            // No rounded allocation: preserve real-row WholeReduceMax.
            const int32_t count = static_cast<int32_t>(h_ < 64 ? h_ : 64);
            for (uint32_t row = 0; row < rows; row += 248) {
                const int32_t repeats = static_cast<int32_t>(RowChunk(rows - row));
                WholeReduceMax(stats_[row], matrix[row * pitch_], count,
                    repeats, 1, 1, static_cast<int32_t>(pitch_ / 8), ReduceOrder::ORDER_ONLY_VALUE);
                if (h_ > 64) {
                    WholeReduceMax(work_[row], matrix[row * pitch_ + 64],
                        static_cast<int32_t>(h_ - 64), repeats, 1, 1,
                        static_cast<int32_t>(pitch_ / 8), ReduceOrder::ORDER_ONLY_VALUE);
                }
            }
            VectorDone();
            if (h_ > 64) {
                Max(stats_, stats_, work_, rows);
                VectorDone();
            }
        }
        BroadcastRows(rows);
        ApplySoftmaxSubP24(matrix, rows);
        ElementwiseRows<true>(matrix, rows);
        ReduceRowSums(matrix, rows);
        VectorDone();
        BroadcastRows(rows, true);
        ApplyRows<true>(matrix, rows);
        ElementwiseRows<false>(matrix, rows);
    }

    __aicore__ inline void NormalizeRows(const LocalTensor<float>& matrix, uint32_t valid)
    {
        const uint32_t rows = valid * h_;
        ReduceRowSums(matrix, rows);
        VectorDone();
        Adds(stats_, stats_, eps_, rows);
        VectorDone();
        // Same three Brcb operations, repeat/stride and two fences as M1.
        // Fold/BR has finished reading nb before rowDen may overlap it.
        const uint8_t repeats=static_cast<uint8_t>((rows+7U)/8U);
        const BrcbRepeatParams steps{3,24};
        for(uint32_t column=0;column<24U;column+=8U)
            Brcb(rowDen_[column],stats_,repeats,steps);
        VectorDone();
        Div(matrix,matrix,rowDen_,static_cast<int32_t>(rows*24U));
        VectorDone();
    }

    // A1: independent eps seed and adjacent pairs share the first fence.
    // FP32 eps association is authorized in this positive-eps P24 branch.
    __aicore__ inline void NormalizeColumns(const LocalTensor<float>& matrix, uint32_t valid)
    {
        constexpr uint32_t pairs=Height/2U;
        const BinaryRepeatParams pairRows{1,1,1,6,12,12};
        const BinaryRepeatParams accumulate{1,1,1,0,6,0};
        const BinaryRepeatParams divide{1,1,1,6,6,0};
        SetMaskNorm();
        SetVectorMask<float,MaskMode::NORMAL>(uint64_t(0),columnMask_);
        // Do not use count Duplicate: it resets the external Normal48 mask.
        Duplicate<float,false>(work_,eps_,MASK_PLACEHOLDER,
            uint8_t(1),uint16_t(1),uint8_t(8));
        Add<float,false>(broadcast_,matrix,matrix[48U],MASK_PLACEHOLDER,
            static_cast<uint8_t>(pairs),pairRows);
        VectorDone();
        // Exact dst=src1 overlap; both repeat strides are zero.
        Add<float,false>(work_,broadcast_,work_,MASK_PLACEHOLDER,
            static_cast<uint8_t>(pairs),accumulate);
        VectorDone();
        Div<float,false>(matrix,matrix,work_,MASK_PLACEHOLDER,
            static_cast<uint8_t>(h_),divide);
        VectorDone();
    }

    __aicore__ inline void Rows(const LocalTensor<float>& matrix)
    {
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 2201 && !ASCENDC_CPU_DEBUG && !defined(__MSTX_DFX_REPORT__)
        if ASCEND_IS_AIV {
            const uint32_t pitch = FixedPitch != 0U ? FixedPitch : pitch_;
            const uint32_t roots = FixedPitch != 0U ? FixedPitch/8U : roots_;
            const uint32_t matrixElements = FixedPitch != 0U
                ? 2U*h_*FixedPitch : matrixElements_;
            ResetMask();
            if(roots==2U && h_%8U!=0){
                vadds(nb_,nm_,0.0f,foldRepeats_,1,roots,8,pitch);VectorDone();
                SetVectorMask<float>(uint64_t(0),shortRowLastBlockMask_);
                vadd(nb_,nb_,nm_+8U,foldRepeats_,1,1,roots,8,8,pitch);
                VectorDone();
            }else{
                vadd(nb_,nm_,nm_+8U,foldRepeats_,1,roots,roots,8,pitch,pitch);
                VectorDone();
                for(uint32_t root=2U;root<roots;++root){
                    if(root+1U==roots)
                        SetVectorMask<float>(uint64_t(0),shortRowLastBlockMask_);
                    else ResetMask();
                    vadd(nb_,nb_,nm_+root*8U,foldRepeats_,1,1,roots,8,8,pitch);
                    VectorDone();
                }
            }
            ResetMask();vcgadd(ns_,nb_,foldRepeats_,1,1,8);VectorDone();
            SetVectorMask<float>(uint64_t(0),rowMask_);
            vadds(ns_,ns_,eps_,1,1,1,8,8);VectorDone();ResetMask();
            for(uint32_t column=0;column<pitch;column+=8U)
                vbrcb((__ubuf__ uint32_t*)(nd_+column),
                    (__ubuf__ uint32_t*)ns_,roots,pitch,foldRepeats_);
            VectorDone();SetMaskCount();
            SetVectorMask<float,MaskMode::COUNTER>(uint64_t(0),uint64_t(matrixElements));
            vdiv(nm_,nm_,nd_,1,1,1,1,8,8,8);VectorDone();
            SetMaskNorm();
        }
#else
        NormalizeRows(matrix,2U);
#endif
    }

    __aicore__ inline void Columns(const LocalTensor<float>& matrix)
    {
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 2201 && !ASCENDC_CPU_DEBUG && !defined(__MSTX_DFX_REPORT__)
        if ASCEND_IS_AIV {
            constexpr uint32_t pairs=Height/2U;
            SetVectorMask<float,MaskMode::NORMAL>(uint64_t(0),columnMask_);
            // Same mask-preserving intrinsic as CANN9 Duplicate<float,false>.
            // Seed/work and pair/broadcast are disjoint; matrix is read-only.
            vector_dup(nw_,eps_,1,1,1,8,0);
            vadd(nb_,nm_,nm_+48U,pairs,1,1,1,6,12,12);
            VectorDone();
            // Supported float Add dst=src1, dstRep0/src1Rep0 recurrence.
            vadd(nw_,nb_,nw_,pairs,1,1,1,0,6,0);
            VectorDone();
            vdiv(nm_,nm_,nw_,h_,1,1,1,columnStride_,columnStride_,0);
            VectorDone();
        }
#else
        NormalizeColumns(matrix,2U);
#endif
    }

    static constexpr uint32_t FixedPitch=24U,pitch_=24U,q_=2U,gateSize_=96U;
    static constexpr uint32_t roots_=3U,columnElements_=48U,columnStride_=6U;
    static constexpr uint64_t columnMask_=0x0000FFFFFFFFFFFFULL;
    static constexpr bool upperShortMath_=false,lowerShortFold8_=true;
    GlobalTensor<float> x_,pre_,post_,comb_;
    LocalTensor<float> work_,stats_,broadcast_,rowDen_;
    uint64_t first_,end_,gateFirst_,gateEnd_;
    uint64_t shortRowLastBlockMask_,rowMask_;
    static constexpr uint32_t h_=Height,w_=Height*Height+2U*Height;
    uint32_t iters_,statsSize_,matrixSize_,foldRepeats_,rows_,matrixElements_;
    uint32_t matrixFloats_,gateAddr_,workAddr_;
    bool shortTailBr_,batchRowDivPanel_,matrixRole_;
    float eps_;
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 2201 && !ASCENDC_CPU_DEBUG && !defined(__MSTX_DFX_REPORT__)
    __ubuf__ float *nm_,*nb_,*nd_,*ns_,*nw_;
#endif
};

// A1: one independent q8/P40 resource family. Host proves whole owner batches;
// all other ownership, metadata and resource cases retain the original entry.
class SlimCompact40Kernel {
public:
    __aicore__ inline void Init(GM_ADDR mixes, GM_ADDR pre, GM_ADDR post,
        GM_ADDR comb, uint64_t n, uint32_t h, uint32_t iters, float eps,
        uint32_t tokenGroup, TPipe* pipe)
    {
        pipe_=pipe; h_=h; iters_=iters; eps_=eps;
        matrixSize_=h*40U; statsSize_=8U*h; w_=h*h+2*h;
        const uint32_t tail=h%8U;
        shortRowBlockMask_=tail==0 ? ~uint64_t(0) :
            ((uint64_t(1)<<tail)-1)*uint64_t(0x0101010101010101ULL);
        TokenRange(n,tokenGroup,first_,end_);
        x_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(mixes));
        pre_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(pre));
        post_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(post));
        comb_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(comb));
        // Exact SA1v2 buffer order and byte counts for bulkInputGather/P40/q8.
        pipe_->InitBuffer(matrixQueue_,1,8U*matrixSize_*sizeof(float));
        pipe_->InitBuffer(gatesQueue_,1,gateSize_*sizeof(float));
        pipe_->InitBuffer(ubBankPadBeforeWork_,uint32_t(256));
        pipe_->InitBuffer(workBuf_,2U*gateSize_*sizeof(float));
        pipe_->InitBuffer(statsBuf_,statsSize_*sizeof(float));
        const uint32_t panel=40U*statsSize_;
        const uint32_t raw=8U*w_;
        pipe_->InitBuffer(broadcastBuf_,(raw>panel?raw:panel)*sizeof(float));
        pipe_->InitBuffer(inputIndexBuf_,(8U*matrixSize_+gateSize_)*sizeof(int32_t));
        work_=workBuf_.Get<float>(); stats_=statsBuf_.Get<float>();
        broadcast_=broadcastBuf_.Get<float>();
        InitGatherMaskPattern(); bulkIndex_=inputIndexBuf_.Get<int32_t>();
        BuildBulkInputIndices();
        ones_=work_[960U];
        w0_=work_;w1_=work_[64];w2_=work_[128];w3_=work_[192];w4_=work_[256];
        p0_=broadcast_;p1_=broadcast_[64];p2_=broadcast_[128];
        p3_=broadcast_[192];p4_=broadcast_[256];
        src16_=broadcast_[5120];src32_=broadcast_[10240];
        Duplicate(stats_,0.0f,statsSize_);VectorDone();
    }
    __aicore__ inline void Process()
    {
        for(uint64_t token=first_;token<end_;token+=8U){
            auto gates=gatesQueue_.AllocTensor<float>();
            auto matrix=matrixQueue_.AllocTensor<float>();
            LoadBulkInput(token,gates,matrix);
            gatesQueue_.template EnQue<TPosition::VECCALC,TPosition::VECCALC>(gates);
            gates=gatesQueue_.template DeQue<TPosition::VECCALC,TPosition::VECCALC,float>();
            matrixQueue_.template EnQue<TPosition::VECCALC,TPosition::VECCALC>(matrix);
            matrix=matrixQueue_.template DeQue<TPosition::VECCALC,TPosition::VECCALC,float>();
            SigmoidInPlace(gates,work_,work_[gateSize_],gateSize_);
            for(uint32_t t=0;t<8U;++t){
                Adds(gates[80U*t],gates[80U*t],eps_,h_);
                Muls(gates[80U*t+40U],gates[80U*t+40U],2.0f,h_);
            }
            VectorDone();
            Softmax(matrix);
            PackRowInnerMatrixFixed(broadcast_,matrix);
            const uint32_t phase=static_cast<uint32_t>(
                ((stats_.GetPhyAddr()-matrix.GetPhyAddr())&uint64_t(511))/sizeof(float));
            const CompactRootViews<5U> roots(matrix,phase);
            const uint32_t offset=static_cast<uint32_t>(
                (broadcast_.GetPhyAddr()+256U-matrix.GetPhyAddr())&511U)/sizeof(float);
            da_=matrix[offset];db_=matrix[offset+64U];
            c8_=matrix[2880];c4_=matrix[1440];c2_=matrix[720];c1_=matrix[360];
            m0_=matrix;m1_=matrix[8];m2_=matrix[16];m3_=matrix[24];m4_=matrix[32];

            // Cache physical pointers once per resident batch, outside all Sinkhorn iterations.
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 2201 && !ASCENDC_CPU_DEBUG && !defined(__MSTX_DFX_REPORT__)
            np_=(__ubuf__ float*)broadcast_.GetPhyAddr();
            nm_=(__ubuf__ float*)matrix.GetPhyAddr();
            ns_=(__ubuf__ float*)stats_.GetPhyAddr();
            nw_=(__ubuf__ float*)work_.GetPhyAddr();no_=(__ubuf__ float*)ones_.GetPhyAddr();
            nr0_=(__ubuf__ float*)roots.root0.GetPhyAddr();
            nr1_=(__ubuf__ float*)roots.root1.GetPhyAddr();
            nr2_=(__ubuf__ float*)roots.root2.GetPhyAddr();
            nr3_=(__ubuf__ float*)roots.root3.GetPhyAddr();
            nr4_=(__ubuf__ float*)roots.root4.GetPhyAddr();
            nda_=(__ubuf__ float*)da_.GetPhyAddr();ndb_=(__ubuf__ float*)db_.GetPhyAddr();
#endif
            Columns(matrix,false);
            for(uint32_t iter=1;iter+1U<iters_;++iter){Rows(roots);Columns(matrix,false);}
            Rows(roots);Columns(matrix,true);
            const GatherMaskParams gp{1,static_cast<uint16_t>(h_),40,0};
            uint64_t count=0;
            GatherMask<float,uint32_t,GatherMaskMode::VERSION_V2>(
                broadcast_,matrix,gatherPattern_,true,uint32_t(320),gp,count);
            VectorDone();
            SyncPipelines<HardEvent::V_MTE3>(*pipe_);
            const DataCopyExtParams gateOut{8,static_cast<uint32_t>(h_*sizeof(float)),5,0,0};
            const DataCopyExtParams matrixOut{1,static_cast<uint32_t>(8U*h_*h_*sizeof(float)),0,0,0};
            DataCopyPad(pre_[token*h_],gates,gateOut);
            DataCopyPad(post_[token*h_],gates[40],gateOut);
            DataCopyPad(comb_[token*h_*h_],broadcast_,matrixOut);
            SyncPipelines<HardEvent::MTE3_V>(*pipe_);
            gatesQueue_.FreeTensor(gates);matrixQueue_.FreeTensor(matrix);
        }
    }
private:
    __aicore__ inline void Softmax(const LocalTensor<float>& matrix)
    {
        const uint32_t rows=8U*h_;
        Duplicate(ones_,1.0f,320U);
        for(uint32_t row=0;row<rows;row+=248U){
            const uint32_t nr=rows-row<248U?rows-row:248U;
            WholeReduceMax(stats_[row],matrix[row*40U],static_cast<int32_t>(h_),
                static_cast<int32_t>(nr),1,1,5,ReduceOrder::ORDER_ONLY_VALUE);
        }
        VectorDone();
        Brcb(broadcast_,stats_,static_cast<uint8_t>(h_),{1,8});VectorDone();
        const BinaryRepeatParams subSteps{1,1,0,5,5,1};
        for(uint32_t row=0;row<rows;row+=248U){
            const uint8_t nr=static_cast<uint8_t>(rows-row<248U?rows-row:248U);
            Sub(matrix[row*40U],matrix[row*40U],broadcast_[row*8U],uint64_t(h_),nr,subSteps);
        }
        VectorDone();Exp(matrix,matrix,static_cast<int32_t>(rows*40U));VectorDone();
        ReduceShortRowsStridedBlockTree(matrix,stats_,broadcast_,h_,40U,rows,statsSize_,shortRowBlockMask_,true);
        VectorDone();
        const BrcbRepeatParams br{5,40};
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 2201 && !ASCENDC_CPU_DEBUG && !defined(__MSTX_DFX_REPORT__)
        if ASCEND_IS_AIV {
            ResetMask();auto src=(__ubuf__ uint32_t*)stats_.GetPhyAddr();
            for(uint32_t col=0;col<40U;col+=8U){
                auto dst=(__ubuf__ uint32_t*)broadcast_[col].GetPhyAddr();
                vbrcb(dst,src,br.dstBlkStride,br.dstRepStride,static_cast<uint8_t>(h_));
            }
        }
#else
        for(uint32_t col=0;col<40U;col+=8U)Brcb(broadcast_[col],stats_,static_cast<uint8_t>(h_),br);
#endif
        VectorDone();Div(matrix,matrix,broadcast_,static_cast<int32_t>(rows*40U));VectorDone();
        Adds(matrix,matrix,eps_,static_cast<int32_t>(rows*40U));VectorDone();
    }
    __aicore__ inline void Rows(const CompactRootViews<5U>& roots)
    {
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 2201 && !ASCENDC_CPU_DEBUG && !defined(__MSTX_DFX_REPORT__)
        if ASCEND_IS_AIV {

        // Same BR8 roots, masks, summation operands, eps and native reciprocal Div.
        SetMaskNorm(); ResetMask();
        vcgadd(nr0_,np_,h_,1,1,40);
        vcgadd(nr1_,np_+64,h_,1,1,40);
        vcgadd(nr2_,np_+128,h_,1,1,40);
        vcgadd(nr3_,np_+192,h_,1,1,40);
        if(h_<40U) SetVectorMask<float>(uint64_t(0),shortRowBlockMask_);
        vcgadd(nr4_,np_+256,h_,1,1,40);VectorDone();
        SetMaskCount();
        SetVectorMask<float,MaskMode::COUNTER>(uint64_t(0),uint64_t(8U*h_));
        vadd(nr0_,nr0_,nr1_,1,1,1,1,8,8,8);
        vadd(nr3_,nr2_,nr3_,1,1,1,1,8,8,8);VectorDone();
        vadd(nr0_,nr0_,nr3_,1,1,1,1,8,8,8);VectorDone();
        vadd(ns_,nr0_,nr4_,1,1,1,1,8,8,8);VectorDone();
        vadds(ns_,ns_,eps_,1,1,1,8,8);VectorDone();
        vdiv(ns_,no_,ns_,1,1,1,1,8,8,8);VectorDone();
        SetMaskNorm();ResetMask();
        vbrcb((__ubuf__ uint32_t*)nda_,(__ubuf__ uint32_t*)ns_,1,24,h_);
        vbrcb((__ubuf__ uint32_t*)ndb_,(__ubuf__ uint32_t*)ns_,1,24,h_);VectorDone();
        vmul(np_,np_,nda_,h_,1,1,1,40,40,24);
        vmul(np_+64,np_+64,ndb_,h_,1,1,1,40,40,24);
        vmul(np_+128,np_+128,nda_,h_,1,1,1,40,40,24);
        vmul(np_+192,np_+192,ndb_,h_,1,1,1,40,40,24);
        vmul(np_+256,np_+256,nda_,h_,1,1,1,40,40,24);VectorDone();
        }
#else

        ReduceRowInnerSumsColoredFixed(broadcast_,roots);VectorDone();
        const UnaryRepeatParams un{1,1,8,8};const BinaryRepeatParams bin{1,1,1,8,8,8};
        Adds<float,false>(stats_,stats_,eps_,MASK_PLACEHOLDER,1,un);VectorDone();
        Div<float,false>(stats_,ones_,stats_,MASK_PLACEHOLDER,1,bin);VectorDone();
        SetMaskNorm();ResetMask();const BrcbRepeatParams br{1,24};
        Brcb(da_,stats_,static_cast<uint8_t>(h_),br);
        Brcb(db_,stats_,static_cast<uint8_t>(h_),br);VectorDone();
        const BinaryRepeatParams mul{1,1,1,40,40,24};
        Mul(p0_,p0_,da_,uint64_t(64),static_cast<uint8_t>(h_),mul);
        Mul(p1_,p1_,db_,uint64_t(64),static_cast<uint8_t>(h_),mul);
        Mul(p2_,p2_,da_,uint64_t(64),static_cast<uint8_t>(h_),mul);
        Mul(p3_,p3_,db_,uint64_t(64),static_cast<uint8_t>(h_),mul);
        Mul(p4_,p4_,da_,uint64_t(64),static_cast<uint8_t>(h_),mul);VectorDone();
    #endif
    }
    __aicore__ inline void Columns(const LocalTensor<float>& scratch,bool final)
    {
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 2201 && !ASCENDC_CPU_DEBUG && !defined(__MSTX_DFX_REPORT__)
        if ASCEND_IS_AIV {

        SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(uint64_t(0),uint64_t(5120));
        vadd(nm_,np_,np_+5120,1,1,1,1,9,8,8);VectorDone();
        SetVectorMask<float,MaskMode::COUNTER>(uint64_t(0),uint64_t(h_-32U)*320U);
        vadd(nm_,nm_,np_+10240,1,1,1,1,9,9,8);VectorDone();
        SetVectorMask<float,MaskMode::COUNTER>(uint64_t(0),uint64_t(2560));
        vadd(nm_,nm_,nm_+2880,1,1,1,1,9,9,9);VectorDone();
        SetVectorMask<float,MaskMode::COUNTER>(uint64_t(0),uint64_t(1280));
        vadd(nm_,nm_,nm_+1440,1,1,1,1,9,9,9);VectorDone();
        SetVectorMask<float,MaskMode::COUNTER>(uint64_t(0),uint64_t(640));
        vadd(nm_,nm_,nm_+720,1,1,1,1,9,9,9);VectorDone();
        SetVectorMask<float,MaskMode::COUNTER>(uint64_t(0),uint64_t(320));
        vadd(nw_,nm_,nm_+360,1,1,1,1,8,9,9);VectorDone();
        vadds(nw_,nw_,eps_,1,1,1,8,8);VectorDone();
        vdiv(nw_,no_,nw_,1,1,1,1,8,8,8);VectorDone();
        SetMaskNorm();ResetMask();
        if(final){
            const uint8_t dstStride=static_cast<uint8_t>(h_*5U);
            vmul(nm_,np_,nw_,h_,dstStride,1,1,5,40,0);
            vmul(nm_+8,np_+64,nw_+64,h_,dstStride,1,1,5,40,0);
            vmul(nm_+16,np_+128,nw_+128,h_,dstStride,1,1,5,40,0);
            vmul(nm_+24,np_+192,nw_+192,h_,dstStride,1,1,5,40,0);
            vmul(nm_+32,np_+256,nw_+256,h_,dstStride,1,1,5,40,0);
        }else{
            vmul(np_,np_,nw_,h_,1,1,1,40,40,0);
            vmul(np_+64,np_+64,nw_+64,h_,1,1,1,40,40,0);
            vmul(np_+128,np_+128,nw_+128,h_,1,1,1,40,40,0);
            vmul(np_+192,np_+192,nw_+192,h_,1,1,1,40,40,0);
            vmul(np_+256,np_+256,nw_+256,h_,1,1,1,40,40,0);
        }VectorDone();
        }
#else

        const BinaryRepeatParams toScratch{1,1,1,9,8,8},tail{1,1,1,9,9,8};
        const BinaryRepeatParams fold{1,1,1,9,9,9},toWork{1,1,1,8,9,9};
        SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(uint64_t(0),uint64_t(5120));
        Add<float,false>(scratch,broadcast_,src16_,MASK_PLACEHOLDER,1,toScratch);VectorDone();
        SetVectorMask<float,MaskMode::COUNTER>(uint64_t(0),uint64_t(h_-32U)*320U);
        Add<float,false>(scratch,scratch,src32_,MASK_PLACEHOLDER,1,tail);VectorDone();
        SetVectorMask<float,MaskMode::COUNTER>(uint64_t(0),uint64_t(2560));
        Add<float,false>(scratch,scratch,c8_,MASK_PLACEHOLDER,1,fold);VectorDone();
        SetVectorMask<float,MaskMode::COUNTER>(uint64_t(0),uint64_t(1280));
        Add<float,false>(scratch,scratch,c4_,MASK_PLACEHOLDER,1,fold);VectorDone();
        SetVectorMask<float,MaskMode::COUNTER>(uint64_t(0),uint64_t(640));
        Add<float,false>(scratch,scratch,c2_,MASK_PLACEHOLDER,1,fold);VectorDone();
        SetVectorMask<float,MaskMode::COUNTER>(uint64_t(0),uint64_t(320));
        Add<float,false>(work_,scratch,c1_,MASK_PLACEHOLDER,1,toWork);VectorDone();
        const UnaryRepeatParams un{1,1,8,8};const BinaryRepeatParams bin{1,1,1,8,8,8};
        Adds<float,false>(work_,work_,eps_,MASK_PLACEHOLDER,1,un);VectorDone();
        Div<float,false>(work_,ones_,work_,MASK_PLACEHOLDER,1,bin);VectorDone();
        SetMaskNorm();ResetMask();
        if(final){
            const BinaryRepeatParams out{static_cast<uint8_t>(h_*5U),1,1,5,40,0};
            Mul(m0_,p0_,w0_,uint64_t(64),static_cast<uint8_t>(h_),out);
            Mul(m1_,p1_,w1_,uint64_t(64),static_cast<uint8_t>(h_),out);
            Mul(m2_,p2_,w2_,uint64_t(64),static_cast<uint8_t>(h_),out);
            Mul(m3_,p3_,w3_,uint64_t(64),static_cast<uint8_t>(h_),out);
            Mul(m4_,p4_,w4_,uint64_t(64),static_cast<uint8_t>(h_),out);
        }else{
            const BinaryRepeatParams mul{1,1,1,40,40,0};
            Mul(p0_,p0_,w0_,uint64_t(64),static_cast<uint8_t>(h_),mul);
            Mul(p1_,p1_,w1_,uint64_t(64),static_cast<uint8_t>(h_),mul);
            Mul(p2_,p2_,w2_,uint64_t(64),static_cast<uint8_t>(h_),mul);
            Mul(p3_,p3_,w3_,uint64_t(64),static_cast<uint8_t>(h_),mul);
            Mul(p4_,p4_,w4_,uint64_t(64),static_cast<uint8_t>(h_),mul);
        }VectorDone();
    #endif
    }
__aicore__ inline void InitGatherMaskPattern()
    {
        gatherPattern_ = ubBankPadBeforeWork_.Get<uint32_t>();
        const uint32_t bits = q_ * pitch_;
        const uint32_t words = (bits + 31U) / 32U;
        const uint64_t rowMask = (uint64_t(1) << h_) - 1U;
        for (uint32_t word = 0; word < words; ++word) {
            const uint32_t offset = word * 32U % pitch_;
            uint64_t pattern = rowMask >> offset;
            if (offset + 32U > pitch_) {
                // P is at least 40 and H is at most 42 here, so this is the
                // only possible row crossing inside one 32-bit pattern word.
                // The second shift is at most 16 and the final set bit is < 64.
                pattern |= rowMask << (pitch_ - offset);
            }
            gatherPattern_.SetValue(word, static_cast<uint32_t>(pattern));
        }
        SyncPipelines<HardEvent::S_V>(*pipe_);
    }
__aicore__ inline void BuildBulkInputIndices()
    {
        const uint32_t matrixPanel = q_ * matrixSize_;
        auto gateIndex = bulkIndex_[matrixPanel];
        for (uint32_t column = 0; column < pitch_; ++column) {
            const uint32_t sourceColumn = column < h_ ? column : h_ - 1;
            gateIndex.SetValue(column,
                static_cast<int32_t>(sourceColumn * sizeof(float)));
        }
        SyncPipelines<HardEvent::S_V>(*pipe_);
        // H<=128 keeps every byte offset below 2^31.
        Adds(gateIndex[pitch_], gateIndex,
            static_cast<int32_t>(h_ * sizeof(float)), pitch_);
        VectorDone();
        uint32_t tokenPrefix = 1;
        while (tokenPrefix < q_) {
            const uint32_t tokens = q_ - tokenPrefix < tokenPrefix
                ? q_ - tokenPrefix : tokenPrefix;
            Adds(gateIndex[2 * tokenPrefix * pitch_], gateIndex,
                static_cast<int32_t>(tokenPrefix * w_ * sizeof(float)),
                2 * tokens * pitch_);
            VectorDone();
            tokenPrefix += tokens;
        }
        // Matrix layout for the compact path is [row, token, padded column].
        // Skip the post row in each gate pair while writing the first matrix row.
        const UnaryRepeatParams preToMatrix{1, 1,
            static_cast<uint8_t>(pitch_ / kBlockFloats),
            static_cast<uint8_t>(2 * pitch_ / kBlockFloats)};
        Adds(bulkIndex_, gateIndex,
            static_cast<int32_t>(2 * h_ * sizeof(float)),
            uint64_t(pitch_), static_cast<uint8_t>(q_), preToMatrix);
        VectorDone();
        const uint32_t firstRow = q_ * pitch_;
        uint32_t rowPrefix = 1;
        while (rowPrefix < h_) {
            const uint32_t rows = h_ - rowPrefix < rowPrefix
                ? h_ - rowPrefix : rowPrefix;
            Adds(bulkIndex_[rowPrefix * firstRow], bulkIndex_[0],
                static_cast<int32_t>(rowPrefix * h_ * sizeof(float)),
                rows * firstRow);
            VectorDone();
            rowPrefix += rows;
        }
    }
__aicore__ inline void LoadBulkInput(uint64_t token,
        const LocalTensor<float>& gates, const LocalTensor<float>& matrix)
    {
        // One contiguous GM transfer replaces 8 strided matrix copies and 16
        // short gate copies. Broadcast is dead before softmax and becomes live
        // again only after both Gathers have completed their raw reads.
        LoadExact(broadcast_, x_[token * w_], q_ * w_);
        SyncPipelines<HardEvent::MTE2_V>(*pipe_);
        const uint32_t matrixPanel = q_ * matrixSize_;
        auto matrixIndex = bulkIndex_.ReinterpretCast<uint32_t>();
        auto gateIndex =
            bulkIndex_[matrixPanel].ReinterpretCast<uint32_t>();
        // Level-2 Gather encodes a uint8 repeat count; keep each call within
        // 255 vector repeats even though admitted A2 compact panels need one.
        constexpr uint32_t gatherChunk = 255U * kVectorFloats;
        for (uint32_t offset = 0; offset < matrixPanel; offset += gatherChunk) {
            const uint32_t remaining = matrixPanel - offset;
            const uint32_t count = remaining < gatherChunk ? remaining : gatherChunk;
            Gather(matrix[offset], broadcast_, matrixIndex[offset],
                uint32_t(0), count);
        }
        Gather(gates, broadcast_, gateIndex, uint32_t(0), gateSize_);
        // Completing every Gather read is required before the same output
        // tensors are overwritten by the padding Duplicate.
        VectorDone();
        // Padding indices always point at column H-1, so no Gather lane can
        // escape the real input panel. Restore the original LoadPad values.
        const uint64_t paddingMask =
            ((uint64_t(1) << pitch_) - 1) & ~((uint64_t(1) << h_) - 1);
        Duplicate(gates, 0.0f, paddingMask, static_cast<uint8_t>(2 * q_),
            uint16_t(1), static_cast<uint8_t>(pitch_ / kBlockFloats));
        const uint32_t matrixRows = q_ * h_;
        for (uint32_t row = 0; row < matrixRows; row += 248) {
            const uint32_t remaining = matrixRows - row;
            const uint8_t repeats = static_cast<uint8_t>(
                remaining < 248 ? remaining : 248);
            Duplicate(matrix[row * pitch_], 0.0f, paddingMask, repeats,
                uint16_t(1), static_cast<uint8_t>(pitch_ / kBlockFloats));
        }
        SetMaskNorm();
        VectorDone();
    }
__aicore__ inline void PackRowInnerMatrixFixed(
        const LocalTensor<float>& packed,
        const LocalTensor<float>& matrix)
    {
        constexpr uint16_t blocks = 5U;
        constexpr uint16_t rowStride = 5U * kBlockFloats;
        const CopyRepeatParams steps{1, blocks, rowStride, rowStride};
        SetMaskNorm();
        for (uint32_t block = 0; block < 5U; ++block) {
            Copy<float>(packed[block * kVectorFloats],
                matrix[block * kBlockFloats], uint64_t(kVectorFloats),
                static_cast<uint8_t>(h_), steps);
        }
        VectorDone();
    }
__aicore__ inline void ReduceRowInnerSumsColoredFixed(
        const LocalTensor<float>& packed,
        const CompactRootViews<5U>& rootViews)
    {
        constexpr uint32_t pitch = 5U * kBlockFloats;
        const uint32_t rows = kBlockFloats * h_;
        const uint64_t mask[2] = {shortRowBlockMask_, uint64_t(0)};
        BlockReduceSum(rootViews.root0, packed, static_cast<int32_t>(h_),
            static_cast<int32_t>(kVectorFloats), 1, 1,
            static_cast<int32_t>(pitch));
        BlockReduceSum(rootViews.root1, packed[kVectorFloats],
            static_cast<int32_t>(h_), static_cast<int32_t>(kVectorFloats),
            1, 1, static_cast<int32_t>(pitch));
        BlockReduceSum(rootViews.root2, p2_,
            static_cast<int32_t>(h_), static_cast<int32_t>(kVectorFloats),
            1, 1, static_cast<int32_t>(pitch));
        BlockReduceSum(rootViews.root3, p3_,
            static_cast<int32_t>(h_), static_cast<int32_t>(kVectorFloats),
            1, 1, static_cast<int32_t>(pitch));
        if (h_ >= 40U) {
            BlockReduceSum(rootViews.root4, p4_,
                static_cast<int32_t>(h_), static_cast<int32_t>(kVectorFloats),
                1, 1, static_cast<int32_t>(pitch));
        }
        if (5U == 6U) {
            if (h_ == 48U) {
                BlockReduceSum(rootViews.root5, packed[5U * kVectorFloats],
                    static_cast<int32_t>(h_),
                    static_cast<int32_t>(kVectorFloats), 1, 1,
                    static_cast<int32_t>(pitch));
            } else {
                BlockReduceSum(rootViews.root5, packed[5U * kVectorFloats],
                    static_cast<int32_t>(h_), mask, 1, 1,
                    static_cast<int32_t>(pitch));
            }
        } else if (h_ < 40U) {
            BlockReduceSum(rootViews.root4, p4_,
                static_cast<int32_t>(h_), mask, 1, 1,
                static_cast<int32_t>(pitch));
        }
        VectorDone();
        const BinaryRepeatParams countModeSteps{1, 1, 1, 8, 8, 8};
        SetMaskCount();
        SetVectorMask<float, MaskMode::COUNTER>(uint64_t(0), uint64_t(rows));
        Add<float, false>(rootViews.root0, rootViews.root0, rootViews.root1,
            MASK_PLACEHOLDER, 1, countModeSteps);
        Add<float, false>(rootViews.root3, rootViews.root2, rootViews.root3,
            MASK_PLACEHOLDER, 1, countModeSteps);
        if (5U == 6U) {
            Add<float, false>(rootViews.root5, rootViews.root4, rootViews.root5,
                MASK_PLACEHOLDER, 1, countModeSteps);
        }
        VectorDone();
        Add<float, false>(rootViews.root0, rootViews.root0, rootViews.root3,
            MASK_PLACEHOLDER, 1, countModeSteps);
        VectorDone();
        if (5U == 5U) {
            Add<float, false>(stats_, rootViews.root0, rootViews.root4,
                MASK_PLACEHOLDER, 1, countModeSteps);
        } else {
            Add<float, false>(stats_, rootViews.root0, rootViews.root5,
                MASK_PLACEHOLDER, 1, countModeSteps);
        }
    }
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 2201 && !ASCENDC_CPU_DEBUG && !defined(__MSTX_DFX_REPORT__)
    __ubuf__ float *np_,*nm_,*ns_,*nw_,*no_,*nr0_,*nr1_,*nr2_,*nr3_,*nr4_,*nda_,*ndb_;
#endif
    static constexpr uint32_t q_=8U,pitch_=40U,gateSize_=640U;
    TPipe* pipe_;
    TQue<QuePosition::VECIN,1> matrixQueue_,gatesQueue_;
    TBuf<TPosition::VECCALC> ubBankPadBeforeWork_,workBuf_,statsBuf_,broadcastBuf_,inputIndexBuf_;
    GlobalTensor<float> x_,pre_,post_,comb_;
    LocalTensor<float> work_,stats_,broadcast_,ones_;
    LocalTensor<float> p0_,p1_,p2_,p3_,p4_,w0_,w1_,w2_,w3_,w4_;
    LocalTensor<float> src16_,src32_,da_,db_,c8_,c4_,c2_,c1_,m0_,m1_,m2_,m3_,m4_;
    LocalTensor<int32_t> bulkIndex_;LocalTensor<uint32_t> gatherPattern_;
    uint64_t first_,end_,shortRowBlockMask_;
    uint32_t h_,iters_,matrixSize_,statsSize_,w_;float eps_;
};

// Metadata helpers below are host-only. They never dereference device tensors.
// Query the executing platform. No A3 measurement or SKU constant enters
// the A2 decision. Keep 16 KiB outside explicit TPipe allocations. A failed
// query retains the original conservative fallback budget.
inline uint64_t QueryUsableUbBytes()
{
    const uint64_t fallback = static_cast<uint64_t>(SINKHORN_NORM_UB_BUDGET_BYTES);
    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform == nullptr) {
        return fallback;
    }
    uint64_t size = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, size);
    const uint64_t reserve = 16U * 1024U;
    if (size == 0) {
        return fallback;
    }
    if (size <= reserve) {
        return 0;
    }
    return (size - reserve) / 32U * 32U;
}

inline uint32_t TokenGroup(uint32_t h)
{
    uint32_t a = h;
    uint32_t b = kBlockFloats;
    while (b != 0) {
        const uint32_t remainder = a % b;
        a = b;
        b = remainder;
    }
    return kBlockFloats / a;
}

inline uint64_t ResidentBytes(uint32_t h)
{
    const uint64_t pitch = (h + 7) / 8 * 8;
    return (sizeof(float) * (h * pitch + 14 * pitch + kReduceScratchFloats)) + kResidentMatrixKernelUbBankPaddingBytes;
}

inline uint64_t ResidentTokenBatchBytes(uint32_t h, uint32_t q)
{
    const uint64_t pitch = (h + 7) / 8 * 8;
    const uint64_t stats = (q * h + 7) / 8 * 8;
    return (sizeof(float) * (q * h * pitch + 6 * q * pitch + 9 * stats)) + kResidentTokenBatchKernelUbBankPaddingBytes;
}

inline uint64_t ResidentTokenBatchBulkInputBytes(uint32_t h, uint32_t q)
{
    const uint64_t pitch = (h + 7) / 8 * 8;
    const uint64_t stats = (q * h + 7) / 8 * 8;
    const uint64_t matrixPanel = uint64_t(q) * h * pitch;
    const uint64_t gatePanel = 2U * uint64_t(q) * pitch;
    const uint64_t rawPanel = uint64_t(q) * (uint64_t(h) * h + 2U * h);
    const uint64_t broadcastPanel = stats * pitch;
    const uint64_t retainedBroadcast =
        rawPanel > broadcastPanel ? rawPanel : broadcastPanel;
    // matrix + gates + one shared index TBuf + max(raw,broadcast) + work + stats
    return sizeof(float) * (
        2U * matrixPanel + 4U * gatePanel + retainedBroadcast + stats) +
        kResidentTokenBatchKernelUbBankPaddingBytes;
}

// Cpack q8 ordinary path: matrix + gates + 256-byte bank pad + work +
// stats + broadcast + the q*H*H int32 gather map.
inline uint64_t ResidentTokenBatchLowIterOutputBytes(uint32_t h, uint32_t q)
{
    const uint64_t pitch = (h + 7) / 8 * 8;
    const uint64_t stats = (q * h + 7) / 8 * 8;
    const uint64_t matrixPanel = uint64_t(q) * h * pitch;
    const uint64_t gates = 2U * uint64_t(q) * pitch;
    const uint64_t work = 2U * gates;
    const uint64_t broadcast = stats * pitch;
    const uint64_t indexMap = uint64_t(q) * h * h;
    return sizeof(float) *
        (matrixPanel + gates + work + stats + broadcast + indexMap) +
        kResidentTokenBatchKernelUbBankPaddingBytes;
}

inline uint64_t ResidentScaledBytes(uint32_t h)
{
    const uint64_t pitch = (h + 7) / 8 * 8;
    const uint64_t extraRowScratch = h < kVectorFloats ? 0 :
        ((h > kVectorFloats && h % kVectorFloats == 0) ? 16U : 8U) * pitch;
    return sizeof(float) * (2 * h * pitch + 15 * pitch + extraRowScratch) +
        kResidentScaledKernelUbBankPaddingBytes;
}

inline uint64_t ResidentScaledTokenBatchBytes(uint32_t h, uint32_t q)
{
    const uint64_t pitch = (h + 7) / 8 * 8;
    const uint64_t stats = (q * h + 7) / 8 * 8;
    return sizeof(float) * (q * h * pitch + 2 * q * pitch + 20 * stats) +
        kResidentScaledKernelUbBankPaddingBytes;
}

// P2 nonaligned wide batch: one matrix, gates, four factor panels and
// sixteen scratch panels, all statistic panels sized to q*P.
inline uint64_t WideOriginalScaledTokenBatchBytes(uint32_t h, uint32_t q)
{
    const uint64_t pitch = (h + 7) / 8 * 8;
    return sizeof(float) * q * pitch * (h + 22U) +
        kResidentScaledKernelUbBankPaddingBytes;
}

// Dedicated H==64 interleaved scaled batch: one q*H*H matrix, gate rows for
// q tokens, three E=q*H factor panels, roots and Brcb broadcast panels of
// eight floats per token row (8*E each), and two gate sigmoid scratch panels.
inline uint64_t H64InterleavedScaledBytes(uint32_t h, uint32_t q)
{
    const uint64_t pitch = (h + 7) / 8 * 8;
    const uint64_t e = uint64_t(q) * h;
    return sizeof(float) * (uint64_t(q) * h * pitch + 2 * e + 3 * e + 8 * e + 8 * e + 4 * e) +
        kResidentScaledKernelUbBankPaddingBytes;
}

inline uint64_t PlaneBytes(uint32_t h, uint32_t q)
{
    const uint64_t width = h * h + 2 * h;
    return sizeof(float) * q * (5 * width + 4 * h);
}

}  // namespace sinkhorn_norm


__global__ __vector__ void sinkhorn_norm_compact_short_native(GM_ADDR mixes,
    GM_ADDR pre,GM_ADDR post,GM_ADDR comb,uint64_t tokens,uint32_t h,
    uint32_t iters,float eps,uint32_t tokenGroup,uint32_t flags)
{
    AscendC::TPipe pipe;sinkhorn_norm::CompactShortNativeKernel<false> kernel;
    kernel.Init(mixes,pre,post,comb,tokens,h,iters,eps,tokenGroup,flags,&pipe);
    kernel.Process();
}

// M1: only the intersection of A1 and C2 admissions uses this entry.
// All original A1 arithmetic and full initialization are retained.
__global__ __vector__ void sinkhorn_norm_compact_short_native_fused(
    GM_ADDR mixes,GM_ADDR pre,GM_ADDR post,GM_ADDR comb,uint64_t tokens,
    uint32_t h,uint32_t iters,float eps,uint32_t tokenGroup,uint32_t flags,
    uint32_t matrixCoreCount)
{
    AscendC::TPipe pipe;
    sinkhorn_norm::CompactShortNativeKernel<true> kernel;
    kernel.Init(mixes,pre,post,comb,tokens,h,iters,eps,tokenGroup,flags,&pipe,
        matrixCoreCount);
    kernel.Process();
}


// M3: exactly one additional small-class instantiation, true/P24.
// Host admits only A&&C&&P24; all allocation and mask events match M2.
__global__ __vector__ void sinkhorn_norm_compact_short_native_fused_p24(
    GM_ADDR mixes,GM_ADDR pre,GM_ADDR post,GM_ADDR comb,uint64_t tokens,
    uint32_t h,uint32_t iters,float eps,uint32_t tokenGroup,uint32_t flags,
    uint32_t matrixCoreCount)
{
    AscendC::TPipe pipe;
    sinkhorn_norm::CompactShortNativeKernel<true,24U> kernel;
    kernel.Init(mixes,pre,post,comb,tokens,h,iters,eps,tokenGroup,flags,&pipe,
        matrixCoreCount);
    kernel.Process();
}

// A1: complete constexpr H18 instance; F3 entry placement and runtime iters/eps.
// A1: complete constexpr H22 instance; F3 entry placement and runtime iters/eps.
__global__ __vector__ void sinkhorn_norm_slim_compact40(GM_ADDR mixes,GM_ADDR pre,
    GM_ADDR post,GM_ADDR comb,uint64_t tokens,uint32_t h,uint32_t iters,float eps,
    uint32_t tokenGroup)
{
    AscendC::TPipe pipe;sinkhorn_norm::SlimCompact40Kernel kernel;
    kernel.Init(mixes,pre,post,comb,tokens,h,iters,eps,tokenGroup,&pipe);
    kernel.Process();
}

// C2: one isolated surplus-q2 entry. The generic entry below keeps its exact
// baseline signature/body and default Init matrixCoreCount=0, allowing its
// extra role branches to fold away. This is a compilation-isolation
// hypothesis until actual binary/profile checks, not a speed assertion.
__global__ __vector__ void sinkhorn_norm_surplus_q2_dedicated(
    GM_ADDR mixes, GM_ADDR pre, GM_ADDR post, GM_ADDR comb,
    uint64_t tokens, uint32_t h, uint32_t iters, float eps,
    uint32_t tokenGroup, uint32_t residentBatch, uint32_t matrixCoreCount)
{
    AscendC::TPipe pipe;
    sinkhorn_norm::ResidentTokenBatchKernel kernel;
    // Keep C1's complete Init on BOTH roles in this first variant, including
    // all matrix metadata/queues/scratch. Only entry isolation is changed.
    kernel.Init(mixes, pre, post, comb, tokens, h, iters, eps, tokenGroup,
        residentBatch, &pipe, matrixCoreCount);
    kernel.Process();
}

__global__ __vector__ void sinkhorn_norm_custom(GM_ADDR mixes, GM_ADDR pre,
    GM_ADDR post, GM_ADDR comb, uint64_t tokens, uint32_t h, uint32_t iters,
    float eps, uint32_t tokenGroup, uint32_t planeBatch, uint32_t residentBatch,
    uint32_t scaledResident)
{
    AscendC::TPipe pipe;
    if (planeBatch != 0) {
        sinkhorn_norm::BatchPlanesKernel<false> kernel;
        kernel.Init(mixes, pre, post, comb, tokens, h, iters, eps, tokenGroup, planeBatch, &pipe);
        kernel.Process();
    } else if (scaledResident != 0) {
        // Complete-vector-row resource families allow compile-time strides
        // and row reduction structure. No iteration or tensor value is fixed.
        if (h % sinkhorn_norm::kVectorFloats == 0) {
            if (h / sinkhorn_norm::kVectorFloats == 1) {
                sinkhorn_norm::ResidentScaledMatrixKernel<1> kernel;
                kernel.Init(mixes, pre, post, comb, tokens, h, iters, eps, tokenGroup, &pipe);
                kernel.Process();
            } else {
                sinkhorn_norm::ResidentScaledMatrixKernel<2> kernel;
                kernel.Init(mixes, pre, post, comb, tokens, h, iters, eps, tokenGroup, &pipe);
                kernel.Process();
            }
        } else {
            sinkhorn_norm::ResidentScaledMatrixKernel<0> kernel;
            kernel.Init(mixes, pre, post, comb, tokens, h, iters, eps, tokenGroup, &pipe);
            kernel.Process();
        }
    } else if (residentBatch > 1 ||
        tokenGroup < sinkhorn_norm::DeviceOutputTokenGroup(h)) {
        sinkhorn_norm::ResidentTokenBatchKernel kernel;
        kernel.Init(mixes, pre, post, comb, tokens, h, iters, eps, tokenGroup, residentBatch, &pipe);
        kernel.Process();
    } else {
        sinkhorn_norm::ResidentMatrixKernel<0> kernel;
        kernel.Init(mixes, pre, post, comb, tokens, h, iters, eps, tokenGroup, &pipe);
        kernel.Process();
    }
}

// Only the added wide scaled token batch has a separate device entry.
// Preserve the original C6 entry above for all other metadata families.
__global__ __vector__ void sinkhorn_norm_custom_scaled_batch(GM_ADDR mixes, GM_ADDR pre,
    GM_ADDR post, GM_ADDR comb, uint64_t tokens, uint32_t h, uint32_t iters,
    float eps, uint32_t tokenGroup, uint32_t planeBatch, uint32_t residentBatch,
    uint32_t scaledResident, uint32_t columnTreeEnabled)
{
    AscendC::TPipe pipe;
